@@ -0,0 +1,59 @@
+/**
+ * Discord-style huddle invite sent to a person's DM. The payload rides in an
+ * HTML comment so clients without the invite card still show the plain line.
+ */
+const MARKER_PREFIX = "<!-- buzz:huddle-invite:v1 ";
+const MARKER_SUFFIX = " -->";
+
+export type HuddleInvite = {
+  parentChannelId: string;
+  ephemeralChannelId: string;
+  huddleEventId: string | null;
+  channelName: string | null;
+  fallbackText: string;
+};
+
+export function buildHuddleInviteContent(opts: {
+  inviterName: string;
+  parentChannelId: string;
+  ephemeralChannelId: string;
+  huddleEventId?: string | null;
+  channelName?: string | null;
+}): string {
+  const channelName = opts.channelName?.trim() || null;
+  const payload = JSON.stringify({
+    parent: opts.parentChannelId,
+    eph: opts.ephemeralChannelId,
+    event: opts.huddleEventId ?? null,
+    channel: channelName,
+  }).replace(/--/g, "-\\u002d"); // never close the comment early
+  const where = channelName ? `#${channelName} ` : "";
+  const name = opts.inviterName.trim() || "누군가";
+  return `${MARKER_PREFIX}${payload}${MARKER_SUFFIX}\n📞 ${name}님이 ${where}통화에 초대했어요.`;
+}
+
+export function parseHuddleInviteContent(content: string): HuddleInvite | null {
+  const trimmed = content.trimStart();
+  if (!trimmed.startsWith(MARKER_PREFIX)) return null;
+  const end = trimmed.indexOf(MARKER_SUFFIX, MARKER_PREFIX.length);
+  if (end < 0) return null;
+  try {
+    const data = JSON.parse(trimmed.slice(MARKER_PREFIX.length, end)) as Record<
+      string,
+      unknown
+    >;
+    if (typeof data.parent !== "string" || typeof data.eph !== "string") {
+      return null;
+    }
+    return {
+      parentChannelId: data.parent,
+      ephemeralChannelId: data.eph,
+      huddleEventId: typeof data.event === "string" ? data.event : null,
+      channelName: typeof data.channel === "string" ? data.channel : null,
+      fallbackText:
+        trimmed.slice(end + MARKER_SUFFIX.length).trim() || "통화 초대",
+    };
+  } catch {
+    return null;
+  }
+}
diff --git a/desktop/src/features/messages/ui/HuddleInviteAttachment.tsx b/desktop/src/features/messages/ui/HuddleInviteAttachment.tsx
new file mode 100644
index 000000000..2c911161a
--- /dev/null
+++ b/desktop/src/features/messages/ui/HuddleInviteAttachment.tsx
@@ -0,0 +1,71 @@
+import * as React from "react";
+import { toast } from "sonner";
+
+import { useHuddle } from "@/features/huddle";
+import { formatHuddleActionError } from "@/features/huddle/lib/huddleError";
+import type { HuddleInvite } from "@/features/messages/lib/huddleInviteMessage";
+import {
+  Attachment,
+  AttachmentAction,
+  AttachmentActions,
+  AttachmentContent,
+  AttachmentDescription,
+  AttachmentMedia,
+  AttachmentTitle,
+} from "@/shared/ui/attachment";
+
+/** DM card for a Discord-style huddle invite: one click joins the call. */
+export function HuddleInviteAttachment({ invite }: { invite: HuddleInvite }) {
+  const { activeEphemeralChannelId, isStarting, joinHuddle } = useHuddle();
+  const alreadyIn = activeEphemeralChannelId === invite.ephemeralChannelId;
+
+  const handleJoin = React.useCallback(
+    async (event: React.MouseEvent<HTMLButtonElement>) => {
+      event.preventDefault();
+      event.stopPropagation();
+      if (alreadyIn || isStarting) return;
+      try {
+        await joinHuddle(
+          invite.parentChannelId,
+          invite.ephemeralChannelId,
+          invite.huddleEventId ?? undefined,
+        );
+      } catch (error) {
+        toast.error(formatHuddleActionError(error, "join"));
+      }
+    },
+    [alreadyIn, invite, isStarting, joinHuddle],
+  );
+
+  return (
+    <Attachment
+      className="mt-1 max-w-md"
+      data-testid="message-huddle-invite-attachment"
+      size="default"
+    >
+      <AttachmentMedia aria-hidden="true" className="text-lg">
+        📞
+      </AttachmentMedia>
+      <AttachmentContent>
+        <AttachmentTitle data-no-translate>
+          {invite.fallbackText}
+        </AttachmentTitle>
+        <AttachmentDescription>
+          {alreadyIn
+            ? "통화에 참여 중이에요."
+            : "통화가 끝났으면 참여할 수 없어요."}
+        </AttachmentDescription>
+      </AttachmentContent>
+      <AttachmentActions>
+        <AttachmentAction
+          disabled={alreadyIn || isStarting}
+          onClick={handleJoin}
+          size="xs"
+          type="button"
+        >
+          참여하기
+        </AttachmentAction>
+      </AttachmentActions>
+    </Attachment>
+  );
+}

+/// Outcome of inviting a person into the active huddle.
+#[derive(Debug, Serialize)]
+pub struct HumanInviteResult {
+    pub parent_channel_id: String,
+    pub ephemeral_channel_id: String,
+    /// The kind:48100 "huddle started" event, when known — lets the invite
+    /// card join with the same thread context as the channel card.
+    pub huddle_event_id: Option<String>,
+    /// Whether the person is (now) a member of the parent channel.
+    pub parent_added: bool,
+    pub parent_error: Option<String>,
+}
+
+/// Let a person into the huddle (Discord-style "invite to call").
+///
+/// Adds them to the private ephemeral huddle channel as `member` — the relay
+/// admits explicit ephemeral members even if they are not in the parent
+/// channel. With `add_to_parent`, also adds them to the parent channel
+/// (best-effort, existing membership and role are left untouched).
+pub async fn add_human_to_huddle(
+    ephemeral_channel_id: Uuid,
+    parent_channel_id: Uuid,
+    pubkey: &str,
+    add_to_parent: bool,
+    state: &AppState,
+) -> Result<(bool, Option<String>), String> {
+    let add_eph = events::build_add_member(ephemeral_channel_id, pubkey, Some("member"))?;
+    submit_event(add_eph, state).await?;
+
+    let parent_id = parent_channel_id.to_string();
+    let already_in_parent = fetch_channel_members_with_roles(&parent_id, state)
+        .await
+        .is_ok_and(|members| contains_member(&members, pubkey));
+    if already_in_parent || !add_to_parent {
+        return Ok((already_in_parent, None));
+    }
+    let add_parent = events::build_add_member(parent_channel_id, pubkey, Some("member"))?;
+    match submit_event(add_parent, state).await {
+        Ok(_) => Ok((true, None)),
+        Err(e) => {
+            eprintln!("buzz-desktop: add person to parent channel failed: {e}");
+            Ok((false, Some(e)))
+        }
+    }
+}
+
 /// Reconcile explicitly added channel agents into the active Huddle.
 ///
 /// The source channel may be either the Huddle's parent or its ephemeral chat.

diff --git a/desktop/src/features/huddle/components/InvitePeopleDialog.tsx b/desktop/src/features/huddle/components/InvitePeopleDialog.tsx
new file mode 100644
index 000000000..4767d753b
--- /dev/null
+++ b/desktop/src/features/huddle/components/InvitePeopleDialog.tsx
@@ -0,0 +1,224 @@
+import { invoke } from "@tauri-apps/api/core";
+import { Check, LoaderCircle } from "lucide-react";
+import * as React from "react";
+
+import { useChannelsQuery } from "@/features/channels/hooks";
+import { buildHuddleInviteContent } from "@/features/messages/lib/huddleInviteMessage";
+import { useUserSearchQuery } from "@/features/profile/hooks";
+import { ProfileAvatar } from "@/features/profile/ui/ProfileAvatar";
+import { openDm, sendChannelMessage } from "@/shared/api/tauri";
+import { normalizePubkey, truncateNpub } from "@/shared/lib/pubkey";
+import { Dialog } from "@/shared/ui/dialog";
+import { ChooserDialogContent } from "@/shared/ui/chooser-dialog-content";
+
+// Mirrors HumanInviteResult in src-tauri/src/huddle/agents.rs.
+type HumanInviteResult = {
+  parent_channel_id: string;
+  ephemeral_channel_id: string;
+  huddle_event_id: string | null;
+  parent_added: boolean;
+  parent_error: string | null;
+};
+
+type InvitePeopleDialogProps = {
+  open: boolean;
+  onClose: () => void;
+  selfPubkey: string | null;
+  selfName: string;
+  participantPubkeys: string[];
+  parentChannelId: string | null;
+  /** Only the huddle's creator can ring with a real huddle card. */
+  isCreator: boolean;
+};
+
+/**
+ * Discord-style "invite to call": admit a person to the running huddle and
+ * ring them with a join card in their DM. Optionally add them to the channel.
+ */
+export function InvitePeopleDialog({
+  open,
+  onClose,
+  selfPubkey,
+  selfName,
+  participantPubkeys,
+  parentChannelId,
+  isCreator,
+}: InvitePeopleDialogProps) {
+  const [query, setQuery] = React.useState("");
+  const [addToChannel, setAddToChannel] = React.useState(false);
+  const [busy, setBusy] = React.useState<string | null>(null);
+  const [invited, setInvited] = React.useState<Set<string>>(new Set());
+  const [error, setError] = React.useState<string | null>(null);
+  const [notice, setNotice] = React.useState<string | null>(null);
+
+  React.useEffect(() => {
+    if (!open) return;
+    setQuery("");
+    setBusy(null);
+    setInvited(new Set());
+    setError(null);
+    setNotice(null);
+  }, [open]);
+
+  const deferredQuery = React.useDeferredValue(query.trim());
+  const searchQuery = useUserSearchQuery(deferredQuery, {
+    enabled: open && deferredQuery.length > 0,
+    limit: 12,
+  });
+  const channelsQuery = useChannelsQuery({ enabled: open });
+  const parentChannel = channelsQuery.data?.find(
+    (c) => c.id === parentChannelId,
+  );
+  // A DM huddle has no meaningful channel name ("DM") to show.
+  const channelName =
+    parentChannel && parentChannel.channelType !== "dm"
+      ? parentChannel.name
+      : null;
+
+  const excluded = React.useMemo(() => {
+    const set = new Set(participantPubkeys.map(normalizePubkey));
+    if (selfPubkey) set.add(normalizePubkey(selfPubkey));
+    return set;
+  }, [participantPubkeys, selfPubkey]);
+
+  const people = (searchQuery.data ?? []).filter(
+    (user) => !user.isAgent && !excluded.has(normalizePubkey(user.pubkey)),
+  );
+
+  async function handleInvite(pubkey: string, label: string) {
+    if (busy) return;
+    setBusy(pubkey);
+    setError(null);
+    setNotice(null);
+    try {
+      const result = await invoke<HumanInviteResult>("invite_to_huddle", {
+        pubkey,
+        addToParent: addToChannel,
+      });
+      const dm = await openDm({ pubkeys: [pubkey] });
+      if (isCreator) {
+        // A real huddle card in their DM: every Buzz client shows it with a
+        // Join button and a call notification, patched or not.
+        await invoke<string>("ring_huddle_in_dm", { dmChannelId: dm.id });
+      } else {
+        await sendChannelMessage(
+          dm.id,
+          buildHuddleInviteContent({
+            inviterName: selfName,
+            parentChannelId: result.parent_channel_id,
+            ephemeralChannelId: result.ephemeral_channel_id,
+            huddleEventId: result.huddle_event_id,
+            channelName,
+          }),
+        );
+      }
+      setInvited((prev) => new Set(prev).add(pubkey));
+      if (addToChannel && result.parent_error) {
+        setNotice(
+          `${label}님을 불렀지만 채널 추가는 실패했어요: ${result.parent_error}`,
+        );
+      }
+    } catch (e: unknown) {
+      const msg = e instanceof Error ? e.message : String(e);
+      setError(`${label}님을 부르지 못했어요: ${msg}`);
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  return (
+    <Dialog
+      onOpenChange={(next) => {
+        if (!next) onClose();
+      }}
+      open={open}
+    >
+      <ChooserDialogContent
+        className="max-w-xl"
+        data-no-translate
+        data-testid="invite-huddle-people-dialog"
+        headerSubtitle="부르면 바로 이 통화에 들어올 수 있고, DM으로 참여 카드가 가요."
+        scrollAreaClassName="space-y-4"
+        title="통화에 사람 부르기"
+      >
+        <input
+          autoFocus
+          className="w-full rounded-lg border bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
+          onChange={(event) => setQuery(event.target.value)}
+          placeholder="이름으로 검색"
+          value={query}
+        />
+        <label className="flex items-center gap-2 text-sm text-muted-foreground">
+          <input
+            checked={addToChannel}
+            onChange={(event) => setAddToChannel(event.target.checked)}
+            type="checkbox"
+          />
+          {channelName ? `#${channelName} 채널에도 추가` : "채널에도 추가"}
+        </label>
+
+        {error ? (
+          <p className="rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">
+            {error}
+          </p>
+        ) : null}
+        {notice ? (
+          <p className="rounded-lg border border-warning/30 bg-warning-bg px-4 py-3 text-sm text-warning">
+            {notice}
+          </p>
+        ) : null}
+
+        {deferredQuery.length === 0 ? (
+          <p className="py-4 text-center text-sm text-muted-foreground">
+            부를 사람 이름을 입력하세요.
+          </p>
+        ) : searchQuery.isLoading ? (
+          <p className="py-4 text-center text-sm text-muted-foreground">
+            찾는 중…
+          </p>
+        ) : people.length === 0 ? (
+          <p className="py-4 text-center text-sm text-muted-foreground">
+            부를 수 있는 사람이 없어요.
+          </p>
+        ) : (
+          <ul className="flex flex-col gap-1">
+            {people.map((user) => {
+              const label =
+                user.displayName?.trim() || truncateNpub(user.pubkey);
+              const isBusy = busy === user.pubkey;
+              const isInvited = invited.has(user.pubkey);
+              return (
+                <li
+                  className="flex items-center gap-3 rounded-lg px-3 py-2"
+                  key={user.pubkey}
+                >
+                  <ProfileAvatar
+                    avatarUrl={user.avatarUrl}
+                    className="h-9 w-9 shrink-0 text-xs"
+                    label={label}
+                  />
+                  <span className="min-w-0 flex-1 truncate text-sm font-medium">
+                    {label}
+                  </span>
+                  <button
+                    className="inline-flex items-center gap-1 rounded-md border px-3 py-1.5 text-xs font-medium transition-colors hover:bg-accent disabled:opacity-50"
+                    disabled={busy !== null || isInvited}
+                    onClick={() => void handleInvite(user.pubkey, label)}
+                    type="button"
+                  >
+                    {isBusy ? (
+                      <LoaderCircle className="h-3.5 w-3.5 animate-spin" />
+                    ) : isInvited ? (
+                      <Check className="h-3.5 w-3.5" />
+                    ) : null}
+                    {isInvited ? "불렀어요" : "부르기"}
+                  </button>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </ChooserDialogContent>
+    </Dialog>
+  );
+}

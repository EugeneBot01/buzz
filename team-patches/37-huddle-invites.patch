@@ -0,0 +1,43 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  buildHuddleInviteContent,
+  parseHuddleInviteContent,
+} from "./huddleInviteMessage.ts";
+
+test("invite content round-trips", () => {
+  const content = buildHuddleInviteContent({
+    inviterName: "구윤",
+    parentChannelId: "p-1",
+    ephemeralChannelId: "e-1",
+    huddleEventId: "ev",
+    channelName: "제작부",
+  });
+  assert.ok(content.endsWith("📞 구윤님이 #제작부 통화에 초대했어요."));
+  assert.deepEqual(parseHuddleInviteContent(content), {
+    parentChannelId: "p-1",
+    ephemeralChannelId: "e-1",
+    huddleEventId: "ev",
+    channelName: "제작부",
+    fallbackText: "📞 구윤님이 #제작부 통화에 초대했어요.",
+  });
+});
+
+test("a channel name with -- cannot close the marker early", () => {
+  const content = buildHuddleInviteContent({
+    inviterName: "a",
+    parentChannelId: "p",
+    ephemeralChannelId: "e",
+    channelName: "x-->y",
+  });
+  assert.equal(parseHuddleInviteContent(content)?.channelName, "x-->y");
+});
+
+test("plain messages are not invites", () => {
+  assert.equal(parseHuddleInviteContent("hello"), null);
+  assert.equal(
+    parseHuddleInviteContent("<!-- buzz:huddle-invite:v1 {bad} -->"),
+    null,
+  );
+});

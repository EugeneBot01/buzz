 }
+
+/// Invite a person into the active huddle: admit them to the huddle channel
+/// and (optionally) add them to the parent channel. The caller then sends the
+/// ringing invite message to their DM.
+#[tauri::command]
+pub async fn invite_to_huddle(
+    pubkey: String,
+    add_to_parent: bool,
+    state: State<'_, AppState>,
+) -> Result<agents::HumanInviteResult, String> {
+    validate_pubkey_hex(&pubkey)?;
+    let (eph_id, parent_id, huddle_event_id) = {
+        let hs = state.huddle()?;
+        if !matches!(hs.phase, HuddlePhase::Connected | HuddlePhase::Active) {
+            return Err("no active huddle".to_string());
+        }
+        (
+            hs.ephemeral_channel_id
+                .clone()
+                .ok_or("no ephemeral channel")?,
+            hs.parent_channel_id.clone().ok_or("no parent channel")?,
+            hs.huddle_thread_event_id.clone(),
+        )
+    };
+    let eph_uuid = Uuid::parse_str(&eph_id).map_err(|e| e.to_string())?;
+    let parent_uuid = Uuid::parse_str(&parent_id).map_err(|e| e.to_string())?;
+
+    let (parent_added, parent_error) =
+        agents::add_human_to_huddle(eph_uuid, parent_uuid, &pubkey, add_to_parent, &state).await?;
+
+    Ok(agents::HumanInviteResult {
+        parent_channel_id: parent_id,
+        ephemeral_channel_id: eph_id,
+        huddle_event_id,
+        parent_added,
+        parent_error,
+    })
+}
+
+/// Ring a person by posting this huddle's "started" card into their DM.
+///
+/// The relay accepts a join through a parent only when that parent holds a
+/// creator-signed kind:48100 for the huddle, so only the huddle's creator can
+/// ring. Every Buzz client already renders the card with a Join button and
+/// raises a call notification for it in DMs. Returns the card's event id.
+#[tauri::command]
+pub async fn ring_huddle_in_dm(
+    dm_channel_id: String,
+    state: State<'_, AppState>,
+) -> Result<String, String> {
+    let eph_id = {
+        let hs = state.huddle()?;
+        if !matches!(hs.phase, HuddlePhase::Connected | HuddlePhase::Active) {
+            return Err("no active huddle".to_string());
+        }
+        if !hs.is_creator {
+            return Err("only the huddle's creator can ring".to_string());
+        }
+        hs.ephemeral_channel_id
+            .clone()
+            .ok_or("no ephemeral channel")?
+    };
+    Uuid::parse_str(&dm_channel_id).map_err(|e| e.to_string())?;
+    let builder = events::build_huddle_started(&dm_channel_id, &eph_id)?;
+    let event = submit_event(builder, &state).await?;
+    Ok(event.event_id)
+}

+/// One file of a bulk download request (team patch).
+#[derive(serde::Deserialize)]
+pub struct BulkDownloadItem {
+    url: String,
+    filename: String,
+}
+
+/// A file a bulk download could not save, and why.
+#[derive(serde::Serialize)]
+pub struct BulkDownloadFailure {
+    filename: String,
+    error: String,
+}
+
+/// Outcome of [`download_files_to_folder`].
+#[derive(serde::Serialize)]
+pub struct BulkDownloadResult {
+    /// The user closed the folder dialog; nothing was downloaded.
+    cancelled: bool,
+    saved: usize,
+    failed: Vec<BulkDownloadFailure>,
+}
+
+/// A path in `folder` for `filename` that does not overwrite an existing
+/// file: `report.pdf`, then `report (2).pdf`, `report (3).pdf`, ...
+fn unique_destination(folder: &std::path::Path, filename: &str) -> std::path::PathBuf {
+    let candidate = folder.join(filename);
+    if !candidate.exists() {
+        return candidate;
+    }
+    let path = std::path::Path::new(filename);
+    let stem = path
+        .file_stem()
+        .and_then(|s| s.to_str())
+        .unwrap_or("file");
+    let ext = path.extension().and_then(|e| e.to_str());
+    for n in 2..10_000u32 {
+        let name = match ext {
+            Some(ext) => format!("{stem} ({n}).{ext}"),
+            None => format!("{stem} ({n})"),
+        };
+        let candidate = folder.join(name);
+        if !candidate.exists() {
+            return candidate;
+        }
+    }
+    candidate
+}
+
+/// Team patch: download several relay `/media/` files into one folder the
+/// user picks once, instead of one save dialog per file.
+///
+/// Every URL is validated against the relay origin before the folder dialog
+/// opens (same SSRF guard as `download_file`). The destination folder comes
+/// only from the native dialog, never from the frontend. A file that fails is
+/// reported and the rest continue; existing files are never overwritten.
+#[tauri::command]
+pub async fn download_files_to_folder(
+    items: Vec<BulkDownloadItem>,
+    app: tauri::AppHandle,
+    state: State<'_, AppState>,
+) -> Result<BulkDownloadResult, String> {
+    if items.is_empty() {
+        return Err("no files selected".to_string());
+    }
+    if items.len() > MAX_BULK_DOWNLOAD_ITEMS {
+        return Err(format!(
+            "too many files selected (max {MAX_BULK_DOWNLOAD_ITEMS})"
+        ));
+    }
+    let relay_base = relay_api_base_url_with_override(&state);
+    for item in &items {
+        validate_download_url(&item.url, &relay_base)?;
+    }
+
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    app.dialog().file().pick_folder(move |path| {
+        let _ = tx.send(path);
+    });
+    let selected = rx.await.map_err(|_| "dialog cancelled".to_string())?;
+    let folder = match selected {
+        Some(path) => path
+            .as_path()
+            .ok_or_else(|| "Folder dialog returned an invalid path".to_string())?
+            .to_path_buf(),
+        None => {
+            return Ok(BulkDownloadResult {
+                cancelled: true,
+                saved: 0,
+                failed: Vec::new(),
+            })
+        }
+    };
+
+    let mut saved = 0usize;
+    let mut failed = Vec::new();
+    for item in items {
+        let filename = sanitize_filename(&item.filename);
+        let outcome: Result<(), String> = async {
+            let bytes =
+                fetch_blob_bytes_with_cap(&item.url, &state, MAX_FILE_DOWNLOAD_BYTES, None).await?;
+            detect_and_validate_mime(&bytes)?;
+            let dest = unique_destination(&folder, &filename);
+            std::fs::write(&dest, &bytes).map_err(|e| format!("Failed to write file: {e}"))
+        }
+        .await;
+        match outcome {
+            Ok(()) => saved += 1,
+            Err(error) => failed.push(BulkDownloadFailure { filename, error }),
+        }
+    }
+
+    Ok(BulkDownloadResult {
+        cancelled: false,
+        saved,
+        failed,
+    })
+}

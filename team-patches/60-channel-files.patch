@@ -0,0 +1,84 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  collectChannelFiles,
+  fileKind,
+  formatFileSize,
+  totalSize,
+} from "./channelFiles.ts";
+
+const ALICE = "a".repeat(64);
+const BOB = "b".repeat(64);
+
+let seq = 0;
+const message = (pubkey, createdAt, ...imeta) => ({
+  id: `id-${String(++seq).padStart(4, "0")}`,
+  pubkey,
+  kind: 9,
+  content: "",
+  created_at: createdAt,
+  tags: [["h", "channel"], ...imeta],
+  sig: "s",
+});
+const imeta = (url, fields = {}) => [
+  "imeta",
+  `url ${url}`,
+  ...Object.entries(fields).map(([key, value]) => `${key} ${value}`),
+];
+
+test("attachments are listed newest first with their recorded name and size", () => {
+  const files = collectChannelFiles([
+    message(ALICE, 100, imeta("https://relay.example/media/aaa.pdf", {
+      filename: "plan v2.pdf",
+      size: 2048,
+      m: "application/pdf",
+    })),
+    message(BOB, 300, imeta("https://relay.example/media/bbb.png", { m: "image/png" })),
+    message(ALICE, 200, imeta("https://relay.example/media/ccc.mp4", { m: "video/mp4", size: "oops" })),
+    message(ALICE, 400),
+  ]);
+  assert.deepEqual(
+    files.map((file) => [file.filename, file.size, file.author, file.postedAt]),
+    [
+      ["bbb.png", undefined, BOB, 300],
+      ["ccc.mp4", undefined, ALICE, 200],
+      ["plan v2.pdf", 2048, ALICE, 100],
+    ],
+  );
+  assert.equal(totalSize(files), 2048);
+});
+
+test("a file posted twice is listed once, at its most recent post", () => {
+  const url = "https://relay.example/media/aaa.pdf";
+  const files = collectChannelFiles([
+    message(ALICE, 100, imeta(url, { filename: "first.pdf" })),
+    message(BOB, 500, imeta(url, { filename: "again.pdf" })),
+    message(ALICE, 300, imeta(url, { filename: "middle.pdf" })),
+  ]);
+  assert.equal(files.length, 1);
+  assert.deepEqual([files[0].filename, files[0].author, files[0].postedAt], ["again.pdf", BOB, 500]);
+});
+
+test("several attachments on one message are all listed", () => {
+  const files = collectChannelFiles([
+    message(ALICE, 100,
+      imeta("https://relay.example/media/b.zip", { filename: "b.zip" }),
+      imeta("https://relay.example/media/a.zip", { filename: "a.zip" }),
+    ),
+  ]);
+  assert.deepEqual(files.map((file) => file.filename), ["a.zip", "b.zip"]);
+});
+
+test("kinds and sizes are labelled", () => {
+  assert.equal(fileKind("image/png"), "image");
+  assert.equal(fileKind("video/mp4"), "video");
+  assert.equal(fileKind("audio/mpeg"), "audio");
+  assert.equal(fileKind("application/pdf"), "file");
+  assert.equal(fileKind(""), "file");
+  assert.equal(formatFileSize(820), "820 B");
+  assert.equal(formatFileSize(12_700), "12 KB");
+  assert.equal(formatFileSize(3_250_000), "3.1 MB");
+  assert.equal(formatFileSize(undefined), "");
+  assert.equal(formatFileSize(-1), "");
+});

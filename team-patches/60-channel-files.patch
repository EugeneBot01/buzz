@@ -0,0 +1,304 @@
+import { FileText, Film, Image as ImageIcon, Music } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import {
+  type ChannelFile,
+  MAX_BULK_DOWNLOAD_FILES,
+  collectChannelFiles,
+  fileKind,
+  formatFileSize,
+  formatPostedDate,
+  totalSize,
+} from "@/features/channel-files/lib/channelFiles";
+import { relayClient } from "@/shared/api/relayClient";
+import { invokeTauri } from "@/shared/api/tauri";
+import type { RelayEvent } from "@/shared/api/types";
+import { CHANNEL_MESSAGE_EVENT_KINDS } from "@/shared/constants/kinds";
+import { Button } from "@/shared/ui/button";
+import { Checkbox } from "@/shared/ui/checkbox";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+
+/** Messages read per page while looking for attachments. */
+const PAGE_SIZE = 500;
+
+type BulkDownloadResult = {
+  cancelled: boolean;
+  saved: number;
+  failed: Array<{ filename: string; error: string }>;
+};
+
+function KindIcon({ mime }: { mime: string }) {
+  const kind = fileKind(mime);
+  const Icon =
+    kind === "image"
+      ? ImageIcon
+      : kind === "video"
+        ? Film
+        : kind === "audio"
+          ? Music
+          : FileText;
+  return <Icon aria-hidden="true" className="h-4 w-4" />;
+}
+
+type ChannelFilesDialogProps = {
+  channelId: string;
+  channelName: string;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+};
+
+/**
+ * Channel files (team patch): the attachments posted in one channel, with
+ * checkboxes to save several into a folder in one go.
+ */
+export function ChannelFilesDialog({
+  channelId,
+  channelName,
+  open,
+  onOpenChange,
+}: ChannelFilesDialogProps) {
+  const [events, setEvents] = React.useState<RelayEvent[]>([]);
+  const [status, setStatus] = React.useState<"loading" | "ready" | "error">(
+    "loading",
+  );
+  const [hasMore, setHasMore] = React.useState(false);
+  const [selected, setSelected] = React.useState<ReadonlySet<string>>(
+    () => new Set(),
+  );
+  const [downloading, setDownloading] = React.useState(false);
+  // Bumped whenever the channel changes or the dialog unmounts, so a page
+  // that arrives late is never added to another channel's list.
+  const generationRef = React.useRef(0);
+
+  const loadPage = React.useCallback(
+    async (until: number | undefined) => {
+      const generation = generationRef.current;
+      setStatus("loading");
+      try {
+        const page = await relayClient.fetchEvents({
+          kinds: [...CHANNEL_MESSAGE_EVENT_KINDS],
+          "#h": [channelId],
+          limit: PAGE_SIZE,
+          ...(until === undefined ? {} : { until }),
+        });
+        if (generationRef.current !== generation) return;
+        setEvents((current) => {
+          const known = new Set(current.map((event) => event.id));
+          const added = page.filter((event) => !known.has(event.id));
+          return added.length > 0 ? [...current, ...added] : current;
+        });
+        setHasMore(page.length >= PAGE_SIZE);
+        setStatus("ready");
+      } catch {
+        if (generationRef.current !== generation) return;
+        setStatus("error");
+      }
+    },
+    [channelId],
+  );
+
+  React.useEffect(() => {
+    generationRef.current += 1;
+    setEvents([]);
+    setSelected(new Set());
+    setHasMore(false);
+    void loadPage(undefined);
+    return () => {
+      generationRef.current += 1;
+    };
+  }, [loadPage]);
+
+  const files = React.useMemo(() => collectChannelFiles(events), [events]);
+  const selectedFiles = React.useMemo(
+    () => files.filter((file) => selected.has(file.url)),
+    [files, selected],
+  );
+  const allSelected = files.length > 0 && selectedFiles.length === files.length;
+  const tooMany = selectedFiles.length > MAX_BULK_DOWNLOAD_FILES;
+
+  const toggle = (file: ChannelFile) => {
+    setSelected((current) => {
+      const next = new Set(current);
+      if (next.has(file.url)) next.delete(file.url);
+      else next.add(file.url);
+      return next;
+    });
+  };
+
+  const loadOlder = () => {
+    const oldest = events.reduce(
+      (min, event) => Math.min(min, event.created_at),
+      Number.POSITIVE_INFINITY,
+    );
+    if (Number.isFinite(oldest)) void loadPage(oldest);
+  };
+
+  const download = async () => {
+    if (downloading || selectedFiles.length === 0 || tooMany) return;
+    setDownloading(true);
+    try {
+      const result = await invokeTauri<BulkDownloadResult>(
+        "download_files_to_folder",
+        {
+          items: selectedFiles.map((file) => ({
+            url: file.url,
+            filename: file.filename,
+          })),
+        },
+      );
+      if (result.cancelled) return;
+      if (result.saved > 0) {
+        toast.success(`파일 ${result.saved}개를 저장했습니다.`);
+      }
+      if (result.failed.length > 0) {
+        const first = result.failed[0];
+        toast.error(
+          `파일 ${result.failed.length}개를 받지 못했습니다. ${first ? `${first.filename}: ${first.error}` : ""}`,
+        );
+      } else {
+        setSelected(new Set());
+      }
+    } catch (error) {
+      toast.error(
+        error instanceof Error && error.message
+          ? error.message
+          : "파일을 받지 못했습니다.",
+      );
+    } finally {
+      setDownloading(false);
+    }
+  };
+
+  const selectedSize = formatFileSize(totalSize(selectedFiles));
+
+  return (
+    <Dialog onOpenChange={onOpenChange} open={open}>
+      <DialogContent
+        className="max-w-2xl"
+        data-no-translate=""
+        data-testid="channel-files-dialog"
+      >
+        <DialogHeader>
+          <DialogTitle>파일 모아보기</DialogTitle>
+          <DialogDescription>
+            #{channelName} 채널에 올라온 파일입니다. 여러 개를 골라 폴더
+            하나에 한꺼번에 저장할 수 있습니다.
+          </DialogDescription>
+        </DialogHeader>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <label className="flex items-center gap-2 text-sm">
+            <Checkbox
+              checked={allSelected}
+              data-testid="channel-files-select-all"
+              disabled={files.length === 0 || downloading}
+              onCheckedChange={(checked) =>
+                setSelected(
+                  checked === true
+                    ? new Set(files.map((file) => file.url))
+                    : new Set(),
+                )
+              }
+            />
+            전체 선택
+          </label>
+          <span aria-live="polite" className="text-xs text-muted-foreground">
+            {files.length}개 중 {selectedFiles.length}개 선택
+            {selectedFiles.length > 0 && selectedSize
+              ? ` · ${selectedSize}`
+              : ""}
+          </span>
+          <Button
+            className="ml-auto"
+            data-testid="channel-files-download"
+            disabled={downloading || selectedFiles.length === 0 || tooMany}
+            onClick={() => void download()}
+            size="sm"
+            type="button"
+          >
+            {downloading ? "받는 중…" : "선택한 파일 받기"}
+          </Button>
+        </div>
+        {tooMany ? (
+          <p className="text-xs text-destructive">
+            한 번에 {MAX_BULK_DOWNLOAD_FILES}개까지 받을 수 있습니다.
+          </p>
+        ) : null}
+
+        <ul
+          aria-label="파일 목록"
+          className="flex max-h-96 flex-col divide-y divide-border/60 overflow-y-auto rounded-lg border border-border/60"
+        >
+          {files.map((file) => {
+            const checked = selected.has(file.url);
+            const size = formatFileSize(file.size);
+            return (
+              <li key={file.url}>
+                <label
+                  className="flex cursor-pointer items-center gap-3 px-3 py-2 hover:bg-muted/60"
+                  data-testid="channel-files-row"
+                >
+                  <Checkbox
+                    aria-label={`${file.filename} 선택`}
+                    checked={checked}
+                    disabled={downloading}
+                    onCheckedChange={() => toggle(file)}
+                  />
+                  <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground">
+                    <KindIcon mime={file.mime} />
+                  </span>
+                  <span className="min-w-0 flex-1">
+                    <span className="block truncate text-sm font-medium">
+                      {file.filename}
+                    </span>
+                    <span className="block text-xs text-muted-foreground">
+                      {[size, formatPostedDate(file.postedAt)]
+                        .filter(Boolean)
+                        .join(" · ")}
+                    </span>
+                  </span>
+                </label>
+              </li>
+            );
+          })}
+          {files.length === 0 && status === "ready" ? (
+            <li className="px-3 py-6 text-center text-sm text-muted-foreground">
+              이 채널에는 아직 올라온 파일이 없습니다.
+            </li>
+          ) : null}
+        </ul>
+
+        <div className="flex min-h-8 items-center gap-3 text-xs text-muted-foreground">
+          <span aria-live="polite">
+            {status === "loading" ? "파일을 찾는 중…" : null}
+            {status === "error"
+              ? "파일 목록을 불러오지 못했습니다. 연결을 확인해 주세요."
+              : null}
+          </span>
+          {status !== "loading" && (hasMore || status === "error") ? (
+            <Button
+              className="ml-auto"
+              onClick={() =>
+                status === "error" && events.length === 0
+                  ? void loadPage(undefined)
+                  : loadOlder()
+              }
+              size="sm"
+              type="button"
+              variant="outline"
+            >
+              {status === "error" ? "다시 시도" : "이전 메시지에서 더 찾기"}
+            </Button>
+          ) : null}
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}

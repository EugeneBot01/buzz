index 0000000..17e1fee
--- /dev/null
+++ b/desktop/src/features/channel-files/lib/channelFiles.ts
@@ -0,0 +1,102 @@
+import type { RelayEvent } from "@/shared/api/types";
+import { parseImetaTags } from "@/shared/ui/markdown/parseImeta";
+
+/**
+ * Channel files (team patch): every attachment posted in a channel, listed in
+ * one place so several can be selected and saved to a folder at once.
+ */
+export type ChannelFile = {
+  /** Relay media URL; also the identity of the file in the list. */
+  url: string;
+  filename: string;
+  /** Bytes, when the message recorded it. */
+  size?: number;
+  mime: string;
+  /** Pubkey of the member who posted it. */
+  author: string;
+  /** Seconds since epoch of the message that carried it. */
+  postedAt: number;
+};
+
+export type ChannelFileKind = "image" | "video" | "audio" | "file";
+
+/** Most files one bulk download may request (matches the native command). */
+export const MAX_BULK_DOWNLOAD_FILES = 200;
+
+export function fileKind(mime: string): ChannelFileKind {
+  if (mime.startsWith("image/")) return "image";
+  if (mime.startsWith("video/")) return "video";
+  if (mime.startsWith("audio/")) return "audio";
+  return "file";
+}
+
+/** The name to save a file under: its recorded filename, else the URL's last segment. */
+function resolveFilename(url: string, filename: string | undefined): string {
+  const named = filename?.trim();
+  if (named) return named;
+  try {
+    const segment = new URL(url).pathname.split("/").filter(Boolean).pop();
+    if (segment) return decodeURIComponent(segment);
+  } catch {
+    // Not a URL: fall through to the generic name.
+  }
+  return "file";
+}
+
+/**
+ * The attachments carried by `events`, newest first. A file posted more than
+ * once (same URL) is listed once, at its most recent post.
+ */
+export function collectChannelFiles(events: RelayEvent[]): ChannelFile[] {
+  const byUrl = new Map<string, ChannelFile>();
+  for (const event of events) {
+    for (const entry of parseImetaTags(event.tags).values()) {
+      const current = byUrl.get(entry.url);
+      if (current && current.postedAt >= event.created_at) continue;
+      byUrl.set(entry.url, {
+        url: entry.url,
+        filename: resolveFilename(entry.url, entry.filename),
+        size:
+          typeof entry.size === "number" &&
+          Number.isFinite(entry.size) &&
+          entry.size >= 0
+            ? entry.size
+            : undefined,
+        mime: entry.m ?? "",
+        author: event.pubkey,
+        postedAt: event.created_at,
+      });
+    }
+  }
+  return [...byUrl.values()].sort(
+    (a, b) =>
+      b.postedAt - a.postedAt ||
+      a.filename.localeCompare(b.filename) ||
+      a.url.localeCompare(b.url),
+  );
+}
+
+/** Human-readable byte size: "820 B", "12.4 KB", "3.1 MB". */
+export function formatFileSize(bytes: number | undefined): string {
+  if (bytes === undefined || !Number.isFinite(bytes) || bytes < 0) return "";
+  if (bytes < 1024) return `${bytes} B`;
+  const units = ["KB", "MB", "GB", "TB"];
+  let size = bytes / 1024;
+  let unit = 0;
+  while (size >= 1024 && unit < units.length - 1) {
+    size /= 1024;
+    unit += 1;
+  }
+  return `${size < 10 ? size.toFixed(1) : Math.round(size)} ${units[unit]}`;
+}
+
+/** Total recorded size of `files` (files without a recorded size count as 0). */
+export function totalSize(files: ChannelFile[]): number {
+  return files.reduce((sum, file) => sum + (file.size ?? 0), 0);
+}
+
+/** `YYYY. M. D.` in local time for a seconds timestamp. */
+export function formatPostedDate(postedAt: number): string {
+  const date = new Date(postedAt * 1_000);
+  return `${date.getFullYear()}. ${date.getMonth() + 1}. ${date.getDate()}.`;
+}

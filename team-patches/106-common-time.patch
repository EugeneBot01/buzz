+import {
+  type AvailabilityRule,
+  type RuleKind,
+  type TeamPerson,
+  ruleAppliesOn,
+} from "./teamAvailability";
+import { addDays, daysBetween } from "./teamCalendar";
+
+/** Bounds the interactive search to at most 31 days and 48 starts per day. */
+export const MAX_COMMON_TIME_DAYS = 31;
+
+/** All dates and wall-clock minutes are interpreted in Korean time. */
+export type CommonTimeOptions = {
+  from: string;
+  through: string;
+  duration: number;
+  start: number;
+  end: number;
+  targetIds?: string[];
+  requiredIds?: string[];
+};
+
+/** One person's status for the complete interval, with all overlapping rules. */
+export type CommonTimePerson = {
+  person: TeamPerson;
+  status: RuleKind;
+  rules: AvailabilityRule[];
+};
+
+/** One candidate interval; unlisted time counts as available. */
+export type CommonTimeSlot = {
+  date: string;
+  start: number;
+  end: number;
+  people: CommonTimePerson[];
+  available: number;
+  tentative: number;
+  requiredAvailable: boolean;
+};
+
+/** Korean today's date, independent of the computer's time zone. */
+export function koreanToday(now: Date = new Date()): string {
+  return new Date(now.getTime() + 9 * 60 * 60 * 1_000)
+    .toISOString()
+    .slice(0, 10);
+}
+
+const validDate = (date: string) =>
+  /^\d{4}-\d{2}-\d{2}$/.test(date) && addDays(date, 0) === date;
+
+/** Why a search cannot run, or null. Also used by the form. */
+export function commonTimeError(options: CommonTimeOptions): string | null {
+  if (!validDate(options.from) || !validDate(options.through))
+    return "날짜를 확인해 주세요.";
+  const days = daysBetween(options.from, options.through) + 1;
+  if (days < 1 || days > MAX_COMMON_TIME_DAYS)
+    return `기간은 1~${MAX_COMMON_TIME_DAYS}일로 골라 주세요.`;
+  if (
+    ![options.duration, options.start, options.end].every(
+      (value) => Number.isInteger(value) && value % 30 === 0,
+    ) ||
+    options.duration < 30 ||
+    options.start < 0 ||
+    options.end > 1_440 ||
+    options.start + options.duration > options.end
+  )
+    return "필요한 시간과 찾을 시간대를 확인해 주세요.";
+  return null;
+}
+
+/** Required attendees first, then available count, fewer tentative, earlier. */
+export function compareCommonTime(
+  a: CommonTimeSlot,
+  b: CommonTimeSlot,
+): number {
+  return (
+    Number(b.requiredAvailable) - Number(a.requiredAvailable) ||
+    b.available - a.available ||
+    a.tentative - b.tentative ||
+    a.date.localeCompare(b.date) ||
+    a.start - b.start
+  );
+}
+
+/**
+ * Searches every 30-minute start using the existing availability recurrence
+ * matcher. Intervals are half-open: an event ending at 18:00 does not block
+ * a meeting starting at 18:00. Busy overrides tentative, then available.
+ * Required people are always included in the target group.
+ */
+export function findCommonTime(
+  people: TeamPerson[],
+  options: CommonTimeOptions,
+): {
+  dates: string[];
+  slots: CommonTimeSlot[];
+  recommendations: CommonTimeSlot[];
+} {
+  const problem = commonTimeError(options);
+  if (problem) throw new Error(problem);
+  const required = new Set(options.requiredIds ?? []);
+  const targets = options.targetIds ? new Set(options.targetIds) : null;
+  const active = people.filter(
+    (person) =>
+      !person.deleted &&
+      (!targets || targets.has(person.id) || required.has(person.id)),
+  );
+  if (!active.length) throw new Error("대상 인원을 골라 주세요.");
+  if ([...required].some((id) => !active.some((person) => person.id === id)))
+    throw new Error("필수 인원을 다시 골라 주세요.");
+  const dates = Array.from(
+    { length: daysBetween(options.from, options.through) + 1 },
+    (_, index) => addDays(options.from, index),
+  );
+  const slots: CommonTimeSlot[] = [];
+  for (const date of dates) {
+    const daily = active.map((person) => ({
+      person,
+      rules: person.rules.filter((rule) => ruleAppliesOn(rule, date)),
+    }));
+    for (
+      let start = options.start;
+      start + options.duration <= options.end;
+      start += 30
+    ) {
+      const end = start + options.duration;
+      const members: CommonTimePerson[] = daily.map(({ person, rules }) => {
+        const overlapping = rules.filter(
+          (rule) => rule.start < end && rule.end > start,
+        );
+        const status = overlapping.some((rule) => rule.kind === "busy")
+          ? "busy"
+          : overlapping.some((rule) => rule.kind === "tentative")
+            ? "tentative"
+            : "available";
+        return { person, rules: overlapping, status };
+      });
+      slots.push({
+        date,
+        start,
+        end,
+        people: members,
+        available: members.filter((member) => member.status === "available")
+          .length,
+        tentative: members.filter((member) => member.status === "tentative")
+          .length,
+        requiredAvailable: members.every(
+          (member) =>
+            !required.has(member.person.id) || member.status === "available",
+        ),
+      });
+    }
+  }
+  return {
+    dates,
+    slots,
+    recommendations: [...slots].sort(compareCommonTime).slice(0, 8),
+  };
+}
diff --git a/desktop/src/features/team-calendar/ui/CommonTimePanel.tsx b/desktop/src/features/team-calendar/ui/CommonTimePanel.tsx
new file mode 100644
index 000000000..a0be70d7b
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/CommonTimePanel.tsx
@@ -0,0 +1,383 @@
+import * as React from "react";
+
+import {
+  type CommonTimeSlot,
+  commonTimeError,
+  findCommonTime,
+  koreanToday,
+} from "../lib/commonTime";
+import {
+  RULE_KIND_SHORT,
+  type TeamPerson,
+  minuteLabel,
+} from "../lib/teamAvailability";
+import { addDays } from "../lib/teamCalendar";
+import { cn } from "@/shared/lib/cn";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import { SELECT_CLASS } from "./EntryForm";
+
+const slotKey = (slot: CommonTimeSlot) => `${slot.date}/${slot.start}`;
+const slotLabel = (slot: CommonTimeSlot) =>
+  `${slot.date} ${minuteLabel(slot.start)}~${minuteLabel(slot.end)}`;
+const timeChoices = Array.from({ length: 49 }, (_, index) => index * 30);
+const cellColor = (available: number, total: number) =>
+  available === total
+    ? "bg-primary/40"
+    : available === 0
+      ? "bg-muted"
+      : available / total >= 0.5
+        ? "bg-primary/25"
+        : "bg-primary/10";
+
+/** Searches the shared team schedules; creating an entry only opens a draft. */
+export function CommonTimePanel({
+  people,
+  onPick,
+}: {
+  people: TeamPerson[];
+  onPick: (slot: CommonTimeSlot) => void;
+}) {
+  const [from, setFrom] = React.useState(koreanToday);
+  const [through, setThrough] = React.useState(() =>
+    addDays(koreanToday(), 13),
+  );
+  const [duration, setDuration] = React.useState(60);
+  const [start, setStart] = React.useState(540);
+  const [end, setEnd] = React.useState(1_320);
+  const [targetIds, setTargetIds] = React.useState<string[] | null>(null);
+  const [requiredIds, setRequiredIds] = React.useState<string[]>([]);
+  const [selected, setSelected] = React.useState<string | null>(null);
+  const targets = people.filter(
+    (person) => !targetIds || targetIds.includes(person.id),
+  );
+  const required = requiredIds.filter((id) =>
+    targets.some((person) => person.id === id),
+  );
+  const options = {
+    from,
+    through,
+    duration,
+    start,
+    end,
+    targetIds: targets.map((person) => person.id),
+    requiredIds: required,
+  };
+  const problem =
+    commonTimeError(options) ??
+    (targets.length ? null : "대상 인원을 골라 주세요.");
+  const targetKey = options.targetIds.join(",");
+  const requiredKey = required.join(",");
+  const result = React.useMemo(
+    () =>
+      problem
+        ? null
+        : findCommonTime(people, {
+            from,
+            through,
+            duration,
+            start,
+            end,
+            targetIds: targetKey.split(","),
+            requiredIds: requiredKey ? requiredKey.split(",") : [],
+          }),
+    [
+      people,
+      problem,
+      from,
+      through,
+      duration,
+      start,
+      end,
+      targetKey,
+      requiredKey,
+    ],
+  );
+  const detail = result?.slots.find((slot) => slotKey(slot) === selected);
+  const rows = result?.slots.filter((slot) => slot.date === from) ?? [];
+  const byKey = new Map(result?.slots.map((slot) => [slotKey(slot), slot]));
+  const headingId = React.useId();
+
+  const toggleTarget = (id: string) => {
+    const current = targets.map((person) => person.id);
+    setTargetIds(
+      current.includes(id)
+        ? current.filter((value) => value !== id)
+        : [...current, id],
+    );
+    setRequiredIds(required.filter((value) => value !== id));
+  };
+
+  return (
+    <section
+      aria-labelledby={headingId}
+      className="space-y-4 rounded-xl border border-border/70 p-4"
+      data-testid="common-time-panel"
+    >
+      <div>
+        <h3 className="text-sm font-semibold" id={headingId}>
+          함께 되는 시간 찾기
+        </h3>
+        <p className="text-xs text-muted-foreground">
+          한국시간 · 등록하지 않은 시간은 가능으로 봅니다.
+        </p>
+      </div>
+      <div className="grid grid-cols-2 gap-3 lg:grid-cols-5">
+        <label htmlFor={`${headingId}-from`} className="space-y-1 text-xs">
+          시작 날짜
+          <Input
+            id={`${headingId}-from`}
+            type="date"
+            value={from}
+            onChange={(event) => setFrom(event.target.value)}
+          />
+        </label>
+        <label htmlFor={`${headingId}-through`} className="space-y-1 text-xs">
+          종료 날짜
+          <Input
+            id={`${headingId}-through`}
+            type="date"
+            value={through}
+            onChange={(event) => setThrough(event.target.value)}
+          />
+        </label>
+        <label className="space-y-1 text-xs">
+          필요한 시간
+          <select
+            className={SELECT_CLASS}
+            value={duration}
+            onChange={(event) => setDuration(Number(event.target.value))}
+          >
+            {timeChoices.slice(1).map((value) => (
+              <option key={value} value={value}>
+                {value}분
+              </option>
+            ))}
+          </select>
+        </label>
+        <label className="space-y-1 text-xs">
+          찾을 시작 시간
+          <select
+            className={SELECT_CLASS}
+            value={start}
+            onChange={(event) => setStart(Number(event.target.value))}
+          >
+            {timeChoices.slice(0, -1).map((value) => (
+              <option key={value} value={value}>
+                {minuteLabel(value)}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label className="space-y-1 text-xs">
+          찾을 종료 시간
+          <select
+            className={SELECT_CLASS}
+            value={end}
+            onChange={(event) => setEnd(Number(event.target.value))}
+          >
+            {timeChoices.slice(1).map((value) => (
+              <option key={value} value={value}>
+                {minuteLabel(value)}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+      <fieldset className="space-y-2">
+        <legend className="text-xs font-semibold">대상 인원</legend>
+        <Button
+          size="xs"
+          variant="outline"
+          type="button"
+          onClick={() => setTargetIds(null)}
+        >
+          전원 선택
+        </Button>
+        <div className="flex flex-wrap gap-3">
+          {people.map((person) => (
+            <label
+              key={person.id}
+              className="flex items-center gap-1.5 text-xs"
+            >
+              <input
+                type="checkbox"
+                checked={targets.some((target) => target.id === person.id)}
+                onChange={() => toggleTarget(person.id)}
+              />
+              {person.name}
+              {person.role ? ` · ${person.role}` : ""}
+            </label>
+          ))}
+        </div>
+      </fieldset>
+      <fieldset className="space-y-2">
+        <legend className="text-xs font-semibold">꼭 와야 하는 인원</legend>
+        <div className="flex flex-wrap gap-3">
+          {targets.map((person) => (
+            <label
+              key={person.id}
+              className="flex items-center gap-1.5 text-xs"
+            >
+              <input
+                type="checkbox"
+                checked={required.includes(person.id)}
+                onChange={() =>
+                  setRequiredIds(
+                    required.includes(person.id)
+                      ? required.filter((id) => id !== person.id)
+                      : [...required, person.id],
+                  )
+                }
+              />
+              {person.name}
+            </label>
+          ))}
+        </div>
+      </fieldset>
+      {problem ? (
+        <p role="alert" className="text-sm text-destructive">
+          {problem}
+        </p>
+      ) : null}
+      {result ? (
+        <>
+          <section aria-label="추천 시간" className="space-y-2">
+            <h4 className="text-sm font-semibold">추천 시간</h4>
+            <div className="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
+              {result.recommendations.map((slot) => (
+                <div
+                  key={slotKey(slot)}
+                  className="space-y-2 rounded-lg border border-border p-3"
+                >
+                  <button
+                    type="button"
+                    aria-pressed={slotKey(slot) === selected}
+                    onClick={() => setSelected(slotKey(slot))}
+                    className="w-full space-y-1 rounded text-left focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
+                  >
+                    <span className="block text-xs font-semibold">
+                      {slotLabel(slot)}
+                    </span>
+                    <span className="block text-xs">
+                      가능 {slot.available}/{slot.people.length}명 · 조율{" "}
+                      {slot.tentative}명
+                    </span>
+                    <span className="block text-2xs text-muted-foreground">
+                      {slot.requiredAvailable
+                        ? required.length
+                          ? "필수 인원 전원 가능"
+                          : "명단 보기"
+                        : "필수 인원 불가·조율 있음"}
+                    </span>
+                  </button>
+                  <Button
+                    size="xs"
+                    type="button"
+                    variant="outline"
+                    onClick={() => onPick(slot)}
+                  >
+                    이 시간으로 일정 만들기
+                  </Button>
+                </div>
+              ))}
+            </div>
+          </section>
+          {detail ? (
+            <section
+              aria-label="시간별 명단"
+              className="space-y-2 rounded-lg border border-border p-3"
+              aria-live="polite"
+            >
+              <h4 className="text-sm font-semibold">{slotLabel(detail)}</h4>
+              {(["available", "busy", "tentative"] as const).map((kind) => (
+                <div key={kind}>
+                  <h5 className="text-xs font-semibold">
+                    {RULE_KIND_SHORT[kind]}{" "}
+                    {
+                      detail.people.filter((member) => member.status === kind)
+                        .length
+                    }
+                    명
+                  </h5>
+                  <ul className="space-y-1 text-xs">
+                    {detail.people
+                      .filter((member) => member.status === kind)
+                      .map(({ person, rules }) => (
+                        <li key={person.id}>
+                          {person.name}
+                          {required.includes(person.id) ? " · 필수" : ""} —{" "}
+                          {rules.length
+                            ? rules.map((rule) => rule.title).join(", ")
+                            : "등록된 일정 없음"}
+                        </li>
+                      ))}
+                  </ul>
+                </div>
+              ))}
+            </section>
+          ) : null}
+          <div className="max-h-[32rem] overflow-auto rounded-lg border border-border">
+            <table className="w-full border-collapse text-xs">
+              <caption className="p-2 text-left text-muted-foreground">
+                30분마다 시작 · {duration}분 전체 기준 · 색이 진할수록 가능
+                인원이 많아요. 칸을 누르면 명단이 열립니다.
+              </caption>
+              <thead>
+                <tr>
+                  <th scope="col" className="sticky left-0 bg-background p-2">
+                    시작
+                  </th>
+                  {result.dates.map((date) => (
+                    <th
+                      scope="col"
+                      key={date}
+                      className="min-w-24 whitespace-nowrap p-2"
+                    >
+                      {date}
+                    </th>
+                  ))}
+                </tr>
+              </thead>
+              <tbody>
+                {rows.map((row) => (
+                  <tr key={row.start}>
+                    <th scope="row" className="sticky left-0 bg-background p-2">
+                      {minuteLabel(row.start)}
+                    </th>
+                    {result.dates.map((date) => {
+                      const slot = byKey.get(`${date}/${row.start}`);
+                      return (
+                        <td key={date} className="p-0.5">
+                          {slot ? (
+                            <button
+                              type="button"
+                              aria-pressed={selected === slotKey(slot)}
+                              aria-label={`${slotLabel(slot)} · 가능 ${slot.available}/${slot.people.length}명${slot.requiredAvailable ? "" : " · 필수 인원 불가·조율"}`}
+                              className={cn(
+                                "w-full rounded p-2 text-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring",
+                                cellColor(slot.available, slot.people.length),
+                              )}
+                              onClick={() => setSelected(slotKey(slot))}
+                            >
+                              {slot.available}/{slot.people.length}
+                              {slot.requiredAvailable ? "" : " *"}
+                            </button>
+                          ) : null}
+                        </td>
+                      );
+                    })}
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <p className="text-2xs text-muted-foreground">
+            * 필수 인원 불가·조율 있음 · 일정 만들기는 입력창만 열고, 저장은
+            직접 눌러 주세요.
+          </p>
+        </>
+      ) : null}
+    </section>
+  );
+}

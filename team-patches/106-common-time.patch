diff --git a/desktop/src/features/team-calendar/ui/commonTime.jsdom-test.mjs b/desktop/src/features/team-calendar/ui/commonTime.jsdom-test.mjs
new file mode 100644
index 000000000..5d40f5a13
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/commonTime.jsdom-test.mjs
@@ -0,0 +1,248 @@
+import assert from "node:assert/strict";
+import { afterEach, mock, test } from "node:test";
+import React from "react";
+import {
+  cleanup,
+  fireEvent,
+  render,
+  waitFor,
+  within,
+} from "@testing-library/react";
+import { TeamCalendarDialog } from "./TeamCalendarDialog.tsx";
+import { CommonTimePanel } from "./CommonTimePanel.tsx";
+import { koreanToday } from "../lib/commonTime.ts";
+import { addDays } from "../lib/teamCalendar.ts";
+import { encodePeople, teamAvailabilityDTag } from "../lib/teamAvailability.ts";
+import {
+  prepareScheduleDom,
+  pubkey,
+  relayUrl,
+} from "../../team-schedule/ui/scheduleTestSupport.mjs";
+
+let env;
+afterEach(() => {
+  cleanup();
+  env?.client.clear();
+  mock.restoreAll();
+  localStorage.clear();
+  delete globalThis.isTauri;
+});
+const today = koreanToday();
+const person = (id, rules = []) => ({
+  id,
+  name: `테스트 ${id}`,
+  rules,
+  updatedAt: 1,
+  updatedBy: pubkey,
+});
+const busy = {
+  id: "r1",
+  kind: "busy",
+  title: "가짜 수업",
+  startDate: today,
+  endDate: addDays(today, 13),
+  weekday: null,
+  start: 540,
+  end: 1080,
+  exclude: [],
+};
+
+test("embedded 103 keeps sprint/calendar, people, import/export and opens an unsaved 106 draft", async () => {
+  const people = { a: person("가", [busy]), b: person("나") };
+  env = prepareScheduleDom(async (filter) =>
+    filter["#d"]?.[0] === teamAvailabilityDTag(relayUrl)
+      ? [
+          {
+            id: "1".repeat(64),
+            kind: 30078,
+            pubkey,
+            created_at: 1,
+            tags: [["d", teamAvailabilityDTag(relayUrl)]],
+            content: encodePeople(people),
+            sig: "",
+          },
+        ]
+      : [],
+  );
+  const ref = React.createRef();
+  const view = render(
+    React.createElement(TeamCalendarDialog, {
+      embedded: true,
+      open: true,
+      onOpenChange() {},
+      pubkey,
+      relayUrl,
+      ref,
+    }),
+    { wrapper: env.Providers },
+  );
+  assert.equal(
+    view
+      .getByRole("tab", { name: "스프린트", exact: true })
+      .getAttribute("aria-selected"),
+    "true",
+  );
+  assert.ok(view.getByRole("button", { name: "가져오기", exact: true }));
+  assert.ok(view.getByRole("button", { name: "배포", exact: true }));
+  assert.equal(
+    view.getByTestId("team-calendar-embedded").className.includes("96vw"),
+    false,
+  );
+  const previousQueries = env.queries.length;
+  ref.current.refresh();
+  await waitFor(() => assert.ok(env.queries.length > previousQueries));
+  fireEvent.click(view.getByRole("tab", { name: "팀원 일정", exact: true }));
+  const open = view.getByRole("button", {
+    name: "함께 되는 시간 찾기",
+    exact: true,
+  });
+  await waitFor(() => assert.equal(open.disabled, false));
+  fireEvent.click(open);
+  const panel = within(view.getByTestId("common-time-panel"));
+  assert.equal(panel.getByLabelText("시작 날짜").value, today);
+  assert.equal(panel.getByLabelText("종료 날짜").value, addDays(today, 13));
+  assert.equal(panel.getByLabelText("필요한 시간").value, "60");
+  const recommendations = within(
+    panel.getByRole("region", { name: "추천 시간" }),
+  );
+  const cards = recommendations.getAllByRole("button", {
+    name: /명단 보기/,
+  });
+  assert.equal(cards.length, 8);
+  assert.match(cards[0].textContent, /18:00~19:00/);
+  fireEvent.click(cards[0]);
+  assert.ok(panel.getByRole("region", { name: "시간별 명단" }));
+  fireEvent.click(
+    panel.getByRole("button", {
+      name: `${today} 09:00~10:00 · 가능 1/2명`,
+      exact: true,
+    }),
+  );
+  assert.match(
+    panel.getByRole("region", { name: "시간별 명단" }).textContent,
+    /테스트 가 — 가짜 수업/,
+  );
+  fireEvent.click(
+    recommendations.getAllByRole("button", {
+      name: "이 시간으로 일정 만들기",
+    })[0],
+  );
+  const form = view.getByTestId("team-calendar-form");
+  assert.equal(form.querySelector('input[type="time"]').value, "18:00");
+  assert.deepEqual(
+    [...form.querySelectorAll('input[type="date"]')].map(
+      (input) => input.value,
+    ),
+    [today, today],
+  );
+  assert.equal(form.querySelectorAll('input[type="time"]')[1].value, "19:00");
+  assert.equal(form.querySelector('input[maxlength="120"]')?.value ?? "", "");
+  assert.equal(
+    view
+      .getByRole("tab", { name: "달력", exact: true })
+      .getAttribute("aria-selected"),
+    "true",
+  );
+  // prepareScheduleDom throws on publication, so every step above is read-only.
+});
+
+test("selection, mandatory people, fresh details and invalid ranges use the real panel", () => {
+  const picks = [];
+  const view = render(
+    React.createElement(CommonTimePanel, {
+      people: [person("가", [busy]), person("나")],
+      onPick: (slot) => picks.push(slot),
+    }),
+  );
+  const targets = within(view.getByRole("group", { name: "대상 인원" }));
+  fireEvent.click(targets.getByRole("checkbox", { name: "테스트 나" }));
+  assert.equal(
+    targets.getByRole("checkbox", { name: "테스트 나" }).checked,
+    false,
+  );
+  const required = within(
+    view.getByRole("group", { name: "꼭 와야 하는 인원" }),
+  );
+  assert.equal(required.queryByRole("checkbox", { name: "테스트 나" }), null);
+  fireEvent.click(required.getByRole("checkbox", { name: "테스트 가" }));
+  assert.match(
+    view.getByRole("region", { name: "추천 시간" }).textContent,
+    /필수 인원 전원 가능/,
+  );
+  fireEvent.change(view.getByLabelText("찾을 시작 시간"), {
+    target: { value: "1380" },
+  });
+  fireEvent.change(view.getByLabelText("찾을 종료 시간"), {
+    target: { value: "1440" },
+  });
+  fireEvent.click(
+    view.getAllByRole("button", { name: "이 시간으로 일정 만들기" })[0],
+  );
+  assert.equal(picks[0].end, 1440);
+  fireEvent.change(view.getByLabelText("필요한 시간"), {
+    target: { value: "90" },
+  });
+  assert.match(view.getByRole("alert").textContent, /확인/);
+  assert.equal(view.queryByRole("region", { name: "추천 시간" }), null);
+  fireEvent.click(targets.getByRole("checkbox", { name: "테스트 가" }));
+  assert.equal(required.queryByRole("checkbox"), null);
+});
+
+test("a 24:00 recommendation populates next-day 00:00 and the existing dialog path remains available", async () => {
+  env = prepareScheduleDom(async (filter) =>
+    filter["#d"]?.[0] === teamAvailabilityDTag(relayUrl)
+      ? [
+          {
+            id: "1".repeat(64),
+            kind: 30078,
+            pubkey,
+            created_at: 1,
+            tags: [["d", teamAvailabilityDTag(relayUrl)]],
+            content: encodePeople({ a: person("가") }),
+            sig: "",
+          },
+        ]
+      : [],
+  );
+  const view = render(
+    React.createElement(TeamCalendarDialog, {
+      open: true,
+      onOpenChange() {},
+      pubkey,
+      relayUrl,
+    }),
+    { wrapper: env.Providers },
+  );
+  assert.ok(view.getByRole("dialog"));
+  assert.match(view.getByTestId("team-calendar-dialog").className, /96vw/);
+  fireEvent.click(view.getByRole("tab", { name: "팀원 일정", exact: true }));
+  const open = view.getByRole("button", {
+    name: "함께 되는 시간 찾기",
+    exact: true,
+  });
+  await waitFor(() => assert.equal(open.disabled, false));
+  fireEvent.click(open);
+  const panel = within(view.getByTestId("common-time-panel"));
+  fireEvent.change(panel.getByLabelText("찾을 종료 시간"), {
+    target: { value: "1440" },
+  });
+  fireEvent.change(panel.getByLabelText("찾을 시작 시간"), {
+    target: { value: "1380" },
+  });
+  fireEvent.click(
+    panel.getAllByRole("button", { name: "이 시간으로 일정 만들기" })[0],
+  );
+  const form = view.getByTestId("team-calendar-form");
+  assert.deepEqual(
+    [...form.querySelectorAll('input[type="date"]')].map(
+      (input) => input.value,
+    ),
+    [today, addDays(today, 1)],
+  );
+  assert.deepEqual(
+    [...form.querySelectorAll('input[type="time"]')].map(
+      (input) => input.value,
+    ),
+    ["23:00", "00:00"],
+  );
+});

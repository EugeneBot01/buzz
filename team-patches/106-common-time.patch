index 000000000..f2dad30b2
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/commonTime.test.mjs
@@ -0,0 +1,190 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  compareCommonTime,
+  findCommonTime,
+  koreanToday,
+} from "./commonTime.ts";
+
+const person = (id, rules = [], extras = {}) => ({
+  id,
+  name: id,
+  rules,
+  updatedAt: 1,
+  updatedBy: "a".repeat(64),
+  ...extras,
+});
+const rule = (kind, start, end, extras = {}) => ({
+  id: kind,
+  kind,
+  start,
+  end,
+  title: `${kind} 일정`,
+  startDate: "2026-11-06",
+  endDate: "2026-11-06",
+  weekday: null,
+  exclude: [],
+  ...extras,
+});
+const options = {
+  from: "2026-11-06",
+  through: "2026-11-06",
+  start: 540,
+  end: 720,
+  duration: 60,
+};
+const search = (people, extra = {}) =>
+  findCommonTime(people, { ...options, ...extra });
+
+test("complete duration is checked, including a one-minute conflict in the middle", () => {
+  const result = search([person("A", [rule("busy", 571, 572)])]);
+  assert.equal(result.slots[0].people[0].status, "busy");
+  assert.equal(result.slots[1].people[0].status, "busy");
+  assert.equal(result.slots[2].people[0].status, "available");
+  assert.equal(result.slots[0].people[0].rules[0].title, "busy 일정");
+});
+
+test("half-open intervals permit meetings at the exact end and before the next start", () => {
+  const result = search(
+    [person("A", [rule("busy", 540, 1080), rule("busy", 1140, 1200)])],
+    { start: 1080, end: 1200 },
+  );
+  assert.equal(result.slots[0].available, 1); // 18:00–19:00
+  assert.equal(result.slots[1].available, 0); // 18:30–19:30
+  assert.equal(result.slots[2].available, 0); // 19:00–20:00
+});
+
+test("busy > tentative > available; blank time is available, with all overlapping titles retained", () => {
+  for (const [rules, expected] of [
+    [[], "available"],
+    [[rule("available", 540, 600)], "available"],
+    [[rule("available", 540, 600), rule("tentative", 555, 556)], "tentative"],
+    [
+      [
+        rule("available", 540, 600),
+        rule("tentative", 540, 600),
+        rule("busy", 599, 600),
+      ],
+      "busy",
+    ],
+  ]) {
+    const slot = search([person("A", rules)]).slots[0];
+    assert.equal(slot.people[0].status, expected);
+    assert.equal(slot.people[0].rules.length, rules.length);
+  }
+});
+
+test("existing recurrence matcher honors weekday, both period boundaries, exclusions and daily rules", () => {
+  const weekly = rule("busy", 0, 1440, {
+    startDate: "2026-11-06",
+    endDate: "2026-11-20",
+    weekday: 5,
+    exclude: ["2026-11-13"],
+  });
+  const result = search([person("A", [weekly])], {
+    from: "2026-11-05",
+    through: "2026-11-21",
+    end: 600,
+  });
+  const busyDates = result.slots
+    .filter((slot) => !slot.available)
+    .map((slot) => slot.date);
+  assert.deepEqual(busyDates, ["2026-11-06", "2026-11-20"]);
+  const daily = search(
+    [person("A", [rule("tentative", 0, 1440, { endDate: "2026-11-07" })])],
+    { through: "2026-11-08", end: 600 },
+  );
+  assert.deepEqual(
+    daily.slots.map((slot) => slot.people[0].status),
+    ["tentative", "tentative", "available"],
+  );
+});
+
+test("required attendees are always targeted and must be fully available, including tentative", () => {
+  const people = [
+    person("A", [rule("tentative", 540, 600)]),
+    person("B", [rule("busy", 600, 720)]),
+    person("C", [], { deleted: true }),
+  ];
+  const result = search(people, { targetIds: ["B", "C"], requiredIds: ["A"] });
+  assert.equal(result.slots[0].requiredAvailable, false);
+  assert.equal(result.slots[2].requiredAvailable, true);
+  assert.deepEqual(
+    result.slots[0].people.map((member) => member.person.id),
+    ["A", "B"],
+  );
+  assert.equal(result.recommendations[0].start, 600);
+  assert.throws(
+    () => search(people, { requiredIds: ["missing"] }),
+    /필수 인원/,
+  );
+});
+
+test("ranking is required available, more available, fewer tentative, date then time; at most eight", () => {
+  const slot = (
+    date,
+    start,
+    available,
+    tentative,
+    requiredAvailable = true,
+  ) => ({
+    date,
+    start,
+    end: start + 60,
+    available,
+    tentative,
+    requiredAvailable,
+    people: [],
+  });
+  const first = slot("2026-11-06", 540, 2, 0);
+  const later = slot("2026-11-06", 570, 2, 0);
+  const tomorrow = slot("2026-11-07", 540, 2, 0);
+  const tentative = slot("2026-11-06", 540, 2, 1);
+  const fewer = slot("2026-11-06", 540, 1, 0);
+  const blocked = slot("2026-11-06", 540, 3, 0, false);
+  assert.deepEqual(
+    [blocked, tomorrow, tentative, fewer, later, first].sort(compareCommonTime),
+    [first, later, tomorrow, tentative, fewer, blocked],
+  );
+  const result = search([person("A")], { through: "2026-11-07" });
+  assert.equal(result.recommendations.length, 8);
+  assert.deepEqual(result.recommendations, result.slots.slice(0, 8));
+});
+
+test("all 30-minute starts cover the chosen duration; midnight remains an exclusive 24:00 end", () => {
+  const result = search([person("A")], {
+    start: 1380,
+    end: 1440,
+    duration: 30,
+  });
+  assert.deepEqual(
+    result.slots.map(({ start, end }) => [start, end]),
+    [
+      [1380, 1410],
+      [1410, 1440],
+    ],
+  );
+  assert.equal(result.recommendations.length, 2);
+});
+
+test("Korean today is stable across UTC midnight and computers in other time zones", () => {
+  assert.equal(koreanToday(new Date("2026-11-05T14:59:59Z")), "2026-11-05");
+  assert.equal(koreanToday(new Date("2026-11-05T15:00:00Z")), "2026-11-06");
+});
+
+test("invalid dates, empty targets and excessive searches fail explicitly", () => {
+  for (const extra of [
+    { from: "" },
+    { from: "2026-02-30" },
+    { through: "2026-11-05" },
+    { through: "2026-12-07" },
+    { duration: 0 },
+    { duration: 45 },
+    { start: -30 },
+    { end: 1441 },
+    { duration: 240 },
+    { targetIds: [] },
+  ])
+    assert.throws(() => search([person("A")], extra));
+  assert.throws(() => search([]), /대상 인원/);
+});

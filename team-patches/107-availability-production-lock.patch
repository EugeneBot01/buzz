+import { scryptAsync } from "@noble/hashes/scrypt.js";
+import { bytesToHex, hexToBytes } from "@noble/hashes/utils.js";
+import {
+  finalizeEvent,
+  generateSecretKey,
+  getPublicKey,
+  verifyEvent,
+} from "nostr-tools/pure";
+import * as nip44 from "nostr-tools/nip44";
+import type { RelayEvent } from "@/shared/api/types";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+import {
+  RULE_KIND_LABELS,
+  type AvailabilityRule,
+  type PeopleById,
+  decodePeople,
+  encodePeople,
+  mergePeople,
+} from "./teamAvailability";
+
+/** Derived production identity, held only on the current device. */
+export type ProductionKey = { secret: Uint8Array; pubkey: string };
+/** Two independent NIP-44 payloads from one ephemeral sender. */
+export type LockedTitle = {
+  sender: string;
+  author: string;
+  production: string;
+  forAuthor: string;
+  forProduction: string;
+};
+
+/** Password bytes are used exactly as entered; the normalized community is the salt. */
+export async function productionKey(
+  password: string,
+  relay: string,
+): Promise<ProductionKey> {
+  const secret = await scryptAsync(
+    password,
+    `buzz-availability-v1:${normalizeRelayUrl(relay)}`,
+    { N: 16384, r: 8, p: 1, dkLen: 32 },
+  );
+  return { secret, pubkey: getPublicKey(secret) };
+}
+
+/** Only the derived secret is remembered, scoped to account and community. */
+export function productionStorageKey(pubkey: string, relay: string): string {
+  return `buzz-availability-production:${pubkey}:${normalizeRelayUrl(relay)}`;
+}
+
+/** Invalid or obsolete device state never opens production mode. */
+export function restoreProduction(
+  value: string | null,
+  expected: string | undefined,
+): ProductionKey | null {
+  try {
+    if (!value || !/^[0-9a-f]{64}$/.test(value)) return null;
+    const secret = hexToBytes(value);
+    const pubkey = getPublicKey(secret);
+    return pubkey === expected ? { secret, pubkey } : null;
+  } catch {
+    return null;
+  }
+}
+/** Device-local representation; never include this in a shared document. */
+export const productionSecretHex = (key: ProductionKey) =>
+  bytesToHex(key.secret);
+
+/** A fresh sender protects the same reason separately for its author and production. */
+export function lockRule(
+  rule: AvailabilityRule,
+  author: string,
+  production: string,
+): AvailabilityRule {
+  const secret = generateSecretKey();
+  const encrypt = (recipient: string) =>
+    nip44.encrypt(rule.title, nip44.getConversationKey(secret, recipient));
+  return {
+    ...rule,
+    title: RULE_KIND_LABELS[rule.kind],
+    lockedTitle: {
+      sender: getPublicKey(secret),
+      author,
+      production,
+      forAuthor: encrypt(author),
+      forProduction: encrypt(production),
+    },
+  };
+}
+
+/** Throws for a non-recipient or damaged payload, rather than returning a false reason. */
+export function unlockTitle(locked: LockedTitle, key: ProductionKey): string {
+  const payload =
+    key.pubkey === locked.author
+      ? locked.forAuthor
+      : key.pubkey === locked.production
+        ? locked.forProduction
+        : null;
+  if (!payload) throw new Error("이 사유를 볼 수 없습니다.");
+  return nip44.decrypt(
+    payload,
+    nip44.getConversationKey(key.secret, locked.sender),
+  );
+}
+
+/** Native account decryption keeps the account secret outside JavaScript. */
+export async function visiblePeople(
+  people: PeopleById,
+  pubkey: string,
+  production: ProductionKey | null,
+  decrypt: (ciphertext: string, sender: string) => Promise<string>,
+): Promise<PeopleById> {
+  const result: PeopleById = {};
+  for (const person of Object.values(people)) {
+    result[person.id] = {
+      ...person,
+      rules: await Promise.all(
+        person.rules.map(async (rule) => {
+          const locked = rule.lockedTitle;
+          if (!locked) return rule;
+          let title = RULE_KIND_LABELS[rule.kind];
+          try {
+            if (production?.pubkey === locked.production)
+              title = unlockTitle(locked, production);
+            else if (pubkey === locked.author)
+              title = await decrypt(locked.forAuthor, locked.sender);
+          } catch {
+            /* An unreadable reason stays hidden; the stored payload is retained. */
+          }
+          return { ...rule, title };
+        }),
+      ),
+    };
+  }
+  return result;
+}
+
+/** Production signs inside the member's envelope (the relay requires the logged-in author). */
+export function signProductionPeople(
+  people: PeopleById,
+  dTag: string,
+  key: ProductionKey,
+  createdAt: number,
+): RelayEvent {
+  return finalizeEvent(
+    {
+      kind: 30078,
+      created_at: createdAt,
+      tags: [["d", dTag]],
+      content: encodePeople(people),
+    },
+    key.secret,
+  );
+}
+
+/** Decode the actual writer, never the editable updatedBy field. */
+export function availabilityCopies(
+  event: RelayEvent,
+  dTag: string,
+  production?: string,
+): { writer: string; people: PeopleById }[] {
+  if (
+    event.kind !== 30078 ||
+    event.tags.filter((t) => t[0] === "d").length !== 1 ||
+    !event.tags.some((t) => t[0] === "d" && t[1] === dTag)
+  )
+    return [];
+  const result = [
+    { writer: event.pubkey, people: decodePeople(event.content) },
+  ];
+  try {
+    const inner = JSON.parse(event.content).production;
+    if (
+      production &&
+      inner?.pubkey === production &&
+      inner.kind === 30078 &&
+      inner.tags?.length === 1 &&
+      inner.tags[0]?.[0] === "d" &&
+      inner.tags[0]?.[1] === dTag &&
+      verifyEvent(inner)
+    )
+      result.push({ writer: production, people: decodePeople(inner.content) });
+  } catch {
+    /* Invalid optional proof confers no permission. */
+  }
+  return result;
+}
+
+/** Enforce the existing binding too: omitting pubkey cannot bypass ownership. */
+export function mergeAuthorizedPeople(
+  base: PeopleById,
+  people: PeopleById,
+  writer: string,
+  production?: string,
+): PeopleById {
+  const accepted: PeopleById = {};
+  for (const [id, person] of Object.entries(people)) {
+    const owner = base[id]?.pubkey;
+    if (writer !== production) {
+      if (
+        (owner && owner !== writer) ||
+        (person.pubkey && person.pubkey !== writer)
+      )
+        continue;
+      if (owner && person.pubkey !== owner) continue;
+    }
+    accepted[id] = { ...person, updatedBy: writer };
+  }
+  return mergePeople(base, accepted);
+}

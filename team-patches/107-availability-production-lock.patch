--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/availabilityMerge.ts
@@ -0,0 +1,114 @@
+import type { RelayEvent } from "@/shared/api/types";
+import type { PeopleById } from "./teamAvailability";
+import {
+  availabilityCopies,
+  mergeAuthorizedPeople,
+} from "./availabilityPrivacy";
+/** Manager-selected public identity and the snapshot carried over on rotation. */
+export type ProductionSettings = { pubkey: string; baseline?: RelayEvent };
+const newer = (a: RelayEvent, b: RelayEvent) =>
+  a.created_at > b.created_at || (a.created_at === b.created_at && a.id < b.id);
+
+/** Each member owns one replaceable coordinate; reject wrong kinds and coordinates. */
+export function newestAvailabilityEvents(
+  events: RelayEvent[],
+  dTag: string,
+): RelayEvent[] {
+  const newest = new Map<string, RelayEvent>();
+  for (const event of events) {
+    if (
+      event.kind !== 30078 ||
+      event.tags.filter((t) => t[0] === "d").length !== 1 ||
+      !event.tags.some((t) => t[0] === "d" && t[1] === dTag)
+    )
+      continue;
+    const old = newest.get(event.pubkey);
+    if (!old || newer(event, old)) newest.set(event.pubkey, event);
+  }
+  return [...newest.values()];
+}
+
+/** Only current community managers can establish or replace the production password. */
+export function readProductionSettings(
+  events: RelayEvent[],
+  managers: Set<string>,
+  dTag: string,
+): ProductionSettings | null {
+  const authorized = newestAvailabilityEvents(events, dTag)
+    .filter((e) => managers.has(e.pubkey))
+    .sort((a, b) => (newer(a, b) ? -1 : 1));
+  for (const event of authorized) {
+    try {
+      const value = JSON.parse(event.content);
+      if (/^[0-9a-f]{64}$/.test(value.pubkey))
+        return { pubkey: value.pubkey, baseline: value.baseline };
+    } catch {
+      /* A malformed settings copy is not a password setting. */
+    }
+  }
+  return null;
+}
+
+/** Merge authenticated writers, including production proofs, on history and live refresh alike. */
+export function mergeAvailabilityEvents(
+  events: RelayEvent[],
+  dTag: string,
+  settings: ProductionSettings | null,
+): PeopleById {
+  const copies = newestAvailabilityEvents(events, dTag).flatMap((e) =>
+    availabilityCopies(e, dTag, settings?.pubkey),
+  );
+  if (settings?.baseline) {
+    copies.unshift(
+      ...availabilityCopies(
+        {
+          kind: 30078,
+          pubkey: "",
+          id: "",
+          created_at: 0,
+          sig: "",
+          tags: [["d", dTag]],
+          content: JSON.stringify({ production: settings.baseline }),
+        },
+        dTag,
+        settings.pubkey,
+      ).filter((c) => c.writer === settings.pubkey),
+    );
+  }
+  const rows = copies.flatMap((copy) =>
+    Object.values(copy.people).map((person) => ({
+      writer: copy.writer,
+      person,
+    })),
+  );
+  // Establish genuine linked records before considering unlinked copies: stripping
+  // pubkey from an unauthorized copy must not erase a known binding on cold load.
+  const bindings = rows
+    .filter(
+      ({ writer, person }) =>
+        person.pubkey &&
+        (writer === person.pubkey || writer === settings?.pubkey),
+    )
+    .sort(
+      (a, b) =>
+        a.person.updatedAt - b.person.updatedAt ||
+        a.writer.localeCompare(b.writer),
+    );
+  let merged: PeopleById = {};
+  for (const { writer, person } of [
+    ...bindings,
+    ...rows.sort(
+      (a, b) =>
+        a.person.updatedAt - b.person.updatedAt ||
+        a.writer.localeCompare(b.writer),
+    ),
+  ]) {
+    merged = mergeAuthorizedPeople(
+      merged,
+      { [person.id]: person },
+      writer,
+      settings?.pubkey,
+    );
+  }
+  return merged;
+}

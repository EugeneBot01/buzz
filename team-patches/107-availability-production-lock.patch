@@ -0,0 +1,556 @@
+import { buildCalendarBackup, parseCalendarImport } from "./calendarImport.ts";
+import assert from "node:assert/strict";
+import { test, mock, afterEach } from "node:test";
+import { getPublicKey, finalizeEvent } from "nostr-tools/pure";
+import * as nip44 from "nostr-tools/nip44";
+import {
+  productionKey,
+  lockRule,
+  unlockTitle,
+  visiblePeople,
+  restoreProduction,
+  productionSecretHex,
+  signProductionPeople,
+} from "./availabilityPrivacy.ts";
+import {
+  mergeAvailabilityEvents,
+  readProductionSettings,
+  productionDTag,
+  saveAvailability,
+  setProductionPassword,
+  readAvailabilitySnapshot,
+} from "./availabilityStore.ts";
+import {
+  mergePeopleEvents,
+  decodePeople,
+  encodePeople,
+  teamAvailabilityDTag,
+} from "./teamAvailability.ts";
+import { ruleDraftOf, ruleOfDraft } from "../ui/AvailabilityRuleForm.tsx";
+import { relayClient } from "@/shared/api/relayClient";
+
+const key = (n) => {
+  const secret = new Uint8Array(32);
+  secret[31] = n;
+  return { secret, pubkey: getPublicKey(secret) };
+};
+const alice = key(1),
+  bob = key(2),
+  production = key(3),
+  next = key(4);
+const relay = "wss://relay.example.test";
+const d = teamAvailabilityDTag(relay);
+const rule = {
+  id: "r1",
+  title: "가짜 수업",
+  kind: "busy",
+  startDate: "2026-11-06",
+  endDate: "2026-11-06",
+  weekday: null,
+  start: 540,
+  end: 720,
+  exclude: [],
+};
+const person = (overrides = {}) => ({
+  id: "p1",
+  name: "가짜 팀원",
+  pubkey: alice.pubkey,
+  rules: [rule],
+  updatedAt: 10,
+  updatedBy: alice.pubkey,
+  ...overrides,
+});
+const event = (who, people, created_at = 1) =>
+  finalizeEvent(
+    {
+      kind: 30078,
+      created_at,
+      tags: [["d", d]],
+      content: encodePeople(people),
+    },
+    who.secret,
+  );
+const wrap = (who, people, created_at = 1) =>
+  finalizeEvent(
+    {
+      kind: 30078,
+      created_at,
+      tags: [["d", d]],
+      content: JSON.stringify({
+        people: {},
+        production: signProductionPeople(people, d, production, created_at),
+      }),
+    },
+    who.secret,
+  );
+afterEach(() => {
+  mock.restoreAll();
+  delete globalThis.window;
+});
+
+test("password derivation is deterministic, community-scoped, accepts empty/short/long passwords exactly", async () => {
+  const a = await productionKey("제작부", relay);
+  assert.equal((await productionKey("제작부", `${relay}/`)).pubkey, a.pubkey);
+  assert.notEqual(
+    (await productionKey("제작부", `${relay}/other`)).pubkey,
+    a.pubkey,
+  );
+  assert.notEqual((await productionKey("제작부 ", relay)).pubkey, a.pubkey);
+  assert.ok(await productionKey("", relay));
+  assert.ok(await productionKey("a".repeat(1024), relay));
+  assert.equal(
+    restoreProduction(productionSecretHex(a), a.pubkey).pubkey,
+    a.pubkey,
+  );
+  assert.equal(restoreProduction(productionSecretHex(a), bob.pubkey), null);
+  assert.equal(restoreProduction("broken", a.pubkey), null);
+});
+
+test("NIP-44 reason is readable only by its author and production; serialized copies never leak view plaintext", async () => {
+  const locked = lockRule(rule, alice.pubkey, production.pubkey);
+  assert.equal(unlockTitle(locked.lockedTitle, alice), rule.title);
+  assert.equal(unlockTitle(locked.lockedTitle, production), rule.title);
+  assert.throws(() => unlockTitle(locked.lockedTitle, bob));
+  assert.throws(() =>
+    nip44.decrypt(
+      locked.lockedTitle.forAuthor,
+      nip44.getConversationKey(bob.secret, locked.lockedTitle.sender),
+    ),
+  );
+  const raw = { p1: person({ rules: [locked] }) };
+  const viewed = await visiblePeople(
+    raw,
+    alice.pubkey,
+    null,
+    async (ciphertext, sender) =>
+      nip44.decrypt(ciphertext, nip44.getConversationKey(alice.secret, sender)),

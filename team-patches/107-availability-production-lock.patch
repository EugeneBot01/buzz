index 000000000..94fb3a239
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/useAvailabilityPrivacy.ts
@@ -0,0 +1,245 @@
+import { useQuery } from "@tanstack/react-query";
+import * as React from "react";
+import { toast } from "sonner";
+import { relayClient } from "@/shared/api/relayClient";
+import { nip44DecryptFromSelf } from "@/shared/api/tauri";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+import {
+  livePeople,
+  teamAvailabilityDTag,
+  type PeopleById,
+} from "./teamAvailability";
+import {
+  type ProductionKey,
+  productionKey,
+  productionSecretHex,
+  productionStorageKey,
+  restoreProduction,
+  visiblePeople,
+} from "./availabilityPrivacy";
+import {
+  productionDTag,
+  readAvailabilitySnapshot,
+  saveAvailability,
+  setProductionPassword,
+} from "./availabilityStore";
+import type { PersonInput } from "./useTeamSprint";
+
+/** Availability-specific reads always keep the signed writer, unlike generic shared documents. */
+export function useTeamAvailability(pubkey: string, relayUrl: string) {
+  const relay = normalizeRelayUrl(relayUrl);
+  const scope = `${pubkey}|${relay}`;
+  const query = useQuery({
+    queryKey: ["team-availability-private", scope],
+    queryFn: () => readAvailabilitySnapshot(relay),
+    retry: false,
+    refetchInterval: 30_000,
+  });
+  const [device, setDevice] = React.useState<{
+    scope: string;
+    key: ProductionKey;
+  } | null>(null);
+  const expected = query.data?.settings?.pubkey;
+  const key =
+    device?.scope === scope && device.key.pubkey === expected
+      ? device.key
+      : null;
+  const generation = React.useRef({ scope, active: true });
+  const busy = React.useRef(false);
+  const [working, setWorking] = React.useState(false);
+  const currentKey = React.useRef(key);
+  currentKey.current = key;
+  const legacyAttempt = React.useRef("");
+  React.useEffect(() => {
+    const current = { scope, active: true };
+    generation.current = current;
+    return () => {
+      current.active = false;
+    };
+  }, [scope]);
+  React.useEffect(() => {
+    try {
+      const restored = restoreProduction(
+        localStorage.getItem(productionStorageKey(pubkey, relay)),
+        expected,
+      );
+      setDevice(restored ? { scope, key: restored } : null);
+    } catch {
+      setDevice(null);
+    }
+  }, [scope, pubkey, relay, expected]);
+  const refetch = query.refetch;
+  const refresh = React.useCallback(() => refetch(), [refetch]);
+  React.useEffect(() => {
+    let cancelled = false;
+    let dispose: (() => Promise<void>) | undefined;
+    const reload = () => {
+      if (!cancelled) void refresh();
+    };
+    void relayClient
+      .subscribeLive(
+        {
+          kinds: [30078],
+          "#d": [teamAvailabilityDTag(relay), productionDTag(relay)],
+          limit: 0,
+        },
+        reload,
+      )
+      .then((unsub) => {
+        if (cancelled) void unsub();
+        else {
+          dispose = unsub;
+          reload();
+        }
+      }, reload);
+    const reconnect = relayClient.subscribeToReconnects(reload);
+    return () => {
+      cancelled = true;
+      reconnect();
+      if (dispose) void dispose();
+    };
+  }, [relay, refresh]);
+  const raw = query.data?.people;
+  const [decoded, setDecoded] = React.useState<{
+    scope: string;
+    raw: PeopleById;
+    key: ProductionKey | null;
+    value: PeopleById;
+  } | null>(null);
+  React.useEffect(() => {
+    let cancelled = false;
+    if (raw)
+      void visiblePeople(raw, pubkey, key, nip44DecryptFromSelf).then(
+        (value) => {
+          if (!cancelled) setDecoded({ scope, raw, key, value });
+        },
+      );
+    return () => {
+      cancelled = true;
+    };
+  }, [scope, raw, pubkey, key]);
+  const value =
+    decoded?.scope === scope && decoded.raw === raw && decoded.key === key
+      ? decoded.value
+      : (raw ?? {});
+  const people = React.useMemo(() => livePeople(value), [value]);
+  const run = React.useCallback(
+    async (action: (active: () => boolean) => Promise<void>) => {
+      if (busy.current) throw new Error("저장이 끝난 뒤 다시 눌러 주세요.");
+      const current = generation.current;
+      const active = () =>
+        current.active &&
+        generation.current === current &&
+        current.scope === scope;
+      busy.current = true;
+      setWorking(true);
+      try {
+        await action(active);
+        if (active()) await refresh();
+      } finally {
+        busy.current = false;
+        setWorking(false);
+      }
+    },
+    [scope, refresh],
+  );
+  const remember = (next: ProductionKey) => {
+    localStorage.setItem(
+      productionStorageKey(pubkey, relay),
+      productionSecretHex(next),
+    );
+    setDevice({ scope, key: next });
+  };
+  const savePeople = (inputs: PersonInput[]) =>
+    run((active) => saveAvailability(relay, pubkey, inputs, key, active));
+  const deletePerson = (id: string) =>
+    run(async (active) => {
+      const snapshot = await readAvailabilitySnapshot(relay);
+      const person = snapshot.people[id];
+      if (person)
+        await saveAvailability(
+          relay,
+          pubkey,
+          [{ ...person, name: "", rules: [], deleted: true }],
+          key,
+          active,
+        );
+    });
+  const unlock = (password: string) =>
+    run(async (active) => {
+      const next = await productionKey(password, relay);
+      const snapshot = await readAvailabilitySnapshot(relay);
+      if (next.pubkey !== snapshot.settings?.pubkey)
+        throw new Error("비밀번호가 맞지 않아요");
+      if (active()) remember(next);
+    });
+  const lock = () => {
+    localStorage.removeItem(productionStorageKey(pubkey, relay));
+    setDevice(null);
+  };
+  const setPassword = (password: string) =>
+    run(async (active) => {
+      const next = await productionKey(password, relay);
+      await setProductionPassword(relay, pubkey, next, key, active);
+      if (active()) remember(next);
+    });
+  const updatedAt = query.dataUpdatedAt;
+  React.useEffect(() => {
+    // A failed attempt waits for the next query (poll/reconnect/reopen), never a tight retry loop.
+    const attempt = `${scope}|${key?.pubkey}|${updatedAt}`;
+    if (
+      working ||
+      busy.current ||
+      !key ||
+      !raw ||
+      legacyAttempt.current === attempt ||
+      !Object.values(raw).some(
+        (p) => !p.deleted && p.rules.some((r) => !r.lockedTitle),
+      )
+    )
+      return;
+    legacyAttempt.current = attempt;
+    void run(async (active) => {
+      const stillOpen = () => active() && currentKey.current === key;
+      const snapshot = await readAvailabilitySnapshot(relay);
+      if (!stillOpen() || key.pubkey !== snapshot.settings?.pubkey) return;
+      const inputs = Object.values(snapshot.people).filter(
+        (p) => !p.deleted && p.rules.some((r) => !r.lockedTitle),
+      );
+      const count = inputs.reduce(
+        (total, person) =>
+          total + person.rules.filter((rule) => !rule.lockedTitle).length,
+        0,
+      );
+      if (!count) return;
+      await saveAvailability(relay, pubkey, inputs, key, stillOpen);
+      if (stillOpen()) toast.success(`예전 사유 ${count}개를 숨겼어요`);
+    }).catch(() => {
+      // Plaintext remains in the shared snapshot, so the next query durably discovers the retry.
+    });
+  }, [scope, key, raw, updatedAt, working, relay, pubkey, run]);
+  return {
+    people,
+    status: query.isError
+      ? ("error" as const)
+      : query.isPending
+        ? ("loading" as const)
+        : ("ready" as const),
+    savePeople,
+    deletePerson,
+    retry: refresh,
+    refresh,
+    production: {
+      configured: !!expected,
+      unlocked: !!key,
+      canManage: query.data?.managers.has(pubkey) ?? false,
+      unlock,
+      lock,
+      setPassword,
+    },
+  };
+}
+/** Password controls exposed by the availability hook. */
+export type AvailabilityProduction = ReturnType<
+  typeof useTeamAvailability
+>["production"];

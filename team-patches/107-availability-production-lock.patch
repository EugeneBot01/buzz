@@ -0,0 +1,172 @@
+import * as React from "react";
+import type { AvailabilityProduction } from "../lib/useAvailabilityPrivacy";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import { Popover, PopoverContent, PopoverTrigger } from "@/shared/ui/popover";
+
+/** One production status button with keyboard-accessible password and lock controls. */
+export function ProductionControls({
+  production,
+}: {
+  production: AvailabilityProduction;
+}) {
+  const passwordId = React.useId();
+  const repeatId = React.useId();
+  const [open, setOpen] = React.useState(false);
+  const [changing, setChanging] = React.useState(false);
+  const [password, setPassword] = React.useState("");
+  const [repeat, setRepeat] = React.useState("");
+  const [saving, setSaving] = React.useState(false);
+  const [error, setError] = React.useState("");
+  const setting = !production.configured || changing;
+  const reset = () => {
+    setChanging(false);
+    setPassword("");
+    setRepeat("");
+    setError("");
+  };
+  if (!production.configured && !production.canManage) return null;
+  return (
+    <Popover
+      open={open}
+      onOpenChange={(next) => {
+        if (!saving) {
+          setOpen(next);
+          reset();
+        }
+      }}
+    >
+      <PopoverTrigger asChild>
+        <Button
+          size="sm"
+          variant="outline"
+          type="button"
+          disabled={saving}
+          data-testid="production-status"
+        >
+          {production.unlocked
+            ? "🔓 제작부 보는 중"
+            : production.configured
+              ? "🔒 제작부"
+              : "🔒 제작부 비밀번호 만들기"}
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent align="end" aria-label="제작부">
+        {production.unlocked && !changing ? (
+          <div className="flex flex-col gap-1">
+            <Button
+              size="sm"
+              variant="ghost"
+              type="button"
+              onClick={() => {
+                try {
+                  production.lock();
+                  setOpen(false);
+                  reset();
+                } catch {
+                  setError("이 기기에서 잠그지 못했어요.");
+                }
+              }}
+            >
+              잠그기
+            </Button>
+            {production.canManage ? (
+              <Button
+                size="sm"
+                variant="ghost"
+                type="button"
+                onClick={() => {
+                  reset();
+                  setChanging(true);
+                }}
+              >
+                비밀번호 바꾸기
+              </Button>
+            ) : null}
+          </div>
+        ) : (
+          <form
+            className="flex flex-col gap-3"
+            onSubmit={async (event) => {
+              event.preventDefault();
+              if (saving) return;
+              setError("");
+              if (setting && password !== repeat) {
+                setError("비밀번호를 똑같이 적어 주세요");
+                return;
+              }
+              setSaving(true);
+              try {
+                if (setting) await production.setPassword(password);
+                else await production.unlock(password);
+                setOpen(false);
+                reset();
+              } catch (e) {
+                setError(e instanceof Error ? e.message : "저장하지 못했어요.");
+              } finally {
+                setSaving(false);
+              }
+            }}
+          >
+            <label htmlFor={passwordId} className="flex flex-col gap-1 text-xs">
+              비밀번호
+              <Input
+                id={passwordId}
+                autoFocus
+                type="password"
+                autoComplete={setting ? "new-password" : "current-password"}
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                disabled={saving}
+              />
+            </label>
+            {setting ? (
+              <>
+                <label
+                  htmlFor={repeatId}
+                  className="flex flex-col gap-1 text-xs"
+                >
+                  한 번 더
+                  <Input
+                    id={repeatId}
+                    type="password"
+                    autoComplete="new-password"
+                    value={repeat}
+                    onChange={(e) => setRepeat(e.target.value)}
+                    disabled={saving}
+                  />
+                </label>
+                <p className="text-xs text-muted-foreground">
+                  제작부 톡방에 공유해 주세요. 다른 팀원에게는 일정 사유가
+                  '불가'로만 보여요.
+                </p>
+              </>
+            ) : null}
+            <div className="flex justify-end gap-2">
+              <Button
+                size="sm"
+                variant="ghost"
+                type="button"
+                disabled={saving}
+                onClick={() => {
+                  setOpen(false);
+                  reset();
+                }}
+              >
+                취소
+              </Button>
+              <Button size="sm" type="submit" disabled={saving}>
+                {setting ? "저장" : "열기"}
+              </Button>
+            </div>
+          </form>
+        )}
+        {error ? (
+          <p role="alert" className="mt-2 text-xs text-destructive">
+            {error}
+          </p>
+        ) : null}
+      </PopoverContent>
+    </Popover>
+  );
+}

+test("locking during automatic hiding cancels the pending publish and success notice", async () => {
+  const notice = mock.method(toast, "success", () => {});
+  const f = await fixture({ legacy: true });
+  localStorage.setItem(
+    productionStorageKey(pubkey, relayUrl),
+    Buffer.from(f.key.secret).toString("hex"),
+  );
+  const invoke = window.__TAURI_INTERNALS__.invoke;
+  let release;
+  window.__TAURI_INTERNALS__.invoke = async (cmd, args) => {
+    if (cmd === "sign_event")
+      await new Promise((resolve) => {
+        release = resolve;
+      });
+    return invoke(cmd, args);
+  };
+  const view = calendar();
+  await selectPerson(view);
+  await waitFor(() => assert.equal(typeof release, "function"));
+  fireEvent.click(view.getByRole("button", { name: "🔓 제작부 보는 중" }));
+  assert.equal(view.queryByRole("button", { name: "비밀번호 바꾸기" }), null);
+  fireEvent.click(view.getByRole("button", { name: "잠그기", exact: true }));
+  await act(async () => {
+    release();
+  });
+  assert.equal(f.publishes.length, 0);
+  assert.equal(notice.mock.callCount(), 0);
+  assert.ok(view.getByRole("button", { name: "🔒 제작부", exact: true }));
+});

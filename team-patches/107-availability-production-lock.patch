+test("automatic hiding retries quietly on the next query and does not repeat successful migration on reopen", async () => {
+  const notice = mock.method(toast, "success", () => {});
+  const errors = mock.method(toast, "error", () => {});
+  const f = await fixture({ legacy: true, failMigration: true });
+  localStorage.setItem(
+    productionStorageKey(pubkey, relayUrl),
+    Buffer.from(f.key.secret).toString("hex"),
+  );
+  let view = calendar();
+  await selectPerson(view);
+  await waitFor(() => assert.equal(f.publishes.length, 1));
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  });
+  assert.equal(f.publishes.length, 1);
+  assert.equal(notice.mock.callCount(), 0);
+  assert.equal(errors.mock.callCount(), 0);
+  f.allowMigration();
+  await act(async () => {
+    for (const receive of f.listeners) receive(f.events[0]);
+  });
+  await waitFor(() => assert.equal(f.publishes.length, 2));
+  await waitFor(() => assert.equal(notice.mock.callCount(), 1));
+  view.unmount();
+  view = calendar();
+  await selectPerson(view);
+  await act(async () => {
+    for (const receive of f.listeners) receive(f.events[0]);
+  });
+  assert.equal(f.publishes.length, 2);
+  assert.equal(notice.mock.callCount(), 1);
+});

     .map_err(|e| format!("spawn_blocking failed: {e}"))?
 }
 
+fn decrypt_account_reason(
+    keys: &Keys,
+    sender_public_key: Option<&str>,
+    ciphertext: &str,
+) -> Result<String, String> {
+    let sender = match sender_public_key {
+        Some(sender) => PublicKey::from_hex(sender).map_err(|e| format!("invalid sender: {e}"))?,
+        None => keys.public_key(),
+    };
+    nip44::decrypt(keys.secret_key(), &sender, ciphertext)
+        .map_err(|e| format!("nip44 decrypt failed: {e}"))
+}
+
+/// Decrypt for the active account; omitted sender preserves existing self-only callers.
 #[tauri::command]
 pub async fn nip44_decrypt_from_self(
     ciphertext: String,
+    sender_public_key: Option<String>,
     state: State<'_, AppState>,
 ) -> Result<String, String> {
     let keys = state.signing_keys()?;
-
     tauri::async_runtime::spawn_blocking(move || {
-        nip44::decrypt(keys.secret_key(), &keys.public_key(), &ciphertext)
-            .map_err(|e| format!("nip44 decrypt failed: {e}"))
+        decrypt_account_reason(&keys, sender_public_key.as_deref(), &ciphertext)
     })
     .await
     .map_err(|e| format!("spawn_blocking failed: {e}"))?
 }
 
+#[cfg(test)]
+mod availability_reason_tests {
+    use super::decrypt_account_reason;
+    use nostr::{nips::nip44, Keys};
+
+    #[test]
+    fn availability_reason_account_peer_and_self_round_trip(
+    ) -> Result<(), Box<dyn std::error::Error>> {
+        let account = Keys::generate();
+        let sender = Keys::generate();
+        let stranger = Keys::generate();
+        let ciphertext = nip44::encrypt(
+            sender.secret_key(),
+            &account.public_key(),
+            "가짜 수업",
+            nip44::Version::V2,
+        )?;
+        assert_eq!(
+            decrypt_account_reason(&account, Some(&sender.public_key().to_hex()), &ciphertext)?,
+            "가짜 수업"
+        );
+        assert!(decrypt_account_reason(
+            &stranger,
+            Some(&sender.public_key().to_hex()),
+            &ciphertext
+        )
+        .is_err());
+        assert!(decrypt_account_reason(&account, Some("invalid"), &ciphertext).is_err());
+        let legacy = nip44::encrypt(
+            account.secret_key(),
+            &account.public_key(),
+            "legacy",
+            nip44::Version::V2,
+        )?;
+        assert_eq!(decrypt_account_reason(&account, None, &legacy)?, "legacy");
+        Ok(())
+    }
+}

+import {
+  type ProductionSettings,
+  mergeAvailabilityEvents,
+  newestAvailabilityEvents,
+  readProductionSettings,
+} from "./availabilityMerge";
+export {
+  mergeAvailabilityEvents,
+  readProductionSettings,
+} from "./availabilityMerge";
+import { relayClient } from "@/shared/api/relayClient";
+import { listRelayMembers } from "@/shared/api/relayMembers";
+import { signRelayEvent } from "@/shared/api/tauri";
+import type { RelayEvent } from "@/shared/api/types";
+import {
+  type PeopleById,
+  type TeamPerson,
+  encodePeopleForPublish,
+  mergePeople,
+  teamAvailabilityDTag,
+} from "./teamAvailability";
+import {
+  type ProductionKey,
+  availabilityCopies,
+  lockRule,
+  signProductionPeople,
+  unlockTitle,
+} from "./availabilityPrivacy";
+
+/** Community-scoped coordinate for manager-authored production settings. */
+export const productionDTag = (relay: string) =>
+  `${teamAvailabilityDTag(relay)}:production`;
+/** Fresh authorized state used both for display and write-time permission checks. */
+export type AvailabilitySnapshot = {
+  people: PeopleById;
+  events: RelayEvent[];
+  settings: ProductionSettings | null;
+  managers: Set<string>;
+};
+/** One bounded community read. Membership failures propagate instead of disabling protection. */
+export async function readAvailabilitySnapshot(
+  relay: string,
+): Promise<AvailabilitySnapshot> {
+  const members = await listRelayMembers();
+  const managers = new Set(
+    members
+      .filter((m) => m.role === "owner" || m.role === "admin")
+      .map((m) => m.pubkey),
+  );
+  const [events, config] = await Promise.all([
+    relayClient.fetchEvents({
+      kinds: [30078],
+      "#d": [teamAvailabilityDTag(relay)],
+      limit: 200,
+    }),
+    relayClient.fetchEvents({
+      kinds: [30078],
+      "#d": [productionDTag(relay)],
+      limit: 200,
+    }),
+  ]);
+  const settings = readProductionSettings(
+    config,
+    managers,
+    productionDTag(relay),
+  );
+  return {
+    people: mergeAvailabilityEvents(
+      events,
+      teamAvailabilityDTag(relay),
+      settings,
+    ),
+    settings,
+    events,
+    managers,
+  };
+}
+
+/** UI and write seam share the same ownership rule. */
+export function canEditAvailability(
+  person: Pick<TeamPerson, "pubkey">,
+  pubkey: string,
+  production: boolean,
+): boolean {
+  return production || !person.pubkey || person.pubkey === pubkey;
+}
+
+async function publish(
+  content: string,
+  dTag: string,
+  createdAt: number,
+  active: () => boolean,
+): Promise<RelayEvent> {
+  if (new TextEncoder().encode(content).length > 60_000)
+    throw new Error("팀원 일정이 너무 많습니다. 지난 일정을 정리해 주세요.");
+  const event = await signRelayEvent({
+    kind: 30078,
+    content,
+    createdAt,
+    tags: [
+      ["d", dTag],
+      ["t", "team-availability"],
+    ],
+  });
+  if (!active()) throw new Error("다른 팀으로 이동했습니다. 다시 열어 주세요.");
+  await relayClient.publishEvent(
+    event,
+    "저장이 오래 걸립니다. 다시 시도해 주세요.",
+    "팀원 일정을 저장하지 못했습니다.",
+    active,
+  );
+  return event;
+}
+
+/** Recheck fresh ownership, preserve unreadable reasons, and publish one snapshot per action. */
+export async function saveAvailability(
+  relay: string,
+  pubkey: string,
+  inputs: Omit<TeamPerson, "updatedAt" | "updatedBy">[],
+  key: ProductionKey | null,
+  active: () => boolean,
+): Promise<void> {
+  const snapshot = await readAvailabilitySnapshot(relay);
+  if (!active()) throw new Error("다른 팀으로 이동했습니다. 다시 열어 주세요.");
+  const production = key?.pubkey === snapshot.settings?.pubkey ? key : null;
+  const own = newestAvailabilityEvents(
+    snapshot.events,
+    teamAvailabilityDTag(relay),
+  ).find((e) => e.pubkey === pubkey);
+  const ownCopies = own
+    ? availabilityCopies(
+        own,
+        teamAvailabilityDTag(relay),
+        snapshot.settings?.pubkey,
+      )
+    : [];
+  // Do not echo stale plaintext after another member migrated this person's reasons.
+  let normal = Object.fromEntries(
+    Object.entries(
+      ownCopies.find((c) => c.writer === pubkey)?.people ?? {},
+    ).filter(
+      ([id, person]) =>
+        (!person.pubkey || person.pubkey === pubkey) &&
+        (snapshot.people[id]?.updatedAt ?? 0) <= person.updatedAt,
+    ),
+  );
+  let privileged =
+    ownCopies.find((c) => c.writer === production?.pubkey)?.people ?? {};
+  const changes: PeopleById = {};
+  for (const input of inputs) {
+    const previous = snapshot.people[input.id];
+    if (
+      !production &&
+      input.pubkey === pubkey &&
+      previous?.pubkey !== pubkey &&
+      Object.values(snapshot.people).some(
+        (p) => p.id !== input.id && p.pubkey === pubkey,
+      )
+    )
+      throw new Error("다른 이름으로 바꾸려면 제작부를 열어 주세요.");
+    if (
+      !canEditAvailability(previous ?? input, pubkey, !!production) ||
+      (!production && previous?.pubkey && previous.pubkey !== input.pubkey) ||
+      (!production && input.pubkey && input.pubkey !== pubkey)
+    )
+      throw new Error("본인과 제작부만 고칠 수 있어요.");
+    const rules = input.rules.map((rule) => {
+      const oldRule = previous?.rules.find((r) => r.id === rule.id);
+      if (
+        rule.lockedTitle &&
+        oldRule?.lockedTitle &&
+        JSON.stringify(rule.lockedTitle) === JSON.stringify(oldRule.lockedTitle)
+      ) {
+        if (production && input.pubkey && input.pubkey !== previous?.pubkey) {
+          return lockRule(
+            { ...rule, title: unlockTitle(rule.lockedTitle, production) },
+            input.pubkey,
+            production.pubkey,
+          );
+        }
+        return { ...rule, title: oldRule.title };
+      }
+      if (rule.lockedTitle) {
+        if (
+          rule.lockedTitle.production !== snapshot.settings?.pubkey ||
+          (input.pubkey && rule.lockedTitle.author !== input.pubkey)
+        )
+          throw new Error(
+            "이전 사유를 읽지 못했어요. 제작부에서 다시 가져와 주세요.",
+          );
+        return rule;
+      }
+      const { lockedTitle: _discard, ...plain } = rule;
+      return snapshot.settings
+        ? lockRule(plain, input.pubkey ?? pubkey, snapshot.settings.pubkey)
+        : plain;
+    });
+    changes[input.id] = {
+      ...input,
+      name: input.name.trim(),
+      role: input.role?.trim() || undefined,
+      rules,
+      updatedAt: Math.max(Date.now(), (previous?.updatedAt ?? 0) + 1),
+      updatedBy: production?.pubkey ?? pubkey,
+    };
+  }
+  const createdAt = Math.max(
+    Math.floor(Date.now() / 1000),
+    (own?.created_at ?? 0) + 1,
+  );
+  if (production) {
+    privileged = mergePeople(privileged, changes);
+    normal = { ...normal };
+    for (const id of Object.keys(changes)) delete normal[id];
+  } else normal = mergePeople(normal, changes);
+  const content = encodePeopleForPublish(normal);
+  if (content === null) throw new Error("팀원 일정이 너무 많습니다.");
+  const payload = JSON.parse(content);
+  // Retain this member's previous production writes when subsequently saving as self.
+  const priorProof = own && JSON.parse(own.content).production;
+  if (production)
+    payload.production = signProductionPeople(
+      privileged,
+      teamAvailabilityDTag(relay),
+      production,
+      createdAt,
+    );
+  else if (priorProof) payload.production = priorProof;
+  await publish(
+    JSON.stringify(payload),
+    teamAvailabilityDTag(relay),
+    createdAt,
+    active,
+  );
+}
+
+/** Rotate in one manager event; carry current data under the new production signer. */
+export async function setProductionPassword(
+  relay: string,
+  pubkey: string,
+  next: ProductionKey,
+  previous: ProductionKey | null,
+  active: () => boolean,
+): Promise<void> {
+  const snapshot = await readAvailabilitySnapshot(relay);
+  if (!snapshot.managers.has(pubkey))
+    throw new Error("방장과 관리자만 정할 수 있어요.");
+  if (snapshot.settings && previous?.pubkey !== snapshot.settings.pubkey)
+    throw new Error("제작부를 먼저 열어 주세요.");
+  const people: PeopleById = {};
+  const carried = previous
+    ? Object.values(snapshot.people).filter(
+        (person) =>
+          person.updatedBy === previous.pubkey ||
+          person.rules.some((rule) => rule.lockedTitle),
+      )
+    : [];
+  for (const person of carried) {
+    people[person.id] = {
+      ...person,
+      updatedBy: next.pubkey,
+      updatedAt: Math.max(Date.now(), person.updatedAt + 1),
+      rules: person.rules.map((rule) => {
+        if (!rule.lockedTitle) return rule;
+        const title = previous
+          ? unlockTitle(rule.lockedTitle, previous)
+          : rule.title;
+        return lockRule(
+          { ...rule, title },
+          person.pubkey ?? rule.lockedTitle?.author ?? pubkey,
+          next.pubkey,
+        );
+      }),
+    };
+  }
+  const config = await relayClient.fetchEvents({
+    kinds: [30078],
+    "#d": [productionDTag(relay)],
+    limit: 200,
+  });
+  const createdAt = Math.max(
+    Math.floor(Date.now() / 1000),
+    ...config
+      .filter((e) => snapshot.managers.has(e.pubkey))
+      .map((e) => e.created_at + 1),
+  );
+  const baseline = carried.length
+    ? signProductionPeople(people, teamAvailabilityDTag(relay), next, createdAt)
+    : undefined;
+  await publish(
+    JSON.stringify({ v: 1, pubkey: next.pubkey, baseline }),
+    productionDTag(relay),
+    createdAt,
+    active,
+  );
+}

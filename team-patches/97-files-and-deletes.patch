@@ -0,0 +1,29 @@
+import type { QueryClient } from "@tanstack/react-query";
+
+import type { RelayEvent } from "@/shared/api/types";
+import { channelMessagesKey } from "./messageQueryKeys";
+
+/**
+ * Drops a deleted message from every cache that shows it (team patch).
+ *
+ * Deleting used to update only the channel timeline, so the message stayed in
+ * an open thread panel (and in a thread opened later from cache) until the
+ * app refetched it. The thread caches are filtered at once and then refetched
+ * so replies to the deleted message and its counters are corrected too.
+ */
+export function forgetDeletedMessage(
+  queryClient: QueryClient,
+  channelId: string,
+  eventId: string,
+): void {
+  const drop = (current: RelayEvent[] | undefined) =>
+    current?.filter((message) => message.id !== eventId);
+  queryClient.setQueryData<RelayEvent[]>(channelMessagesKey(channelId), drop);
+  queryClient.setQueriesData<RelayEvent[]>(
+    { queryKey: ["thread-replies", channelId] },
+    drop,
+  );
+  void queryClient.invalidateQueries({
+    queryKey: ["thread-replies", channelId],
+  });
+}

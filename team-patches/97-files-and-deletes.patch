  * The attachments carried by `events`, newest first. A file posted more than
  * once (same URL) is listed once, at its most recent post.
  */
+/** The files one message carries, in the order the message lists them. */
+export function filesFromTags(tags: string[][] | undefined): ChannelFile[] {
+  if (!tags) return [];
+  const seen = new Set<string>();
+  const files: ChannelFile[] = [];
+  for (const entry of parseImetaTags(tags).values()) {
+    if (seen.has(entry.url)) continue;
+    seen.add(entry.url);
+    files.push({
+      url: entry.url,
+      filename: resolveFilename(entry.url, entry.filename),
+      size:
+        typeof entry.size === "number" &&
+        Number.isFinite(entry.size) &&
+        entry.size >= 0
+          ? entry.size
+          : undefined,
+      mime: entry.m ?? "",
+      author: "",
+      postedAt: 0,
+    });
+  }
+  return files;
+}
+
+/** Files whose name contains every word of `query` (case does not matter). */
+export function searchFiles(files: ChannelFile[], query: string): ChannelFile[] {
+  const words = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
+  if (words.length === 0) return files;
+  return files.filter((file) => {
+    const name = file.filename.toLowerCase();
+    return words.every((word) => name.includes(word));
+  });
+}

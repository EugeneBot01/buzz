@@ -0,0 +1,43 @@
+import { toast } from "sonner";
+
+import type { ChannelFile } from "@/features/channel-files/lib/channelFiles";
+import { invokeTauri } from "@/shared/api/tauri";
+import { downloadErrorText } from "@/shared/lib/downloadErrorText";
+
+type BulkDownloadResult = {
+  cancelled: boolean;
+  saved: number;
+  failed: Array<{ filename: string; error: string }>;
+};
+
+/**
+ * Asks for one folder and saves every file into it (team patch), then tells
+ * the person how it went. Resolves to true when every file was saved.
+ */
+export async function downloadFilesToFolder(
+  files: ChannelFile[],
+): Promise<boolean> {
+  try {
+    const result = await invokeTauri<BulkDownloadResult>(
+      "download_files_to_folder",
+      {
+        items: files.map((file) => ({ url: file.url, filename: file.filename })),
+      },
+    );
+    if (result.cancelled) return false;
+    if (result.saved > 0) toast.success(`파일 ${result.saved}개를 저장했습니다.`);
+    const first = result.failed[0];
+    if (first) {
+      toast.error(`파일 ${result.failed.length}개를 받지 못했습니다.`, {
+        description: `${first.filename}: ${downloadErrorText(first.error)}`,
+      });
+      return false;
+    }
+    return true;
+  } catch (error) {
+    toast.error(
+      downloadErrorText(error instanceof Error ? error.message : String(error)),
+    );
+    return false;
+  }
+}

new file mode 100644
index 000000000..7d42155cd
--- /dev/null
+++ b/desktop/src/shared/lib/downloadErrorText.ts
@@ -0,0 +1,20 @@
+/**
+ * A Korean sentence for a failed file download (team patch). The native
+ * download command answers in terse English ("download URL must match the
+ * relay origin"), which told people nothing about what to do.
+ */
+export function downloadErrorText(raw: string): string {
+  const text = raw.trim();
+  if (/must match the relay origin|must be a \/media\/ path/i.test(text))
+    return "이 파일은 지금 연결된 커뮤니티 서버에 있지 않아 받을 수 없습니다. Buzz를 완전히 종료(⌘Q)한 뒤 다시 켜고, 파일이 올라온 커뮤니티에서 다시 받아 주세요.";
+  if (/file too large/i.test(text))
+    return "파일이 너무 커서 받을 수 없습니다. (최대 512MB)";
+  if (/\b(401|403)\b|unauthori[sz]ed|forbidden|expired/i.test(text))
+    return "서버가 파일 받기를 거절했습니다. 맥의 날짜와 시간이 맞는지 확인한 뒤 다시 받아 주세요.";
+  if (/\b404\b|not found/i.test(text))
+    return "서버에 이 파일이 없습니다. 지워졌을 수 있습니다.";
+  if (/cancel/i.test(text)) return "파일 받기를 취소했습니다.";
+  if (/timed? ?out|timeout/i.test(text))
+    return "파일을 받는 데 시간이 너무 오래 걸렸습니다. 인터넷 연결을 확인하고 다시 받아 주세요.";
+  return `파일을 받지 못했습니다: ${text || "알 수 없는 오류"}`;
+}

@@ -0,0 +1,39 @@
+import { Download } from "lucide-react";
+import * as React from "react";
+
+import { downloadFilesToFolder } from "@/features/channel-files/lib/bulkDownload";
+import {
+  MAX_BULK_DOWNLOAD_FILES,
+  filesFromTags,
+} from "@/features/channel-files/lib/channelFiles";
+import { Button } from "@/shared/ui/button";
+
+/**
+ * "Download all" under a message that carries two or more files (team patch):
+ * one folder picker, every file saved into it.
+ */
+export function MessageFilesDownloadButton({ tags }: { tags?: string[][] }) {
+  const files = React.useMemo(() => filesFromTags(tags), [tags]);
+  const [busy, setBusy] = React.useState(false);
+  if (files.length < 2 || files.length > MAX_BULK_DOWNLOAD_FILES) return null;
+
+  return (
+    <Button
+      aria-label={`첨부 파일 ${files.length}개 모두 받기`}
+      className="mt-1 h-7 gap-1.5 px-2 text-xs"
+      data-no-translate=""
+      data-testid="message-files-download-all"
+      disabled={busy}
+      onClick={() => {
+        setBusy(true);
+        void downloadFilesToFolder(files).finally(() => setBusy(false));
+      }}
+      size="sm"
+      type="button"
+      variant="outline"
+    >
+      <Download className="h-3.5 w-3.5" />
+      {busy ? "받는 중…" : `파일 ${files.length}개 모두 받기`}
+    </Button>
+  );
+}

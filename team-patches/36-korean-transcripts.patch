+/// Language the huddle transcript is recognised in. Selects which STT model
+/// slot every `stt_*` accessor reports, downloads, and loads.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SttLanguage {
+    English,
+    Korean,
+}
+
+impl SttLanguage {
+    pub fn parse(code: &str) -> Option<Self> {
+        match code.trim().to_ascii_lowercase().as_str() {
+            "en" => Some(Self::English),
+            "ko" => Some(Self::Korean),
+            _ => None,
+        }
+    }
+}
+
+static STT_LANGUAGE: AtomicU8 = AtomicU8::new(0);
+
+/// Current transcript language (English until the frontend says otherwise).
+pub fn stt_language() -> SttLanguage {
+    match STT_LANGUAGE.load(Ordering::Acquire) {
+        1 => SttLanguage::Korean,
+        _ => SttLanguage::English,
+    }
+}
+
+/// Switch the transcript language. Returns `true` when it changed.
+pub fn set_stt_language(language: SttLanguage) -> bool {
+    let next = match language {
+        SttLanguage::English => 0,
+        SttLanguage::Korean => 1,
+    };
+    STT_LANGUAGE.swap(next, Ordering::AcqRel) != next
+}

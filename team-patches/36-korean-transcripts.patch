+fn short_pubkey(pubkey: &str) -> String {
+    format!("{}…", &pubkey[..pubkey.len().min(8)])
+}
+
+/// Kind-0 display name for a transcript speaker (best-effort, one query).
+async fn fetch_display_name(
+    http_client: &reqwest::Client,
+    keys: &nostr::Keys,
+    relay_base_url: &str,
+    pubkey: &str,
+) -> Option<String> {
+    let url = format!("{relay_base_url}/query");
+    let body = serde_json::to_vec(&[serde_json::json!({
+        "kinds": [0],
+        "authors": [pubkey],
+        "limit": 1,

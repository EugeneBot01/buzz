     state.emit_huddle_state_changed();
     Ok(())
 }
+
+/// Set the huddle transcript language (`"en"` or `"ko"`).
+///
+/// Starts downloading that language's STT model if needed. When a transcript
+/// is running, the pipeline is restarted on the new model; if that model is
+/// not downloaded yet, the hot-start loop picks it up once it is ready.
+#[tauri::command]
+pub async fn set_huddle_stt_language(
+    language: String,
+    state: State<'_, AppState>,
+) -> Result<(), String> {
+    let language = models::SttLanguage::parse(&language)
+        .ok_or_else(|| format!("unsupported transcript language: {language}"))?;
+    if !models::set_stt_language(language) {
+        return Ok(());
+    }
+    if let Some(manager) = models::global_model_manager() {
+        manager.start_stt_download(state.http_client.clone());
+    }
+
+    let restart = {
+        let mut hs = state.huddle()?;
+        match hs.ephemeral_channel_id.clone() {
+            Some(channel_id) if hs.transcription_enabled => {
+                hs.invalidate_transcription_pipeline();
+                Some((channel_id, hs.take_stt_pipeline()))
+            }
+            _ => None,
+        }
+    };
+    if let Some((channel_id, old_stt)) = restart {
+        if let Some(ref pipeline) = old_stt {
+            pipeline.shutdown();
+        }
+        drop(old_stt);
+        if let Err(e) = maybe_start_stt_pipeline(&state, &channel_id).await {
+            eprintln!("buzz-desktop: STT restart after language change failed: {e}");
+        }
+    }
+
+    state.emit_huddle_state_changed();
+    Ok(())
+}

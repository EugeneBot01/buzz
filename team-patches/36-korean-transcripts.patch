+/// Loads the Korean SenseVoice model exactly as `stt_worker` does and decodes
+/// a 16 kHz mono f32le clip. Run with:
+/// BUZZ_KO_MODEL_DIR=<…/sense-voice-ko-2024-07-17> BUZZ_KO_PCM=<clip.f32> \
+///   cargo test korean_sense_voice_decodes -- --ignored --nocapture
+#[test]
+#[ignore = "needs the SenseVoice model on disk"]
+fn korean_sense_voice_decodes() {
+    let dir =
+        std::path::PathBuf::from(std::env::var("BUZZ_KO_MODEL_DIR").expect("BUZZ_KO_MODEL_DIR"));
+    let pcm = std::fs::read(std::env::var("BUZZ_KO_PCM").expect("BUZZ_KO_PCM")).expect("read pcm");
+    let samples: Vec<f32> = pcm
+        .chunks_exact(4)
+        .map(|b| f32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        .collect();
+    let (cfg, korean) =
+        recognizer_config(&dir, &dir.join("model.int8.onnx"), &dir.join("tokens.txt"));
+    assert!(korean, "directory name must select the SenseVoice path");
+    let recognizer = sherpa_onnx::OfflineRecognizer::create(&cfg).expect("create recognizer");
+    KOREAN_SPACING.with(|flag| flag.set(true));
+    let text = decode_speech(&recognizer, &samples);
+    eprintln!("transcript: {text}");
+    assert!(text.contains("확정을"), "unexpected transcript: {text}");
+}

@@ -0,0 +1,37 @@
+import { invoke } from "@tauri-apps/api/core";
+
+/** Huddle transcript language: Korean uses SenseVoice, English uses Parakeet. */
+export type TranscriptLanguage = "ko" | "en";
+
+const STORAGE_KEY = "buzz-huddle-transcript-language";
+
+/** Saved choice, else Korean on a Korean system and English elsewhere. */
+export function readTranscriptLanguage(): TranscriptLanguage {
+  try {
+    const saved = window.localStorage.getItem(STORAGE_KEY);
+    if (saved === "ko" || saved === "en") return saved;
+  } catch {
+    // Storage unavailable — fall back to the system language.
+  }
+  try {
+    return navigator.language?.toLowerCase().startsWith("ko") ? "ko" : "en";
+  } catch {
+    return "en";
+  }
+}
+
+/**
+ * Tell the backend which STT model to use (and to download it if needed).
+ * Pass `language` to change and remember the choice; omit it to re-sync.
+ */
+export async function applyTranscriptLanguage(
+  language: TranscriptLanguage = readTranscriptLanguage(),
+): Promise<TranscriptLanguage> {
+  try {
+    window.localStorage.setItem(STORAGE_KEY, language);
+  } catch {
+    // Best effort — the backend still switches for this session.
+  }
+  await invoke("set_huddle_stt_language", { language });
+  return language;
+}

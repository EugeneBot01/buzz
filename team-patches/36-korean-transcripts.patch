+//! Spacing cleanup for Korean SenseVoice transcripts.
+//!
+//! SenseVoice emits Korean as sub-word tokens and joins them with spaces, so
+//! particles and endings land as separate words ("확정 을", "했 습니다").
+//! This re-attaches a token from the list below to the previous word when
+//! that word ends in Hangul or a digit. It is a readability fix for live
+//! captions, not a full Korean word-spacing model.
+
+/// Particles and endings SenseVoice tends to split off as their own token.
+const ATTACH: &[&str] = &[
+    "습니다",
+    "니다",
+    "겠습니다",
+    "어요",
+    "아요",
+    "에요",
+    "예요",
+    "해요",
+    "죠",
+    "요",
+    "은",
+    "는",
+    "이",
+    "가",
+    "을",
+    "를",
+    "에",
+    "에서",
+    "에게",
+    "께",
+    "로",
+    "으로",
+    "의",
+    "도",
+    "만",
+    "까지",
+    "부터",
+    "와",
+    "과",
+    "이라고",
+    "라고",
+    "이나",
+    "나",
+    "랑",
+    "이랑",
+    "님",
+    "들",
+    "께서",
+    "처럼",
+    "보다",
+    "마다",
+    "씩",
+    "째",
+    "차",
+    "시는",
+    "시고",
+    "시면",
+    "셔서",
+    "세요",
+    "주세요",
+    "던",
+    "는데",
+    "은데",
+    "인데",
+    "고",
+    "며",
+    "면",
+    "서",
+    "니까",
+    "지만",
+    "거나",
+    "기로",
+    "게",
+    "겠",
+    "었",
+    "았",
+    "였",
+    "어",
+    "아",
+    "여",
+    "일",
+    "월",
+    "시",
+    "분",
+];
+
+fn ends_in_hangul_or_digit(word: &str) -> bool {
+    word.chars()
+        .last()
+        .is_some_and(|c| c.is_ascii_digit() || ('가'..='힣').contains(&c))
+}
+
+fn ends_in_digit(word: &str) -> bool {
+    word.chars().last().is_some_and(|c| c.is_ascii_digit())
+}
+
+/// Counter words that follow a number without a space (일, 월, 시, 분 …).
+fn starts_with_counter(token: &str) -> bool {
+    token
+        .chars()
+        .next()
+        .is_some_and(|c| "일월시분초차번년주개명회층".contains(c))
+}
+
+fn is_attachable(token: &str) -> bool {
+    let core = token.trim_end_matches(['.', ',', '?', '!']);
+    ATTACH.contains(&core)
+}
+
+/// Re-attach split-off particles/endings to the preceding word.
+pub fn fix_korean_spacing(text: &str) -> String {
+    let mut words: Vec<String> = Vec::new();
+    for token in text.split_whitespace() {
+        match words.last_mut() {
+            Some(prev) if ends_in_hangul_or_digit(prev) && is_attachable(token) => {
+                prev.push_str(token);
+            }
+            // "14 일로" → "14일로": ITN digits followed by a counter word.
+            Some(prev) if ends_in_digit(prev) && starts_with_counter(token) => {
+                prev.push_str(token);
+            }
+            _ => words.push(token.to_string()),
+        }
+    }
+    words.join(" ")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::fix_korean_spacing;
+
+    #[test]
+    fn reattaches_particles_and_endings() {
+        assert_eq!(
+            fix_korean_spacing("안무 기획 간 확정 을 다음 주 수요 일로 미루 기로 했 습니다."),
+            "안무 기획 간 확정을 다음 주 수요 일로 미루기로 했습니다."
+        );
+        assert_eq!(
+            fix_korean_spacing("배우 사이즈 실측 은 배우 일정 때문에 14 일로 연기 됐 어요."),
+            "배우 사이즈 실측은 배우 일정 때문에 14일로 연기 됐어요."
+        );
+        assert_eq!(
+            fix_korean_spacing("로케이션 공 문은 월요일 에 피디 님 이 발송 하 시는 걸로 하 죠."),
+            "로케이션 공 문은 월요일에 피디님이 발송 하시는 걸로 하죠."
+        );
+    }
+
+    #[test]
+    fn leaves_english_and_leading_tokens_alone() {
+        assert_eq!(fix_korean_spacing("PPM 전에 QC 한 번"), "PPM 전에 QC 한 번");
+        assert_eq!(fix_korean_spacing("은 그렇고"), "은 그렇고");
+        assert_eq!(fix_korean_spacing(""), "");
+    }
+}

+//! Opt-in: keep web views painting while their window is covered.
+//!
+//! WebKit stops rendering a `WKWebView` whose window is occluded, so window
+//! captures of a covered Buzz (screenshots, automated UI checks) return a
+//! stale frame. Setting the per-user default
+//! `defaults write xyz.block.buzz.app BuzzRenderWhenCovered -bool YES`
+//! turns occlusion detection off for every Buzz web view on that Mac only.
+//! It costs some extra power while covered, so it is off by default.
+
+#[cfg(target_os = "macos")]
+pub fn apply<R: tauri::Runtime>(webview: &tauri::Webview<R>) {
+    use objc2::runtime::{AnyClass, AnyObject, Bool};
+    use objc2::{msg_send, sel};
+    use objc2_foundation::NSString;
+
+    // SAFETY: plain Foundation calls on the main thread's standard defaults.
+    let enabled: bool = unsafe {
+        let Some(cls) = AnyClass::get(c"NSUserDefaults") else {
+            return;
+        };
+        let defaults: *mut AnyObject = msg_send![cls, standardUserDefaults];
+        if defaults.is_null() {
+            return;
+        }
+        let key = NSString::from_str("BuzzRenderWhenCovered");
+        let value: Bool = msg_send![defaults, boolForKey: &*key];
+        value.as_bool()
+    };
+    if !enabled {
+        return;
+    }
+
+    let result = webview.with_webview(|platform| {
+        let wk = platform.inner() as *mut AnyObject;
+        if wk.is_null() {
+            return;
+        }
+        // SAFETY: `wk` is the live WKWebView; the private setter is probed
+        // with respondsToSelector: first so an OS that drops it is a no-op.
+        unsafe {
+            let selector = sel!(_setWindowOcclusionDetectionEnabled:);
+            let responds: Bool = msg_send![wk, respondsToSelector: selector];
+            if responds.as_bool() {
+                let _: () = msg_send![wk, _setWindowOcclusionDetectionEnabled: Bool::NO];
+            }
+        }
+    });
+    if let Err(error) = result {
+        eprintln!("buzz-desktop: render-when-covered setup failed: {error}");
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+pub fn apply<R: tauri::Runtime>(_webview: &tauri::Webview<R>) {}

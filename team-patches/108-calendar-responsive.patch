@@ -0,0 +1,45 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { calendarCellLayout, stackScheduleColumns } from "./calendarLayout.ts";
+
+test("columns use body width, with the 860px boundary included", () => {
+  for (const [width, stacked] of [
+    [0, true],
+    [600, true],
+    [800, true],
+    [859.99, true],
+    [860, false],
+    [960, false],
+    [1200, false],
+  ])
+    assert.equal(stackScheduleColumns(width), stacked, `body ${width}`);
+});
+
+test("availability abbreviates only below the actual 110px cell boundary", () => {
+  for (const [width, compact] of [
+    [40, true],
+    [85, true],
+    [109.99, true],
+    [110, false],
+    [172, false],
+  ])
+    assert.equal(calendarCellLayout(width, 112, 16).compact, compact);
+});
+
+test("lanes fit the measured height and root font scaling, with zero and three bounds", () => {
+  for (const [height, rem, lanes] of [
+    [0, 16, 0],
+    [46, 16, 0],
+    [62, 16, 1],
+    [80, 16, 2],
+    [112, 16, 3],
+    [500, 16, 3],
+    [100, 20, 2],
+    [140, 20, 3],
+  ])
+    assert.equal(
+      calendarCellLayout(85, height, rem).lanes,
+      lanes,
+      `${height}/${rem}`,
+    );
+});
diff --git a/desktop/src/features/team-calendar/lib/calendarLayout.ts b/desktop/src/features/team-calendar/lib/calendarLayout.ts
new file mode 100644
index 000000000..dc64285b6
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/calendarLayout.ts
@@ -0,0 +1,23 @@
+/** The schedule body, excluding the app sidebar, needs this width for two columns. */
+export const SCHEDULE_COLUMNS_MIN_WIDTH = 860;
+
+/** Unknown or narrow body widths keep the detail panel below the main view. */
+export function stackScheduleColumns(bodyWidth: number): boolean {
+  return bodyWidth < SCHEDULE_COLUMNS_MIN_WIDTH;
+}
+
+/**
+ * Reserve 2.75rem for date/count and availability, then fit at most three
+ * 1rem bars with 0.125rem gaps. Dimensions come from the actual day button,
+ * including root font scaling, rather than the viewport or a fixed lane count.
+ */
+export function calendarCellLayout(width: number, height: number, rem: number) {
+  const available = Math.max(0, height - 2.875 * rem);
+  return {
+    compact: width < 110,
+    lanes: Math.max(
+      0,
+      Math.min(3, Math.floor((available + 0.125 * rem) / (1.125 * rem))),
+    ),
+  };
+}

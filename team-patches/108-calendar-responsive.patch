@@ -0,0 +1,26 @@
+import type { ComponentProps } from "react";
+
+import { stackScheduleColumns } from "../lib/calendarLayout";
+import { useElementWidth } from "@/shared/hooks/use-mobile";
+import { cn } from "@/shared/lib/cn";
+
+/** Keeps calendar, sprint editor and member detail columns within their own body. */
+export function ScheduleColumns({
+  className,
+  ...props
+}: ComponentProps<"div">) {
+  const [ref, width] = useElementWidth<HTMLDivElement>();
+  const stacked = stackScheduleColumns(width);
+  return (
+    <div
+      {...props}
+      ref={ref}
+      data-stacked={stacked}
+      className={cn(
+        "group/schedule flex min-w-0 w-full gap-4",
+        stacked ? "flex-col" : "flex-row",
+        className,
+      )}
+    />
+  );
+}

diff --git a/desktop/src/features/team-calendar/ui/calendarLayout.jsdom-test.mjs b/desktop/src/features/team-calendar/ui/calendarLayout.jsdom-test.mjs
new file mode 100644
index 000000000..e04d95e0c
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/calendarLayout.jsdom-test.mjs
@@ -0,0 +1,197 @@
+import assert from "node:assert/strict";
+import { afterEach, mock, test } from "node:test";
+import React from "react";
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  within,
+} from "@testing-library/react";
+import { CalendarGrid } from "./CalendarGrid.tsx";
+import { ScheduleColumns } from "./ScheduleColumns.tsx";
+import { TeamCalendarDialog } from "./TeamCalendarDialog.tsx";
+import {
+  prepareScheduleDom,
+  pubkey,
+  relayUrl,
+} from "../../team-schedule/ui/scheduleTestSupport.mjs";
+
+let env;
+afterEach(() => {
+  cleanup();
+  env?.client.clear();
+  mock.restoreAll();
+  localStorage.clear();
+  delete globalThis.isTauri;
+  delete globalThis.ResizeObserver;
+});
+function measure(initialWidth, initialHeight = 80) {
+  let width = initialWidth;
+  let height = initialHeight;
+  const observers = new Set();
+  mock.method(HTMLElement.prototype, "getBoundingClientRect", () => ({
+    width,
+    height,
+  }));
+  globalThis.ResizeObserver = class {
+    constructor(callback) {
+      this.callback = callback;
+    }
+    observe() {
+      observers.add(this);
+    }
+    unobserve() {
+      observers.delete(this);
+    }
+    disconnect() {
+      observers.delete(this);
+    }
+  };
+  return {
+    resize(w, h = height) {
+      width = w;
+      height = h;
+      act(() => {
+        for (const observer of observers) observer.callback([]);
+      });
+    },
+    observers,
+  };
+}
+const date = "2026-11-06";
+const entry = (index) => ({
+  id: `entry-${index}`,
+  title: `아주 긴 일정 제목 ${index}`,
+  date,
+  updatedAt: 1,
+  updatedBy: pubkey,
+});
+const people = [0, 1].map((n) => ({
+  id: `p${n}`,
+  name: `가짜 ${n}`,
+  updatedAt: 1,
+  updatedBy: pubkey,
+  rules: [
+    {
+      id: `r${n}`,
+      title: "가짜 불가",
+      kind: "busy",
+      startDate: date,
+      endDate: date,
+      weekday: null,
+      start: 0,
+      end: 1440,
+      exclude: [],
+    },
+  ],
+}));
+const props = {
+  month: "2026-11",
+  entries: Array.from({ length: 6 }, (_, i) => entry(i)),
+  selectedDate: date,
+  today: date,
+  people,
+  mineOnly: false,
+  showPeople: true,
+  status: "ready",
+  colorOfDept: () => "",
+  onMonth() {},
+  onSelectDate() {},
+  onMineOnly() {},
+  onShowPeople() {},
+};
+
+test("real columns resize at body widths 600/800/1200, independent of viewport", () => {
+  const measurements = measure(600);
+  const view = render(
+    React.createElement(ScheduleColumns, { "data-testid": "columns" }, "본문"),
+  );
+  const columns = view.getByTestId("columns");
+  for (const [width, stacked] of [
+    [600, true],
+    [800, true],
+    [1200, false],
+    [859, true],
+    [860, false],
+  ]) {
+    measurements.resize(width);
+    assert.equal(columns.dataset.stacked, String(stacked));
+    assert.ok(columns.classList.contains(stacked ? "flex-col" : "flex-row"));
+    assert.ok(columns.classList.contains("min-w-0"));
+  }
+  view.unmount();
+  assert.equal(measurements.observers.size, 0);
+});
+
+test("real month cells abbreviate, separate the date/count, clip bars, and recount on resize", () => {
+  const measurements = measure(85, 80);
+  const selected = [];
+  const view = render(
+    React.createElement(CalendarGrid, {
+      ...props,
+      onSelectDate: (value) => selected.push(value),
+    }),
+  );
+  const day = view.getByTestId(`team-calendar-day-${date}`);
+  const badge = within(day).getByTestId("team-calendar-busy-badge");
+  const header = within(day).getByTestId("calendar-day-header");
+  assert.equal(badge.textContent, "●2");
+  assert.match(badge.title, /종일 불가 2명/);
+  assert.equal(header.contains(badge), false);
+  assert.equal(within(header).getByTestId("calendar-more").textContent, "+4");
+  assert.equal(view.getAllByTestId("team-calendar-bar").length, 2);
+  for (const element of [badge, ...view.getAllByTestId("team-calendar-bar")])
+    for (const token of ["min-w-0", "truncate", "whitespace-nowrap"])
+      assert.ok(
+        element.classList.contains(token),
+        `${element.textContent}: ${token}`,
+      );
+  for (const bar of view.getAllByTestId("team-calendar-bar"))
+    assert.ok(bar.classList.contains("h-4"));
+  measurements.resize(110, 112);
+  assert.equal(badge.textContent, "종일 불가 2");
+  assert.equal(view.getAllByTestId("team-calendar-bar").length, 3);
+  assert.equal(within(header).getByTestId("calendar-more").textContent, "+3");
+  measurements.resize(85, 62);
+  assert.equal(view.getAllByTestId("team-calendar-bar").length, 1);
+  assert.equal(within(header).getByTestId("calendar-more").textContent, "+5");
+  fireEvent.click(day);
+  assert.deepEqual(selected, [date]);
+  assert.match(day.getAttribute("aria-label"), /일정 6개, 종일 불가 2명/);
+  view.unmount();
+  assert.equal(measurements.observers.size, 0);
+});
+
+test("actual calendar dialog keeps wrapping toolbar and applies body columns to calendar, sprint editor and people", () => {
+  env = prepareScheduleDom();
+  const measurements = measure(600);
+  localStorage.setItem("buzz-team-calendar-view", "calendar");
+  const view = render(
+    React.createElement(TeamCalendarDialog, {
+      embedded: true,
+      open: true,
+      onOpenChange() {},
+      pubkey,
+      relayUrl,
+    }),
+    { wrapper: env.Providers },
+  );
+  const toolbar = view.getByTestId("calendar-toolbar");
+  assert.ok(toolbar.classList.contains("flex-wrap"));
+  for (const width of [600, 800, 1200]) {
+    measurements.resize(width);
+    assert.equal(
+      view.getByTestId("calendar-columns").dataset.stacked,
+      String(width < 860),
+    );
+  }
+  fireEvent.click(view.getByRole("tab", { name: "스프린트", exact: true }));
+  fireEvent.click(view.getAllByTestId("sprint-add")[0]);
+  measurements.resize(600);
+  const sprint = view.getByTestId("sprint-columns");
+  assert.equal(sprint.dataset.stacked, "true");
+  assert.ok(within(sprint).getByRole("complementary", { name: "일정 편집" }));
+  fireEvent.click(view.getByRole("tab", { name: "팀원 일정", exact: true }));
+  assert.equal(view.getByTestId("availability-panel").dataset.stacked, "true");
+});

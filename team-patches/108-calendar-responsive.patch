+  // (loading state), so re-measure whenever the measured cell changes.
+  const [cell, ref] = React.useState<HTMLButtonElement | null>(null);
+  const [layout, setLayout] = React.useState({ compact: true, lanes: 2 });
+  React.useEffect(() => {
+    if (!cell) return;
+    const measure = () => {
+      const { width, height } = cell.getBoundingClientRect();
+      if (width <= 0 || height <= 0) return;

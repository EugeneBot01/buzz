new file mode 100644
index 0000000..45c6df5
--- /dev/null
+++ b/desktop/src/features/projects/projectDtagTeamNames.test.mjs
@@ -0,0 +1,20 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { projectDtagFromName } from "./projectCreation.ts";
+
+test("names in Korean get a stable ASCII id instead of an empty one", () => {
+  // Plain ASCII names are unchanged.
+  assert.equal(projectDtagFromName("bee-garden game"), "bee-garden-game");
+  assert.equal(projectDtagFromName("  My App 2 "), "my-app-2");
+  assert.equal(projectDtagFromName("a & b"), "a-b");
+  // A name with nothing to keep still has no id (the caller reports it).
+  assert.equal(projectDtagFromName("!!!"), "");
+  const korean = projectDtagFromName("버즈 프로젝트");
+  assert.match(korean, /^project-[0-9a-f]{8}$/);
+  assert.equal(projectDtagFromName(" 버즈 프로젝트 "), korean);
+  assert.notEqual(projectDtagFromName("다른 프로젝트"), korean);
+  // Mixed names keep the ASCII part and stay distinct from each other.
+  assert.match(projectDtagFromName("버즈 app"), /^app-[0-9a-f]{8}$/);
+  assert.notEqual(projectDtagFromName("버즈 app"), projectDtagFromName("다른 app"));
+});

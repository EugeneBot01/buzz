+/// Team patch: extra MCP servers for the agent, as a JSON array of
+/// `{ "name", "command", "args": [..], "env": { .. } }`. The desktop app sets
+/// it from the agent's "연결" settings; it is an ordinary per-agent env var.
+const TEAM_MCP_SERVERS_ENV: &str = "BUZZ_TEAM_MCP_SERVERS";
+const MAX_TEAM_MCP_SERVERS: usize = 16;
+
+/// Parses [`TEAM_MCP_SERVERS_ENV`]. Malformed input yields no servers and a
+/// malformed entry is skipped: a bad setting must not stop the agent.
+fn parse_team_mcp_servers(raw: &str) -> Vec<McpServer> {
+    let Ok(serde_json::Value::Array(items)) = serde_json::from_str::<serde_json::Value>(raw)
+    else {
+        return Vec::new();
+    };
+    let mut servers: Vec<McpServer> = Vec::new();
+    for item in items {
+        if servers.len() >= MAX_TEAM_MCP_SERVERS {
+            break;
+        }
+        let Some(name) = item.get("name").and_then(|v| v.as_str()).map(str::trim) else {
+            continue;
+        };
+        let Some(command) = item.get("command").and_then(|v| v.as_str()).map(str::trim) else {
+            continue;
+        };
+        if name.is_empty() || command.is_empty() || servers.iter().any(|s| s.name == name) {
+            continue;
+        }
+        let args: Vec<String> = item
+            .get("args")
+            .and_then(|v| v.as_array())
+            .map(|values| {
+                values
+                    .iter()
+                    .filter_map(|v| v.as_str().map(str::to_string))
+                    .collect()
+            })
+            .unwrap_or_default();
+        let env: Vec<EnvVar> = item
+            .get("env")
+            .and_then(|v| v.as_object())
+            .map(|map| {
+                map.iter()
+                    .filter_map(|(key, value)| {
+                        value.as_str().map(|value| EnvVar {
+                            name: key.clone(),
+                            value: value.to_string(),
+                        })
+                    })
+                    .collect()
+            })
+            .unwrap_or_default();
+        servers.push(McpServer {
+            name: name.to_string(),
+            command: command.to_string(),
+            args,
+            env,
+        });
+    }
+    servers
+}
+
 fn build_mcp_servers(config: &Config) -> Vec<McpServer> {
+    let mut servers = build_primary_mcp_servers(config);
+    if let Ok(raw) = std::env::var(TEAM_MCP_SERVERS_ENV) {
+        for server in parse_team_mcp_servers(&raw) {
+            // The harness's own server keeps its name.
+            if !servers.iter().any(|existing| existing.name == server.name) {
+                servers.push(server);
+            }
+        }
+    }
+    servers
+}

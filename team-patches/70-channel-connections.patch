diff --git a/desktop/src/features/team-links/lib/mcpCatalog.ts b/desktop/src/features/team-links/lib/mcpCatalog.ts
new file mode 100644
index 0000000..75adfa9
--- /dev/null
+++ b/desktop/src/features/team-links/lib/mcpCatalog.ts
@@ -0,0 +1,174 @@
+/**
+ * MCP servers for agents (team patch). The agent harness (`buzz-acp`) reads
+ * this environment variable and hands the servers to the agent together with
+ * its own, whatever runtime the agent uses (Claude, Codex, ...): MCP is one
+ * standard, and the harness passes servers to every runtime the same way.
+ */
+export const TEAM_MCP_SERVERS_ENV = "BUZZ_TEAM_MCP_SERVERS";
+export const MAX_TEAM_MCP_SERVERS = 16;
+
+/** One MCP server started as a local command (stdio). */
+export type McpServerSpec = {
+  name: string;
+  command: string;
+  args: string[];
+  env: Record<string, string>;
+};
+
+const NAME_PATTERN = /^[a-z0-9][a-z0-9_-]{0,31}$/;
+
+/**
+ * A remote (https) MCP server reached through `mcp-remote`, which bridges it
+ * to a local command and opens the browser to sign in the first time.
+ */
+export function remoteMcpServer(name: string, url: string): McpServerSpec {
+  return { name, command: "npx", args: ["-y", "mcp-remote", url], env: {} };
+}
+
+/** The address of a server made by `remoteMcpServer`, else `null`. */
+export function remoteUrlOf(server: McpServerSpec): string | null {
+  return server.command === "npx" &&
+    server.args.length === 3 &&
+    server.args[0] === "-y" &&
+    server.args[1] === "mcp-remote"
+    ? (server.args[2] ?? null)
+    : null;
+}
+
+export type McpPreset = {
+  server: McpServerSpec;
+  label: string;
+  description: string;
+};
+
+/**
+ * Servers offered as a tick box. Notion, Atlassian and Linear sign in through
+ * the browser the first time. Figma's hosted server only admits clients Figma
+ * has approved (it refuses `mcp-remote`), so Figma goes through the server the
+ * Figma desktop app runs on this computer once it is switched on there.
+ */
+export const MCP_PRESETS: McpPreset[] = [
+  {
+    server: {
+      name: "figma",
+      command: "npx",
+      args: ["-y", "mcp-remote", "http://127.0.0.1:3845/mcp", "--allow-http"],
+      env: {},
+    },
+    label: "피그마 (데스크톱 앱)",
+    description:
+      "피그마 앱을 켜고, 앱 설정에서 MCP 서버를 켜 두어야 합니다.",
+  },
+  {
+    server: remoteMcpServer("notion", "https://mcp.notion.com/mcp"),
+    label: "노션",
+    description: "페이지를 찾고 읽고 씁니다.",
+  },
+  {
+    server: remoteMcpServer("atlassian", "https://mcp.atlassian.com/v1/sse"),
+    label: "지라 · 컨플루언스",
+    description: "이슈와 문서를 찾고 만듭니다.",
+  },
+  {
+    server: remoteMcpServer("linear", "https://mcp.linear.app/mcp"),
+    label: "리니어",
+    description: "이슈를 찾고 만듭니다.",
+  },
+];
+
+function readServer(raw: unknown): McpServerSpec | null {
+  if (!raw || typeof raw !== "object") return null;
+  const value = raw as Record<string, unknown>;
+  if (typeof value.name !== "string" || !NAME_PATTERN.test(value.name))
+    return null;
+  if (typeof value.command !== "string" || value.command.trim().length === 0)
+    return null;
+  const args = Array.isArray(value.args)
+    ? value.args.filter((arg): arg is string => typeof arg === "string")
+    : [];
+  const env: Record<string, string> = {};
+  if (value.env && typeof value.env === "object") {
+    for (const [key, item] of Object.entries(
+      value.env as Record<string, unknown>,
+    ))
+      if (typeof item === "string") env[key] = item;
+  }
+  return { name: value.name, command: value.command.trim(), args, env };
+}
+
+/**
+ * `servers` with every server that shares a preset's name replaced by the
+ * preset as it is today, so a preset whose address was corrected reaches
+ * agents that ticked the old one the next time they are saved.
+ */
+export function withCurrentPresets(servers: McpServerSpec[]): McpServerSpec[] {
+  return servers.map(
+    (server) =>
+      MCP_PRESETS.find((preset) => preset.server.name === server.name)
+        ?.server ?? server,
+  );
+}
+
+/** The servers stored in an agent's environment variable. */
+export function parseMcpServers(raw: string | undefined): McpServerSpec[] {
+  if (!raw) return [];
+  try {
+    const json: unknown = JSON.parse(raw);
+    if (!Array.isArray(json)) return [];
+    const servers: McpServerSpec[] = [];
+    for (const item of json) {
+      const server = readServer(item);
+      if (server && !servers.some((other) => other.name === server.name))
+        servers.push(server);
+    }
+    return servers.slice(0, MAX_TEAM_MCP_SERVERS);
+  } catch {
+    return [];
+  }
+}
+
+export const serializeMcpServers = (servers: McpServerSpec[]) =>
+  JSON.stringify(servers);
+
+/**
+ * An agent's environment with its MCP servers replaced (the variable is
+ * removed when there are none). Everything else is kept.
+ */
+export function envWithMcpServers(
+  env: Record<string, string>,
+  servers: McpServerSpec[],
+): Record<string, string> {
+  const { [TEAM_MCP_SERVERS_ENV]: _old, ...rest } = env;
+  return servers.length === 0
+    ? rest
+    : { ...rest, [TEAM_MCP_SERVERS_ENV]: serializeMcpServers(servers) };
+}
+
+/**
+ * The server a person described by hand: a name and either an https address
+ * or a command line ("npx -y some-mcp --flag"). `error` says what to fix.
+ */
+export function customMcpServer(
+  nameRaw: string,
+  target: string,
+): { server: McpServerSpec } | { error: string } {
+  const name = nameRaw.trim().toLowerCase();
+  if (!NAME_PATTERN.test(name))
+    return {
+      error: "이름은 영어 소문자·숫자·-·_ 만 쓸 수 있습니다 (예: my-tool).",
+    };
+  const text = target.trim();
+  if (text.length === 0) return { error: "주소나 실행 명령을 적어 주세요." };
+  if (/^https:\/\//i.test(text)) {
+    try {
+      return { server: remoteMcpServer(name, new URL(text).toString()) };
+    } catch {
+      return { error: "주소를 확인해 주세요." };
+    }
+  }
+  if (/^http:\/\//i.test(text))
+    return { error: "https:// 로 시작하는 주소만 쓸 수 있습니다." };
+  const [command, ...args] = text.split(/\s+/);
+  if (!command) return { error: "실행 명령을 적어 주세요." };
+  return { server: { name, command, args, env: {} } };
+}

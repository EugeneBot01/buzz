+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  MCP_PRESETS,
+  TEAM_MCP_SERVERS_ENV,
+  customMcpServer,
+  envWithMcpServers,
+  parseMcpServers,
+  remoteUrlOf,
+  serializeMcpServers,
+  withCurrentPresets,
+} from "./mcpCatalog.ts";
+import {
+  decodeTeamLinks,
+  encodeTeamLinks,
+  guessLinkKind,
+  linksForChannel,
+  mergeTeamLinkEvents,
+  mergeTeamLinks,
+  normalizeLinkUrl,
+  validateTeamLink,
+} from "./teamLinks.ts";
+
+const A = "a".repeat(64);
+const B = "b".repeat(64);
+const link = (fields) => ({
+  id: "l1",
+  kind: "meet",
+  title: "회의방",
+  url: "https://meet.google.com/abc-defg-hij",
+  updatedAt: 1,
+  updatedBy: A,
+  ...fields,
+});
+
+test("only https addresses are accepted, with or without the scheme typed", () => {
+  assert.equal(
+    normalizeLinkUrl(" meet.google.com/abc-defg-hij "),
+    "https://meet.google.com/abc-defg-hij",
+  );
+  assert.equal(normalizeLinkUrl("http://example.com"), null);
+  assert.equal(normalizeLinkUrl("javascript:alert(1)"), null);
+  assert.equal(normalizeLinkUrl("file:///etc/passwd"), null);
+  assert.equal(normalizeLinkUrl("localhost"), null);
+  assert.equal(normalizeLinkUrl(""), null);
+  assert.equal(guessLinkKind("https://meet.google.com/x"), "meet");
+  assert.equal(guessLinkKind("https://www.figma.com/design/x"), "figma");
+  assert.equal(guessLinkKind("https://notfigma.com/"), "other");
+  assert.match(validateTeamLink({ title: "", url: "https://a.b", kind: "other" }), /이름/);
+  assert.match(validateTeamLink({ title: "x", url: "ftp://a.b", kind: "other" }), /https/);
+});
+
+test("shortcuts round-trip, merge by last writer and filter by channel", () => {
+  const own = link({ channelId: "c1" });
+  const wide = link({ id: "l2", kind: "figma", title: "디자인", url: "https://www.figma.com/file/x" });
+  const decoded = decodeTeamLinks(encodeTeamLinks({ l1: own, l2: wide }));
+  assert.deepEqual(decoded, { l1: own, l2: wide });
+  // A stored link with a bad address is dropped.
+  assert.deepEqual(
+    decodeTeamLinks(JSON.stringify({ links: { x: link({ url: "javascript:1" }) } })),
+    {},
+  );
+  const removed = link({ channelId: "c1", updatedAt: 2, updatedBy: B, title: "", deleted: true });
+  const merged = mergeTeamLinks({ l1: own, l2: wide }, { l1: removed });
+  assert.equal(merged.l1.deleted, true);
+  assert.deepEqual(linksForChannel(merged, "c1").map((item) => item.id), ["l2"]);
+  assert.deepEqual(
+    linksForChannel({ l1: own, l2: wide }, "c1").map((item) => item.id),
+    ["l1", "l2"],
+  );
+  assert.deepEqual(
+    linksForChannel({ l1: own, l2: wide }, "other").map((item) => item.id),
+    ["l2"],
+  );
+  const event = (pubkey, created_at, links) => ({
+    id: `${pubkey.slice(0, 4)}${created_at}`,
+    pubkey,
+    created_at,
+    kind: 30078,
+    tags: [["d", "dtag"]],
+    content: JSON.stringify({ v: 1, links }),
+    sig: "",
+  });
+  const state = mergeTeamLinkEvents(
+    [event(A, 5, { l1: own }), event(B, 7, { l1: removed })],
+    "dtag",
+    A,
+  );
+  assert.equal(state.ownCreatedAt, 5);
+  assert.equal(state.links.l1.deleted, true);
+});
+
+test("MCP servers are stored in one environment variable", () => {
+  const figma = MCP_PRESETS[1].server;
+  assert.equal(remoteUrlOf(figma), "https://mcp.notion.com/mcp");
+  // The Figma preset is the desktop app's local server, not a hosted address.
+  assert.equal(remoteUrlOf(MCP_PRESETS[0].server), null);
+  const stale = { name: "figma", command: "npx", args: ["-y", "mcp-remote", "https://mcp.figma.com/mcp"], env: {} };
+  assert.deepEqual(withCurrentPresets([stale, { name: "mine", command: "x", args: [], env: {} }]), [
+    MCP_PRESETS[0].server,
+    { name: "mine", command: "x", args: [], env: {} },
+  ]);
+  const env = envWithMcpServers({ OTHER: "1" }, [figma]);
+  assert.equal(env.OTHER, "1");
+  assert.deepEqual(parseMcpServers(env[TEAM_MCP_SERVERS_ENV]), [figma]);
+  assert.deepEqual(envWithMcpServers(env, []), { OTHER: "1" });
+  assert.deepEqual(parseMcpServers("not json"), []);
+  assert.deepEqual(
+    parseMcpServers(serializeMcpServers([figma, figma, { name: "Bad Name", command: "x", args: [], env: {} }])),
+    [figma],
+  );
+  assert.deepEqual(customMcpServer("My-Tool", "https://example.com/mcp"), {
+    server: { name: "my-tool", command: "npx", args: ["-y", "mcp-remote", "https://example.com/mcp"], env: {} },
+  });
+  assert.deepEqual(customMcpServer("local", "npx -y some-mcp --flag"), {
+    server: { name: "local", command: "npx", args: ["-y", "some-mcp", "--flag"], env: {} },
+  });
+  assert.ok("error" in customMcpServer("한글", "https://a.b"));
+  assert.ok("error" in customMcpServer("x", "http://a.b"));
+  assert.ok("error" in customMcpServer("x", ""));
+});

index 0000000..352c6f3
--- /dev/null
+++ b/desktop/src/features/team-links/lib/teamLinks.ts
@@ -0,0 +1,233 @@
+import type { RelayEvent } from "@/shared/api/types";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+
+/**
+ * Channel shortcuts (team patch): links a team opens straight from a channel,
+ * such as its Google Meet room or its Figma file. A shortcut belongs to one
+ * channel or to the whole community.
+ *
+ * Same sharing model as the team calendar: each member publishes their merged
+ * copy as a plaintext kind 30078 event and readers merge every member's copy,
+ * last writer wins per shortcut.
+ */
+export const TEAM_LINKS_D_TAG = "team-links";
+export const MAX_TEAM_LINKS_AUTHORS = 200;
+export const MAX_TEAM_LINKS_CONTENT_BYTES = 60_000;
+export const MAX_LINK_TITLE_LENGTH = 40;
+export const MAX_LINK_URL_LENGTH = 500;
+
+export const LINK_KINDS = ["meet", "figma", "other"] as const;
+export type LinkKind = (typeof LINK_KINDS)[number];
+
+export type TeamLink = {
+  id: string;
+  kind: LinkKind;
+  title: string;
+  url: string;
+  /** The channel it shows in; absent = every channel of the community. */
+  channelId?: string;
+  updatedAt: number;
+  updatedBy: string;
+  deleted?: true;
+};
+
+export type TeamLinks = Record<string, TeamLink>;
+
+export function teamLinksDTag(relayUrl: string): string {
+  return `${TEAM_LINKS_D_TAG}:${normalizeRelayUrl(relayUrl)}`;
+}
+
+const isPubkey = (value: unknown): value is string =>
+  typeof value === "string" && /^[0-9a-f]{64}$/.test(value);
+
+/** The address as it is stored, or `null` when it is not a usable https link. */
+export function normalizeLinkUrl(raw: string): string | null {
+  const text = raw.trim();
+  if (text.length === 0 || text.length > MAX_LINK_URL_LENGTH) return null;
+  // People paste "meet.google.com/abc-defg-hij" without the scheme.
+  const withScheme = /^[a-z][a-z0-9+.-]*:/i.test(text) ? text : `https://${text}`;
+  try {
+    const url = new URL(withScheme);
+    // Only https: a shortcut is opened with one click, by anyone in the team.
+    if (url.protocol !== "https:" || !url.hostname.includes(".")) return null;
+    return url.toString();
+  } catch {
+    return null;
+  }
+}
+
+/** The kind an address most likely is, to pick an icon and a default name. */
+export function guessLinkKind(url: string): LinkKind {
+  try {
+    const host = new URL(url).hostname.toLowerCase();
+    if (host === "meet.google.com") return "meet";
+    if (host === "figma.com" || host.endsWith(".figma.com")) return "figma";
+  } catch {
+    // Not an address yet.
+  }
+  return "other";
+}
+
+export const LINK_KIND_LABELS: Record<LinkKind, string> = {
+  meet: "구글 미트",
+  figma: "피그마",
+  other: "기타 링크",
+};
+
+export type TeamLinkInput = {
+  title: string;
+  url: string;
+  kind: LinkKind;
+  channelId?: string;
+};
+
+/** Why a shortcut cannot be saved (a message for the person), or `null`. */
+export function validateTeamLink(input: TeamLinkInput): string | null {
+  if (input.title.trim().length === 0) return "이름을 적어 주세요.";
+  if (normalizeLinkUrl(input.url) === null)
+    return "https:// 로 시작하는 주소를 넣어 주세요.";
+  return null;
+}
+
+function readLink(id: string, raw: unknown): TeamLink | null {
+  if (!raw || typeof raw !== "object") return null;
+  const value = raw as Record<string, unknown>;
+  if (id.length === 0 || id.length > 64) return null;
+  if (
+    typeof value.updatedAt !== "number" ||
+    !Number.isFinite(value.updatedAt) ||
+    value.updatedAt <= 0 ||
+    !isPubkey(value.updatedBy)
+  )
+    return null;
+  const deleted = value.deleted === true;
+  const url = typeof value.url === "string" ? normalizeLinkUrl(value.url) : null;
+  const title =
+    typeof value.title === "string"
+      ? value.title.trim().slice(0, MAX_LINK_TITLE_LENGTH)
+      : "";
+  if (!deleted && (url === null || title.length === 0)) return null;
+  const link: TeamLink = {
+    id,
+    kind: (LINK_KINDS as readonly unknown[]).includes(value.kind)
+      ? (value.kind as LinkKind)
+      : "other",
+    title,
+    url: url ?? "",
+    updatedAt: value.updatedAt,
+    updatedBy: value.updatedBy,
+  };
+  if (typeof value.channelId === "string" && value.channelId.length <= 64)
+    link.channelId = value.channelId;
+  if (deleted) link.deleted = true;
+  return link;
+}
+
+/** Parses one member's document. Malformed shortcuts are skipped. */
+export function decodeTeamLinks(content: string): TeamLinks {
+  let json: unknown = null;
+  try {
+    json = JSON.parse(content);
+  } catch {
+    return {};
+  }
+  if (!json || typeof json !== "object") return {};
+  const links = (json as { links?: unknown }).links;
+  if (!links || typeof links !== "object") return {};
+  const result: TeamLinks = {};
+  for (const [id, raw] of Object.entries(links as Record<string, unknown>)) {
+    const link = readLink(id, raw);
+    if (link) result[id] = link;
+  }
+  return result;
+}
+
+/** The document to publish, or `null` when it cannot fit. */
+export function encodeTeamLinks(links: TeamLinks): string | null {
+  const out: Record<string, Omit<TeamLink, "id">> = {};
+  for (const id of Object.keys(links).sort()) {
+    const { id: _id, ...rest } = links[id] as TeamLink;
+    out[id] = rest;
+  }
+  const content = JSON.stringify({ v: 1, links: out });
+  return new TextEncoder().encode(content).length <=
+    MAX_TEAM_LINKS_CONTENT_BYTES
+    ? content
+    : null;
+}
+
+const wins = (candidate: TeamLink, current: TeamLink) =>
+  candidate.updatedAt !== current.updatedAt
+    ? candidate.updatedAt > current.updatedAt
+    : candidate.updatedBy !== current.updatedBy
+      ? candidate.updatedBy > current.updatedBy
+      : candidate.deleted === true && current.deleted !== true;
+
+/** Merges copies shortcut by shortcut. Returns `base` when nothing changed. */
+export function mergeTeamLinks(
+  base: TeamLinks,
+  ...others: TeamLinks[]
+): TeamLinks {
+  let result = base;
+  for (const other of others) {
+    for (const [id, link] of Object.entries(other)) {
+      const current = result[id];
+      if (current && !wins(link, current)) continue;
+      if (result === base) result = { ...base };
+      result[id] = link;
+    }
+  }
+  return result;
+}
+
+/** Every member's newest event merged, plus `pubkey`'s own `created_at`. */
+export function mergeTeamLinkEvents(
+  events: RelayEvent[],
+  dTag: string,
+  pubkey: string,
+): { links: TeamLinks; ownCreatedAt: number } {
+  const newest = new Map<string, RelayEvent>();
+  for (const event of events) {
+    const d = event.tags.filter((tag) => tag[0] === "d");
+    if (d.length !== 1 || d[0]?.[1] !== dTag) continue;
+    const current = newest.get(event.pubkey);
+    if (
+      current &&
+      !(
+        event.created_at > current.created_at ||
+        (event.created_at === current.created_at && event.id < current.id)
+      )
+    )
+      continue;
+    newest.set(event.pubkey, event);
+  }
+  let links: TeamLinks = {};
+  let ownCreatedAt = 0;
+  for (const event of newest.values()) {
+    links = mergeTeamLinks(links, decodeTeamLinks(event.content));
+    if (event.pubkey === pubkey) ownCreatedAt = event.created_at;
+  }
+  return { links, ownCreatedAt };
+}
+
+/**
+ * The live shortcuts a channel shows: its own first, then the community-wide
+ * ones, each group by name.
+ */
+export function linksForChannel(
+  links: TeamLinks,
+  channelId: string,
+): TeamLink[] {
+  return Object.values(links)
+    .filter(
+      (link) =>
+        !link.deleted &&
+        (link.channelId === undefined || link.channelId === channelId),
+    )
+    .sort(
+      (a, b) =>
+        Number(a.channelId === undefined) - Number(b.channelId === undefined) ||
+        a.title.localeCompare(b.title, "ko") ||
+        a.id.localeCompare(b.id),
+    );
+}
diff --git a/desktop/src/features/team-links/lib/useTeamLinks.ts b/desktop/src/features/team-links/lib/useTeamLinks.ts
new file mode 100644
index 0000000..65c18ef
--- /dev/null
+++ b/desktop/src/features/team-links/lib/useTeamLinks.ts
@@ -0,0 +1,216 @@
+import * as React from "react";
+
+import { relayClient } from "@/shared/api/relayClient";
+import { signRelayEvent } from "@/shared/api/tauri";
+import type { RelayEvent } from "@/shared/api/types";
+import { KIND_CHANNEL_SECTIONS } from "@/shared/constants/kinds";
+import {
+  MAX_LINK_TITLE_LENGTH,
+  MAX_TEAM_LINKS_AUTHORS,
+  TEAM_LINKS_D_TAG,
+  type TeamLink,
+  type TeamLinkInput,
+  type TeamLinks,
+  decodeTeamLinks,
+  encodeTeamLinks,
+  mergeTeamLinkEvents,
+  mergeTeamLinks,
+  normalizeLinkUrl,
+  teamLinksDTag,
+  validateTeamLink,
+} from "./teamLinks";
+
+export type TeamLinksStatus = "loading" | "ready" | "error";
+
+/**
+ * The community's channel shortcuts for one pubkey + relay scope: every
+ * member's copy merged, kept live, and this member's edits published.
+ */
+export function useTeamLinks(pubkey: string, relayUrl: string) {
+  const scope = `${pubkey}|${relayUrl}`;
+  const [state, setState] = React.useState<{
+    scope: string;
+    links: TeamLinks;
+    status: TeamLinksStatus;
+  }>({ scope, links: {}, status: "loading" });
+  const current =
+    state.scope === scope
+      ? state
+      : { scope, links: {} as TeamLinks, status: "loading" as const };
+
+  const liveRef = React.useRef<{
+    scope: string;
+    cancelled: boolean;
+    links: TeamLinks;
+    ownCreatedAt: number;
+    queue: Promise<void>;
+  } | null>(null);
+
+  React.useEffect(() => {
+    const live = {
+      scope,
+      cancelled: false,
+      links: {} as TeamLinks,
+      ownCreatedAt: 0,
+      queue: Promise.resolve(),
+    };
+    liveRef.current = live;
+    setState({ scope, links: {}, status: "loading" });
+
+    const dTag = teamLinksDTag(relayUrl);
+    const filter = { kinds: [KIND_CHANNEL_SECTIONS], "#d": [dTag] };
+    const apply = (links: TeamLinks, status?: TeamLinksStatus) => {
+      live.links = links;
+      setState((previous) => ({
+        scope,
+        links,
+        status:
+          status ?? (previous.scope === scope ? previous.status : "ready"),
+      }));
+    };
+
+    const load = () =>
+      void relayClient
+        .fetchEvents({ ...filter, limit: MAX_TEAM_LINKS_AUTHORS })
+        .then(
+          (events) => {
+            if (live.cancelled) return;
+            const merged = mergeTeamLinkEvents(events, dTag, pubkey);
+            if (merged.ownCreatedAt > live.ownCreatedAt)
+              live.ownCreatedAt = merged.ownCreatedAt;
+            apply(mergeTeamLinks(live.links, merged.links), "ready");
+          },
+          () => {
+            if (live.cancelled) return;
+            setState((previous) =>
+              previous.scope === scope && previous.status === "loading"
+                ? { ...previous, status: "error" }
+                : previous,
+            );
+          },
+        );
+
+    const ingest = (event: RelayEvent) => {
+      if (live.cancelled) return;
+      const d = event.tags.filter((tag) => tag[0] === "d");
+      if (d.length !== 1 || d[0]?.[1] !== dTag) return;
+      if (event.pubkey === pubkey && event.created_at > live.ownCreatedAt)
+        live.ownCreatedAt = event.created_at;
+      const merged = mergeTeamLinks(
+        live.links,
+        decodeTeamLinks(event.content),
+      );
+      if (merged !== live.links) apply(merged);
+    };
+
+    let unsubLive: (() => Promise<void>) | null = null;
+    void relayClient
+      .subscribeLive({ ...filter, limit: 0 }, ingest)
+      .then((dispose) => {
+        if (live.cancelled) void dispose();
+        else unsubLive = dispose;
+      })
+      .catch(() => {});
+    const unsubReconnect = relayClient.subscribeToReconnects(load);
+    load();
+
+    return () => {
+      live.cancelled = true;
+      unsubReconnect();
+      if (unsubLive) void unsubLive();
+    };
+  }, [scope, pubkey, relayUrl]);
+
+  /** Applies `change` locally, then publishes this member's copy. */
+  const commit = React.useCallback(
+    (change: (links: TeamLinks) => TeamLinks): Promise<void> => {
+      const live = liveRef.current;
+      if (!live || live.cancelled || live.scope !== scope)
+        return Promise.reject(new Error("연결을 아직 불러오는 중입니다."));
+      const next = change(live.links);
+      live.links = next;
+      setState((previous) => ({
+        scope,
+        links: next,
+        status: previous.scope === scope ? previous.status : "ready",
+      }));
+      const run = async () => {
+        if (live.cancelled) return;
+        const content = encodeTeamLinks(live.links);
+        if (content === null)
+          throw new Error("연결이 너무 많아 더 저장할 수 없습니다.");
+        const createdAt = Math.max(
+          Math.floor(Date.now() / 1_000),
+          live.ownCreatedAt + 1,
+        );
+        const event = await signRelayEvent({
+          kind: KIND_CHANNEL_SECTIONS,
+          content,
+          createdAt,
+          tags: [
+            ["d", teamLinksDTag(relayUrl)],
+            ["t", TEAM_LINKS_D_TAG],
+          ],
+        });
+        try {
+          await relayClient.publishEvent(
+            event,
+            "연결을 저장하는 데 시간이 너무 오래 걸립니다.",
+            "연결을 저장하지 못했습니다.",
+            () => !live.cancelled,
+          );
+        } catch (error) {
+          if (!String((error as Error)?.message).startsWith("duplicate:"))
+            throw error;
+        }
+        live.ownCreatedAt = createdAt;
+      };
+      const result = live.queue.then(run, run);
+      live.queue = result.catch(() => {});
+      return result;
+    },
+    [scope, relayUrl],
+  );
+
+  const saveLink = React.useCallback(
+    (input: TeamLinkInput & { id?: string }): Promise<void> => {
+      const problem = validateTeamLink(input);
+      const url = normalizeLinkUrl(input.url);
+      if (problem || url === null)
+        return Promise.reject(new Error(problem ?? "주소를 확인해 주세요."));
+      return commit((links) => {
+        const previous = input.id ? links[input.id] : undefined;
+        const link: TeamLink = {
+          id: input.id ?? crypto.randomUUID(),
+          kind: input.kind,
+          title: input.title.trim().slice(0, MAX_LINK_TITLE_LENGTH),
+          url,
+          updatedAt: Math.max(Date.now(), (previous?.updatedAt ?? 0) + 1),
+          updatedBy: pubkey,
+        };
+        if (input.channelId) link.channelId = input.channelId;
+        return mergeTeamLinks(links, { [link.id]: link });
+      });
+    },
+    [commit, pubkey],
+  );
+
+  const deleteLink = React.useCallback(
+    (id: string): Promise<void> =>
+      commit((links) => {
+        const link = links[id];
+        if (!link || link.deleted) return links;
+        const gone: TeamLink = {
+          ...link,
+          title: "",
+          updatedAt: Math.max(Date.now(), link.updatedAt + 1),
+          updatedBy: pubkey,
+          deleted: true,
+        };
+        return mergeTeamLinks(links, { [id]: gone });
+      }),
+    [commit, pubkey],
+  );
+
+  return { links: current.links, status: current.status, saveLink, deleteLink };
+}
diff --git a/desktop/src/features/team-links/ui/AgentMcpSection.tsx b/desktop/src/features/team-links/ui/AgentMcpSection.tsx
new file mode 100644
index 0000000..6015d8b
--- /dev/null
+++ b/desktop/src/features/team-links/ui/AgentMcpSection.tsx
@@ -0,0 +1,275 @@
+import * as React from "react";
+import { toast } from "sonner";
+
+import {
+  useManagedAgentsQuery,
+  useStartManagedAgentMutation,
+  useStopManagedAgentMutation,
+  useUpdateManagedAgentMutation,
+} from "@/features/agents/hooks";
+import { useChannelMembersQuery } from "@/features/channels/hooks";
+import {
+  MAX_TEAM_MCP_SERVERS,
+  MCP_PRESETS,
+  type McpServerSpec,
+  TEAM_MCP_SERVERS_ENV,
+  customMcpServer,
+  envWithMcpServers,
+  parseMcpServers,
+  remoteUrlOf,
+  withCurrentPresets,
+} from "@/features/team-links/lib/mcpCatalog";
+import type { ManagedAgent } from "@/shared/api/types";
+import { Button } from "@/shared/ui/button";
+import { Checkbox } from "@/shared/ui/checkbox";
+import { Input } from "@/shared/ui/input";
+
+const errorText = (error: unknown, fallback: string) =>
+  error instanceof Error && error.message ? error.message : fallback;
+
+const sameServers = (a: McpServerSpec[], b: McpServerSpec[]) =>
+  JSON.stringify([...a].sort((x, y) => x.name.localeCompare(y.name))) ===
+  JSON.stringify([...b].sort((x, y) => x.name.localeCompare(y.name)));
+
+/** The MCP servers of one of this person's agents, with save and restart. */
+function AgentMcpEditor({ agent }: { agent: ManagedAgent }) {
+  const saved = React.useMemo(
+    () => parseMcpServers(agent.envVars[TEAM_MCP_SERVERS_ENV]),
+    [agent.envVars],
+  );
+  // Opens on today's presets: a corrected preset shows as an unsaved change.
+  const [servers, setServers] = React.useState(() =>
+    withCurrentPresets(saved),
+  );
+  const [name, setName] = React.useState("");
+  const [target, setTarget] = React.useState("");
+  const [busy, setBusy] = React.useState(false);
+  // Set after a save while the agent runs: it must restart to pick them up.
+  const [restartPending, setRestartPending] = React.useState(false);
+  const update = useUpdateManagedAgentMutation();
+  const stop = useStopManagedAgentMutation();
+  const start = useStartManagedAgentMutation();
+
+  const dirty = !sameServers(servers, saved);
+  const presetNames = new Set(MCP_PRESETS.map((preset) => preset.server.name));
+  const custom = servers.filter((server) => !presetNames.has(server.name));
+  const full = servers.length >= MAX_TEAM_MCP_SERVERS;
+
+  const addCustom = () => {
+    const result = customMcpServer(name, target);
+    if ("error" in result) {
+      toast.error(result.error);
+      return;
+    }
+    if (servers.some((server) => server.name === result.server.name)) {
+      toast.error("같은 이름의 MCP가 이미 있습니다.");
+      return;
+    }
+    setServers([...servers, result.server]);
+    setName("");
+    setTarget("");
+  };
+
+  const save = async () => {
+    setBusy(true);
+    try {
+      await update.mutateAsync({
+        pubkey: agent.pubkey,
+        envVars: envWithMcpServers(agent.envVars, servers),
+      });
+      setRestartPending(agent.status === "running");
+      toast.success(
+        agent.status === "running"
+          ? "저장했습니다. 에이전트를 다시 시작하면 적용됩니다."
+          : "저장했습니다. 에이전트를 시작하면 적용됩니다.",
+      );
+    } catch (error) {
+      toast.error(errorText(error, "MCP 설정을 저장하지 못했습니다."));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const restart = async () => {
+    setBusy(true);
+    try {
+      await stop.mutateAsync(agent.pubkey);
+      await start.mutateAsync(agent.pubkey);
+      setRestartPending(false);
+      toast.success("에이전트를 다시 시작했습니다.");
+    } catch (error) {
+      toast.error(errorText(error, "에이전트를 다시 시작하지 못했습니다."));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <li
+      className="flex flex-col gap-2 rounded-lg border border-border/60 px-3 py-2"
+      data-testid="team-mcp-agent"
+    >
+      <p className="text-sm font-medium">
+        {agent.name}
+        <span className="ml-2 text-xs font-normal text-muted-foreground">
+          {agent.status === "running" ? "실행 중" : "꺼져 있음"}
+        </span>
+      </p>
+      <div className="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
+        {MCP_PRESETS.map((preset) => {
+          const on = servers.some(
+            (server) => server.name === preset.server.name,
+          );
+          return (
+            <label
+              className="flex items-start gap-2 text-xs"
+              key={preset.server.name}
+            >
+              <Checkbox
+                checked={on}
+                className="mt-0.5"
+                disabled={busy || (!on && full)}
+                onCheckedChange={(checked) =>
+                  setServers(
+                    checked === true
+                      ? [...servers, preset.server]
+                      : servers.filter(
+                          (server) => server.name !== preset.server.name,
+                        ),
+                  )
+                }
+              />
+              <span>
+                <span className="font-medium">{preset.label}</span>
+                <span className="block text-muted-foreground">
+                  {preset.description}
+                </span>
+              </span>
+            </label>
+          );
+        })}
+      </div>
+      {custom.length > 0 ? (
+        <ul className="flex flex-col gap-1 text-xs">
+          {custom.map((server) => (
+            <li className="flex items-center gap-2" key={server.name}>
+              <span className="min-w-0 flex-1 truncate">
+                <span className="font-medium">{server.name}</span>{" "}
+                <span className="text-muted-foreground">
+                  {remoteUrlOf(server) ??
+                    [server.command, ...server.args].join(" ")}
+                </span>
+              </span>
+              <Button
+                disabled={busy}
+                onClick={() =>
+                  setServers(
+                    servers.filter((other) => other.name !== server.name),
+                  )
+                }
+                size="xs"
+                type="button"
+                variant="ghost"
+              >
+                빼기
+              </Button>
+            </li>
+          ))}
+        </ul>
+      ) : null}
+      <div className="flex items-end gap-2">
+        <label className="flex w-28 flex-col gap-1 text-xs">
+          직접 추가: 이름
+          <Input
+            onChange={(event) => setName(event.target.value)}
+            placeholder="my-tool"
+            value={name}
+          />
+        </label>
+        <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+          주소 (https://…) 또는 실행 명령
+          <Input
+            onChange={(event) => setTarget(event.target.value)}
+            placeholder="https://example.com/mcp"
+            value={target}
+          />
+        </label>
+        <Button
+          disabled={busy || full || !name.trim() || !target.trim()}
+          onClick={addCustom}
+          size="sm"
+          type="button"
+          variant="outline"
+        >
+          추가
+        </Button>
+      </div>
+      <div className="flex items-center justify-end gap-2">
+        {restartPending && !dirty ? (
+          <Button
+            data-testid="team-mcp-restart"
+            disabled={busy}
+            onClick={() => void restart()}
+            size="sm"
+            type="button"
+            variant="outline"
+          >
+            에이전트 다시 시작
+          </Button>
+        ) : null}
+        <Button
+          data-testid="team-mcp-save"
+          disabled={busy || !dirty}
+          onClick={() => void save()}
+          size="sm"
+          type="button"
+        >
+          저장
+        </Button>
+      </div>
+    </li>
+  );
+}
+
+/**
+ * MCP servers for the agents of a channel (team patch). Only agents this
+ * person runs on this computer are listed: an agent's servers start on the
+ * computer the agent runs on.
+ */
+export function AgentMcpSection({ channelId }: { channelId: string }) {
+  const agents = useManagedAgentsQuery().data;
+  const members = useChannelMembersQuery(channelId).data;
+  const inChannel = React.useMemo(() => {
+    const pubkeys = new Set(
+      (members ?? []).map((member) => member.pubkey.toLowerCase()),
+    );
+    return (agents ?? []).filter((agent) =>
+      pubkeys.has(agent.pubkey.toLowerCase()),
+    );
+  }, [agents, members]);
+
+  return (
+    <section aria-label="에이전트 MCP" className="flex flex-col gap-2">
+      <h3 className="text-sm font-semibold">에이전트가 쓰는 도구 (MCP)</h3>
+      <p className="text-xs text-muted-foreground">
+        체크한 도구를 이 채널의 내 에이전트가 쓸 수 있게 됩니다. Claude와 GPT
+        에이전트 모두 같은 방법으로 연결됩니다. 처음 쓸 때는 에이전트가
+        돌아가는 이 컴퓨터에서 브라우저 로그인 창이 한 번 뜹니다.
+      </p>
+      {agents === undefined || members === undefined ? (
+        <p className="text-sm text-muted-foreground">불러오는 중…</p>
+      ) : inChannel.length === 0 ? (
+        <p className="text-sm text-muted-foreground">
+          이 채널에 내가 이 컴퓨터에서 돌리는 에이전트가 없습니다. 채널에
+          에이전트를 먼저 추가해 주세요.
+        </p>
+      ) : (
+        <ul className="flex flex-col gap-2">
+          {inChannel.map((agent) => (
+            <AgentMcpEditor agent={agent} key={agent.pubkey} />
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/desktop/src/features/team-links/ui/ChannelConnections.tsx b/desktop/src/features/team-links/ui/ChannelConnections.tsx
new file mode 100644
index 0000000..8145f58
--- /dev/null
+++ b/desktop/src/features/team-links/ui/ChannelConnections.tsx
@@ -0,0 +1,354 @@
+import { openUrl } from "@tauri-apps/plugin-opener";
+import { Link2, PenTool, Plug, Video } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import { useCommunities } from "@/features/communities/useCommunities";
+import {
+  LINK_KIND_LABELS,
+  type LinkKind,
+  MAX_LINK_TITLE_LENGTH,
+  type TeamLink,
+  guessLinkKind,
+  linksForChannel,
+  normalizeLinkUrl,
+  validateTeamLink,
+} from "@/features/team-links/lib/teamLinks";
+import { useTeamLinks } from "@/features/team-links/lib/useTeamLinks";
+import { Button } from "@/shared/ui/button";
+import { Checkbox } from "@/shared/ui/checkbox";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+import { Input } from "@/shared/ui/input";
+import { Tooltip, TooltipContent, TooltipTrigger } from "@/shared/ui/tooltip";
+import { AgentMcpSection } from "./AgentMcpSection";
+
+/** Shortcut buttons shown straight in the channel header; the rest are in the dialog. */
+const MAX_HEADER_SHORTCUTS = 3;
+
+const KIND_ICONS: Record<LinkKind, typeof Link2> = {
+  meet: Video,
+  figma: PenTool,
+  other: Link2,
+};
+
+const errorText = (error: unknown, fallback: string) =>
+  error instanceof Error && error.message ? error.message : fallback;
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).hostname;
+  } catch {
+    return url;
+  }
+}
+
+function open(link: TeamLink) {
+  // The address was checked to be https when it was read.
+  void openUrl(link.url).catch(() =>
+    toast.error("링크를 열지 못했습니다."),
+  );
+}
+
+/**
+ * Channel connections (team patch): one-click shortcuts to the channel's
+ * Google Meet room, Figma file or any other link, and the MCP servers of the
+ * channel's agents. Shortcuts are shared with the whole community.
+ */
+export function ChannelConnections({
+  channelId,
+  currentPubkey,
+}: {
+  channelId: string;
+  currentPubkey?: string;
+}) {
+  const relayUrl = useCommunities().activeCommunity?.relayUrl;
+  if (!currentPubkey || !relayUrl) return null;
+  return (
+    <ChannelConnectionsInner
+      channelId={channelId}
+      pubkey={currentPubkey}
+      relayUrl={relayUrl}
+    />
+  );
+}
+
+function ChannelConnectionsInner({
+  channelId,
+  pubkey,
+  relayUrl,
+}: {
+  channelId: string;
+  pubkey: string;
+  relayUrl: string;
+}) {
+  const { links, status, saveLink, deleteLink } = useTeamLinks(pubkey, relayUrl);
+  const [dialogOpen, setDialogOpen] = React.useState(false);
+  const shown = linksForChannel(links, channelId);
+
+  return (
+    <span className="flex items-center gap-[6px]" data-no-translate="">
+      {shown.slice(0, MAX_HEADER_SHORTCUTS).map((link) => {
+        const Icon = KIND_ICONS[link.kind];
+        return (
+          <Tooltip disableHoverableContent key={link.id}>
+            <TooltipTrigger asChild>
+              <Button
+                aria-label={`${link.title} 열기`}
+                data-testid="channel-shortcut"
+                onClick={() => open(link)}
+                size="icon"
+                type="button"
+                variant="outline"
+              >
+                <Icon />
+              </Button>
+            </TooltipTrigger>
+            <TooltipContent>{link.title}</TooltipContent>
+          </Tooltip>
+        );
+      })}
+      <Tooltip disableHoverableContent>
+        <TooltipTrigger asChild>
+          <Button
+            aria-label="연결"
+            data-testid="channel-connections-trigger"
+            onClick={() => setDialogOpen(true)}
+            size="icon"
+            type="button"
+            variant="outline"
+          >
+            <Plug />
+          </Button>
+        </TooltipTrigger>
+        <TooltipContent>연결 (미트 · 피그마 · MCP)</TooltipContent>
+      </Tooltip>
+      {dialogOpen ? (
+        <ConnectionsDialog
+          channelId={channelId}
+          loading={status !== "ready"}
+          onDelete={deleteLink}
+          onOpenChange={setDialogOpen}
+          onSave={saveLink}
+          shown={shown}
+        />
+      ) : null}
+    </span>
+  );
+}
+
+function ConnectionsDialog({
+  channelId,
+  shown,
+  loading,
+  onSave,
+  onDelete,
+  onOpenChange,
+}: {
+  channelId: string;
+  shown: TeamLink[];
+  loading: boolean;
+  onSave: (input: {
+    title: string;
+    url: string;
+    kind: LinkKind;
+    channelId?: string;
+  }) => Promise<void>;
+  onDelete: (id: string) => Promise<void>;
+  onOpenChange: (open: boolean) => void;
+}) {
+  const [title, setTitle] = React.useState("");
+  const [url, setUrl] = React.useState("");
+  const [everywhere, setEverywhere] = React.useState(false);
+  const [busy, setBusy] = React.useState(false);
+  const [confirmingId, setConfirmingId] = React.useState<string | null>(null);
+
+  const normalized = normalizeLinkUrl(url);
+  const kind = normalized ? guessLinkKind(normalized) : "other";
+  // An empty name falls back to what the address is ("구글 미트").
+  const effectiveTitle = title.trim() || (normalized ? LINK_KIND_LABELS[kind] : "");
+  const problem =
+    url.trim().length === 0
+      ? null
+      : validateTeamLink({ title: effectiveTitle, url, kind });
+
+  const run = async (action: () => Promise<void>, failure: string) => {
+    setBusy(true);
+    try {
+      await action();
+      return true;
+    } catch (error) {
+      toast.error(errorText(error, failure));
+      return false;
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const add = async (event: React.FormEvent) => {
+    event.preventDefault();
+    if (busy || normalized === null || problem) return;
+    const saved = await run(
+      () =>
+        onSave({
+          title: effectiveTitle,
+          url,
+          kind,
+          channelId: everywhere ? undefined : channelId,
+        }),
+      "바로가기를 저장하지 못했습니다.",
+    );
+    if (!saved) return;
+    setTitle("");
+    setUrl("");
+  };
+
+  return (
+    <Dialog onOpenChange={onOpenChange} open>
+      <DialogContent
+        className="max-h-[85vh] max-w-2xl overflow-y-auto"
+        data-no-translate=""
+        data-testid="channel-connections-dialog"
+      >
+        <DialogHeader>
+          <DialogTitle>연결</DialogTitle>
+          <DialogDescription>
+            이 채널에서 바로 여는 링크와, 에이전트가 쓰는 도구를 정합니다.
+          </DialogDescription>
+        </DialogHeader>
+
+        <section aria-label="바로가기" className="flex flex-col gap-2">
+          <h3 className="text-sm font-semibold">바로가기 (누르면 바로 열림)</h3>
+          <p className="text-xs text-muted-foreground">
+            추가하면 채널 위쪽에 버튼이 생기고, 팀원 모두에게 보입니다. 구글
+            미트 방이나 피그마 파일 주소를 넣어 두세요.
+          </p>
+          {loading ? (
+            <p className="text-sm text-muted-foreground">불러오는 중…</p>
+          ) : shown.length === 0 ? (
+            <p className="text-sm text-muted-foreground">
+              아직 바로가기가 없습니다.
+            </p>
+          ) : (
+            <ul className="flex flex-col gap-1">
+              {shown.map((link) => {
+                const Icon = KIND_ICONS[link.kind];
+                return (
+                  <li
+                    className="flex items-center gap-2 rounded-lg border border-border/60 px-3 py-1.5 text-sm"
+                    data-testid="channel-shortcut-row"
+                    key={link.id}
+                  >
+                    <Icon aria-hidden="true" className="h-4 w-4 shrink-0" />
+                    <span className="min-w-0 flex-1 truncate">
+                      <span className="font-medium">{link.title}</span>{" "}
+                      <span className="text-xs text-muted-foreground">
+                        {hostOf(link.url)}
+                        {link.channelId === undefined ? " · 모든 채널" : ""}
+                      </span>
+                    </span>
+                    <Button
+                      onClick={() => open(link)}
+                      size="xs"
+                      type="button"
+                      variant="outline"
+                    >
+                      열기
+                    </Button>
+                    <Button
+                      disabled={busy}
+                      onBlur={() => setConfirmingId(null)}
+                      onClick={() => {
+                        if (confirmingId !== link.id) {
+                          setConfirmingId(link.id);
+                          return;
+                        }
+                        setConfirmingId(null);
+                        void run(
+                          () => onDelete(link.id),
+                          "바로가기를 삭제하지 못했습니다.",
+                        );
+                      }}
+                      size="xs"
+                      type="button"
+                      variant={
+                        confirmingId === link.id ? "destructive" : "ghost"
+                      }
+                    >
+                      {confirmingId === link.id ? "삭제 확인" : "삭제"}
+                    </Button>
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+          <form
+            className="flex flex-col gap-2"
+            data-testid="channel-shortcut-form"
+            onSubmit={(event) => void add(event)}
+          >
+            <div className="flex items-end gap-2">
+              <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+                주소
+                <Input
+                  onChange={(event) => setUrl(event.target.value)}
+                  placeholder="https://meet.google.com/abc-defg-hij"
+                  value={url}
+                />
+              </label>
+              <label className="flex w-40 flex-col gap-1 text-xs">
+                이름 (선택)
+                <Input
+                  maxLength={MAX_LINK_TITLE_LENGTH}
+                  onChange={(event) => setTitle(event.target.value)}
+                  placeholder={normalized ? LINK_KIND_LABELS[kind] : "회의방"}
+                  value={title}
+                />
+              </label>
+              <Button
+                disabled={busy || normalized === null || problem !== null}
+                size="sm"
+                type="submit"
+              >
+                추가
+              </Button>
+            </div>
+            {problem ? (
+              <p className="text-xs text-destructive" role="alert">
+                {problem}
+              </p>
+            ) : null}
+            <div className="flex items-center justify-between gap-2">
+              <label className="flex items-center gap-2 text-xs">
+                <Checkbox
+                  checked={everywhere}
+                  onCheckedChange={(checked) => setEverywhere(checked === true)}
+                />
+                모든 채널에 보이기
+              </label>
+              <Button
+                onClick={() =>
+                  void openUrl("https://meet.google.com/new").catch(() =>
+                    toast.error("링크를 열지 못했습니다."),
+                  )
+                }
+                size="xs"
+                type="button"
+                variant="ghost"
+              >
+                새 구글 미트 방 만들러 가기
+              </Button>
+            </div>
+          </form>
+        </section>
+
+        <AgentMcpSection channelId={channelId} />
+      </DialogContent>
+    </Dialog>
+  );
+}

+    "application/x-msi",
+    "application/vnd.android.package-archive",
+    "application/x-apple-diskimage",
+];
+
+/// Team patch: whether `mime` may be uploaded, and if so whether it is a
+/// generic file (document, sheet, slides, archive, text) rather than inline
+/// media. The relay stores generic files as downloads; images and video keep
+/// the media allowlist, and other images and audio are refused there, so they
+/// are refused here with a hint.
+pub fn upload_kind(mime: &str) -> Result<bool, CliError> {
+    if ALLOWED_MIMES.contains(&mime) {
+        return Ok(false);
+    }
+    if mime.starts_with("image/") || mime.starts_with("video/") || mime.starts_with("audio/") {
+        return Err(CliError::Usage(format!(
+            "unsupported file type: {mime} (only jpeg/png/gif/webp images and mp4 video; zip other media first)"
+        )));
+    }
+    if BLOCKED_FILE_MIMES.contains(&mime) {
+        return Err(CliError::Usage(format!("unsupported file type: {mime}")));
+    }
+    Ok(true)
+}

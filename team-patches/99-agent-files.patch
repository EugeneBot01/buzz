+const MAX_GENERIC_FILE_BYTES: u64 = 100 * 1024 * 1024;
+
+/// Team patch: types the relay refuses on its generic file path (active web
+/// content and executables). Mirrors `BLOCKED_FILE_MIME_TYPES` in buzz-media.
+const BLOCKED_FILE_MIMES: &[&str] = &[
+    "application/xhtml+xml",
+    "image/svg+xml",
+    "application/javascript",
+    "text/javascript",
+    "application/x-msdownload",
+    "application/x-executable",

@@ -0,0 +1,166 @@
+import * as React from "react";
+import { toast } from "sonner";
+
+import { GOOGLE_APPS_SCRIPT } from "@/features/team-calendar/lib/googleSync";
+import { useGoogleSyncSettings } from "@/features/team-calendar/lib/useGoogleCalendarSync";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+
+function statusText(
+  status: ReturnType<typeof useGoogleSyncSettings>["status"],
+): string | null {
+  if (!status) return null;
+  const at = new Date(status.at).toLocaleString("ko-KR");
+  if (status.result === "error")
+    return `${at} 실패: ${status.message ?? "알 수 없는 오류"} (잠시 뒤 다시 시도)`;
+  if (status.result === "sent")
+    return `${at} 일정 ${status.count}개 보냄 (구글 응답은 확인 못 함)`;
+  return `${at} 일정 ${status.count}개 반영됨`;
+}
+
+/**
+ * Google Calendar link of this device (team patch). Only the device that has
+ * it set sends changes, so one person with the app often open should set it.
+ */
+export function GoogleSyncSection({
+  pubkey,
+  relayUrl,
+}: {
+  pubkey: string;
+  relayUrl: string;
+}) {
+  const { config, status, save, resendAll } = useGoogleSyncSettings(
+    pubkey,
+    relayUrl,
+  );
+  const [url, setUrl] = React.useState(config?.url ?? "");
+  const [secret, setSecret] = React.useState(config?.secret ?? "");
+  const [showScript, setShowScript] = React.useState(false);
+
+  const apply = () => {
+    try {
+      save({ url, secret });
+      toast.success(
+        "구글 캘린더 연동을 켰습니다. 30초 안에 보내기 시작합니다.",
+      );
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const line = statusText(status);
+
+  return (
+    <section
+      aria-label="구글 캘린더 연동"
+      className="flex flex-col gap-2 border-t border-border pt-4"
+      data-testid="team-calendar-google"
+    >
+      <h3 className="text-sm font-medium">
+        구글 공동 캘린더로 보내기 (이 기기)
+      </h3>
+      <p className="text-xs text-muted-foreground">
+        팀 캘린더에서 추가·수정·삭제한 일정을 구글 캘린더에도 똑같이 반영합니다
+        (Buzz → 구글 한 방향). 구글 캘린더 주인이 아래 스크립트를 한 번
+        배포하고, 나온 주소와 비밀문구를 자주 켜 두는 한 사람의 Buzz에만
+        넣으세요.
+      </p>
+      <Input
+        aria-label="Apps Script 웹 앱 주소"
+        data-testid="team-calendar-google-url"
+        onChange={(event) => setUrl(event.target.value)}
+        placeholder="https://script.google.com/macros/s/…/exec"
+        value={url}
+      />
+      <Input
+        aria-label="비밀문구"
+        data-testid="team-calendar-google-secret"
+        onChange={(event) => setSecret(event.target.value)}
+        placeholder="스크립트에 넣은 비밀문구"
+        type="password"
+        value={secret}
+      />
+      <div className="flex flex-wrap gap-2">
+        <Button
+          disabled={!url || !secret}
+          onClick={apply}
+          size="sm"
+          type="button"
+        >
+          {config ? "바꾸기" : "연동 켜기"}
+        </Button>
+        {config ? (
+          <>
+            <Button
+              onClick={() => {
+                resendAll();
+                toast("다음 확인 때 모든 일정을 다시 보냅니다.");
+              }}
+              size="sm"
+              type="button"
+              variant="outline"
+            >
+              전부 다시 보내기
+            </Button>
+            <Button
+              onClick={() => {
+                save(null);
+                setUrl("");
+                setSecret("");
+              }}
+              size="sm"
+              type="button"
+              variant="ghost"
+            >
+              연동 끄기
+            </Button>
+          </>
+        ) : null}
+        <Button
+          aria-expanded={showScript}
+          onClick={() => setShowScript((shown) => !shown)}
+          size="sm"
+          type="button"
+          variant="ghost"
+        >
+          {showScript ? "스크립트 숨기기" : "구글 쪽 스크립트 보기"}
+        </Button>
+      </div>
+      {line ? <p className="text-xs text-muted-foreground">{line}</p> : null}
+      {showScript ? (
+        <div className="flex flex-col gap-1">
+          <ol className="list-decimal pl-5 text-xs text-muted-foreground">
+            <li>
+              구글 캘린더 설정 → 해당 캘린더 → "캘린더 통합"에서 캘린더 ID 복사
+            </li>
+            <li>
+              script.google.com → 새 프로젝트 → 아래 코드 붙여넣기, ID·비밀문구
+              채우기
+            </li>
+            <li>
+              배포 → 새 배포 → 웹 앱, 실행: 나, 액세스: 모든 사용자 → 권한 허용
+            </li>
+            <li>나온 웹 앱 주소를 위 칸에 붙여넣기</li>
+          </ol>
+          <Button
+            className="self-start"
+            onClick={() =>
+              void navigator.clipboard
+                .writeText(GOOGLE_APPS_SCRIPT)
+                .then(() => toast.success("스크립트를 복사했습니다."))
+                .catch(() => toast.error("복사하지 못했습니다."))
+            }
+            size="sm"
+            type="button"
+            variant="outline"
+          >
+            스크립트 복사
+          </Button>
+          <pre className="max-h-48 overflow-auto rounded-md bg-muted p-2 text-2xs">
+            {GOOGLE_APPS_SCRIPT}
+          </pre>
+        </div>
+      ) : null}
+    </section>
+  );
+}

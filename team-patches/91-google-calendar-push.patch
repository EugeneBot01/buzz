diff --git a/desktop/src/features/team-calendar/lib/googleSync.test.mjs b/desktop/src/features/team-calendar/lib/googleSync.test.mjs
new file mode 100644
index 000000000..129b5ab92
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/googleSync.test.mjs
@@ -0,0 +1,92 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  GOOGLE_APPS_SCRIPT,
+  MAX_OPS_PER_PUSH,
+  isAppsScriptUrl,
+  newestVersions,
+  parsePushed,
+  pendingOps,
+} from "./googleSync.ts";
+
+const ME = "a".repeat(64);
+const entry = (id, updatedAt, extra = {}) => ({
+  id,
+  title: id,
+  date: "2026-10-14",
+  updatedAt,
+  updatedBy: ME,
+  ...extra,
+});
+
+test("a moved entry: the live copy beats its deletion in the old month", () => {
+  const moved = newestVersions([
+    { x: entry("x", 5, { deleted: true }) },
+    { x: entry("x", 5, { date: "2026-11-02" }) },
+  ]);
+  assert.equal(moved.length, 1);
+  assert.equal(moved[0].deleted, undefined);
+  const deleted = newestVersions([
+    { x: entry("x", 5) },
+    { x: entry("x", 6, { deleted: true }) },
+  ]);
+  assert.equal(deleted[0].deleted, true);
+});
+
+test("only changed entries are sent, oldest first, with their fields", () => {
+  const { ops, versions } = pendingOps(
+    [
+      entry("same", 1),
+      entry("newer", 9, { time: "15:00", endTime: "16:00", note: "회의실 B" }),
+      entry("weekly", 3, { repeat: { every: "weekly", until: "2026-12-31" } }),
+    ],
+    { same: 1, newer: 2 },
+  );
+  assert.deepEqual(
+    ops.map((op) => op.id),
+    ["weekly", "newer"],
+  );
+  assert.deepEqual(ops[1], {
+    op: "upsert",
+    id: "newer",
+    title: "newer",
+    date: "2026-10-14",
+    time: "15:00",
+    endTime: "16:00",
+    note: "회의실 B",
+  });
+  assert.deepEqual(ops[0].repeat, { every: "weekly", until: "2026-12-31" });
+  assert.deepEqual(versions, { weekly: 3, newer: 9 });
+});
+
+test("deletions are sent only for entries that were sent", () => {
+  const { ops, versions } = pendingOps(
+    [entry("sent", 4, { deleted: true }), entry("never", 4, { deleted: true })],
+    { sent: 2 },
+  );
+  assert.deepEqual(ops, [{ op: "delete", id: "sent" }]);
+  assert.deepEqual(versions, { sent: 4 });
+});
+
+test("a push is capped", () => {
+  const many = Array.from({ length: MAX_OPS_PER_PUSH + 5 }, (_, i) =>
+    entry(`e${i}`, i + 1),
+  );
+  assert.equal(pendingOps(many, {}).ops.length, MAX_OPS_PER_PUSH);
+});
+
+test("stored record and URL checks", () => {
+  assert.deepEqual(parsePushed('{"a":1,"b":"x"}'), { a: 1 });
+  assert.deepEqual(parsePushed("nope"), {});
+  assert.ok(
+    isAppsScriptUrl("https://script.google.com/macros/s/AKfy-cb_12/exec"),
+  );
+  assert.ok(!isAppsScriptUrl("https://evil.example.com/macros/s/x/exec"));
+  assert.ok(!isAppsScriptUrl("http://script.google.com/macros/s/x/exec"));
+});
+
+test("the Apps Script parses as JavaScript", () => {
+  // Apps Script is V8 JavaScript: a syntax error here would only show in Google.
+  assert.doesNotThrow(() => new Function(GOOGLE_APPS_SCRIPT));
+});
diff --git a/desktop/src/features/team-calendar/lib/googleSync.ts b/desktop/src/features/team-calendar/lib/googleSync.ts
new file mode 100644
index 000000000..51c3a6b67
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/googleSync.ts
@@ -0,0 +1,189 @@
+import type { CalendarEntry, CalendarMonth } from "./teamCalendar";
+
+/**
+ * Team patch: one-way copy of the team calendar into a Google Calendar.
+ *
+ * The app does not sign in to Google. The owner of the Google calendar
+ * deploys a small Apps Script web app (`GOOGLE_APPS_SCRIPT` below) that
+ * writes to their calendar, and pastes its URL and a shared secret into one
+ * member's Buzz. That member's app sends every change it sees; the script
+ * keeps the Buzz id → Google event id map. Settings stay on that device.
+ */
+
+/** What the script is asked to do with one entry. */
+export type GoogleSyncOp =
+  | {
+      op: "upsert";
+      id: string;
+      title: string;
+      date: string;
+      time?: string;
+      endDate?: string;
+      endTime?: string;
+      note?: string;
+      repeat?: { every: string; until?: string };
+    }
+  | { op: "delete"; id: string };
+
+/** Entry id → `updatedAt` of the version last sent. */
+export type PushedVersions = Record<string, number>;
+
+/** Most operations sent in one request. */
+export const MAX_OPS_PER_PUSH = 40;
+
+/** The newest version of each entry across documents, deletions included. */
+export function newestVersions(docs: CalendarMonth[]): CalendarEntry[] {
+  const byId = new Map<string, CalendarEntry>();
+  for (const doc of docs) {
+    for (const entry of Object.values(doc)) {
+      const current = byId.get(entry.id);
+      // A moved entry leaves a deletion behind in its old month with the same
+      // time as the live copy: the live copy wins the tie.
+      if (
+        !current ||
+        entry.updatedAt > current.updatedAt ||
+        (entry.updatedAt === current.updatedAt &&
+          current.deleted &&
+          !entry.deleted)
+      )
+        byId.set(entry.id, entry);
+    }
+  }
+  return [...byId.values()];
+}
+
+/**
+ * The operations that bring Google up to date with `entries`, oldest change
+ * first, at most `MAX_OPS_PER_PUSH`. A deletion of an entry never sent is
+ * skipped (and needs no record).
+ */
+export function pendingOps(
+  entries: CalendarEntry[],
+  pushed: PushedVersions,
+): { ops: GoogleSyncOp[]; versions: PushedVersions } {
+  const ops: GoogleSyncOp[] = [];
+  const versions: PushedVersions = {};
+  const changed = entries
+    .filter((entry) => pushed[entry.id] !== entry.updatedAt)
+    .filter((entry) => !entry.deleted || pushed[entry.id] !== undefined)
+    .sort((a, b) => a.updatedAt - b.updatedAt);
+  for (const entry of changed.slice(0, MAX_OPS_PER_PUSH)) {
+    versions[entry.id] = entry.updatedAt;
+    if (entry.deleted) {
+      ops.push({ op: "delete", id: entry.id });
+      continue;
+    }
+    const op: GoogleSyncOp = {
+      op: "upsert",
+      id: entry.id,
+      title: entry.title,
+      date: entry.date,
+    };
+    if (entry.time) op.time = entry.time;
+    if (entry.endDate) op.endDate = entry.endDate;
+    if (entry.endTime) op.endTime = entry.endTime;
+    if (entry.note) op.note = entry.note;
+    if (entry.repeat) op.repeat = { ...entry.repeat };
+    ops.push(op);
+  }
+  return { ops, versions };
+}
+
+/** Parses the stored record of sent versions; anything malformed is dropped. */
+export function parsePushed(raw: string | null): PushedVersions {
+  if (!raw) return {};
+  try {
+    const value = JSON.parse(raw) as unknown;
+    if (!value || typeof value !== "object") return {};
+    const result: PushedVersions = {};
+    for (const [id, at] of Object.entries(value as Record<string, unknown>))
+      if (typeof at === "number" && Number.isFinite(at)) result[id] = at;
+    return result;
+  } catch {
+    return {};
+  }
+}
+
+/** True for the URL of a deployed Apps Script web app. */
+export function isAppsScriptUrl(url: string): boolean {
+  return /^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(
+    url.trim(),
+  );
+}
+
+/**
+ * The Apps Script the calendar owner deploys (Extensions → Apps Script in a
+ * Google account that can edit the shared calendar; Deploy → New deployment →
+ * Web app, execute as "Me", access "Anyone"). `CALENDAR_ID` and `SECRET` are
+ * filled in by the owner; the same secret goes into Buzz.
+ */
+export const GOOGLE_APPS_SCRIPT = `const CALENDAR_ID = "여기에_캘린더_ID@group.calendar.google.com";
+const SECRET = "여기에_비밀문구";
+
+function doPost(e) {
+  const body = JSON.parse(e.postData.contents);
+  if (body.secret !== SECRET) return reply({ ok: false, error: "secret" });
+  const calendar = CalendarApp.getCalendarById(CALENDAR_ID);
+  const map = PropertiesService.getScriptProperties();
+  const done = [];
+  for (const op of body.ops || []) {
+    const key = "buzz:" + op.id;
+    const old = map.getProperty(key);
+    if (old) {
+      try {
+        const series = calendar.getEventSeriesById(old);
+        if (series) series.deleteEventSeries();
+      } catch (err) {}
+      map.deleteProperty(key);
+    }
+    if (op.op === "upsert") {
+      const made = create(calendar, op);
+      map.setProperty(key, made.getId());
+    }
+    done.push(op.id);
+  }
+  return reply({ ok: true, done: done });
+}
+
+function create(calendar, op) {
+  const description = (op.note || "") + "\\n\\n(Buzz 팀 캘린더에서 자동 추가)";
+  const options = { description: description.trim() };
+  const day = (date, time) => {
+    const [y, m, d] = date.split("-").map(Number);
+    const [h, mi] = (time || "00:00").split(":").map(Number);
+    return new Date(y, m - 1, d, h, mi);
+  };
+  const end = op.endDate || op.date;
+  const rule = recurrence(op.repeat);
+  if (!op.time) {
+    const start = day(op.date);
+    const last = day(end);
+    last.setDate(last.getDate() + 1);
+    if (rule) return calendar.createAllDayEventSeries(op.title, start, rule, options);
+    return calendar.createAllDayEvent(op.title, start, last, options);
+  }
+  const start = day(op.date, op.time);
+  const stop = op.endTime ? day(end, op.endTime) : new Date(day(end, op.time).getTime() + 60 * 60 * 1000);
+  if (rule) return calendar.createEventSeries(op.title, start, stop, rule, options);
+  return calendar.createEvent(op.title, start, stop, options);
+}
+
+function recurrence(repeat) {
+  if (!repeat) return null;
+  const rule = CalendarApp.newRecurrence();
+  let r;
+  if (repeat.every === "daily") r = rule.addDailyRule();
+  else if (repeat.every === "weekly") r = rule.addWeeklyRule();
+  else if (repeat.every === "biweekly") r = rule.addWeeklyRule().interval(2);
+  else r = rule.addMonthlyRule();
+  if (repeat.until) {
+    const [y, m, d] = repeat.until.split("-").map(Number);
+    r.until(new Date(y, m - 1, d, 23, 59));
+  }
+  return rule;
+}
+
+function reply(value) {
+  return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
+}
+`;
diff --git a/desktop/src/features/team-calendar/lib/useGoogleCalendarSync.ts b/desktop/src/features/team-calendar/lib/useGoogleCalendarSync.ts
new file mode 100644
index 000000000..190476cae
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/useGoogleCalendarSync.ts
@@ -0,0 +1,220 @@
+import * as React from "react";
+
+import {
+  type GoogleSyncOp,
+  isAppsScriptUrl,
+  newestVersions,
+  parsePushed,
+  pendingOps,
+} from "./googleSync";
+import { REPEAT_DOC, monthOfDate, shiftMonth, todayKey } from "./teamCalendar";
+import { useTeamCalendarMonth } from "./useTeamCalendar";
+
+const CONFIG_PREFIX = "buzz-team-calendar-google.v1";
+const PUSHED_PREFIX = "buzz-team-calendar-google-pushed.v1";
+const STATUS_PREFIX = "buzz-team-calendar-google-status.v1";
+const CHANGED_EVENT = "buzz-team-calendar-google-changed";
+const CHECK_INTERVAL_MS = 30_000;
+
+/** This device's Google link: the Apps Script URL and the shared secret. */
+export type GoogleSyncConfig = { url: string; secret: string };
+/** The outcome of the last push, for the settings panel. */
+export type GoogleSyncStatus = {
+  at: number;
+  /** "ok": the script answered; "sent": sent, but the answer was unreadable. */
+  result: "ok" | "sent" | "error";
+  message?: string;
+  count: number;
+};
+
+const keyOf = (prefix: string, pubkey: string, relayUrl: string) =>
+  `${prefix}:${pubkey}:${relayUrl}`;
+
+function read<T>(key: string, parse: (raw: string) => T | null): T | null {
+  try {
+    const raw = window.localStorage.getItem(key);
+    return raw ? parse(raw) : null;
+  } catch {
+    return null;
+  }
+}
+
+function write(key: string, value: unknown) {
+  try {
+    if (value === null) window.localStorage.removeItem(key);
+    else window.localStorage.setItem(key, JSON.stringify(value));
+  } catch {
+    // Storage blocked: the link lasts until the app restarts at most.
+  }
+  window.dispatchEvent(new Event(CHANGED_EVENT));
+}
+
+function parseConfig(raw: string): GoogleSyncConfig | null {
+  try {
+    const value = JSON.parse(raw) as Partial<GoogleSyncConfig>;
+    return typeof value.url === "string" &&
+      isAppsScriptUrl(value.url) &&
+      typeof value.secret === "string"
+      ? { url: value.url, secret: value.secret }
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+function parseStatus(raw: string): GoogleSyncStatus | null {
+  try {
+    return JSON.parse(raw) as GoogleSyncStatus;
+  } catch {
+    return null;
+  }
+}
+
+/** This device's Google link settings and last result. */
+export function useGoogleSyncSettings(pubkey: string, relayUrl: string) {
+  const configKey = keyOf(CONFIG_PREFIX, pubkey, relayUrl);
+  const statusKey = keyOf(STATUS_PREFIX, pubkey, relayUrl);
+  const snapshot = React.useCallback(
+    () => ({
+      config: read(configKey, parseConfig),
+      status: read(statusKey, parseStatus),
+    }),
+    [configKey, statusKey],
+  );
+  const [state, setState] = React.useState(snapshot);
+  React.useEffect(() => {
+    const refresh = () => setState(snapshot());
+    refresh();
+    window.addEventListener(CHANGED_EVENT, refresh);
+    return () => window.removeEventListener(CHANGED_EVENT, refresh);
+  }, [snapshot]);
+
+  const save = React.useCallback(
+    (config: GoogleSyncConfig | null) => {
+      if (config && !isAppsScriptUrl(config.url))
+        throw new Error(
+          "Apps Script 웹 앱 주소(https://script.google.com/macros/s/…/exec)를 넣으세요.",
+        );
+      write(
+        configKey,
+        config && { url: config.url.trim(), secret: config.secret },
+      );
+    },
+    [configKey],
+  );
+  /** Sends every entry again on the next check (after fixing the script). */
+  const resendAll = React.useCallback(
+    () => write(keyOf(PUSHED_PREFIX, pubkey, relayUrl), null),
+    [pubkey, relayUrl],
+  );
+
+  return { ...state, save, resendAll };
+}
+
+async function send(
+  config: GoogleSyncConfig,
+  ops: GoogleSyncOp[],
+): Promise<"ok" | "sent"> {
+  // text/plain keeps this a simple request (no CORS preflight), which Apps
+  // Script web apps accept.
+  const init: RequestInit = {
+    method: "POST",
+    headers: { "Content-Type": "text/plain;charset=utf-8" },
+    body: JSON.stringify({ secret: config.secret, ops }),
+  };
+  let response: Response;
+  try {
+    response = await fetch(config.url, init);
+  } catch {
+    // The answer could not be read (cross-origin redirect). Send it blind:
+    // every operation replaces the event, so sending twice is harmless.
+    await fetch(config.url, { ...init, mode: "no-cors" });
+    return "sent";
+  }
+  const answer = (await response.json().catch(() => null)) as {
+    ok?: boolean;
+    error?: string;
+  } | null;
+  if (!response.ok || !answer?.ok)
+    throw new Error(
+      answer?.error === "secret"
+        ? "비밀문구가 스크립트와 다릅니다."
+        : `구글 스크립트가 거절했습니다 (${response.status}).`,
+    );
+  return "ok";
+}
+
+/**
+ * Copies team calendar changes to Google while the app runs (team patch).
+ * Does nothing on devices without a Google link. Covers last month to three
+ * months ahead plus repeating entries.
+ */
+export function useGoogleCalendarSync(pubkey: string, relayUrl: string) {
+  const { config } = useGoogleSyncSettings(pubkey, relayUrl);
+  const [month, setMonth] = React.useState(() => monthOfDate(todayKey()));
+  const docs = [
+    useTeamCalendarMonth(pubkey, relayUrl, shiftMonth(month, -1)),
+    useTeamCalendarMonth(pubkey, relayUrl, month),
+    useTeamCalendarMonth(pubkey, relayUrl, shiftMonth(month, 1)),
+    useTeamCalendarMonth(pubkey, relayUrl, shiftMonth(month, 2)),
+    useTeamCalendarMonth(pubkey, relayUrl, shiftMonth(month, 3)),
+    useTeamCalendarMonth(pubkey, relayUrl, REPEAT_DOC),
+  ];
+  const latest = React.useRef({
+    config,
+    ready: false,
+    entries: newestVersions([]),
+  });
+  latest.current = {
+    config,
+    ready: docs.every((doc) => doc.status === "ready"),
+    entries: newestVersions(docs.map((doc) => doc.entries)),
+  };
+
+  React.useEffect(() => {
+    const pushedKey = keyOf(PUSHED_PREFIX, pubkey, relayUrl);
+    const statusKey = keyOf(STATUS_PREFIX, pubkey, relayUrl);
+    let busy = false;
+    // A failing script is retried with backoff (30 s doubling, up to 30 min).
+    let failures = 0;
+    let retryAt = 0;
+
+    const check = async () => {
+      setMonth(monthOfDate(todayKey()));
+      const now = latest.current;
+      if (busy || !now.config || !now.ready || Date.now() < retryAt) return;
+      const pushed = read(pushedKey, parsePushed) ?? {};
+      const { ops, versions } = pendingOps(now.entries, pushed);
+      if (ops.length === 0) return;
+      busy = true;
+      try {
+        const result = await send(now.config, ops);
+        // Re-read: "다시 보내기" may have cleared the record meanwhile.
+        write(pushedKey, {
+          ...(read(pushedKey, parsePushed) ?? {}),
+          ...versions,
+        });
+        write(statusKey, { at: Date.now(), result, count: ops.length });
+        failures = 0;
+        retryAt = 0;
+      } catch (error) {
+        failures += 1;
+        retryAt =
+          Date.now() + Math.min(30 * 60_000, CHECK_INTERVAL_MS * 2 ** failures);
+        // Not recorded as sent, so the next check tries again.
+        write(statusKey, {
+          at: Date.now(),
+          result: "error",
+          count: ops.length,
+          message: error instanceof Error ? error.message : String(error),
+        });
+      } finally {
+        busy = false;
+      }
+    };
+
+    void check();
+    const interval = window.setInterval(() => void check(), CHECK_INTERVAL_MS);
+    return () => window.clearInterval(interval);
+  }, [pubkey, relayUrl]);
+}

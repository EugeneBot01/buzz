index 0000000..0a51286
--- /dev/null
+++ b/desktop/src/features/sidebar/lib/teamSectionsSync.ts
@@ -0,0 +1,279 @@
+import type { RelayEvent } from "@/shared/api/types";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+import { SECTIONS_LANE, type SectionsView } from "./channelSectionsSync";
+import { decodeDoc, encodeDoc, type LaneCodec } from "./sidebarLaneStore";
+import { canonical, isEmptyTree, mergeTrees, type Tree } from "./sidebarLwwMap";
+
+/**
+ * Team sections: one section layout shared by every member of a community.
+ *
+ * Each member publishes their merged copy as a plaintext kind 30078 event at
+ * their own `(pubkey, d = team-channel-sections)` coordinate. Readers merge
+ * every member's event per field (the same LWW registers as personal
+ * sections), so nobody can overwrite anyone else's event and any two members
+ * who have seen the same events hold the same layout.
+ *
+ * Section names and channel assignments are therefore readable by every
+ * community member. Personal sections (`channel-sections`) stay encrypted and
+ * are untouched.
+ */
+export const TEAM_SECTIONS_D_TAG = "team-channel-sections";
+
+/**
+ * The `d` tag for one community. Communities on a shared host can serve the
+ * same member's events, so the coordinate itself names the community: a
+ * layout published in one can never be read (or overwritten) from another.
+ */
+export const teamSectionsDTag = (relayUrl: string) =>
+  `${TEAM_SECTIONS_D_TAG}:${normalizeRelayUrl(relayUrl)}`;
+
+/** Relay event size ceiling shared by every sidebar blob. */
+const MAX_CONTENT_BYTES = 65_535;
+/** Most member events merged per read; a community larger than this is out of scope. */
+export const MAX_TEAM_SECTION_AUTHORS = 200;
+const DEBOUNCE_MS = 2_000;
+const BACKOFF_MS = [5_000, 10_000, 30_000, 60_000, 60_000];
+
+// v2: v1 caches could hold another community's layout (unscoped `d` tag).
+const TEAM_STORAGE_KEY_PREFIX = "buzz-team-sections.v2";
+/** The pre-scoping cache, read once to carry a community's own layout over. */
+export const LEGACY_TEAM_STORAGE_KEY_PREFIX = "buzz-team-sections.v1";
+
+/** Same register shape as personal sections, in its own relay-scoped cache. */
+export const TEAM_SECTIONS_LANE: LaneCodec & {
+  withinLimits: (projection: Record<string, unknown>) => boolean;
+} = {
+  storageKey: (pubkey, relayUrl) =>
+    `${TEAM_STORAGE_KEY_PREFIX}:${pubkey}:${encodeURIComponent(normalizeRelayUrl(relayUrl))}`,
+  shape: SECTIONS_LANE.shape,
+  // Team documents always carry registers; a meta-less payload is unreadable.
+  fromLegacy: () => null,
+  project: SECTIONS_LANE.project,
+  withinLimits: SECTIONS_LANE.withinLimits,
+};
+
+/** The tree store this reconciler drives (`LaneStore` in the app). */
+export type TeamSectionsStore = {
+  get: () => Tree;
+  merge: (remote: Tree) => void;
+};
+
+export type TeamSectionsTransport = {
+  /** Every member's current team-sections event. Throws on transport failure. */
+  fetch: () => Promise<RelayEvent[]>;
+  /**
+   * Signs and publishes this member's event. Throws on failure. `isCurrent`
+   * is checked right before the send, so a publish that outlives its scope
+   * (a community switch mid-flight) is dropped instead of sent.
+   */
+  publish: (
+    content: string,
+    createdAt: number,
+    isCurrent: () => boolean,
+  ) => Promise<void>;
+};
+
+type Seen = { id: string; createdAt: number; tree: Tree };
+
+const byteLength = (text: string) => new TextEncoder().encode(text).length;
+
+/**
+ * Converges the local team tree with every member's event. Remote events only
+ * ever merge in. This member's event is (re)published only when the local
+ * tree holds a register the union of all seen events lacks — that is, after a
+ * local edit — so reading never causes a write and edits cannot echo.
+ */
+export class TeamSectionsReconciler {
+  private seen = new Map<string, Seen>();
+  private ready = false;
+  private publishing = false;
+  private failures = 0;
+  private notBefore = 0;
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private destroyed = false;
+
+  private readonly store: TeamSectionsStore;
+  private readonly pubkey: string;
+  private readonly transport: TeamSectionsTransport;
+  private readonly dTag: string;
+
+  constructor(
+    store: TeamSectionsStore,
+    pubkey: string,
+    transport: TeamSectionsTransport,
+    dTag: string = TEAM_SECTIONS_D_TAG,
+  ) {
+    this.store = store;
+    this.pubkey = pubkey;
+    this.transport = transport;
+    this.dTag = dTag;
+  }
+
+  /** Merges one member's event if it is their newest readable one. */
+  ingest(event: RelayEvent): void {
+    if (this.destroyed) return;
+    const d = event.tags.filter((tag) => tag[0] === "d");
+    if (d.length !== 1 || d[0]?.[1] !== this.dTag) return;
+    if (byteLength(event.content) > MAX_CONTENT_BYTES) return;
+    const prev = this.seen.get(event.pubkey);
+    // The relay's replaceable winner: later `created_at`, then lower id.
+    if (
+      prev &&
+      !(
+        event.created_at > prev.createdAt ||
+        (event.created_at === prev.createdAt && event.id < prev.id)
+      )
+    )
+      return;
+    if (!prev && this.seen.size >= MAX_TEAM_SECTION_AUTHORS) return;
+    let json: unknown = null;
+    try {
+      json = JSON.parse(event.content);
+    } catch {
+      return;
+    }
+    const doc = decodeDoc(TEAM_SECTIONS_LANE, json, 0);
+    if (!doc || doc.legacy) return;
+    this.seen.set(event.pubkey, {
+      id: event.id,
+      createdAt: event.created_at,
+      tree: doc.tree,
+    });
+    this.store.merge(doc.tree);
+    this.schedule();
+  }
+
+  /** One relay read of every member's event. Throws on transport failure. */
+  async read(): Promise<void> {
+    const events = await this.transport.fetch();
+    if (this.destroyed) return;
+    for (const event of events) this.ingest(event);
+    this.ready = true;
+    this.schedule();
+  }
+
+  /** A local edit: publish after the debounce. */
+  defer(): void {
+    this.notBefore = Date.now() + DEBOUNCE_MS;
+    this.schedule();
+  }
+
+  /** True when the local tree holds registers no seen event carries. */
+  needsPublish(): boolean {
+    const local = this.store.get();
+    if (isEmptyTree(local)) return false;
+    let union: Tree = {};
+    for (const { tree } of this.seen.values()) union = mergeTrees(union, tree);
+    // `mergeTrees` returns its first argument when the second adds nothing.
+    return mergeTrees(union, local) !== union;
+  }
+
+  private schedule(): void {
+    if (this.destroyed || this.publishing || !this.ready) return;
+    if (this.timer !== null) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+    if (!this.needsPublish()) return;
+    this.timer = setTimeout(
+      () => {
+        this.timer = null;
+        void this.attempt();
+      },
+      Math.max(0, this.notBefore - Date.now()),
+    );
+  }
+
+  private async attempt(): Promise<void> {
+    if (this.destroyed || this.publishing || !this.needsPublish()) return;
+    const tree = this.store.get();
+    // Over today's caps or the relay's size ceiling: keep it local, never
+    // publish a truncated layout.
+    if (!TEAM_SECTIONS_LANE.withinLimits(TEAM_SECTIONS_LANE.project(tree)))
+      return;
+    const content = canonical(encodeDoc(TEAM_SECTIONS_LANE, tree));
+    if (byteLength(content) > MAX_CONTENT_BYTES) return;
+    const mine = this.seen.get(this.pubkey);
+    const createdAt = Math.max(
+      Math.floor(Date.now() / 1_000),
+      (mine?.createdAt ?? 0) + 1,
+    );
+    this.publishing = true;
+    try {
+      await this.transport.publish(
+        content,
+        createdAt,
+        () => !this.destroyed,
+      );
+      if (this.destroyed) return;
+      this.failures = 0;
+      // Our own event now carries `tree`; the live echo (same `created_at`,
+      // any id) never beats this entry, so it is not merged twice.
+      this.seen.set(this.pubkey, { id: "", createdAt, tree });
+    } catch (error) {
+      if (this.destroyed) return;
+      console.warn(`[${TEAM_SECTIONS_D_TAG}] publish failed:`, error);
+      this.notBefore =
+        Date.now() +
+        (BACKOFF_MS[Math.min(this.failures, BACKOFF_MS.length - 1)] as number);
+      this.failures++;
+    } finally {
+      this.publishing = false;
+      // Picks up an edit made mid-publish, or retries behind the backoff.
+      this.schedule();
+    }
+  }
+
+  destroy(): void {
+    this.destroyed = true;
+    if (this.timer !== null) clearTimeout(this.timer);
+  }
+}
+
+/**
+ * Whether the community owner's app should copy the owner's personal layout
+ * into the team one. Only into a team layout that has never held anything
+ * (confirmed by a successful read), and only once per install, so it can
+ * never re-add sections the team has since deleted or override a layout
+ * someone else started.
+ */
+export function shouldSeedTeamSections(input: {
+  isOwner: boolean;
+  /** A relay read of every member's event has succeeded. */
+  synced: boolean;
+  /** The merged team tree has no registers at all, tombstones included. */
+  teamEmpty: boolean;
+  personalSectionCount: number;
+  alreadySeeded: boolean;
+}): boolean {
+  return (
+    input.isOwner &&
+    input.synced &&
+    input.teamEmpty &&
+    input.personalSectionCount > 0 &&
+    !input.alreadySeeded
+  );
+}
+
+/**
+ * The part of a pre-scoping (v1) cached layout that belongs to this
+ * community: sections holding at least one channel that exists here, with
+ * only those channels assigned. A v1 cache could hold another community's
+ * layout, whose channel ids never match, so those sections drop out. `null`
+ * when nothing belongs here.
+ */
+export function carryOverTeamSections(
+  legacy: SectionsView,
+  channelIds: Iterable<string>,
+): SectionsView | null {
+  const here = new Set(channelIds);
+  const assignments: Record<string, string> = {};
+  const used = new Set<string>();
+  for (const [channelId, sectionId] of Object.entries(legacy.assignments)) {
+    if (!here.has(channelId)) continue;
+    assignments[channelId] = sectionId;
+    used.add(sectionId);
+  }
+  const sections = legacy.sections.filter((section) => used.has(section.id));
+  return sections.length > 0 ? { sections, assignments } : null;
+}
diff --git a/desktop/src/features/sidebar/lib/useTeamChannelSections.ts b/desktop/src/features/sidebar/lib/useTeamChannelSections.ts
new file mode 100644
index 0000000..1956037
--- /dev/null
+++ b/desktop/src/features/sidebar/lib/useTeamChannelSections.ts
@@ -0,0 +1,471 @@
+import * as React from "react";
+
+import { relayClient } from "@/shared/api/relayClient";
+import { signRelayEvent } from "@/shared/api/tauri";
+import { KIND_CHANNEL_SECTIONS } from "@/shared/constants/kinds";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+import type { ChannelSection } from "./channelSectionsStorage";
+import {
+  maxLiveOrder,
+  projectSections,
+  type SectionsView,
+} from "./channelSectionsSync";
+import { decodeDoc, LaneStore } from "./sidebarLaneStore";
+import { isEmptyTree, own, setRegs, type Tree } from "./sidebarLwwMap";
+import {
+  carryOverTeamSections,
+  LEGACY_TEAM_STORAGE_KEY_PREFIX,
+  MAX_TEAM_SECTION_AUTHORS,
+  TEAM_SECTIONS_D_TAG,
+  TEAM_SECTIONS_LANE,
+  teamSectionsDTag,
+  TeamSectionsReconciler,
+  shouldSeedTeamSections,
+  type TeamSectionsTransport,
+} from "./teamSectionsSync";
+
+const EMPTY: Tree = Object.freeze({}) as Tree;
+const REFRESH_MS = 5 * 60 * 1_000;
+
+/** Relay reads and writes for one community's team layout (see `teamSectionsDTag`). */
+function relayTransport(dTag: string): TeamSectionsTransport & {
+  filter: { kinds: number[]; "#d": string[] };
+} {
+  const filter = { kinds: [KIND_CHANNEL_SECTIONS], "#d": [dTag] };
+  return {
+    filter,
+    fetch: () =>
+      relayClient.fetchEvents({ ...filter, limit: MAX_TEAM_SECTION_AUTHORS }),
+    async publish(content, createdAt, isCurrent) {
+      const event = await signRelayEvent({
+        kind: KIND_CHANNEL_SECTIONS,
+        content,
+        createdAt,
+        tags: [
+          ["d", dTag],
+          ["t", TEAM_SECTIONS_D_TAG],
+        ],
+      });
+      try {
+        await relayClient.publishEvent(
+          event,
+          `Timed out publishing ${TEAM_SECTIONS_D_TAG}.`,
+          `Failed to publish ${TEAM_SECTIONS_D_TAG}.`,
+          isCurrent, // checked again right before each socket send
+        );
+      } catch (error) {
+        if (!String((error as Error)?.message).startsWith("duplicate:"))
+          throw error;
+      }
+    },
+  };
+}
+
+/** Same whole-list reorder as personal sections (`useChannelSections`). */
+function writeOrder(tree: Tree, requested: string[]) {
+  const live = projectSections(tree).sections.map((s) => s.id);
+  const wanted = new Set(requested.filter((id) => live.includes(id)));
+  const ids = [...wanted, ...live.filter((id) => !wanted.has(id))];
+  return setRegs(
+    tree,
+    ids.map((id, index) => [["s", id, "order"], index]),
+    true,
+  );
+}
+
+/**
+ * Team sections for one pubkey + relay scope: the layout every member shares
+ * and any member can edit (see `teamSectionsSync`). Same surface as
+ * `useChannelSections`, plus `adoptSections` to seed the team layout from a
+ * personal one.
+ */
+export function useTeamChannelSections(
+  pubkey: string | undefined,
+  relayUrl?: string,
+) {
+  const store = React.useMemo(
+    () =>
+      pubkey && relayUrl
+        ? new LaneStore(TEAM_SECTIONS_LANE, pubkey, relayUrl)
+        : null,
+    [pubkey, relayUrl],
+  );
+  const reconcilerRef = React.useRef<TeamSectionsReconciler | null>(null);
+  // The store whose relay read has succeeded; compared by identity so a scope
+  // change is never mistaken for a synced one.
+  const [syncedStore, setSyncedStore] = React.useState<LaneStore | null>(null);
+  const tree = React.useSyncExternalStore(
+    React.useCallback(
+      (fn: () => void) => store?.subscribe(fn) ?? (() => {}),
+      [store],
+    ),
+    () => store?.get() ?? EMPTY,
+  );
+
+  React.useEffect(() => {
+    if (!store || !pubkey || !relayUrl) return;
+    const dTag = teamSectionsDTag(relayUrl);
+    const transport = relayTransport(dTag);
+    const rec = new TeamSectionsReconciler(store, pubkey, transport, dTag);
+    reconcilerRef.current = rec;
+    let disposed = false;
+    let unsubLive: (() => Promise<void>) | null = null;
+    const read = () =>
+      void rec.read().then(
+        () => {
+          if (!disposed) setSyncedStore(store);
+        },
+        () => {},
+      );
+    const detachTabs = store.attachCrossTab();
+    const unsubReconnect = relayClient.subscribeToReconnects(read);
+    void relayClient
+      .subscribeLive({ ...transport.filter, limit: 0 }, (event) => {
+        if (!disposed) rec.ingest(event);
+      })
+      .then((dispose) => {
+        if (disposed) void dispose();
+        else unsubLive = dispose;
+      })
+      .catch(() => {});
+    read();
+    // A missed live event or a failed first read is repaired here.
+    const refresh = setInterval(read, REFRESH_MS);
+    return () => {
+      disposed = true;
+      rec.destroy();
+      reconcilerRef.current = null;
+      clearInterval(refresh);
+      detachTabs();
+      unsubReconnect();
+      if (unsubLive) void unsubLive();
+    };
+  }, [store, pubkey, relayUrl]);
+
+  const edit = React.useCallback(
+    (fn: (tree: Tree) => Tree) => {
+      if (!store) return;
+      const before = store.get();
+      store.transact(fn);
+      if (store.get() !== before) reconcilerRef.current?.defer();
+    },
+    [store],
+  );
+
+  const { sections, assignments } = React.useMemo(
+    () => projectSections(tree),
+    [tree],
+  );
+
+  const createSection = React.useCallback(
+    (name: string, icon?: string): ChannelSection | null => {
+      if (!pubkey || !relayUrl) return null;
+      const id = crypto.randomUUID();
+      let order = 0;
+      edit((prev) => {
+        order = projectSections(prev).sections.length;
+        return setRegs(prev, [
+          [["s", id, "name"], name],
+          [["s", id, "icon"], icon || null],
+          [["s", id, "order"], maxLiveOrder(prev) + 1],
+          [["s", id, "live"], true],
+        ]);
+      });
+      return { id, name, ...(icon ? { icon } : {}), order };
+    },
+    [pubkey, relayUrl, edit],
+  );
+
+  const renameSection = React.useCallback(
+    (sectionId: string, newName: string, icon?: string) =>
+      edit((prev) =>
+        setRegs(prev, [
+          [["s", sectionId, "name"], newName],
+          [["s", sectionId, "icon"], icon || null],
+        ]),
+      ),
+    [edit],
+  );
+
+  const deleteSection = React.useCallback(
+    (sectionId: string) =>
+      edit((prev) => setRegs(prev, [[["s", sectionId, "live"], false]])),
+    [edit],
+  );
+
+  const reorderSections = React.useCallback(
+    (orderedIds: string[]) => edit((prev) => writeOrder(prev, orderedIds)),
+    [edit],
+  );
+
+  const moveSection = React.useCallback(
+    (sectionId: string, step: -1 | 1) =>
+      edit((prev) => {
+        const ids = projectSections(prev).sections.map((s) => s.id);
+        const from = ids.indexOf(sectionId);
+        const to = from + step;
+        if (from < 0 || to < 0 || to >= ids.length) return prev;
+        [ids[from], ids[to]] = [ids[to] as string, sectionId];
+        return writeOrder(prev, ids);
+      }),
+    [edit],
+  );
+  const moveSectionUp = React.useCallback(
+    (sectionId: string) => moveSection(sectionId, -1),
+    [moveSection],
+  );
+  const moveSectionDown = React.useCallback(
+    (sectionId: string) => moveSection(sectionId, 1),
+    [moveSection],
+  );
+
+  const assignChannel = React.useCallback(
+    (channelId: string, sectionId: string) =>
+      edit((prev) => setRegs(prev, [[["a", channelId], sectionId]])),
+    [edit],
+  );
+
+  const unassignChannel = React.useCallback(
+    (channelId: string) =>
+      edit((prev) =>
+        prev.a && own(prev.a as Tree, channelId)
+          ? setRegs(prev, [[["a", channelId], null]])
+          : prev,
+      ),
+    [edit],
+  );
+
+  /** Adds `view`'s sections (after the existing ones) and assignments, as one edit. */
+  const adoptSections = React.useCallback(
+    (view: SectionsView) =>
+      edit((prev) => {
+        const base = maxLiveOrder(prev) + 1;
+        return setRegs(prev, [
+          ...view.sections.flatMap(
+            (section, index): Array<[string[], unknown]> => [
+              [["s", section.id, "name"], section.name],
+              [["s", section.id, "icon"], section.icon ?? null],
+              [["s", section.id, "order"], base + index],
+              [["s", section.id, "live"], true],
+            ],
+          ),
+          ...Object.entries(view.assignments).map(
+            ([channelId, sectionId]): [string[], unknown] => [
+              ["a", channelId],
+              sectionId,
+            ],
+          ),
+        ]);
+      }),
+    [edit],
+  );
+
+  return {
+    sections,
+    assignments,
+    createSection,
+    renameSection,
+    deleteSection,
+    moveSectionUp,
+    moveSectionDown,
+    reorderSections,
+    assignChannel,
+    unassignChannel,
+    adoptSections,
+    /** A relay read of every member's event has succeeded in this scope. */
+    synced: store !== null && syncedStore === store,
+    /** The team layout has never held anything (no registers, no tombstones). */
+    isEmpty: isEmptyTree(tree),
+  };
+}
+
+const seededKey = (pubkey: string, relayUrl: string) =>
+  `buzz-team-sections-seeded.v2:${pubkey}:${encodeURIComponent(normalizeRelayUrl(relayUrl))}`;
+
+/**
+ * Makes the community owner's personal layout the team's starting layout: the
+ * first time the owner's app sees a never-used team layout, it copies the
+ * owner's personal sections into it (see `shouldSeedTeamSections`). Members
+ * who never chose then see that layout by default.
+ */
+export function useSeedTeamSectionsFromOwner(
+  isOwner: boolean,
+  team: {
+    synced: boolean;
+    isEmpty: boolean;
+    adoptSections: (view: SectionsView) => void;
+  },
+  personal: SectionsView,
+  pubkey: string | undefined,
+  relayUrl: string | undefined,
+) {
+  const { synced, isEmpty, adoptSections } = team;
+  const { sections, assignments } = personal;
+  React.useEffect(() => {
+    if (!pubkey || !relayUrl) return;
+    const key = seededKey(pubkey, relayUrl);
+    let alreadySeeded = true;
+    try {
+      alreadySeeded = window.localStorage.getItem(key) !== null;
+    } catch {
+      // Unreadable storage: never seed, rather than seed on every launch.
+    }
+    if (
+      !shouldSeedTeamSections({
+        isOwner,
+        synced,
+        teamEmpty: isEmpty,
+        personalSectionCount: sections.length,
+        alreadySeeded,
+      })
+    )
+      return;
+    try {
+      window.localStorage.setItem(key, "1");
+    } catch {
+      return;
+    }
+    adoptSections({ sections, assignments });
+  }, [
+    isOwner,
+    synced,
+    isEmpty,
+    sections,
+    assignments,
+    adoptSections,
+    pubkey,
+    relayUrl,
+  ]);
+}
+
+const scopeSuffix = (pubkey: string, relayUrl: string) =>
+  `${pubkey}:${encodeURIComponent(normalizeRelayUrl(relayUrl))}`;
+
+/** This install's pre-scoping (v1) cached team layout, if it has one. */
+function readLegacyTeamSections(
+  pubkey: string,
+  relayUrl: string,
+): SectionsView | null {
+  try {
+    const raw = window.localStorage.getItem(
+      `${LEGACY_TEAM_STORAGE_KEY_PREFIX}:${scopeSuffix(pubkey, relayUrl)}`,
+    );
+    const doc = raw ? decodeDoc(TEAM_SECTIONS_LANE, JSON.parse(raw), 1) : null;
+    return doc ? projectSections(doc.tree) : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Carries this community's own sections over from the pre-scoping (v1) cache
+ * into the scoped team layout, once per install, so scoping the events does
+ * not make the team rebuild its layout. Only into a layout nobody has written
+ * yet, and only the sections that hold channels of this community (see
+ * `carryOverTeamSections`). Returns `true` once the decision is made; the
+ * owner seed waits for it so the two never both fill an empty layout.
+ */
+export function useCarryOverTeamSections(
+  team: {
+    synced: boolean;
+    isEmpty: boolean;
+    adoptSections: (view: SectionsView) => void;
+  },
+  channelIds: readonly string[],
+  pubkey: string | undefined,
+  relayUrl: string | undefined,
+): boolean {
+  const { synced, isEmpty, adoptSections } = team;
+  const scope = pubkey && relayUrl ? scopeSuffix(pubkey, relayUrl) : null;
+  const [settledScope, setSettledScope] = React.useState<string | null>(null);
+  React.useEffect(() => {
+    if (!scope || !pubkey || !relayUrl || !synced) return;
+    if (settledScope === scope) return;
+    const key = `buzz-team-sections-carried.v2:${scope}`;
+    let done = true;
+    try {
+      done = window.localStorage.getItem(key) !== null;
+    } catch {
+      // Unreadable storage: never carry over, rather than on every launch.
+    }
+    const legacy = done ? null : readLegacyTeamSections(pubkey, relayUrl);
+    if (!done && legacy && legacy.sections.length > 0 && isEmpty) {
+      // The channel list decides what belongs here; wait for it to load.
+      if (channelIds.length === 0) return;
+      const view = carryOverTeamSections(legacy, channelIds);
+      try {
+        window.localStorage.setItem(key, "1");
+      } catch {
+        return;
+      }
+      if (view) adoptSections(view);
+    } else if (!done) {
+      try {
+        window.localStorage.setItem(key, "1");
+      } catch {
+        // Decided for this session only.
+      }
+    }
+    setSettledScope(scope);
+  }, [
+    scope,
+    pubkey,
+    relayUrl,
+    synced,
+    isEmpty,
+    channelIds,
+    adoptSections,
+    settledScope,
+  ]);
+  return settledScope === scope && scope !== null;
+}
+
+type TeamSectionsPreference = "on" | "off" | null;
+
+const preferenceKey = (pubkey: string, relayUrl: string) =>
+  `buzz-team-sections-pref.v1:${pubkey}:${encodeURIComponent(normalizeRelayUrl(relayUrl))}`;
+
+function readPreference(key: string | null): TeamSectionsPreference {
+  try {
+    const raw = key ? window.localStorage.getItem(key) : null;
+    return raw === "on" || raw === "off" ? raw : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * This install's choice for one pubkey + relay scope: `"on"` shows the team
+ * layout, `"off"` the personal one, and `null` (never chosen) follows the
+ * team layout once it has any section.
+ */
+export function useTeamSectionsPreference(
+  pubkey: string | undefined,
+  relayUrl: string | undefined,
+): [TeamSectionsPreference, (next: boolean) => void] {
+  const key = pubkey && relayUrl ? preferenceKey(pubkey, relayUrl) : null;
+  const [state, setState] = React.useState(() => ({
+    key,
+    value: readPreference(key),
+  }));
+  // Re-read during render when the scope changes, so no frame shows the
+  // previous community's choice.
+  const current =
+    state.key === key ? state : { key, value: readPreference(key) };
+  if (current !== state) setState(current);
+
+  const set = React.useCallback(
+    (next: boolean) => {
+      if (!key) return;
+      const value = next ? "on" : "off";
+      try {
+        window.localStorage.setItem(key, value);
+      } catch {
+        // Still applies for this session.
+      }
+      setState({ key, value });
+    },
+    [key],
+  );
+  return [current.value, set];
+}

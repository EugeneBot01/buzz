diff --git a/desktop/src/features/sidebar/ui/TeamSectionsMenu.tsx b/desktop/src/features/sidebar/ui/TeamSectionsMenu.tsx
new file mode 100644
index 0000000..5936110
--- /dev/null
+++ b/desktop/src/features/sidebar/ui/TeamSectionsMenu.tsx
@@ -0,0 +1,88 @@
+import { Check, Users } from "lucide-react";
+import * as React from "react";
+
+import type { SectionsView } from "@/features/sidebar/lib/channelSectionsSync";
+import {
+  ContextMenuIconSlot,
+  deferMenuAction,
+} from "@/features/sidebar/ui/sidebarMenuHelpers";
+import {
+  ContextMenuItem,
+  ContextMenuSeparator,
+} from "@/shared/ui/context-menu";
+
+type TeamSectionsMenuState = {
+  /** The sidebar is showing the shared team layout. */
+  active: boolean;
+  setActive: (next: boolean) => void;
+  /** Copies the personal layout into the team one; null when there is nothing to copy. */
+  copyPersonal: (() => void) | null;
+};
+
+// What the mounted sidebar currently offers. Channel menus render deep below
+// the sidebar through several prop layers, so they read it from here instead.
+// Set by `useProvideTeamSectionsMenu` and cleared when the sidebar unmounts
+// (which a community switch does), so nothing outlives its community.
+let current: TeamSectionsMenuState | null = null;
+const listeners = new Set<() => void>();
+
+function publish(next: TeamSectionsMenuState | null) {
+  current = next;
+  for (const listener of listeners) listener();
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+};
+
+/** Called by the sidebar: exposes its team-section state to the channel menus. */
+export function useProvideTeamSectionsMenu(
+  active: boolean,
+  setActive: (next: boolean) => void,
+  personal: SectionsView,
+  adoptSections: (view: SectionsView) => void,
+) {
+  const { sections, assignments } = personal;
+  React.useEffect(() => {
+    publish({
+      active,
+      setActive,
+      copyPersonal:
+        sections.length > 0
+          ? () => adoptSections({ sections, assignments })
+          : null,
+    });
+    return () => publish(null);
+  }, [active, setActive, sections, assignments, adoptSections]);
+}
+
+/** Team-section entries for the channel "Move to section" submenu. */
+export function TeamSectionsMenuItems() {
+  const team = React.useSyncExternalStore(subscribe, () => current);
+  if (!team) return null;
+  const { active, setActive, copyPersonal } = team;
+  return (
+    <>
+      <ContextMenuSeparator />
+      <ContextMenuItem
+        onSelect={() => deferMenuAction(() => setActive(!active))}
+      >
+        <ContextMenuIconSlot>
+          {active ? <Check className="h-4 w-4" /> : null}
+        </ContextMenuIconSlot>
+        <span>Use team sections (shared with everyone)</span>
+      </ContextMenuItem>
+      {active && copyPersonal ? (
+        <ContextMenuItem onSelect={() => deferMenuAction(copyPersonal)}>
+          <ContextMenuIconSlot>
+            <Users className="h-4 w-4" />
+          </ContextMenuIconSlot>
+          <span>Copy my sections to team</span>
+        </ContextMenuItem>
+      ) : null}
+    </>
+  );
+}

+++ b/desktop/src/features/sidebar/lib/teamSectionsSync.test.mjs
@@ -0,0 +1,342 @@
+import assert from "node:assert/strict";
+import test, { beforeEach, mock } from "node:test";
+
+import { projectSections } from "./channelSectionsSync.ts";
+import { encodeDoc } from "./sidebarLaneStore.ts";
+import { canonical, mergeTrees, setRegs } from "./sidebarLwwMap.ts";
+import {
+  TEAM_SECTIONS_D_TAG,
+  TEAM_SECTIONS_LANE,
+  TeamSectionsReconciler,
+  carryOverTeamSections,
+  shouldSeedTeamSections,
+  teamSectionsDTag,
+} from "./teamSectionsSync.ts";
+
+const ALICE = "a".repeat(64);
+const BOB = "b".repeat(64);
+
+const storage = new Map();
+globalThis.window ??= {};
+globalThis.window.localStorage = {
+  getItem: (k) => storage.get(k) ?? null,
+  setItem: (k, v) => storage.set(k, v),
+  removeItem: (k) => storage.delete(k),
+};
+
+beforeEach(() => {
+  storage.clear();
+  mock.restoreAll();
+  mock.timers.reset();
+  mock.timers.enable({ apis: ["setTimeout", "Date"], now: 1_800_000_000_000 });
+});
+
+/** A member: in-memory tree store, a reconciler, and a scripted relay. */
+function member(pubkey, relay) {
+  let tree = {};
+  const store = {
+    get: () => tree,
+    merge: (remote) => {
+      tree = mergeTrees(tree, remote);
+    },
+  };
+  const me = { pubkey, published: [], failPublish: 0, failFetch: false };
+  me.rec = new TeamSectionsReconciler(store, pubkey, {
+    fetch: async () => {
+      if (me.failFetch) throw new Error("offline");
+      return [...relay.values()];
+    },
+    publish: async (content, createdAt) => {
+      if (me.failPublish > 0) {
+        me.failPublish--;
+        throw new Error("rejected");
+      }
+      const event = ev(pubkey, content, createdAt);
+      me.published.push(event);
+      relay.set(pubkey, event);
+    },
+  });
+  me.tree = () => tree;
+  me.view = () => projectSections(tree);
+  me.edit = (fn) => {
+    tree = fn(tree);
+    me.rec.defer();
+  };
+  return me;
+}
+
+let seq = 0;
+function ev(pubkey, content, createdAt, dTag = TEAM_SECTIONS_D_TAG) {
+  return {
+    id: `id-${String(++seq).padStart(6, "0")}`,
+    pubkey,
+    kind: 30078,
+    content,
+    created_at: createdAt,
+    tags: [
+      ["d", dTag],
+      ["t", dTag],
+    ],
+    sig: "s",
+  };
+}
+
+const addSection = (id, name) => (tree) =>
+  setRegs(tree, [
+    [["s", id, "name"], name],
+    [["s", id, "icon"], null],
+    [["s", id, "order"], 0],
+    [["s", id, "live"], true],
+  ]);
+const assign = (channelId, sectionId) => (tree) =>
+  setRegs(tree, [[["a", channelId], sectionId]]);
+
+/** Runs the debounce/backoff timers and lets async publishes settle. */
+async function settle(ms = 2_000) {
+  mock.timers.tick(ms);
+  for (let i = 0; i < 10; i++) await Promise.resolve();
+}
+
+test("an edit publishes one plaintext event that another member merges without echoing", async () => {
+  const relay = new Map();
+  const alice = member(ALICE, relay);
+  const bob = member(BOB, relay);
+  await alice.rec.read();
+  await bob.rec.read();
+
+  alice.edit(addSection("s1", "Work"));
+  alice.edit(assign("chan-1", "s1"));
+  assert.equal(alice.published.length, 0, "debounced");
+  await settle();
+  assert.equal(alice.published.length, 1);
+  const doc = JSON.parse(alice.published[0].content);
+  assert.deepEqual(doc.sections, [{ id: "s1", name: "Work", order: 0 }]);
+  assert.deepEqual(doc.assignments, { "chan-1": "s1" });
+
+  bob.rec.ingest(alice.published[0]);
+  assert.deepEqual(bob.view(), alice.view());
+  await settle(60_000);
+  assert.equal(bob.published.length, 0, "reading never causes a write");
+  assert.equal(alice.published.length, 1, "no republish without a new edit");
+});
+
+test("edits by two members converge on both sides, per field", async () => {
+  const relay = new Map();
+  const alice = member(ALICE, relay);
+  const bob = member(BOB, relay);
+  await alice.rec.read();
+  await bob.rec.read();
+
+  alice.edit(addSection("s1", "Work"));
+  await settle();
+  bob.rec.ingest(alice.published[0]);
+
+  // Concurrent edits to different fields both survive.
+  alice.edit(assign("chan-1", "s1"));
+  mock.timers.tick(5);
+  bob.edit((tree) => setRegs(tree, [[["s", "s1", "name"], "Workroom"]]));
+  await settle();
+  alice.rec.ingest(bob.published.at(-1));
+  bob.rec.ingest(alice.published.at(-1));
+
+  const expected = {
+    sections: [{ id: "s1", name: "Workroom", order: 0 }],
+    assignments: { "chan-1": "s1" },
+  };
+  assert.deepEqual(alice.view(), expected);
+  assert.deepEqual(bob.view(), expected);
+  assert.equal(canonical(alice.tree()), canonical(bob.tree()));
+
+  // Between them the two events already carry every register, so merging
+  // the other side's edit triggers no further publish.
+  const counts = [alice.published.length, bob.published.length];
+  await settle(60_000);
+  assert.deepEqual([alice.published.length, bob.published.length], counts);
+  assert.equal(alice.rec.needsPublish(), false);
+  assert.equal(bob.rec.needsPublish(), false);
+});
+
+test("a deleted section stays deleted for a member who still held it", async () => {
+  const relay = new Map();
+  const alice = member(ALICE, relay);
+  const bob = member(BOB, relay);
+  await alice.rec.read();
+  alice.edit(addSection("s1", "Work"));
+  await settle();
+  await bob.rec.read();
+  assert.equal(bob.view().sections.length, 1);
+
+  mock.timers.tick(5);
+  alice.edit((tree) => setRegs(tree, [[["s", "s1", "live"], false]]));
+  await settle();
+  bob.rec.ingest(alice.published.at(-1));
+  assert.deepEqual(bob.view(), { sections: [], assignments: {} });
+});
+
+test("nothing is published before a read succeeds, then the pending edit goes out", async () => {
+  const relay = new Map();
+  const alice = member(ALICE, relay);
+  alice.failFetch = true;
+  await assert.rejects(alice.rec.read());
+  alice.edit(addSection("s1", "Work"));
+  await settle(60_000);
+  assert.equal(alice.published.length, 0);
+
+  alice.failFetch = false;
+  await alice.rec.read();
+  await settle();
+  assert.equal(alice.published.length, 1);
+});
+
+test("a failed publish retries behind the backoff", async () => {
+  const relay = new Map();
+  const alice = member(ALICE, relay);
+  await alice.rec.read();
+  alice.failPublish = 1;
+  alice.edit(addSection("s1", "Work"));
+  await settle();
+  assert.equal(alice.published.length, 0);
+  await settle(4_000);
+  assert.equal(alice.published.length, 0, "still inside the 5s backoff");
+  await settle(1_000);
+  assert.equal(alice.published.length, 1);
+});
+
+test("unreadable, foreign-coordinate, oversized and stale events are ignored", async () => {
+  const relay = new Map();
+  const bob = member(BOB, relay);
+  await bob.rec.read();
+  const good = canonical(
+    encodeDoc(TEAM_SECTIONS_LANE, addSection("s1", "Work")({})),
+  );
+  const legacy = JSON.stringify({
+    version: 1,
+    sections: [{ id: "x", name: "Legacy", order: 0 }],
+    assignments: {},
+  });
+
+  bob.rec.ingest(ev(ALICE, "not json", 10));
+  bob.rec.ingest(ev(ALICE, legacy, 10));
+  bob.rec.ingest(ev(ALICE, good, 10, "channel-sections"));
+  bob.rec.ingest(ev(ALICE, `${good}${" ".repeat(70_000)}`, 10));
+  assert.deepEqual(bob.view(), { sections: [], assignments: {} });
+
+  bob.rec.ingest(ev(ALICE, good, 10));
+  assert.equal(bob.view().sections.length, 1);
+
+  // An older event from the same author never replaces the newer one.
+  const renamed = canonical(
+    encodeDoc(TEAM_SECTIONS_LANE, addSection("s2", "Old")({})),
+  );
+  bob.rec.ingest(ev(ALICE, renamed, 9));
+  assert.deepEqual(
+    bob.view().sections.map((s) => s.id),
+    ["s1"],
+  );
+  await settle(60_000);
+  assert.equal(bob.published.length, 0);
+});
+
+test("only the owner seeds, only a never-used team layout, only once", () => {
+  const ok = {
+    isOwner: true,
+    synced: true,
+    teamEmpty: true,
+    personalSectionCount: 3,
+    alreadySeeded: false,
+  };
+  assert.equal(shouldSeedTeamSections(ok), true);
+  assert.equal(shouldSeedTeamSections({ ...ok, isOwner: false }), false);
+  // Before a read succeeds an existing team layout would look empty.
+  assert.equal(shouldSeedTeamSections({ ...ok, synced: false }), false);
+  assert.equal(shouldSeedTeamSections({ ...ok, teamEmpty: false }), false);
+  assert.equal(
+    shouldSeedTeamSections({ ...ok, personalSectionCount: 0 }),
+    false,
+  );
+  assert.equal(shouldSeedTeamSections({ ...ok, alreadySeeded: true }), false);
+});
+
+test("a community only merges events published under its own d tag", async () => {
+  const here = teamSectionsDTag("wss://a.example.com/");
+  const there = teamSectionsDTag("wss://b.example.com");
+  assert.notEqual(here, there);
+  assert.equal(here, teamSectionsDTag("WSS://A.example.com"));
+
+  let tree = {};
+  const store = {
+    get: () => tree,
+    merge: (remote) => {
+      tree = mergeTrees(tree, remote);
+    },
+  };
+  const doc = (id, name) =>
+    canonical(encodeDoc(TEAM_SECTIONS_LANE, addSection(id, name)({})));
+  const rec = new TeamSectionsReconciler(
+    store,
+    ALICE,
+    { fetch: async () => [], publish: async () => {} },
+    here,
+  );
+  // Another community's layout, and a pre-scoping (bare d tag) event.
+  rec.ingest(ev(BOB, doc("s1", "Theirs"), 10, there));
+  rec.ingest(ev(BOB, doc("s2", "Legacy"), 11));
+  assert.deepEqual(projectSections(tree).sections, []);
+  rec.ingest(ev(BOB, doc("s3", "Ours"), 12, here));
+  assert.deepEqual(
+    projectSections(tree).sections.map((s) => s.name),
+    ["Ours"],
+  );
+});
+
+test("a publish in flight when the scope is torn down is told it is stale", async () => {
+  let tree = {};
+  const store = {
+    get: () => tree,
+    merge: (remote) => {
+      tree = mergeTrees(tree, remote);
+    },
+  };
+  let current = null;
+  let release = () => {};
+  const rec = new TeamSectionsReconciler(store, ALICE, {
+    fetch: async () => [],
+    publish: (_content, _createdAt, isCurrent) => {
+      current = isCurrent;
+      return new Promise((resolve) => {
+        release = resolve;
+      });
+    },
+  });
+  await rec.read();
+  tree = addSection("s1", "Work")(tree);
+  rec.defer();
+  await settle();
+  assert.equal(current(), true);
+  rec.destroy();
+  assert.equal(current(), false, "a community switch cancels the send");
+  release();
+  await settle();
+});
+
+test("carry-over keeps only sections that hold this community's channels", () => {
+  const legacy = {
+    sections: [
+      { id: "s1", name: "Work", order: 0 },
+      { id: "s2", name: "Elsewhere", order: 1 },
+      { id: "s3", name: "Empty", order: 2 },
+      { id: "s4", name: "Play", order: 3 },
+    ],
+    assignments: { "c-1": "s1", "c-2": "s1", "x-1": "s2", "c-3": "s4" },
+  };
+  assert.deepEqual(carryOverTeamSections(legacy, ["c-1", "c-3", "c-9"]), {
+    sections: [
+      { id: "s1", name: "Work", order: 0 },
+      { id: "s4", name: "Play", order: 3 },
+    ],
+    assignments: { "c-1": "s1", "c-3": "s4" },
+  });
+  // Another community's layout: no channel matches, nothing is carried.
+  assert.equal(carryOverTeamSections(legacy, ["y-1", "y-2"]), null);
+  assert.equal(carryOverTeamSections(legacy, []), null);
+});

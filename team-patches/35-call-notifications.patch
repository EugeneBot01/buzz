+/**
+ * Turn protocol payloads into readable text. Huddle starts carry JSON
+ * (`{"ephemeral_channel_id": ...}`) and waves carry an HTML-comment marker;
+ * neither is meant to be shown raw.
+ */
+function readableContent(content: string): string {
+  const withoutComments = content.replace(/<!--[\s\S]*?-->/g, "").trim();
+  if (/^[{[]/.test(withoutComments)) {
+    try {
+      JSON.parse(withoutComments);
+      return "";
+    } catch {
+      // Not JSON — show as written.
+    }
+  }
+  return withoutComments;
+}
 

diff --git a/desktop/src/features/notifications/lib/notificationFormat.test.mjs b/desktop/src/features/notifications/lib/notificationFormat.test.mjs
index 162cb6a43..11e3f3b84 100644
--- a/desktop/src/features/notifications/lib/notificationFormat.test.mjs
+++ b/desktop/src/features/notifications/lib/notificationFormat.test.mjs
@@ -161,3 +161,30 @@ test("senderNameFromSummary prefers displayName, then NIP-05, never a pubkey", (
   assert.equal(senderNameFromSummary(null), null);
   assert.equal(senderNameFromSummary(undefined), null);
 });
+
+test("a DM huddle start reads as an incoming call, not raw JSON", () => {
+  const content = JSON.stringify({ ephemeral_channel_id: "8a7f0c1e-0000-4000-8000-000000000000" });
+  const en = formatMessageNotification({ source: "dm", senderName: "Alice", content, kind: 48100, locale: "en" });
+  assert.equal(en.title, "📞 Alice is calling you");
+  assert.equal(en.body, "Click to join the call.");
+  const ko = formatMessageNotification({ source: "dm", senderName: "성태엄마", content, kind: 48100, locale: "ko" });
+  assert.equal(ko.title, "📞 성태엄마님의 전화");
+  assert.equal(ko.body, "눌러서 통화에 참여하세요.");
+});
+
+test("a wave drops its protocol marker", () => {
+  const content = "<!-- buzz:wave:v1 -->\nAlice waved at you.";
+  const ko = formatMessageNotification({ source: "dm", senderName: "Alice", content, locale: "ko" });
+  assert.equal(ko.body, "👋 Alice님이 손을 흔들었어요.");
+  assert.ok(!ko.body.includes("<!--"));
+});
+
+test("JSON payloads fall back to neutral copy instead of leaking", () => {
+  const { body } = formatMessageNotification({ source: "channel_message", senderName: "Bot", channelName: "general", content: '{"type":"status","ok":true}', locale: "ko" });
+  assert.equal(body, "새 메시지");
+});
+
+test("Korean copy localizes mention titles", () => {
+  const { title } = formatMessageNotification({ source: "mention", senderName: "구윤", channelName: "제작부", content: "확인 부탁", locale: "ko" });
+  assert.equal(title, "구윤님이 회원님을 언급했어요 · #제작부");
+});

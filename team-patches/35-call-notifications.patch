+/**
+ * Notification copy follows the OS language (Korean on a Korean Mac) unless
+ * the user switched the Buzz UI to English. Kept independent of the DOM
+ * translation layer: OS notifications never pass through the DOM.
+ */
+export function resolveNotificationLocale(): NotificationLocale {
+  try {
+    if (window.localStorage.getItem("buzz-ui-locale") === "en") return "en";
+  } catch {
+    // Storage unavailable — fall through to the OS language.
+  }
+  try {
+    return navigator.language?.toLowerCase().startsWith("ko") ? "ko" : "en";
+  } catch {
+    return "en";
+  }

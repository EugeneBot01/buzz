+/**
+ * Where an entry shows: `both` views, the sprint board only (a goal) or the
+ * calendar only (a step such as a meeting).
+ */
+export type CalendarShow = "both" | "sprint" | "calendar";
+
+export const CALENDAR_SHOW_VALUES: readonly CalendarShow[] = [
+  "both",
+  "sprint",
+  "calendar",
+];
+
+/** The view(s) `entry` shows in; an entry without `show` uses the default. */
+export function entryShow(entry: Pick<CalendarEntry, "show" | "repeat">) {
+  if (entry.show) return entry.show;
+  return entry.repeat ? "calendar" : "both";
+}
+
+export const showsOnSprint = (entry: Pick<CalendarEntry, "show" | "repeat">) =>
+  entryShow(entry) !== "calendar";
+
+export const showsOnCalendar = (
+  entry: Pick<CalendarEntry, "show" | "repeat">,
+) => entryShow(entry) !== "sprint";
+

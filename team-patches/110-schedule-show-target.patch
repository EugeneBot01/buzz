+  const entries = [
+    entry("keystaff", { date: "2026-09-16", time: "20:00", repeat: weekly }),
+    entry("goal", { date: "2026-10-01", dept: "ALL", show: "sprint" }),
+    entry("meeting", { date: "2026-10-02", dept: "ALL", show: "calendar" }),
+    entry("both", { date: "2026-10-03", dept: "ALL" }),
+  ];
+  assert.deepEqual(
+    entries.map(entryShow),
+    ["calendar", "sprint", "calendar", "both"],
+  );
+  assert.deepEqual(
+    entries.filter(showsOnSprint).map((e) => e.id),
+    ["goal", "both"],
+  );
+  assert.deepEqual(
+    entries.filter(showsOnCalendar).map((e) => e.id),
+    ["keystaff", "meeting", "both"],
+  );
+  const cells = sprintCells(plan(), entries);
+  // The weekly meeting has no department: it would have made a 부서 미지정
+  // row on every week. Now it stays on the calendar only.
+  assert.equal(cells.has(UNASSIGNED_ROW), false);
+  assert.equal(
+    sprintRows(plan(), entries).some((row) => row.key === UNASSIGNED_ROW),
+    false,
+  );
+  assert.deepEqual(
+    cells.get("ALL")[2].map((item) => item.entry.id),
+    ["goal", "both"],
+  );
+});
+

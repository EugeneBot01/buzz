diff --git a/desktop/src/features/team-calendar/ui/ExportPanel.tsx b/desktop/src/features/team-calendar/ui/ExportPanel.tsx
new file mode 100644
index 000000000..7806edfc1
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/ExportPanel.tsx
@@ -0,0 +1,337 @@
+import { Download } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import { buildCalendarBackup } from "@/features/team-calendar/lib/calendarImport";
+import {
+  pagesToPdf,
+  pagesToPng,
+} from "@/features/team-calendar/lib/exportCanvas";
+import {
+  buildDocx,
+  fileSafe,
+} from "@/features/team-calendar/lib/exportFormats";
+import {
+  type BoardPage,
+  calendarPages,
+  entriesCsv,
+  sprintPages,
+} from "@/features/team-calendar/lib/exportModel";
+import type { TeamPerson } from "@/features/team-calendar/lib/teamAvailability";
+import { addDays, shiftMonth } from "@/features/team-calendar/lib/teamCalendar";
+import {
+  type SprintPlan,
+  planEnd,
+  planMonths,
+  sprintWeeks,
+} from "@/features/team-calendar/lib/teamSprint";
+import {
+  type ExportKind,
+  saveExportFile,
+} from "@/features/team-calendar/lib/saveExport";
+import { fetchEntriesForMonths } from "@/features/team-calendar/lib/useTeamCalendar";
+import { cn } from "@/shared/lib/cn";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import { SELECT_CLASS } from "./EntryForm";
+
+type View = "sprint" | "calendar";
+
+const FORMATS: Array<{ kind: ExportKind; label: string; hint: string }> = [
+  { kind: "png", label: "PNG 이미지", hint: "한 장의 이미지 (메신저 공유용)" },
+  { kind: "pdf", label: "PDF", hint: "A4 가로, 인쇄용" },
+  { kind: "docx", label: "Word (DOCX)", hint: "표로 들어가서 고칠 수 있어요" },
+  { kind: "csv", label: "CSV (엑셀)", hint: "일정 목록" },
+  { kind: "json", label: "백업 (JSON)", hint: "다시 가져오기용 전체 백업" },
+];
+
+const MAX_EXPORT_MONTHS = 12;
+
+function monthsBetween(from: string, to: string): string[] {
+  const months: string[] = [];
+  for (
+    let month = from;
+    month <= to && months.length < MAX_EXPORT_MONTHS;
+    month = shiftMonth(month, 1)
+  )
+    months.push(month);
+  return months;
+}
+
+/**
+ * "배포" (team patch): saves the sprint board or the month calendar as PNG,
+ * PDF or Word, the entries as CSV, or everything as a backup file.
+ */
+export function ExportPanel({
+  pubkey,
+  relayUrl,
+  plan,
+  people,
+  initialView,
+  month,
+  today,
+  onClose,
+}: {
+  pubkey: string;
+  relayUrl: string;
+  plan: SprintPlan;
+  people: TeamPerson[];
+  initialView: View;
+  month: string;
+  today: string;
+  onClose: () => void;
+}) {
+  const weeks = sprintWeeks(plan);
+  const [view, setView] = React.useState<View>(initialView);
+  const [kind, setKind] = React.useState<ExportKind>("png");
+  const [fromWeek, setFromWeek] = React.useState(0);
+  const [toWeek, setToWeek] = React.useState(plan.weeks - 1);
+  const [fromMonth, setFromMonth] = React.useState(month);
+  const [toMonth, setToMonth] = React.useState(month);
+  const [busy, setBusy] = React.useState(false);
+
+  const deptLabel = (key: string) =>
+    plan.depts.find((dept) => dept.key === key)?.label;
+  const months = monthsBetween(fromMonth, toMonth);
+  const rangeError =
+    view === "sprint"
+      ? fromWeek > toWeek
+        ? "끝 주가 시작 주보다 빠릅니다."
+        : null
+      : !fromMonth || !toMonth || fromMonth > toMonth
+        ? "끝 달이 시작 달보다 빠릅니다."
+        : shiftMonth(fromMonth, MAX_EXPORT_MONTHS - 1) < toMonth
+          ? `한 번에 ${MAX_EXPORT_MONTHS}개월까지 내보낼 수 있습니다.`
+          : null;
+
+  const filename = () => {
+    const base =
+      view === "sprint"
+        ? `${plan.title} ${weeks[fromWeek]?.id}-${weeks[toWeek]?.id}`
+        : `팀 캘린더 ${fromMonth}${toMonth !== fromMonth ? `~${toMonth}` : ""}`;
+    return `${fileSafe(kind === "json" ? `${plan.title} 백업 ${today}` : base)}.${kind}`;
+  };
+
+  const build = async (): Promise<Uint8Array> => {
+    const neededMonths =
+      kind === "json" || view === "sprint" ? planMonths(plan) : months;
+    const fetchMonths =
+      view === "calendar" && kind !== "json"
+        ? [shiftMonth(months[0] ?? month, -1), ...months]
+        : neededMonths;
+    const entries = await fetchEntriesForMonths(pubkey, relayUrl, fetchMonths);
+    if (kind === "json") {
+      return new TextEncoder().encode(
+        buildCalendarBackup({ plan, entries, people }),
+      );
+    }
+    if (kind === "csv") {
+      const from =
+        view === "sprint"
+          ? (weeks[fromWeek]?.start ?? plan.start)
+          : `${months[0]}-01`;
+      const to =
+        view === "sprint"
+          ? (weeks[toWeek]?.end ?? planEnd(plan))
+          : addDays(
+              `${shiftMonth(months[months.length - 1] ?? month, 1)}-01`,
+              -1,
+            );
+      return new TextEncoder().encode(
+        entriesCsv({ entries, from, to, deptLabel }),
+      );
+    }
+    const pages: BoardPage[] =
+      view === "sprint"
+        ? sprintPages({
+            plan,
+            entries,
+            fromWeek,
+            toWeek,
+            today,
+            paginate: kind !== "png",
+          })
+        : calendarPages({
+            title: plan.title,
+            months,
+            entries,
+            today,
+            deptLabel,
+          });
+    if (kind === "png") return pagesToPng(pages);
+    if (kind === "pdf") return pagesToPdf(pages);
+    return buildDocx(pages);
+  };
+
+  const run = async () => {
+    if (busy || rangeError) return;
+    setBusy(true);
+    try {
+      const bytes = await build();
+      const saved = await saveExportFile(bytes, filename(), kind);
+      if (saved)
+        toast.success("파일을 저장했습니다.", { description: filename() });
+    } catch (error) {
+      toast.error("파일을 만들지 못했습니다.", {
+        description: error instanceof Error ? error.message : String(error),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="flex flex-col gap-4 text-xs" data-testid="export-panel">
+      <fieldset className="flex flex-col gap-1.5">
+        <legend className="mb-1 text-sm font-semibold">1. 어떤 모양으로</legend>
+        <div className="grid grid-cols-2 gap-2">
+          {(
+            [
+              ["sprint", "스프린트 보드", "부서 × 주차 표 (마스터 플랜 형식)"],
+              ["calendar", "달력", "월별 달력"],
+            ] as const
+          ).map(([value, label, hint]) => (
+            <button
+              aria-pressed={view === value}
+              className={cn(
+                "rounded-lg border px-3 py-2 text-left transition-colors hover:bg-muted",
+                view === value
+                  ? "border-primary bg-primary/5"
+                  : "border-border",
+              )}
+              data-testid={`export-view-${value}`}
+              disabled={kind === "json"}
+              key={value}
+              onClick={() => setView(value)}
+              type="button"
+            >
+              <span className="block text-sm font-semibold">{label}</span>
+              <span className="text-muted-foreground">{hint}</span>
+            </button>
+          ))}
+        </div>
+      </fieldset>
+
+      <fieldset className="flex flex-col gap-1.5">
+        <legend className="mb-1 text-sm font-semibold">2. 범위</legend>
+        {kind === "json" ? (
+          <p className="text-muted-foreground">
+            백업은 보드 설정, 보드 기간의 모든 일정, 반복 일정, 팀원 일정을 한
+            파일로 담습니다.
+          </p>
+        ) : view === "sprint" ? (
+          <div className="flex items-center gap-2">
+            <select
+              aria-label="시작 주"
+              className={SELECT_CLASS}
+              data-testid="export-from-week"
+              onChange={(event) => setFromWeek(Number(event.target.value))}
+              value={fromWeek}
+            >
+              {weeks.map((week) => (
+                <option key={week.id} value={week.index}>
+                  {week.id} ({week.start.slice(5)})
+                </option>
+              ))}
+            </select>
+            ~
+            <select
+              aria-label="끝 주"
+              className={SELECT_CLASS}
+              data-testid="export-to-week"
+              onChange={(event) => setToWeek(Number(event.target.value))}
+              value={toWeek}
+            >
+              {weeks.map((week) => (
+                <option key={week.id} value={week.index}>
+                  {week.id} ({week.end.slice(5)})
+                </option>
+              ))}
+            </select>
+            <Button
+              onClick={() => {
+                setFromWeek(0);
+                setToWeek(plan.weeks - 1);
+              }}
+              size="xs"
+              type="button"
+              variant="ghost"
+            >
+              전체
+            </Button>
+          </div>
+        ) : (
+          <div className="flex items-center gap-2">
+            <Input
+              aria-label="시작 달"
+              className="w-40"
+              data-testid="export-from-month"
+              onChange={(event) => setFromMonth(event.target.value)}
+              type="month"
+              value={fromMonth}
+            />
+            ~
+            <Input
+              aria-label="끝 달"
+              className="w-40"
+              data-testid="export-to-month"
+              onChange={(event) => setToMonth(event.target.value)}
+              type="month"
+              value={toMonth}
+            />
+          </div>
+        )}
+        {rangeError && kind !== "json" ? (
+          <p className="text-destructive" role="alert">
+            {rangeError}
+          </p>
+        ) : null}
+      </fieldset>
+
+      <fieldset className="flex flex-col gap-1.5">
+        <legend className="mb-1 text-sm font-semibold">3. 파일 형식</legend>
+        <div className="grid grid-cols-2 gap-2 sm:grid-cols-5">
+          {FORMATS.map((format) => (
+            <button
+              aria-pressed={kind === format.kind}
+              className={cn(
+                "rounded-lg border px-3 py-2 text-left transition-colors hover:bg-muted",
+                kind === format.kind
+                  ? "border-primary bg-primary/5"
+                  : "border-border",
+              )}
+              data-testid={`export-kind-${format.kind}`}
+              key={format.kind}
+              onClick={() => setKind(format.kind)}
+              type="button"
+            >
+              <span className="block text-sm font-semibold">
+                {format.label}
+              </span>
+              <span className="text-muted-foreground">{format.hint}</span>
+            </button>
+          ))}
+        </div>
+      </fieldset>
+
+      <div className="flex items-center justify-between gap-2 border-t border-border/60 pt-3">
+        <p className="min-w-0 truncate text-muted-foreground">{filename()}</p>
+        <div className="flex gap-2">
+          <Button onClick={onClose} size="sm" type="button" variant="ghost">
+            닫기
+          </Button>
+          <Button
+            data-testid="export-run"
+            disabled={busy || (rangeError !== null && kind !== "json")}
+            onClick={() => void run()}
+            size="sm"
+            type="button"
+          >
+            <Download className="h-4 w-4" />
+            {busy ? "만드는 중…" : "다운로드"}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/desktop/src/features/team-calendar/ui/ImportPanel.tsx b/desktop/src/features/team-calendar/ui/ImportPanel.tsx
new file mode 100644
index 000000000..3df125854
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/ImportPanel.tsx
@@ -0,0 +1,232 @@
+import { FileUp } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import {
+  type CalendarImport,
+  parseCalendarImport,
+} from "@/features/team-calendar/lib/calendarImport";
+import { saveEntriesToDocs } from "@/features/team-calendar/lib/useTeamCalendar";
+import type {
+  PersonInput,
+  SprintPlanInput,
+} from "@/features/team-calendar/lib/useTeamSprint";
+import { Button } from "@/shared/ui/button";
+
+/** Most bytes of an import file (a full team backup is well under this). */
+const MAX_IMPORT_BYTES = 2 * 1024 * 1024;
+
+/**
+ * "가져오기" (team patch): loads a master plan / backup file into the shared
+ * calendar. Nothing is written until the person presses "가져오기" after the
+ * preview. Ids in the file are kept, so importing the same file again
+ * updates instead of duplicating.
+ */
+export function ImportPanel({
+  pubkey,
+  relayUrl,
+  hasPlan,
+  onSavePlan,
+  onSavePeople,
+  onImported,
+  onClose,
+}: {
+  pubkey: string;
+  relayUrl: string;
+  /** A plan is already saved (importing one replaces it). */
+  hasPlan: boolean;
+  onSavePlan: (plan: SprintPlanInput) => Promise<void>;
+  onSavePeople: (people: PersonInput[]) => Promise<void>;
+  /** Called after an import (also a partial one) so views read again. */
+  onImported: () => void;
+  onClose: () => void;
+}) {
+  const [file, setFile] = React.useState<{
+    name: string;
+    data: CalendarImport;
+  } | null>(null);
+  const [error, setError] = React.useState<string | null>(null);
+  const [include, setInclude] = React.useState({
+    plan: true,
+    entries: true,
+    people: true,
+  });
+  const [progress, setProgress] = React.useState<string | null>(null);
+  const aliveRef = React.useRef(true);
+  React.useEffect(() => {
+    aliveRef.current = true;
+    return () => {
+      aliveRef.current = false;
+    };
+  }, []);
+
+  const pick = async (picked: File | undefined) => {
+    setError(null);
+    setFile(null);
+    if (!picked) return;
+    if (picked.size > MAX_IMPORT_BYTES) {
+      setError("파일이 너무 큽니다 (2MB까지).");
+      return;
+    }
+    try {
+      const data = parseCalendarImport(await picked.text());
+      setFile({ name: picked.name, data });
+      setInclude({
+        plan: data.plan !== null,
+        entries: data.entries.length > 0,
+        people: data.people.length > 0,
+      });
+    } catch (problem) {
+      setError(problem instanceof Error ? problem.message : String(problem));
+    }
+  };
+
+  const run = async () => {
+    if (!file || progress) return;
+    const { data } = file;
+    try {
+      if (include.plan && data.plan) {
+        setProgress("보드 설정 저장 중…");
+        await onSavePlan(data.plan);
+      }
+      if (include.entries && data.entries.length > 0) {
+        setProgress(`일정 저장 중… 0/${data.entries.length}`);
+        const saved = await saveEntriesToDocs({
+          pubkey,
+          relayUrl,
+          entries: data.entries,
+          isCurrent: () => aliveRef.current,
+          onProgress: (done, total) => {
+            if (aliveRef.current) setProgress(`일정 저장 중… ${done}/${total}`);
+          },
+        });
+        if (saved < data.entries.length)
+          throw new Error(`일정 ${saved}/${data.entries.length}개까지만 저장했습니다.`);
+      }
+      if (include.people && data.people.length > 0) {
+        setProgress("팀원 일정 저장 중…");
+        await onSavePeople(data.people);
+      }
+      toast.success("가져오기를 마쳤습니다.");
+      onClose();
+    } catch (problem) {
+      toast.error("가져오는 중에 멈췄습니다.", {
+        description: `${
+          problem instanceof Error ? problem.message : String(problem)
+        } — 같은 파일을 다시 가져오면 이어서 맞춰집니다.`,
+      });
+    } finally {
+      // Months that opened while importing may have missed the new entries.
+      onImported();
+      if (aliveRef.current) setProgress(null);
+    }
+  };
+
+  const ruleCount =
+    file?.data.people.reduce((sum, person) => sum + person.rules.length, 0) ??
+    0;
+  const nothing =
+    !file ||
+    !(
+      (include.plan && file.data.plan) ||
+      (include.entries && file.data.entries.length) ||
+      (include.people && file.data.people.length)
+    );
+
+  return (
+    <div className="flex flex-col gap-4 text-xs" data-testid="import-panel">
+      <p className="text-muted-foreground">
+        마스터 플랜·팀원 일정 파일(<code>buzz-team-calendar</code> 형식 JSON)
+        또는 "배포 → 백업"으로 받은 파일을 불러옵니다. 가져온 내용은 이
+        커뮤니티의 모든 멤버에게 보입니다.
+      </p>
+      <label className="flex cursor-pointer items-center justify-center gap-2 rounded-lg border-2 border-dashed border-border px-4 py-6 text-sm hover:bg-muted">
+        <FileUp className="h-5 w-5" />
+        {file ? file.name : "파일 고르기"}
+        <input
+          accept="application/json,.json"
+          className="sr-only"
+          data-testid="import-file"
+          onChange={(event) => void pick(event.target.files?.[0])}
+          type="file"
+        />
+      </label>
+      {error ? (
+        <p className="text-destructive" data-testid="import-error" role="alert">
+          {error}
+        </p>
+      ) : null}
+      {file ? (
+        <fieldset className="flex flex-col gap-2" data-testid="import-preview">
+          <legend className="mb-1 text-sm font-semibold">가져올 내용</legend>
+          <label className="flex items-center gap-2">
+            <input
+              checked={include.plan}
+              disabled={!file.data.plan}
+              onChange={(event) =>
+                setInclude({ ...include, plan: event.target.checked })
+              }
+              type="checkbox"
+            />
+            보드 설정{" "}
+            {file.data.plan
+              ? `“${file.data.plan.title}” ${file.data.plan.start}부터 ${file.data.plan.weeks}주, 부서 ${file.data.plan.depts.length}개${hasPlan ? " (지금 설정을 바꿉니다)" : ""}`
+              : "없음"}
+          </label>
+          <label className="flex items-center gap-2">
+            <input
+              checked={include.entries}
+              disabled={file.data.entries.length === 0}
+              onChange={(event) =>
+                setInclude({ ...include, entries: event.target.checked })
+              }
+              type="checkbox"
+            />
+            일정 {file.data.entries.length}개 (스프린트·달력에 함께 보임)
+          </label>
+          <label className="flex items-center gap-2">
+            <input
+              checked={include.people}
+              disabled={file.data.people.length === 0}
+              onChange={(event) =>
+                setInclude({ ...include, people: event.target.checked })
+              }
+              type="checkbox"
+            />
+            팀원 {file.data.people.length}명의 일정 {ruleCount}개 (같은 팀원은
+            덮어씀)
+          </label>
+        </fieldset>
+      ) : null}
+      <div className="flex items-center justify-between gap-2 border-t border-border/60 pt-3">
+        <p
+          aria-live="polite"
+          className="text-muted-foreground"
+          data-testid="import-progress"
+        >
+          {progress}
+        </p>
+        <div className="flex gap-2">
+          <Button
+            disabled={progress !== null}
+            onClick={onClose}
+            size="sm"
+            type="button"
+            variant="ghost"
+          >
+            닫기
+          </Button>
+          <Button
+            data-testid="import-run"
+            disabled={nothing || progress !== null}
+            onClick={() => void run()}
+            size="sm"
+            type="button"
+          >
+            가져오기
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/desktop/src/features/team-calendar/ui/SprintBoard.tsx b/desktop/src/features/team-calendar/ui/SprintBoard.tsx
new file mode 100644
index 000000000..77217f2df
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/SprintBoard.tsx
@@ -0,0 +1,397 @@
+import { Plus, Settings2 } from "lucide-react";
+import * as React from "react";
+
+import type {
+  CalendarEntry,
+  CalendarOccurrence,
+} from "@/features/team-calendar/lib/teamCalendar";
+import {
+  type SprintPlan,
+  type SprintWeek,
+  UNASSIGNED_ROW,
+  dDayLabel,
+  phaseOfWeeks,
+  shortDate,
+  sprintCells,
+  sprintRows,
+  sprintWeeks,
+  weekIndexOf,
+} from "@/features/team-calendar/lib/teamSprint";
+import { cn } from "@/shared/lib/cn";
+import { Button } from "@/shared/ui/button";
+import { COLOR_STYLES } from "./EntryForm";
+
+const PHASE_CLASS = {
+  pre: "bg-sky-500/10",
+  prod: "bg-orange-500/15 font-semibold text-orange-700 dark:text-orange-300",
+  post: "bg-green-500/10",
+  other: "bg-muted",
+} as const;
+
+type SprintBoardProps = {
+  plan: SprintPlan;
+  /** True while nobody has saved settings yet (the default plan is shown). */
+  isDefaultPlan: boolean;
+  entries: CalendarEntry[];
+  today: string;
+  /** The day selected in either view; its week is outlined. */
+  selectedDate: string;
+  /** The entry being edited, outlined on the board. */
+  editingId?: string;
+  status: "loading" | "ready" | "error";
+  onSelectWeek: (week: SprintWeek) => void;
+  onAdd: (deptKey: string, week: SprintWeek) => void;
+  onEdit: (entry: CalendarOccurrence) => void;
+  onEditPlan: () => void;
+};
+
+/**
+ * The sprint board (team patch): departments down the side, weekly sprints
+ * across, in the layout of the team's production master plan. Every item is
+ * a team calendar entry, so the month view shows the same items.
+ */
+export function SprintBoard({
+  plan,
+  isDefaultPlan,
+  entries,
+  today,
+  selectedDate,
+  editingId,
+  status,
+  onSelectWeek,
+  onAdd,
+  onEdit,
+  onEditPlan,
+}: SprintBoardProps) {
+  const weeks = React.useMemo(() => sprintWeeks(plan), [plan]);
+  const phases = React.useMemo(() => phaseOfWeeks(plan), [plan]);
+  const cells = React.useMemo(
+    () => sprintCells(plan, entries),
+    [plan, entries],
+  );
+  const rows = React.useMemo(() => sprintRows(plan, entries), [plan, entries]);
+  const currentWeek = weekIndexOf(plan, today);
+  const selectedWeek = weekIndexOf(plan, selectedDate);
+  const colorOf = React.useMemo(
+    () => new Map(plan.depts.map((dept) => [dept.key, dept.color])),
+    [plan.depts],
+  );
+
+  const bands: Array<{ label: string; span: number; tone: string }> = [];
+  for (const phase of phases) {
+    const label = phase?.label ?? "";
+    const tone = phase?.tone ?? "none";
+    const previous = bands[bands.length - 1];
+    if (previous && previous.label === label && previous.tone === tone)
+      previous.span += 1;
+    else bands.push({ label, span: 1, tone });
+  }
+
+  // Bring the selected (else this) week into view when the board opens or
+  // the selection moves to a week that is off screen.
+  const scrollerRef = React.useRef<HTMLDivElement>(null);
+  const focusWeek = selectedWeek >= 0 ? selectedWeek : currentWeek;
+  React.useEffect(() => {
+    const scroller = scrollerRef.current;
+    if (!scroller || focusWeek < 0) return;
+    const header = scroller.querySelector<HTMLElement>(
+      `[data-week-index="${focusWeek}"]`,
+    );
+    if (!header) return;
+    const label = scroller.querySelector<HTMLElement>("[data-sprint-label]");
+    const left = header.offsetLeft - (label?.offsetWidth ?? 0) - 8;
+    const right = header.offsetLeft + header.offsetWidth;
+    if (
+      left < scroller.scrollLeft ||
+      right > scroller.scrollLeft + scroller.clientWidth
+    )
+      scroller.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
+  }, [focusWeek]);
+
+  return (
+    <section aria-label="스프린트 보드" className="flex min-w-0 flex-col gap-3">
+      <header className="flex flex-wrap items-end justify-between gap-3">
+        <div className="min-w-0">
+          <h3 className="text-base font-bold" data-testid="sprint-title">
+            {plan.title}
+          </h3>
+          <p className="text-xs text-muted-foreground">
+            {weeks[0]?.id} {shortDate(plan.start)} ~{" "}
+            {weeks[weeks.length - 1]?.id}{" "}
+            {shortDate(weeks[weeks.length - 1]?.end ?? plan.start)} · 칸을
+            누르면 일정이 추가되고, 항목을 누르면 고칠 수 있어요. 달력에도 바로
+            반영됩니다.
+          </p>
+        </div>
+        <div className="flex flex-wrap items-stretch gap-2">
+          {plan.keyDates.map((keyDate, index) => (
+            <div
+              className="min-w-24 rounded-md border border-border/70 px-2.5 py-1"
+              data-testid="sprint-counter"
+              key={`${keyDate.label}-${keyDate.date}`}
+            >
+              <p
+                className={cn(
+                  "font-mono text-base font-semibold leading-tight tabular-nums",
+                  index === 0 && "text-orange-600 dark:text-orange-400",
+                )}
+              >
+                {dDayLabel(keyDate.date, today)}
+              </p>
+              <p className="text-2xs text-muted-foreground">
+                {keyDate.label} {shortDate(keyDate.date)}
+              </p>
+            </div>
+          ))}
+          {currentWeek >= 0 ? (
+            <div className="min-w-24 rounded-md border border-border/70 px-2.5 py-1">
+              <p className="font-mono text-base font-semibold leading-tight">
+                {weeks[currentWeek]?.id}
+              </p>
+              <p className="text-2xs text-muted-foreground">
+                이번 주 {shortDate(weeks[currentWeek]?.start ?? today)}–
+                {shortDate(weeks[currentWeek]?.end ?? today)}
+              </p>
+            </div>
+          ) : null}
+          <Button
+            className="h-auto self-stretch"
+            data-testid="sprint-settings"
+            onClick={onEditPlan}
+            size="sm"
+            type="button"
+            variant="outline"
+          >
+            <Settings2 className="h-4 w-4" />
+            보드 설정
+          </Button>
+        </div>
+      </header>
+
+      {isDefaultPlan ? (
+        <p className="rounded-md border border-dashed border-border px-3 py-2 text-xs text-muted-foreground">
+          아직 저장된 보드 설정이 없어 기본값(이번 주부터 8주)으로 보여 줍니다.
+          "보드 설정"에서 기간·단계·부서를 정하거나, "가져오기"로 마스터 플랜
+          파일을 불러오세요.
+        </p>
+      ) : null}
+      {plan.note ? (
+        <p
+          className="rounded-md border border-border/70 border-l-4 border-l-orange-500 px-3 py-1.5 text-xs"
+          data-testid="sprint-note"
+        >
+          {plan.note}
+        </p>
+      ) : null}
+      <div className="flex flex-wrap gap-4 text-2xs text-muted-foreground">
+        <span>
+          <span className="font-bold text-orange-600">◆</span> 하루짜리
+          마감·이벤트
+        </span>
+        <span>• 기간 작업</span>
+        <span>
+          <span className="rounded-sm bg-yellow-400 px-1 font-semibold text-yellow-950">
+            노란 열
+          </span>{" "}
+          이번 주
+        </span>
+        <span>
+          <span className="rounded-sm px-1 ring-2 ring-primary ring-inset">
+            테두리
+          </span>{" "}
+          선택한 주 (달력과 같이 움직여요)
+        </span>
+      </div>
+
+      <div
+        className="max-h-[min(60vh,40rem)] overflow-auto rounded-lg border border-border/70"
+        ref={scrollerRef}
+      >
+        <table className="w-max min-w-full border-separate border-spacing-0 text-left text-xs">
+          <thead>
+            <tr>
+              <th
+                className="sticky left-0 top-0 z-30 h-7 w-28 min-w-28 border-b border-r border-border/70 bg-muted px-2 font-mono text-2xs font-medium tracking-wider text-muted-foreground"
+                data-sprint-label=""
+                scope="col"
+              >
+                PHASE
+              </th>
+              {bands.map((band, index) => (
+                <th
+                  className={cn(
+                    "sticky top-0 z-20 h-7 border-b border-r border-border/70 bg-background px-2 font-mono text-2xs uppercase tracking-wider",
+                    band.tone !== "none" &&
+                      PHASE_CLASS[band.tone as keyof typeof PHASE_CLASS],
+                  )}
+                  colSpan={band.span}
+                  // biome-ignore lint/suspicious/noArrayIndexKey: bands are positional
+                  key={index}
+                  scope="colgroup"
+                >
+                  {band.label}
+                </th>
+              ))}
+            </tr>
+            <tr>
+              <th
+                className="sticky left-0 top-7 z-30 border-b border-r border-border/70 bg-muted px-2 py-1.5 font-mono text-2xs font-medium tracking-wider text-muted-foreground"
+                scope="col"
+              >
+                SPRINT
+              </th>
+              {weeks.map((week) => {
+                const isNow = week.index === currentWeek;
+                const isSelected = week.index === selectedWeek;
+                return (
+                  <th
+                    className={cn(
+                      "sticky top-7 z-20 w-44 min-w-44 border-b border-r border-border/70 bg-muted p-0 font-normal",
+                      isNow && "bg-yellow-400 text-yellow-950",
+                    )}
+                    data-week-index={week.index}
+                    key={week.id}
+                    scope="col"
+                  >
+                    <button
+                      aria-label={`${week.id} ${shortDate(week.start)}부터 ${shortDate(week.end)}까지 선택`}
+                      aria-pressed={isSelected}
+                      className={cn(
+                        "flex w-full items-baseline gap-1.5 px-2 py-1.5 text-left hover:bg-foreground/5 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring",
+                        isSelected && "ring-2 ring-inset ring-primary",
+                      )}
+                      data-testid={`sprint-week-${week.id}`}
+                      onClick={() => onSelectWeek(week)}
+                      type="button"
+                    >
+                      <span className="font-mono text-xs font-semibold">
+                        {week.id}
+                      </span>
+                      <span
+                        className={cn(
+                          "font-mono text-2xs tabular-nums",
+                          isNow ? "text-yellow-900" : "text-muted-foreground",
+                        )}
+                      >
+                        {shortDate(week.start)}–{shortDate(week.end)}
+                      </span>
+                    </button>
+                  </th>
+                );
+              })}
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((row) => (
+              <tr key={row.key || "unassigned"}>
+                <th
+                  className="sticky left-0 z-10 border-b border-r border-border/70 bg-muted px-2 py-1.5 align-top"
+                  scope="row"
+                >
+                  <span className="block font-mono text-2xs font-medium tracking-wider text-muted-foreground">
+                    {row.key === UNASSIGNED_ROW ? "ETC" : row.key}
+                  </span>
+                  <span className="flex items-center gap-1 text-xs font-semibold">
+                    {row.color ? (
+                      <span
+                        aria-hidden="true"
+                        className={cn(
+                          "h-2 w-2 shrink-0 rounded-full",
+                          COLOR_STYLES[row.color].dot,
+                        )}
+                      />
+                    ) : null}
+                    {row.label}
+                  </span>
+                </th>
+                {weeks.map((week) => {
+                  const items = cells.get(row.key)?.[week.index] ?? [];
+                  const isNow = week.index === currentWeek;
+                  const isSelected = week.index === selectedWeek;
+                  const isProd = phases[week.index]?.tone === "prod";
+                  return (
+                    <td
+                      className={cn(
+                        "group/cell border-b border-r border-border/70 p-0 align-top",
+                        isNow && "bg-yellow-400/10",
+                        isProd && "border-x-2 border-x-orange-500/60",
+                        isSelected && "bg-primary/5",
+                      )}
+                      data-testid={`sprint-cell-${row.key || "ETC"}-${week.id}`}
+                      key={week.id}
+                    >
+                      <div className="flex min-h-11 flex-col gap-0.5 p-1">
+                        {items.map((item) => {
+                          const color =
+                            item.entry.color ??
+                            colorOf.get(item.entry.dept ?? "");
+                          return (
+                            <button
+                              className={cn(
+                                "grid grid-cols-[0.75rem_1fr] gap-1 rounded px-1 py-0.5 text-left leading-snug hover:bg-foreground/5 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring",
+                                editingId === item.entry.id &&
+                                  "bg-primary/10 ring-1 ring-primary",
+                              )}
+                              data-testid="sprint-item"
+                              key={`${item.entry.id}@${item.entry.date}`}
+                              onClick={() => onEdit(item.entry)}
+                              title={`${item.label}\n누르면 고칠 수 있어요.`}
+                              type="button"
+                            >
+                              {item.milestone ? (
+                                <span
+                                  aria-hidden="true"
+                                  className="text-center font-bold text-orange-600 dark:text-orange-400"
+                                >
+                                  ◆
+                                </span>
+                              ) : (
+                                <span
+                                  aria-hidden="true"
+                                  className={cn(
+                                    "mx-auto mt-1.5 h-1.5 w-1.5 rounded-full",
+                                    color
+                                      ? COLOR_STYLES[color].dot
+                                      : "bg-muted-foreground",
+                                  )}
+                                />
+                              )}
+                              <span
+                                className={cn(
+                                  "break-words",
+                                  item.milestone && "font-semibold",
+                                )}
+                              >
+                                {item.label}
+                              </span>
+                            </button>
+                          );
+                        })}
+                        <button
+                          aria-label={`${row.label} ${week.id}에 일정 추가`}
+                          className="flex items-center gap-1 rounded px-1 py-0.5 text-2xs text-muted-foreground opacity-0 hover:bg-foreground/5 focus-visible:opacity-100 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring group-hover/cell:opacity-100"
+                          data-testid="sprint-add"
+                          onClick={() => onAdd(row.key, week)}
+                          type="button"
+                        >
+                          <Plus className="h-3 w-3" />
+                          추가
+                        </button>
+                      </div>
+                    </td>
+                  );
+                })}
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+      <p aria-live="polite" className="min-h-4 text-xs text-muted-foreground">
+        {status === "loading" ? "일정을 불러오는 중…" : null}
+        {status === "error"
+          ? "일정을 불러오지 못했습니다. 연결을 확인해 주세요."
+          : null}
+      </p>
+    </section>
+  );
+}

+            </button>
+          </p>
+        ) : null}
+        <label className="flex flex-col gap-1 sm:col-span-3">
+          공지 (보드 위 한 줄, 선택)
+          <Textarea
+            maxLength={MAX_PLAN_NOTE_LENGTH}
+            onChange={(event) => set({ note: event.target.value })}
+            placeholder="예: 10/22 변경 프로덕션 12/5–6 → 12/12–13(토–일)"
+            rows={2}
+            value={plan.note ?? ""}
+          />
+        </label>
+      </fieldset>
+
+      <fieldset className="flex flex-col gap-2">
+        <legend className="mb-1 text-sm font-semibold">
+          단계{" "}
+          <span className="font-normal text-muted-foreground">
+            ({phaseWeeks}/{plan.weeks}주)
+          </span>
+        </legend>
+        {plan.phases.map((phase, index) => (
+          // biome-ignore lint/suspicious/noArrayIndexKey: rows are positional
+          <div className="flex items-center gap-2" key={index}>
+            <Input
+              aria-label="단계 이름"
+              className="min-w-0 flex-1"
+              maxLength={MAX_LABEL_LENGTH}
+              onChange={(event) =>
+                set({
+                  phases: plan.phases.map((item, at) =>
+                    at === index
+                      ? { ...item, label: event.target.value }
+                      : item,
+                  ),
+                })
+              }
+              value={phase.label}
+            />
+            <Input
+              aria-label="주 수"
+              className="w-20"
+              min={1}
+              onChange={(event) =>
+                set({
+                  phases: plan.phases.map((item, at) =>
+                    at === index
+                      ? { ...item, weeks: Number(event.target.value) }
+                      : item,
+                  ),
+                })
+              }
+              type="number"
+              value={phase.weeks}
+            />
+            <select
+              aria-label="색"
+              className={SELECT_CLASS}
+              onChange={(event) =>
+                set({
+                  phases: plan.phases.map((item, at) =>
+                    at === index
+                      ? { ...item, tone: event.target.value as PhaseTone }
+                      : item,
+                  ),
+                })
+              }
+              value={phase.tone}
+            >
+              {PHASE_TONES.map((tone) => (
+                <option key={tone} value={tone}>
+                  {TONE_LABELS[tone]}
+                </option>
+              ))}
+            </select>
+            <Button
+              aria-label="단계 삭제"
+              onClick={() =>
+                set({ phases: plan.phases.filter((_, at) => at !== index) })
+              }
+              size="icon-xs"
+              type="button"
+              variant="ghost"
+            >
+              <Trash2 />
+            </Button>
+          </div>
+        ))}
+        {plan.phases.length < MAX_PHASES ? (
+          <Button
+            className="self-start"
+            onClick={() =>
+              set({
+                phases: [
+                  ...plan.phases,
+                  {
+                    label: "새 단계",
+                    weeks: Math.max(1, plan.weeks - phaseWeeks),
+                    tone: "other",
+                  },
+                ],
+              })
+            }
+            size="xs"
+            type="button"
+            variant="outline"
+          >
+            <Plus className="h-3 w-3" />
+            단계 추가
+          </Button>
+        ) : null}
+      </fieldset>
+
+      <fieldset className="flex flex-col gap-2">
+        <legend className="mb-1 text-sm font-semibold">부서 (보드의 행)</legend>
+        {plan.depts.map((dept, index) => (
+          // biome-ignore lint/suspicious/noArrayIndexKey: rows are positional
+          <div className="flex items-center gap-2" key={index}>
+            <Input
+              aria-label="부서 코드"
+              className="w-28 font-mono uppercase"
+              maxLength={24}
+              onChange={(event) =>
+                set({
+                  depts: plan.depts.map((item, at) =>
+                    at === index
+                      ? {
+                          ...item,
+                          key: event.target.value
+                            .toUpperCase()
+                            .replace(/\s/g, "_"),
+                        }
+                      : item,
+                  ),
+                })
+              }
+              value={dept.key}
+            />
+            <Input
+              aria-label="부서 이름"
+              className="min-w-0 flex-1"
+              maxLength={MAX_LABEL_LENGTH}
+              onChange={(event) =>
+                set({
+                  depts: plan.depts.map((item, at) =>
+                    at === index
+                      ? { ...item, label: event.target.value }
+                      : item,
+                  ),

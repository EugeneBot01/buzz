+              size="icon-xs"
+              type="button"
+              variant="ghost"
+            >
+              <ArrowDown />
+            </Button>
+            <Button
+              aria-label="부서 삭제"
+              onClick={() =>
+                set({ depts: plan.depts.filter((_, at) => at !== index) })
+              }
+              size="icon-xs"
+              type="button"
+              variant="ghost"
+            >
+              <Trash2 />
+            </Button>
+          </div>
+        ))}
+        {plan.depts.length < MAX_DEPTS ? (
+          <Button
+            className="self-start"
+            onClick={() =>
+              set({
+                depts: [
+                  ...plan.depts,
+                  { key: `DEPT${plan.depts.length + 1}`, label: "새 부서" },
+                ],
+              })
+            }
+            size="xs"
+            type="button"
+            variant="outline"
+          >
+            <Plus className="h-3 w-3" />
+            부서 추가
+          </Button>
+        ) : null}
+        <p className="text-muted-foreground">
+          부서를 지우거나 코드를 바꾸면, 그 부서 일정은 지워지지 않고 "부서
+          미지정" 행에 보입니다.
+        </p>
+      </fieldset>
+
+      <fieldset className="flex flex-col gap-2">
+        <legend className="mb-1 text-sm font-semibold">
+          주요 날짜 (D-day 표시)
+        </legend>
+        {plan.keyDates.map((keyDate, index) => (
+          // biome-ignore lint/suspicious/noArrayIndexKey: rows are positional
+          <div className="flex items-center gap-2" key={index}>
+            <Input
+              aria-label="이름"
+              className="min-w-0 flex-1"
+              maxLength={MAX_LABEL_LENGTH}
+              onChange={(event) =>
+                set({
+                  keyDates: plan.keyDates.map((item, at) =>
+                    at === index
+                      ? { ...item, label: event.target.value }
+                      : item,
+                  ),
+                })
+              }
+              placeholder="예: 프로덕션"
+              value={keyDate.label}
+            />
+            <Input
+              aria-label="날짜"
+              className="w-40"
+              onChange={(event) =>
+                set({
+                  keyDates: plan.keyDates.map((item, at) =>
+                    at === index ? { ...item, date: event.target.value } : item,
+                  ),
+                })
+              }
+              type="date"
+              value={keyDate.date}
+            />
+            <Button
+              aria-label="주요 날짜 삭제"
+              onClick={() =>
+                set({ keyDates: plan.keyDates.filter((_, at) => at !== index) })
+              }
+              size="icon-xs"
+              type="button"
+              variant="ghost"
+            >
+              <Trash2 />
+            </Button>
+          </div>
+        ))}
+        {plan.keyDates.length < MAX_KEY_DATES ? (
+          <Button
+            className="self-start"
+            onClick={() =>
+              set({
+                keyDates: [...plan.keyDates, { label: "", date: plan.start }],
+              })
+            }
+            size="xs"
+            type="button"
+            variant="outline"
+          >
+            <Plus className="h-3 w-3" />
+            주요 날짜 추가
+          </Button>
+        ) : null}
+      </fieldset>
+
+      {error ? (
+        <p
+          className="text-destructive"
+          data-testid="sprint-plan-error"
+          role="alert"
+        >
+          {error}
+        </p>
+      ) : null}
+      <div className="sticky bottom-0 flex justify-end gap-2 bg-background pt-2">
+        <Button
+          disabled={saving}
+          onClick={onCancel}
+          size="sm"
+          type="button"
+          variant="ghost"
+        >
+          취소
+        </Button>
+        <Button
+          data-testid="sprint-plan-save"
+          disabled={saving || error !== null}
+          size="sm"
+          type="submit"
+        >
+          설정 저장
+        </Button>
+      </div>
+    </form>
+  );
+}

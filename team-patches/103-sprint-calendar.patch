+import {
+  type AvailabilityRule,
+  MAX_PEOPLE,
+  MAX_RULES_PER_PERSON,
+  RULE_KINDS,
+  type RuleKind,
+  type TeamPerson,
+  validateRule,
+} from "./teamAvailability";
+import {
+  CALENDAR_COLORS,
+  type CalendarColor,
+  type CalendarEntry,
+  DEPT_KEY_PATTERN,
+  MAX_NOTE_LENGTH,
+  MAX_TITLE_LENGTH,
+  REPEAT_CHOICES,
+  type RepeatEvery,
+  validateRange,
+} from "./teamCalendar";
+import { PHASE_TONES, type PhaseTone, validatePlan } from "./teamSprint";
+import type { CalendarEntryInput } from "./useTeamCalendar";
+import type { PersonInput, SprintPlanInput } from "./useTeamSprint";
+
+/**
+ * The file the calendar imports and backs up to (team patch). One JSON file
+ * can carry the sprint board settings, calendar entries and member
+ * schedules; any part may be left out.
+ *
+ * Ids are kept, so importing the same file twice updates what the first
+ * import made instead of adding everything again.
+ */
+export const IMPORT_FORMAT = "buzz-team-calendar";
+export const IMPORT_VERSION = 1;
+/** Most entries one file may carry. */
+export const MAX_IMPORT_ENTRIES = 2_000;
+
+export type CalendarImport = {
+  plan: SprintPlanInput | null;
+  entries: CalendarEntryInput[];
+  people: PersonInput[];
+};
+
+const DATE_PATTERN = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const TIME_PATTERN = /^([01]\d|2[0-3]):[0-5]\d$/;
+const ID_PATTERN = /^[A-Za-z0-9_-]{1,64}$/;
+
+const str = (value: unknown) => (typeof value === "string" ? value : "");
+
+function fail(message: string): never {
+  throw new Error(message);
+}
+
+function readImportEntry(raw: unknown, index: number): CalendarEntryInput {
+  const where = `일정 ${index + 1}번째`;
+  if (!raw || typeof raw !== "object") fail(`${where} 형식이 맞지 않습니다.`);
+  const value = raw as Record<string, unknown>;
+  const title = str(value.title).trim();
+  if (!title) fail(`${where}: 제목이 없습니다.`);
+  if (typeof value.id !== "string" || !ID_PATTERN.test(value.id))
+    fail(`${where} (${title}): id가 없거나 형식이 맞지 않습니다.`);
+  const date = str(value.date);
+  if (!DATE_PATTERN.test(date))
+    fail(`${where} (${title}): 날짜를 확인해 주세요.`);
+  const entry: CalendarEntryInput = {
+    id: value.id,
+    title: title.slice(0, MAX_TITLE_LENGTH),
+    date,
+  };
+  const endDate = str(value.endDate);
+  if (endDate) entry.endDate = endDate;
+  const time = str(value.time);
+  if (time) {
+    if (!TIME_PATTERN.test(time))
+      fail(`${where} (${title}): 시간을 확인해 주세요.`);
+    entry.time = time;
+  }
+  const endTime = str(value.endTime);
+  if (endTime) {
+    if (!TIME_PATTERN.test(endTime))
+      fail(`${where} (${title}): 종료 시간을 확인해 주세요.`);
+    entry.endTime = endTime;
+  }
+  if (value.color !== undefined) {
+    if (!(CALENDAR_COLORS as readonly unknown[]).includes(value.color))
+      fail(`${where} (${title}): 색상 "${String(value.color)}"을 모릅니다.`);
+    entry.color = value.color as CalendarColor;
+  }
+  const note = str(value.note).trim();
+  if (note) entry.note = note.slice(0, MAX_NOTE_LENGTH);
+  if (value.dept !== undefined) {
+    if (typeof value.dept !== "string" || !DEPT_KEY_PATTERN.test(value.dept))
+      fail(`${where} (${title}): 부서 코드를 확인해 주세요.`);
+    entry.dept = value.dept;
+  }
+  if (value.milestone === true) entry.milestone = true;
+  if (value.repeat !== undefined) {
+    const repeat = value.repeat as Record<string, unknown> | null;
+    if (
+      !repeat ||
+      !(REPEAT_CHOICES as readonly unknown[]).includes(repeat.every)
+    )
+      fail(`${where} (${title}): 반복 설정을 확인해 주세요.`);
+    entry.repeat = { every: repeat.every as RepeatEvery };
+    const until = str(repeat.until);
+    if (until) {
+      if (!DATE_PATTERN.test(until))
+        fail(`${where} (${title}): 반복 종료 날짜를 확인해 주세요.`);
+      entry.repeat.until = until;
+    }
+  }
+  const problem = validateRange(entry);
+  if (problem) fail(`${where} (${title}): ${problem}`);
+  return entry;
+}
+
+function readImportRule(raw: unknown, who: string, index: number) {
+  const where = `${who}님의 ${index + 1}번째 일정`;
+  if (!raw || typeof raw !== "object") fail(`${where} 형식이 맞지 않습니다.`);
+  const value = raw as Record<string, unknown>;
+  if (!(RULE_KINDS as readonly unknown[]).includes(value.kind))
+    fail(`${where}: 종류(busy/available/tentative)를 확인해 주세요.`);
+  const rule: AvailabilityRule = {
+    id: ID_PATTERN.test(str(value.id)) ? str(value.id) : `r${index + 1}`,
+    kind: value.kind as RuleKind,
+    startDate: str(value.startDate),
+    endDate: str(value.endDate) || str(value.startDate),
+    weekday:
+      typeof value.weekday === "number" && Number.isInteger(value.weekday)
+        ? value.weekday
+        : null,
+    start: typeof value.start === "number" ? value.start : 0,
+    end: typeof value.end === "number" ? value.end : 1_440,
+    title: str(value.title).trim(),
+    exclude: Array.isArray(value.exclude)
+      ? value.exclude.filter(
+          (day): day is string =>
+            typeof day === "string" && DATE_PATTERN.test(day),
+        )
+      : [],
+  };
+  const problem = validateRule(rule);
+  if (problem) fail(`${where} (${rule.title || "제목 없음"}): ${problem}`);
+  return rule;
+}
+
+function readImportPerson(raw: unknown, index: number): PersonInput {
+  const where = `팀원 ${index + 1}번째`;
+  if (!raw || typeof raw !== "object") fail(`${where} 형식이 맞지 않습니다.`);
+  const value = raw as Record<string, unknown>;
+  const name = str(value.name).trim();
+  if (!name) fail(`${where}: 이름이 없습니다.`);
+  if (typeof value.id !== "string" || !ID_PATTERN.test(value.id))
+    fail(`${where} (${name}): id가 없거나 형식이 맞지 않습니다.`);
+  const rawRules = Array.isArray(value.rules) ? value.rules : [];
+  if (rawRules.length > MAX_RULES_PER_PERSON)
+    fail(`${name}님의 일정이 ${MAX_RULES_PER_PERSON}개를 넘습니다.`);
+  const rules = rawRules.map((rule, ruleIndex) =>
+    readImportRule(rule, name, ruleIndex),
+  );
+  const ids = new Set<string>();
+  for (const rule of rules) {
+    if (ids.has(rule.id)) fail(`${name}님의 일정 id "${rule.id}"가 겹칩니다.`);
+    ids.add(rule.id);
+  }
+  const person: PersonInput = { id: value.id, name, rules };
+  const role = str(value.role).trim();
+  if (role) person.role = role;
+  if (typeof value.pubkey === "string" && /^[0-9a-f]{64}$/.test(value.pubkey))
+    person.pubkey = value.pubkey;
+  return person;
+}
+
+function readImportPlan(raw: unknown): SprintPlanInput {
+  if (!raw || typeof raw !== "object")
+    fail("스프린트 설정 형식이 맞지 않습니다.");
+  const value = raw as Record<string, unknown>;
+  const list = (field: unknown) => (Array.isArray(field) ? field : []);
+  const plan: SprintPlanInput = {
+    title: str(value.title).trim(),
+    start: str(value.start),
+    weeks: Number(value.weeks),
+    phases: list(value.phases).map((phase) => {
+      const item = (phase ?? {}) as Record<string, unknown>;
+      return {
+        label: str(item.label).trim(),
+        weeks: Number(item.weeks),
+        tone: (PHASE_TONES as readonly unknown[]).includes(item.tone)
+          ? (item.tone as PhaseTone)
+          : "other",
+      };
+    }),
+    depts: list(value.depts).map((dept) => {
+      const item = (dept ?? {}) as Record<string, unknown>;
+      const next: SprintPlanInput["depts"][number] = {
+        key: str(item.key),
+        label: str(item.label).trim(),
+      };
+      if ((CALENDAR_COLORS as readonly unknown[]).includes(item.color))
+        next.color = item.color as CalendarColor;
+      return next;
+    }),
+    keyDates: list(value.keyDates).map((keyDate) => {
+      const item = (keyDate ?? {}) as Record<string, unknown>;
+      return { label: str(item.label).trim(), date: str(item.date) };
+    }),
+  };
+  const note = str(value.note).trim();
+  if (note) plan.note = note;
+  const problem = validatePlan(plan);
+  if (problem) fail(`스프린트 설정: ${problem}`);
+  return plan;
+}
+
+/** Reads an import file. Throws an Error with a Korean message when it is wrong. */
+export function parseCalendarImport(content: string): CalendarImport {
+  let json: unknown;
+  try {
+    json = JSON.parse(content.replace(/^﻿/, ""));
+  } catch {
+    fail("JSON 파일이 아니거나 내용이 깨져 있습니다.");
+  }
+  if (!json || typeof json !== "object") fail("파일 형식이 맞지 않습니다.");
+  const value = json as Record<string, unknown>;
+  if (value.format !== IMPORT_FORMAT)
+    fail(`"${IMPORT_FORMAT}" 형식의 파일이 아닙니다.`);
+  if (value.version !== IMPORT_VERSION)
+    fail(`이 앱이 모르는 파일 버전입니다 (${String(value.version)}).`);
+  const rawEntries = Array.isArray(value.entries) ? value.entries : [];
+  if (rawEntries.length > MAX_IMPORT_ENTRIES)
+    fail(`일정이 ${MAX_IMPORT_ENTRIES}개를 넘습니다.`);
+  const entries = rawEntries.map(readImportEntry);
+  const entryIds = new Set<string>();
+  for (const entry of entries) {
+    if (entryIds.has(entry.id as string))
+      fail(`일정 id "${entry.id}"가 겹칩니다.`);
+    entryIds.add(entry.id as string);
+  }
+  const rawPeople = Array.isArray(value.people) ? value.people : [];
+  if (rawPeople.length > MAX_PEOPLE) fail(`팀원이 ${MAX_PEOPLE}명을 넘습니다.`);
+  const people = rawPeople.map(readImportPerson);
+  const personIds = new Set<string>();
+  for (const person of people) {
+    if (personIds.has(person.id)) fail(`팀원 id "${person.id}"가 겹칩니다.`);
+    personIds.add(person.id);
+  }
+  const plan = value.plan === undefined ? null : readImportPlan(value.plan);
+  if (!plan && entries.length === 0 && people.length === 0)
+    fail("가져올 내용이 없습니다.");
+  return { plan, entries, people };
+}
+
+/** The import/backup file of what the calendar holds now. */
+export function buildCalendarBackup(input: {
+  plan: SprintPlanInput | null;
+  entries: CalendarEntry[];
+  people: TeamPerson[];
+}): string {
+  const entries = input.entries.map((entry) => {
+    const out: Record<string, unknown> = {
+      id: entry.id,
+      title: entry.title,
+      date: entry.date,
+    };
+    if (entry.endDate) out.endDate = entry.endDate;
+    if (entry.time) out.time = entry.time;
+    if (entry.endTime) out.endTime = entry.endTime;
+    if (entry.color) out.color = entry.color;
+    if (entry.note) out.note = entry.note;
+    if (entry.dept) out.dept = entry.dept;
+    if (entry.milestone) out.milestone = true;
+    if (entry.repeat) out.repeat = entry.repeat;
+    return out;
+  });
+  const people = input.people.map((person) => {
+    const out: Record<string, unknown> = {
+      id: person.id,
+      name: person.name,
+      rules: person.rules,
+    };
+    if (person.role) out.role = person.role;
+    if (person.pubkey) out.pubkey = person.pubkey;
+    return out;
+  });
+  const plan = input.plan
+    ? {
+        title: input.plan.title,
+        start: input.plan.start,
+        weeks: input.plan.weeks,
+        phases: input.plan.phases,
+        depts: input.plan.depts,
+        keyDates: input.plan.keyDates,
+        ...(input.plan.note ? { note: input.plan.note } : {}),
+      }
+    : undefined;
+  return `${JSON.stringify(
+    {
+      format: IMPORT_FORMAT,
+      version: IMPORT_VERSION,
+      ...(plan ? { plan } : {}),
+      entries,
+      people,
+    },
+    null,
+    2,
+  )}\n`;
+}
diff --git a/desktop/src/features/team-calendar/lib/exportCanvas.ts b/desktop/src/features/team-calendar/lib/exportCanvas.ts
new file mode 100644
index 000000000..c22dcf115
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/exportCanvas.ts
@@ -0,0 +1,372 @@
+import type { BoardPage } from "./exportModel";
+import { PAPER_COLORS, PHASE_FILLS, buildPdf } from "./exportFormats";
+
+/**
+ * Draws board pages on a canvas (team patch) for PNG and PDF exports. Always
+ * the light "paper" look, whatever the app theme, so a printout is readable.
+ */
+
+const FONT_FAMILY =
+  '"Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", system-ui, sans-serif';
+const INK = "#15191e";
+const MUTED = "#5d6672";
+const LINE = "#d5d9de";
+const STRONG_LINE = "#9aa3ad";
+const ACCENT = "#d4380d";
+const TAPE = "#ffd84a";
+
+/** WebKit refuses canvases over about 16.7 million pixels. */
+const MAX_CANVAS_PIXELS = 16_000_000;
+
+type Layout = {
+  width: number;
+  height: number;
+  labelWidth: number;
+  columnWidth: number;
+  headerHeight: number;
+  bandHeight: number;
+  columnHeaderHeight: number;
+  rowHeights: number[];
+  cellLines: string[][][][]; // row -> column -> item -> lines
+};
+
+const PAD = 24;
+const ITEM_FONT = 12.5;
+const LINE_HEIGHT = 17;
+
+function font(size: number, weight = 400) {
+  return `${weight} ${size}px ${FONT_FAMILY}`;
+}
+
+/** Splits `text` into lines no wider than `width` (Korean breaks anywhere). */
+export function wrapText(
+  measure: (value: string) => number,
+  text: string,
+  width: number,
+): string[] {
+  const lines: string[] = [];
+  let line = "";
+  let lastSpace = -1;
+  for (const char of text) {
+    const next = line + char;
+    if (measure(next) <= width || line.length === 0) {
+      line = next;
+      if (char === " ") lastSpace = line.length - 1;
+      continue;
+    }
+    if (lastSpace > 0 && char !== " ") {
+      lines.push(line.slice(0, lastSpace));
+      line = line.slice(lastSpace + 1) + char;
+    } else {
+      lines.push(line.trimEnd());
+      line = char === " " ? "" : char;
+    }
+    lastSpace = -1;
+  }
+  if (line.trim()) lines.push(line.trimEnd());
+  return lines.length ? lines : [""];
+}
+
+function layoutPage(ctx: CanvasRenderingContext2D, page: BoardPage): Layout {
+  const isMonth = !page.rowLabels;
+  const labelWidth = page.rowLabels ? 112 : 0;
+  const columnWidth = isMonth ? 150 : 176;
+  const width = PAD * 2 + labelWidth + columnWidth * page.columns.length;
+  const headerHeight = 64 + (page.note ? 36 : 0);
+  const bandHeight = page.bands?.some((band) => band.label) ? 24 : 0;
+  const columnHeaderHeight = isMonth ? 26 : 34;
+  ctx.font = font(ITEM_FONT);
+  const measure = (value: string) => ctx.measureText(value).width;
+  const textWidth = columnWidth - 18 - 14;
+  const cellLines = page.rows.map((row) =>
+    row.cells.map((cell) =>
+      cell.items.map((item) => wrapText(measure, item.text, textWidth)),
+    ),
+  );
+  const rowHeights = cellLines.map((row) => {
+    const tallest = Math.max(
+      0,
+      ...row.map(
+        (items) =>
+          items.reduce(
+            (sum, lines) => sum + lines.length * LINE_HEIGHT + 3,
+            0,
+          ) + (isMonth ? 24 : 14),
+      ),
+    );
+    return Math.max(isMonth ? 104 : 46, tallest);
+  });
+  const height =
+    PAD * 2 +
+    headerHeight +
+    bandHeight +
+    columnHeaderHeight +
+    rowHeights.reduce((sum, value) => sum + value, 0);
+  return {
+    width,
+    height,
+    labelWidth,
+    columnWidth,
+    headerHeight,
+    bandHeight,
+    columnHeaderHeight,
+    rowHeights,
+    cellLines,
+  };
+}
+
+function drawPage(
+  ctx: CanvasRenderingContext2D,
+  page: BoardPage,
+  layout: Layout,
+  top: number,
+) {
+  const left = PAD;
+  ctx.fillStyle = "#ffffff";
+  ctx.fillRect(0, top, layout.width, layout.height);
+  ctx.textBaseline = "top";
+
+  // Title, subtitle and counters.
+  ctx.fillStyle = INK;
+  ctx.font = font(22, 700);
+  ctx.fillText(page.title, left, top + PAD);
+  if (page.subtitle) {
+    ctx.fillStyle = MUTED;
+    ctx.font = font(12.5);
+    ctx.fillText(page.subtitle, left, top + PAD + 32);
+  }
+  let counterRight = layout.width - PAD;
+  for (const counter of [...(page.counters ?? [])].reverse()) {
+    ctx.font = font(11.5);
+    const labelWidth = ctx.measureText(counter.label).width;
+    ctx.font = font(20, 600);
+    const valueWidth = ctx.measureText(counter.value).width;
+    const boxWidth = Math.max(labelWidth, valueWidth) + 24;
+    const x = counterRight - boxWidth;
+    ctx.strokeStyle = LINE;
+    ctx.lineWidth = 1;
+    ctx.strokeRect(x + 0.5, top + PAD + 0.5, boxWidth, 50);
+    ctx.fillStyle = counter.hot ? ACCENT : INK;
+    ctx.fillText(counter.value, x + 12, top + PAD + 6);
+    ctx.fillStyle = MUTED;
+    ctx.font = font(11.5);
+    ctx.fillText(counter.label, x + 12, top + PAD + 32);
+    counterRight = x - 8;
+  }
+  let y = top + PAD + 64;
+  if (page.note) {
+    ctx.fillStyle = "#f5f6f8";
+    ctx.fillRect(left, y, layout.width - PAD * 2, 26);
+    ctx.fillStyle = ACCENT;
+    ctx.fillRect(left, y, 4, 26);
+    ctx.fillStyle = INK;
+    ctx.font = font(12.5);
+    ctx.fillText(page.note, left + 12, y + 6);
+    y += 36;
+  }
+
+  const gridLeft = left + layout.labelWidth;
+  const gridWidth = layout.columnWidth * page.columns.length;
+
+  // Phase bands.
+  if (layout.bandHeight) {
+    if (page.rowLabels) {
+      ctx.fillStyle = `#${PHASE_FILLS.none}`;
+      ctx.fillRect(left, y, layout.labelWidth, layout.bandHeight);
+      ctx.fillStyle = MUTED;
+      ctx.font = font(10.5, 600);
+      ctx.fillText("PHASE", left + 8, y + 7);
+    }
+    let x = gridLeft;
+    for (const band of page.bands ?? []) {
+      const bandWidth = band.span * layout.columnWidth;
+      ctx.fillStyle = `#${PHASE_FILLS[band.tone]}`;
+      ctx.fillRect(x, y, bandWidth, layout.bandHeight);
+      ctx.fillStyle = band.tone === "prod" ? ACCENT : INK;
+      ctx.font = font(10.5, 600);
+      ctx.fillText(band.label, x + 8, y + 7, bandWidth - 12);
+      x += bandWidth;
+    }
+    y += layout.bandHeight;
+  }
+
+  // Column headers.
+  if (page.rowLabels) {
+    ctx.fillStyle = `#${PHASE_FILLS.none}`;
+    ctx.fillRect(left, y, layout.labelWidth, layout.columnHeaderHeight);
+    ctx.fillStyle = MUTED;
+    ctx.font = font(10.5, 600);
+    ctx.fillText("SPRINT", left + 8, y + 11);
+  }
+  page.columns.forEach((column, index) => {
+    const x = gridLeft + index * layout.columnWidth;
+    ctx.fillStyle = column.highlight ? TAPE : `#${PHASE_FILLS.none}`;
+    ctx.fillRect(x, y, layout.columnWidth, layout.columnHeaderHeight);
+    ctx.fillStyle = INK;
+    ctx.font = font(13, 600);
+    if (page.rowLabels) {
+      ctx.fillText(column.label, x + 8, y + 10);
+      const labelWidth = ctx.measureText(column.label).width;
+      ctx.fillStyle = column.highlight ? "#3d3000" : MUTED;
+      ctx.font = font(11);
+      if (column.sub) ctx.fillText(column.sub, x + 14 + labelWidth, y + 11);
+    } else {
+      ctx.textAlign = "center";
+      ctx.fillText(column.label, x + layout.columnWidth / 2, y + 6);
+      ctx.textAlign = "left";
+    }
+  });
+  y += layout.columnHeaderHeight;
+
+  // Rows.
+  page.rows.forEach((row, rowIndex) => {
+    const rowHeight = layout.rowHeights[rowIndex] ?? 46;
+    if (page.rowLabels) {
+      ctx.fillStyle = "#f5f6f8";
+      ctx.fillRect(left, y, layout.labelWidth, rowHeight);
+      ctx.fillStyle = MUTED;
+      ctx.font = font(10.5, 600);
+      ctx.fillText(row.label, left + 8, y + 8, layout.labelWidth - 12);
+      if (row.sub) {
+        ctx.fillStyle = INK;
+        ctx.font = font(13, 600);
+        ctx.fillText(row.sub, left + 8, y + 24, layout.labelWidth - 12);
+      }
+    }
+    row.cells.forEach((cell, columnIndex) => {
+      const x = gridLeft + columnIndex * layout.columnWidth;
+      const column = page.columns[columnIndex];
+      if (cell.today) ctx.fillStyle = "#fff4cc";
+      else if (column?.highlight) ctx.fillStyle = "#fff8dc";
+      else if (cell.accent) ctx.fillStyle = "#fff1ea";
+      else ctx.fillStyle = "#ffffff";
+      ctx.fillRect(x, y, layout.columnWidth, rowHeight);
+      let lineY = y + 8;
+      if (cell.day) {
+        ctx.font = font(12.5, cell.today ? 700 : 500);
+        ctx.fillStyle = cell.muted ? "#aab0b8" : cell.today ? ACCENT : INK;
+        ctx.fillText(cell.day, x + 8, lineY);
+        lineY += 20;
+      }
+      const lines = layout.cellLines[rowIndex]?.[columnIndex] ?? [];
+      cell.items.forEach((item, itemIndex) => {
+        const color = `#${PAPER_COLORS[item.color ?? "default"]}`;
+        ctx.font = font(ITEM_FONT, 700);
+        ctx.fillStyle = item.milestone ? ACCENT : color;
+        ctx.fillText(item.milestone ? "◆" : "•", x + 8, lineY);
+        ctx.font = font(ITEM_FONT, item.milestone ? 600 : 400);
+        ctx.fillStyle = cell.muted ? MUTED : INK;
+        for (const line of lines[itemIndex] ?? []) {
+          ctx.fillText(line, x + 22, lineY);
+          lineY += LINE_HEIGHT;
+        }
+        lineY += 3;
+      });
+    });
+    y += rowHeight;
+  });
+
+  // Grid lines.
+  const gridTop =
+    top +
+    layout.height -
+    PAD -
+    layout.rowHeights.reduce((a, b) => a + b, 0) -
+    layout.columnHeaderHeight -
+    layout.bandHeight;
+  const gridBottom = top + layout.height - PAD;
+  ctx.strokeStyle = LINE;
+  ctx.lineWidth = 1;
+  ctx.beginPath();
+  let lineY = gridTop + layout.bandHeight + layout.columnHeaderHeight;
+  ctx.moveTo(left, gridTop + layout.bandHeight + 0.5);
+  ctx.lineTo(gridLeft + gridWidth, gridTop + layout.bandHeight + 0.5);
+  for (const rowHeight of [0, ...layout.rowHeights]) {
+    lineY += rowHeight;
+    ctx.moveTo(left, Math.round(lineY) + 0.5);
+    ctx.lineTo(gridLeft + gridWidth, Math.round(lineY) + 0.5);
+  }
+  for (let index = 0; index <= page.columns.length; index++) {
+    const x = Math.round(gridLeft + index * layout.columnWidth) + 0.5;
+    ctx.moveTo(x, gridTop);
+    ctx.lineTo(x, gridBottom);
+  }
+  ctx.moveTo(left + 0.5, gridTop);
+  ctx.lineTo(left + 0.5, gridBottom);
+  ctx.stroke();
+  if (page.rowLabels) {
+    ctx.strokeStyle = STRONG_LINE;
+    ctx.beginPath();
+    ctx.moveTo(gridLeft + 0.5, gridTop);
+    ctx.lineTo(gridLeft + 0.5, gridBottom);
+    ctx.stroke();
+  }
+}
+
+function measuringContext(): CanvasRenderingContext2D {
+  const ctx = document.createElement("canvas").getContext("2d");
+  if (!ctx) throw new Error("이미지를 만들 수 없습니다 (캔버스를 쓸 수 없음).");
+  return ctx;
+}
+
+/** Renders pages stacked top to bottom on one canvas. */
+export function renderPages(pages: BoardPage[]): HTMLCanvasElement {
+  const measure = measuringContext();
+  const layouts = pages.map((page) => layoutPage(measure, page));
+  const width = Math.max(...layouts.map((layout) => layout.width));
+  const height = layouts.reduce((sum, layout) => sum + layout.height, 0);
+  const scale = Math.min(2, Math.sqrt(MAX_CANVAS_PIXELS / (width * height)));
+  const canvas = document.createElement("canvas");
+  canvas.width = Math.max(1, Math.floor(width * scale));
+  canvas.height = Math.max(1, Math.floor(height * scale));
+  const ctx = canvas.getContext("2d");
+  if (!ctx) throw new Error("이미지를 만들 수 없습니다 (캔버스를 쓸 수 없음).");
+  ctx.scale(scale, scale);
+  ctx.fillStyle = "#ffffff";
+  ctx.fillRect(0, 0, width, height);
+  let top = 0;
+  pages.forEach((page, index) => {
+    const layout = layouts[index] as Layout;
+    drawPage(ctx, page, { ...layout, width }, top);
+    top += layout.height;
+  });
+  return canvas;
+}
+
+function canvasBytes(
+  canvas: HTMLCanvasElement,
+  type: "image/png" | "image/jpeg",
+): Promise<Uint8Array> {
+  return new Promise((resolve, reject) => {
+    canvas.toBlob(
+      (blob) => {
+        if (!blob) {
+          reject(new Error("이미지를 만들지 못했습니다."));
+          return;
+        }
+        void blob
+          .arrayBuffer()
+          .then((buffer) => resolve(new Uint8Array(buffer)), reject);
+      },
+      type,
+      type === "image/jpeg" ? 0.92 : undefined,
+    );
+  });
+}
+
+export async function pagesToPng(pages: BoardPage[]): Promise<Uint8Array> {
+  return canvasBytes(renderPages(pages), "image/png");
+}
+
+export async function pagesToPdf(pages: BoardPage[]): Promise<Uint8Array> {
+  const images = [];
+  for (const page of pages) {
+    const canvas = renderPages([page]);
+    images.push({
+      jpeg: await canvasBytes(canvas, "image/jpeg"),
+      width: canvas.width,
+      height: canvas.height,
+    });
+  }
+  return buildPdf(images);
+}
diff --git a/desktop/src/features/team-calendar/lib/exportFormats.ts b/desktop/src/features/team-calendar/lib/exportFormats.ts
new file mode 100644
index 000000000..c163d9d4c
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/exportFormats.ts
@@ -0,0 +1,470 @@
+import type { CalendarColor } from "./teamCalendar";
+import type { BoardPage } from "./exportModel";
+
+/**
+ * File writers for calendar exports (team patch), with no dependencies:
+ * a stored (uncompressed) ZIP for .docx, a Word document of tables, and a
+ * PDF of one JPEG image per page. Pure functions so they can be tested.
+ */
+
+/** Hex colors of the calendar colors on paper (bar fill, text-safe). */
+export const PAPER_COLORS: Record<CalendarColor | "default", string> = {
+  default: "5B6B7F",
+  red: "D9363E",
+  orange: "E8710A",
+  green: "2F9E44",
+  blue: "1C7ED6",
+  purple: "7048E8",
+  pink: "D6336C",
+  gray: "868E96",
+  yellow: "E0A800",
+  lime: "66A80F",
+  teal: "0CA678",
+  cyan: "1098AD",
+  indigo: "4263EB",
+  brown: "8B5A2B",
+};
+
+export const PHASE_FILLS = {
+  pre: "DFE7F0",
+  prod: "FFE3D6",
+  post: "E2ECDF",
+  other: "ECECEC",
+  none: "F5F6F8",
+} as const;
+
+const CRC_TABLE = (() => {
+  const table = new Uint32Array(256);
+  for (let index = 0; index < 256; index++) {
+    let value = index;
+    for (let bit = 0; bit < 8; bit++)
+      value = value & 1 ? 0xedb88320 ^ (value >>> 1) : value >>> 1;
+    table[index] = value >>> 0;
+  }
+  return table;
+})();
+
+export function crc32(bytes: Uint8Array): number {
+  let crc = 0xffffffff;
+  for (const byte of bytes)
+    crc = (CRC_TABLE[(crc ^ byte) & 0xff] as number) ^ (crc >>> 8);
+  return (crc ^ 0xffffffff) >>> 0;
+}
+
+const utf8 = (value: string) => new TextEncoder().encode(value);
+
+/** A ZIP archive with every file stored (no compression). */
+export function zipStore(files: Array<{ name: string; data: Uint8Array }>) {
+  const chunks: Uint8Array[] = [];
+  const central: Uint8Array[] = [];
+  let offset = 0;
+  // 1980-01-01 00:00, the earliest DOS date: stable output for tests.
+  const dosTime = 0;
+  const dosDate = (0 << 9) | (1 << 5) | 1;
+  for (const file of files) {
+    const name = utf8(file.name);
+    const crc = crc32(file.data);
+    const local = new DataView(new ArrayBuffer(30));
+    local.setUint32(0, 0x04034b50, true);
+    local.setUint16(4, 20, true);
+    local.setUint16(6, 0x0800, true); // UTF-8 names
+    local.setUint16(8, 0, true); // stored
+    local.setUint16(10, dosTime, true);
+    local.setUint16(12, dosDate, true);
+    local.setUint32(14, crc, true);
+    local.setUint32(18, file.data.length, true);
+    local.setUint32(22, file.data.length, true);
+    local.setUint16(26, name.length, true);
+    local.setUint16(28, 0, true);
+    chunks.push(new Uint8Array(local.buffer), name, file.data);
+
+    const entry = new DataView(new ArrayBuffer(46));
+    entry.setUint32(0, 0x02014b50, true);
+    entry.setUint16(4, 20, true);
+    entry.setUint16(6, 20, true);
+    entry.setUint16(8, 0x0800, true);
+    entry.setUint16(10, 0, true);
+    entry.setUint16(12, dosTime, true);
+    entry.setUint16(14, dosDate, true);
+    entry.setUint32(16, crc, true);
+    entry.setUint32(20, file.data.length, true);
+    entry.setUint32(24, file.data.length, true);
+    entry.setUint16(28, name.length, true);
+    entry.setUint32(42, offset, true);
+    central.push(new Uint8Array(entry.buffer), name);
+    offset += 30 + name.length + file.data.length;
+  }
+  const centralSize = central.reduce((sum, part) => sum + part.length, 0);
+  const end = new DataView(new ArrayBuffer(22));
+  end.setUint32(0, 0x06054b50, true);
+  end.setUint16(8, files.length, true);
+  end.setUint16(10, files.length, true);
+  end.setUint32(12, centralSize, true);
+  end.setUint32(16, offset, true);
+  return concat([...chunks, ...central, new Uint8Array(end.buffer)]);
+}
+
+export function concat(parts: Uint8Array[]): Uint8Array {
+  const total = parts.reduce((sum, part) => sum + part.length, 0);
+  const out = new Uint8Array(total);
+  let at = 0;
+  for (const part of parts) {
+    out.set(part, at);
+    at += part.length;
+  }
+  return out;
+}
+
+/** Text safe inside XML (and without characters XML 1.0 forbids). */
+export function xmlText(value: string): string {
+  return (
+    value
+      // biome-ignore lint/suspicious/noControlCharactersInRegex: stripping them is the point
+      .replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F￾￿]/g, "")
+      .replace(/&/g, "&amp;")
+      .replace(/</g, "&lt;")
+      .replace(/>/g, "&gt;")
+      .replace(/"/g, "&quot;")
+  );
+}
+
+const FONT =
+  '<w:rFonts w:ascii="Malgun Gothic" w:hAnsi="Malgun Gothic" w:eastAsia="Malgun Gothic" w:cs="Malgun Gothic"/>';
+
+function run(
+  value: string,
+  options: { bold?: boolean; size?: number; color?: string } = {},
+) {
+  const props = [
+    FONT,
+    options.bold ? "<w:b/>" : "",
+    options.color ? `<w:color w:val="${options.color}"/>` : "",
+    `<w:sz w:val="${options.size ?? 16}"/><w:szCs w:val="${options.size ?? 16}"/>`,
+  ].join("");
+  return `<w:r><w:rPr>${props}</w:rPr><w:t xml:space="preserve">${xmlText(value)}</w:t></w:r>`;
+}
+
+function paragraph(
+  runs: string,
+  options: {
+    align?: "center";
+    after?: number;
+    keepNext?: boolean;
+    pageBreakBefore?: boolean;
+  } = {},
+) {
+  const props = [
+    options.keepNext ? "<w:keepNext/>" : "",
+    options.pageBreakBefore ? "<w:pageBreakBefore/>" : "",
+    `<w:spacing w:before="0" w:after="${options.after ?? 0}" w:line="240" w:lineRule="auto"/>`,
+    options.align ? `<w:jc w:val="${options.align}"/>` : "",
+  ].join("");
+  return `<w:p><w:pPr>${props}</w:pPr>${runs}</w:p>`;
+}
+
+function cell(
+  content: string,
+  options: { width: number; fill?: string; span?: number } = { width: 1000 },
+) {
+  const props = [
+    `<w:tcW w:w="${options.width}" w:type="dxa"/>`,
+    options.span && options.span > 1
+      ? `<w:gridSpan w:val="${options.span}"/>`
+      : "",
+    options.fill
+      ? `<w:shd w:val="clear" w:color="auto" w:fill="${options.fill}"/>`
+      : "",
+    '<w:tcMar><w:top w:w="40" w:type="dxa"/><w:left w:w="60" w:type="dxa"/><w:bottom w:w="40" w:type="dxa"/><w:right w:w="60" w:type="dxa"/></w:tcMar>',
+  ].join("");
+  return `<w:tc><w:tcPr>${props}</w:tcPr>${content || paragraph("")}</w:tc>`;
+}
+
+/** Usable width of an A4 landscape page with 1.27 cm margins, in twips. */
+const PAGE_WIDTH = 16838 - 2 * 720;
+
+function pageTable(page: BoardPage): string {
+  const labelWidth = page.rowLabels ? 1300 : 0;
+  const columnWidth = Math.floor(
+    (PAGE_WIDTH - labelWidth) / Math.max(1, page.columns.length),
+  );
+  const grid = [
+    ...(page.rowLabels ? [labelWidth] : []),
+    ...page.columns.map(() => columnWidth),
+  ]
+    .map((width) => `<w:gridCol w:w="${width}"/>`)
+    .join("");
+  const rows: string[] = [];
+  const header = (cells: string) =>
+    `<w:tr><w:trPr><w:tblHeader/><w:cantSplit/></w:trPr>${cells}</w:tr>`;
+  if (page.bands?.some((band) => band.label)) {
+    rows.push(
+      header(
+        (page.rowLabels
+          ? cell(paragraph(run("PHASE", { bold: true, size: 14 })), {
+              width: labelWidth,
+              fill: PHASE_FILLS.none,
+            })
+          : "") +
+          page.bands
+            .map((band) =>
+              cell(
+                paragraph(
+                  run(band.label, {
+                    bold: true,
+                    size: 14,
+                    color: band.tone === "prod" ? "D4380D" : undefined,
+                  }),
+                ),
+                {
+                  width: columnWidth * band.span,
+                  span: band.span,
+                  fill: PHASE_FILLS[band.tone],
+                },
+              ),
+            )
+            .join(""),
+      ),
+    );
+  }
+  rows.push(
+    header(
+      (page.rowLabels
+        ? cell(
+            paragraph(
+              run(page.bands ? "SPRINT" : "", { bold: true, size: 14 }),
+            ),
+            {
+              width: labelWidth,
+              fill: PHASE_FILLS.none,
+            },
+          )
+        : "") +
+        page.columns
+          .map((column) =>
+            cell(
+              paragraph(
+                run(column.label, { bold: true, size: 16 }) +
+                  (column.sub
+                    ? run(` ${column.sub}`, { size: 14, color: "5D6672" })
+                    : ""),
+                { align: page.rowLabels ? undefined : "center" },
+              ),
+              {
+                width: columnWidth,
+                fill: column.highlight ? "FFD84A" : PHASE_FILLS.none,
+              },
+            ),
+          )
+          .join(""),
+    ),
+  );
+  for (const row of page.rows) {
+    const cells = row.cells
+      .map((boardCell) => {
+        const parts: string[] = [];
+        if (boardCell.day)
+          parts.push(
+            paragraph(
+              run(boardCell.day, {
+                bold: boardCell.today,
+                size: 16,
+                color: boardCell.muted
+                  ? "AAB0B8"
+                  : boardCell.today
+                    ? "D4380D"
+                    : undefined,
+              }),
+            ),
+          );
+        for (const item of boardCell.items) {
+          const color = PAPER_COLORS[item.color ?? "default"];
+          parts.push(
+            paragraph(
+              run(item.milestone ? "◆ " : "• ", {
+                bold: true,
+                size: 14,
+                color: item.milestone ? "D4380D" : color,
+              }) + run(item.text, { bold: item.milestone, size: 15 }),
+            ),
+          );
+        }
+        return cell(parts.join(""), {
+          width: columnWidth,
+          fill: boardCell.today
+            ? "FFF4CC"
+            : boardCell.accent
+              ? "FFF1EA"
+              : undefined,
+        });
+      })
+      .join("");
+    const label = page.rowLabels
+      ? cell(
+          paragraph(run(row.label, { bold: true, size: 13, color: "5D6672" })) +
+            (row.sub ? paragraph(run(row.sub, { bold: true, size: 16 })) : ""),
+          { width: labelWidth, fill: "F5F6F8" },
+        )
+      : "";
+    rows.push(
+      `<w:tr><w:trPr><w:cantSplit/>${
+        page.rowLabels ? "" : '<w:trHeight w:val="1300"/>'
+      }</w:trPr>${label}${cells}</w:tr>`,
+    );
+  }
+  const border = (side: string) =>
+    `<w:${side} w:val="single" w:sz="4" w:space="0" w:color="C9CED6"/>`;
+  return [
+    "<w:tbl><w:tblPr>",
+    '<w:tblW w:w="0" w:type="auto"/><w:tblLayout w:type="fixed"/>',
+    `<w:tblBorders>${["top", "left", "bottom", "right", "insideH", "insideV"].map(border).join("")}</w:tblBorders>`,
+    `</w:tblPr><w:tblGrid>${grid}</w:tblGrid>`,
+    rows.join(""),
+    "</w:tbl>",
+  ].join("");
+}
+
+/** A Word document (.docx) with one landscape page (table) per board page. */
+export function buildDocx(pages: BoardPage[]): Uint8Array {
+  const body = pages
+    .map((page, index) => {
+      const parts = [
+        paragraph(run(page.title, { bold: true, size: 28 }), {
+          after: 40,
+          keepNext: true,
+          pageBreakBefore: index > 0,
+        }),
+      ];
+      const meta = [
+        page.subtitle,
+        ...(page.counters ?? []).map(
+          (counter) => `${counter.value} ${counter.label}`,
+        ),
+      ].filter(Boolean);
+      if (meta.length)
+        parts.push(
+          paragraph(run(meta.join("  ·  "), { size: 16, color: "5D6672" }), {
+            after: 60,
+            keepNext: true,
+          }),
+        );
+      if (page.note)
+        parts.push(
+          paragraph(run(page.note, { size: 16 }), {
+            after: 80,
+            keepNext: true,
+          }),
+        );
+      parts.push(pageTable(page));
+      return parts.join("");
+    })
+    .join("");
+  const document = [
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',
+    '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">',
+    "<w:body>",
+    body,
+    '<w:sectPr><w:pgSz w:w="16838" w:h="11906" w:orient="landscape"/>',
+    '<w:pgMar w:top="720" w:right="720" w:bottom="720" w:left="720" w:header="360" w:footer="360" w:gutter="0"/>',
+    "</w:sectPr></w:body></w:document>",
+  ].join("");
+  const contentTypes = [
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',
+    '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">',
+    '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>',
+    '<Default Extension="xml" ContentType="application/xml"/>',
+    '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>',
+    "</Types>",
+  ].join("");
+  const rels = [
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',
+    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">',
+    '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>',
+    "</Relationships>",
+  ].join("");
+  return zipStore([
+    { name: "[Content_Types].xml", data: utf8(contentTypes) },
+    { name: "_rels/.rels", data: utf8(rels) },
+    { name: "word/document.xml", data: utf8(document) },
+  ]);
+}
+
+export type PdfImagePage = { jpeg: Uint8Array; width: number; height: number };
+
+/** A4 landscape in points. */
+const PDF_PAGE = { width: 842, height: 595, margin: 24 };
+
+/**
+ * A PDF with one A4 landscape page per JPEG image, each scaled to fit the
+ * page (aspect ratio kept) and centered.
+ */
+export function buildPdf(pages: PdfImagePage[]): Uint8Array {
+  const parts: Uint8Array[] = [];
+  const offsets: number[] = [];
+  let length = 0;
+  const push = (part: Uint8Array | string) => {
+    const bytes = typeof part === "string" ? utf8(part) : part;
+    parts.push(bytes);
+    length += bytes.length;
+  };
+  const object = (id: number, body: Array<Uint8Array | string>) => {
+    offsets[id] = length;
+    push(`${id} 0 obj\n`);
+    for (const piece of body) push(piece);
+    push("\nendobj\n");
+  };
+  push("%PDF-1.4\n%âãÏÓ\n");
+  // 1 catalog, 2 pages, then 3 objects per page: page, content, image.
+  const pageIds = pages.map((_, index) => 3 + index * 3);
+  object(1, ["<< /Type /Catalog /Pages 2 0 R >>"]);
+  object(2, [
+    `<< /Type /Pages /Count ${pages.length} /Kids [${pageIds.map((id) => `${id} 0 R`).join(" ")}] >>`,
+  ]);
+  pages.forEach((page, index) => {
+    const pageId = pageIds[index] as number;
+    const contentId = pageId + 1;
+    const imageId = pageId + 2;
+    const room = {
+      width: PDF_PAGE.width - 2 * PDF_PAGE.margin,
+      height: PDF_PAGE.height - 2 * PDF_PAGE.margin,
+    };
+    const scale = Math.min(room.width / page.width, room.height / page.height);
+    const width = page.width * scale;
+    const height = page.height * scale;
+    const x = (PDF_PAGE.width - width) / 2;
+    const y = (PDF_PAGE.height - height) / 2;
+    const content = `q ${width.toFixed(2)} 0 0 ${height.toFixed(2)} ${x.toFixed(2)} ${y.toFixed(2)} cm /Im0 Do Q`;
+    object(pageId, [
+      `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${PDF_PAGE.width} ${PDF_PAGE.height}] /Resources << /XObject << /Im0 ${imageId} 0 R >> >> /Contents ${contentId} 0 R >>`,
+    ]);
+    object(contentId, [
+      `<< /Length ${utf8(content).length} >>\nstream\n${content}\nendstream`,
+    ]);
+    object(imageId, [
+      `<< /Type /XObject /Subtype /Image /Width ${page.width} /Height ${page.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${page.jpeg.length} >>\nstream\n`,
+      page.jpeg,
+      "\nendstream",
+    ]);
+  });
+  const count = 3 + pages.length * 3;
+  const xrefAt = length;
+  const lines = ["xref", `0 ${count}`, "0000000000 65535 f "];
+  for (let id = 1; id < count; id++)
+    lines.push(`${String(offsets[id] ?? 0).padStart(10, "0")} 00000 n `);
+  push(`${lines.join("\n")}\n`);
+  push(
+    `trailer\n<< /Size ${count} /Root 1 0 R >>\nstartxref\n${xrefAt}\n%%EOF\n`,
+  );
+  return concat(parts);
+}
+
+/** Safe file name part: no path separators or characters macOS dislikes. */
+export function fileSafe(value: string): string {
+  return (
+    value
+      // biome-ignore lint/suspicious/noControlCharactersInRegex: stripping them is the point
+      .replace(/[\\/:*?"<>|\u0000-\u001F]/g, " ")
+      .replace(/\s+/g, " ")
+      .trim()
+      .slice(0, 80) || "calendar"
+  );
+}
diff --git a/desktop/src/features/team-calendar/lib/exportModel.ts b/desktop/src/features/team-calendar/lib/exportModel.ts
new file mode 100644
index 000000000..61d3d3687
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/exportModel.ts
@@ -0,0 +1,273 @@
+import {
+  type CalendarColor,
+  type CalendarEntry,
+  entriesOnDate,
+  entryEndDate,
+  expandRepeats,
+  monthGrid,
+} from "./teamCalendar";
+import {
+  type PhaseTone,
+  type SprintPlan,
+  UNASSIGNED_ROW,
+  dDayLabel,
+  phaseOfWeeks,
+  shortDate,
+  sprintCells,
+  sprintRows,
+  sprintWeeks,
+} from "./teamSprint";
+
+/**
+ * What an export draws, independent of the file format (team patch). Both
+ * views become "board pages": a grid with optional row labels down the side,
+ * column headers across the top and short items in every cell. PNG, PDF and
+ * Word all render these pages, so the three files always agree.
+ */
+export type BoardItem = {
+  text: string;
+  /** A deadline/event (◆) rather than work over a period (•). */
+  milestone: boolean;
+  color?: CalendarColor;
+};
+
+export type BoardColumn = {
+  label: string;
+  sub?: string;
+  /** This week / today. */
+  highlight?: boolean;
+};
+
+export type BoardCell = {
+  items: BoardItem[];
+  /** Day number of a month cell. */
+  day?: string;
+  /** A day outside the month. */
+  muted?: boolean;
+  today?: boolean;
+  /** The production column of a sprint board. */
+  accent?: boolean;
+};
+
+export type BoardRow = { label: string; sub?: string; cells: BoardCell[] };
+
+export type BoardPage = {
+  title: string;
+  subtitle?: string;
+  note?: string;
+  /** Phase bands over the columns (sprint board only). */
+  bands?: Array<{ label: string; span: number; tone: PhaseTone | "none" }>;
+  columns: BoardColumn[];
+  rows: BoardRow[];
+  /** Whether the first column holds row labels. */
+  rowLabels: boolean;
+  /** Small counters shown at the top right ("D-36 프로덕션"). */
+  counters?: Array<{ value: string; label: string; hot?: boolean }>;
+};
+
+/** Columns of a sprint page printed on paper (wider boards are split). */
+export const SPRINT_WEEKS_PER_PAGE = 8;
+
+export type SprintExportOptions = {
+  plan: SprintPlan;
+  entries: CalendarEntry[];
+  /** First and last week (0-based, inclusive) to include. */
+  fromWeek: number;
+  toWeek: number;
+  today: string;
+  /** Split into pages of `SPRINT_WEEKS_PER_PAGE` weeks (paper formats). */
+  paginate: boolean;
+};
+
+export function sprintPages(options: SprintExportOptions): BoardPage[] {
+  const { plan, entries, today } = options;
+  const weeks = sprintWeeks(plan);
+  const from = Math.max(0, Math.min(options.fromWeek, plan.weeks - 1));
+  const to = Math.max(from, Math.min(options.toWeek, plan.weeks - 1));
+  const cells = sprintCells(plan, entries);
+  const rows = sprintRows(plan, entries);
+  const phases = phaseOfWeeks(plan);
+  const prodWeeks = new Set(
+    phases
+      .map((phase, index) => (phase?.tone === "prod" ? index : -1))
+      .filter((index) => index >= 0),
+  );
+  const colorOf = new Map(plan.depts.map((dept) => [dept.key, dept.color]));
+  const counters = plan.keyDates.map((keyDate, index) => ({
+    value: dDayLabel(keyDate.date, today),
+    label: `${keyDate.label} ${shortDate(keyDate.date)}`,
+    hot: index === 0,
+  }));
+
+  const chunks: Array<[number, number]> = [];
+  const size = options.paginate ? SPRINT_WEEKS_PER_PAGE : to - from + 1;
+  for (let start = from; start <= to; start += size)
+    chunks.push([start, Math.min(to, start + size - 1)]);
+
+  return chunks.map(([first, last], pageIndex) => {
+    const shown = weeks.slice(first, last + 1);
+    const bands: NonNullable<BoardPage["bands"]> = [];
+    for (const week of shown) {
+      const phase = phases[week.index] ?? null;
+      const label = phase?.label ?? "";
+      const tone = phase?.tone ?? "none";
+      const previous = bands[bands.length - 1];
+      if (previous && previous.label === label && previous.tone === tone)
+        previous.span += 1;
+      else bands.push({ label, span: 1, tone });
+    }
+    return {
+      title:
+        chunks.length > 1
+          ? `${plan.title} (${pageIndex + 1}/${chunks.length})`
+          : plan.title,
+      subtitle: `${shown[0]?.id} ${shortDate(shown[0]?.start ?? plan.start)} ~ ${
+        shown[shown.length - 1]?.id
+      } ${shortDate(shown[shown.length - 1]?.end ?? plan.start)}`,
+      note: plan.note,
+      bands,
+      counters,
+      rowLabels: true,
+      columns: shown.map((week) => ({
+        label: week.id,
+        sub: `${shortDate(week.start)}–${shortDate(week.end)}`,
+        highlight: week.start <= today && today <= week.end,
+      })),
+      rows: rows.map((row) => ({
+        label: row.key === UNASSIGNED_ROW ? "기타" : row.key,
+        sub: row.label,
+        cells: shown.map((week) => ({
+          accent: prodWeeks.has(week.index),
+          items: (cells.get(row.key)?.[week.index] ?? []).map((item) => ({
+            text: item.label,
+            milestone: item.milestone,
+            color:
+              item.entry.color ??
+              colorOf.get(item.entry.dept ?? "") ??
+              undefined,
+          })),
+        })),
+      })),
+    };
+  });
+}
+
+const timeLabel = (entry: CalendarEntry) =>
+  entry.time
+    ? entry.endTime
+      ? `${entry.time}–${entry.endTime}`
+      : entry.time
+    : "";
+
+/** One page per month (`YYYY-MM`), Sunday first, like the month view. */
+export function calendarPages(input: {
+  title: string;
+  months: string[];
+  entries: CalendarEntry[];
+  today: string;
+  deptLabel?: (key: string) => string | undefined;
+}): BoardPage[] {
+  return input.months.map((month) => {
+    const grid = monthGrid(month);
+    const first = grid[0]?.date ?? `${month}-01`;
+    const last = grid[grid.length - 1]?.date ?? `${month}-28`;
+    const shown = expandRepeats(input.entries, first, last);
+    const weeks: (typeof grid)[] = [];
+    for (let start = 0; start < grid.length; start += 7)
+      weeks.push(grid.slice(start, start + 7));
+    // Drop a trailing week that is entirely next month.
+    while (
+      weeks.length > 4 &&
+      weeks[weeks.length - 1]?.every((cell) => !cell.inMonth)
+    )
+      weeks.pop();
+    const [year, value] = month.split("-").map(Number);
+    return {
+      title: `${year}년 ${value}월`,
+      subtitle: input.title,
+      rowLabels: false,
+      columns: ["일", "월", "화", "수", "목", "금", "토"].map((label) => ({
+        label,
+      })),
+      rows: weeks.map((week) => ({
+        label: "",
+        cells: week.map((cell, column) => ({
+          day: String(cell.day),
+          muted: !cell.inMonth,
+          today: cell.date === input.today,
+          // A multi-day entry is written once per week row: on its first day,
+          // or on Sunday when it carries on from the week before.
+          items: entriesOnDate(shown, cell.date)
+            .filter(
+              (entry) =>
+                entry.date === cell.date ||
+                (column === 0 && entry.date < cell.date),
+            )
+            .map((entry) => {
+              const end = entryEndDate(entry);
+              const multi = entry.date !== end;
+              const dept = entry.dept ? input.deptLabel?.(entry.dept) : undefined;
+              const parts = [
+                multi && entry.date !== cell.date ? "↳" : "",
+                multi ? "" : timeLabel(entry),
+                entry.title,
+                multi ? `(${shortDate(entry.date)}–${shortDate(end)})` : "",
+                dept ? `[${dept}]` : "",
+              ].filter(Boolean);
+              return {
+                text: parts.join(" "),
+                milestone: entry.milestone === true,
+                color: entry.color,
+              };
+            }),
+        })),
+      })),
+    };
+  });
+}
+
+const csvField = (value: string) =>
+  /[",\n\r]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+
+/**
+ * Entries between `from` and `to` as CSV (UTF-8 with BOM so Excel reads the
+ * Korean right), one row per occurrence.
+ */
+export function entriesCsv(input: {
+  entries: CalendarEntry[];
+  from: string;
+  to: string;
+  deptLabel?: (key: string) => string | undefined;
+}): string {
+  const header = [
+    "시작 날짜",
+    "종료 날짜",
+    "시작 시간",
+    "종료 시간",
+    "제목",
+    "부서",
+    "종류",
+    "메모",
+  ];
+  const lines = [header.join(",")];
+  const shown = expandRepeats(input.entries, input.from, input.to).filter(
+    (entry) => entry.date <= input.to && entryEndDate(entry) >= input.from,
+  );
+  for (const entry of shown) {
+    lines.push(
+      [
+        entry.date,
+        entryEndDate(entry),
+        entry.time ?? "",
+        entry.endTime ?? "",
+        entry.title,
+        entry.dept ? (input.deptLabel?.(entry.dept) ?? entry.dept) : "",
+        entry.milestone ? "마감·이벤트" : entry.repeat ? "반복" : "작업",
+        entry.note ?? "",
+      ]
+        .map(csvField)
+        .join(","),
+    );
+  }
+  return `﻿${lines.join("\r\n")}\r\n`;
+}

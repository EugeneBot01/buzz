@@ -0,0 +1,124 @@
+//! Team calendar exports (team patch): the calendar builds PNG, PDF, Word,
+//! CSV or JSON bytes in the webview and this command saves them through the
+//! native save dialog. The bytes are checked against the kind so the command
+//! can only write the file types the calendar makes.
+
+use base64::{engine::general_purpose::STANDARD, Engine as _};
+
+use crate::commands::export_util::save_bytes_with_dialog;
+use crate::commands::media_filename::sanitize_filename;
+
+/// Largest export accepted (a long sprint board as PNG is a few MB).
+const MAX_EXPORT_BYTES: usize = 40 * 1024 * 1024;
+
+const PNG_MAGIC: &[u8] = b"\x89PNG\r\n\x1a\n";
+const PDF_MAGIC: &[u8] = b"%PDF-";
+const ZIP_MAGIC: &[u8] = b"PK\x03\x04";
+
+/// The dialog filter and extension of a kind, or an error for an unknown one.
+fn kind_info(kind: &str) -> Result<(&'static str, &'static str), String> {
+    match kind {
+        "png" => Ok(("PNG image", "png")),
+        "pdf" => Ok(("PDF document", "pdf")),
+        "docx" => Ok(("Word document", "docx")),
+        "csv" => Ok(("CSV file", "csv")),
+        "json" => Ok(("JSON file", "json")),
+        _ => Err(format!("unsupported export kind: {kind}")),
+    }
+}
+
+fn check_bytes(kind: &str, bytes: &[u8]) -> Result<(), String> {
+    let ok = match kind {
+        "png" => bytes.starts_with(PNG_MAGIC),
+        "pdf" => bytes.starts_with(PDF_MAGIC),
+        "docx" => bytes.starts_with(ZIP_MAGIC),
+        // Text exports: must be UTF-8 (CSV may start with a BOM).
+        "csv" | "json" => std::str::from_utf8(bytes).is_ok(),
+        _ => false,
+    };
+    if ok {
+        Ok(())
+    } else {
+        Err(format!("export does not look like a {kind} file"))
+    }
+}
+
+fn decode_export(kind: &str, data_base64: &str) -> Result<Vec<u8>, String> {
+    kind_info(kind)?;
+    // base64 is 4/3 of the bytes; refuse before decoding something huge.
+    if data_base64.len() > MAX_EXPORT_BYTES / 3 * 4 + 4 {
+        return Err("export is too large".to_string());
+    }
+    let bytes = STANDARD
+        .decode(data_base64.trim())
+        .map_err(|_| "invalid export data".to_string())?;
+    if bytes.is_empty() || bytes.len() > MAX_EXPORT_BYTES {
+        return Err("export is empty or too large".to_string());
+    }
+    check_bytes(kind, &bytes)?;
+    Ok(bytes)
+}
+
+/// Make sure the suggested name ends with the kind's extension.
+fn with_extension(filename: &str, extension: &str) -> String {
+    let clean = sanitize_filename(filename);
+    let suffix = format!(".{extension}");
+    if clean.to_lowercase().ends_with(&suffix) {
+        clean
+    } else {
+        format!("{clean}{suffix}")
+    }
+}
+
+/// Save a calendar export through the native save-file dialog. Returns
+/// `false` when the person cancelled the dialog.
+#[tauri::command]
+pub async fn save_team_calendar_export(
+    data_base64: String,
+    filename: String,
+    kind: String,
+    app: tauri::AppHandle,
+) -> Result<bool, String> {
+    let bytes = decode_export(&kind, &data_base64)?;
+    let (filter_name, extension) = kind_info(&kind)?;
+    let filename = with_extension(&filename, extension);
+    save_bytes_with_dialog(&app, &filename, filter_name, &[extension], &bytes).await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_each_kind_with_matching_bytes() {
+        let cases: [(&str, &[u8]); 5] = [
+            ("png", b"\x89PNG\r\n\x1a\nrest"),
+            ("pdf", b"%PDF-1.4\n"),
+            ("docx", b"PK\x03\x04rest"),
+            ("csv", "\u{feff}날짜,제목\r\n".as_bytes()),
+            ("json", b"{\"format\":1}"),
+        ];
+        for (kind, bytes) in cases {
+            let encoded = STANDARD.encode(bytes);
+            assert_eq!(decode_export(kind, &encoded).unwrap(), bytes, "{kind}");
+        }
+    }
+
+    #[test]
+    fn rejects_wrong_kind_bytes_or_data() {
+        let png = STANDARD.encode(b"\x89PNG\r\n\x1a\n");
+        assert!(decode_export("pdf", &png).is_err());
+        assert!(decode_export("exe", &png).is_err());
+        assert!(decode_export("png", "not base64!").is_err());
+        assert!(decode_export("png", "").is_err());
+        let invalid_utf8 = STANDARD.encode([0xff, 0xfe, 0xfd]);
+        assert!(decode_export("csv", &invalid_utf8).is_err());
+    }
+
+    #[test]
+    fn adds_the_extension_once() {
+        assert_eq!(with_extension("보드.png", "png"), "보드.png");
+        assert_eq!(with_extension("보드", "pdf"), "보드.pdf");
+        assert!(!with_extension("../../etc/passwd", "csv").contains('/'));
+    }
+}

+import { ArrowDown, ArrowUp, Plus, Trash2 } from "lucide-react";
+import * as React from "react";
+
+import { CALENDAR_COLORS } from "@/features/team-calendar/lib/teamCalendar";
+import {
+  MAX_DEPTS,
+  MAX_KEY_DATES,
+  MAX_LABEL_LENGTH,
+  MAX_PHASES,
+  MAX_PLAN_NOTE_LENGTH,
+  MAX_PLAN_TITLE_LENGTH,
+  MAX_SPRINT_WEEKS,
+  PHASE_TONES,
+  type PhaseTone,
+  mondayOf,
+  validatePlan,
+} from "@/features/team-calendar/lib/teamSprint";
+import type { SprintPlanInput } from "@/features/team-calendar/lib/useTeamSprint";

+import * as React from "react";
+
+import { useChannelsQuery } from "@/features/channels/hooks";
+import { useMyRelayMembershipLookupQuery } from "@/features/community-members/hooks";
+import { useCommunities } from "@/features/communities/useCommunities";
+import { SettingsSectionHeader } from "@/features/settings/ui/SettingsSectionHeader";
+import {
+  ONBOARDING_TAG,
+  encodeOnboarding,
+  onboardingDTag,
+} from "@/features/team-welcome/lib/defaults";
+import {
+  openWelcomeGuide,
+  readDefaultChannels,
+} from "@/features/team-welcome/lib/useTeamWelcome";
+import { relayClient } from "@/shared/api/relayClient";
+import { canManageCommunityMembers } from "@/shared/api/relayMembers";
+import { signRelayEvent } from "@/shared/api/tauri";
+import { KIND_CHANNEL_SECTIONS } from "@/shared/constants/kinds";
+import { Button } from "@/shared/ui/button";
+import { Checkbox } from "@/shared/ui/checkbox";
+
+/** Settings → 팀 안내: show the guide again, and (admins) pick default channels. */
+export function TeamWelcomeSettingsCard() {
+  const relayUrl = useCommunities().activeCommunity?.relayUrl;
+  const membership = useMyRelayMembershipLookupQuery();
+  const manager = canManageCommunityMembers(membership.data);
+
+  return (
+    <section className="min-w-0" data-no-translate="">
+      <SettingsSectionHeader
+        action={
+          <Button
+            onClick={() => openWelcomeGuide()}
+            type="button"
+            variant="outline"
+          >
+            안내 다시 보기
+          </Button>
+        }
+        description="업데이트 후 처음 켤 때 한 번 보이는 5단계 안내예요."
+        title="팀 안내"
+      />
+      {manager && relayUrl ? (
+        <DefaultChannels key={relayUrl} relayUrl={relayUrl} />
+      ) : null}
+    </section>
+  );
+}
+
+function DefaultChannels({ relayUrl }: { relayUrl: string }) {
+  const channelsQuery = useChannelsQuery();
+  const channels = React.useMemo(
+    () =>
+      (channelsQuery.data ?? [])
+        .filter(
+          (channel) =>
+            channel.channelType !== "dm" &&
+            channel.visibility === "open" &&
+            !channel.archivedAt,
+        )
+        .sort((a, b) => a.name.localeCompare(b.name, "ko")),
+    [channelsQuery.data],
+  );
+  const [chosen, setChosen] = React.useState<ReadonlySet<string>>();
+  const [status, setStatus] = React.useState("");
+  const [busy, setBusy] = React.useState(false);
+  const lastSavedAt = React.useRef(0);
+
+  React.useEffect(() => {
+    let cancelled = false;
+    readDefaultChannels(relayUrl).then(
+      (doc) => {
+        if (!cancelled) setChosen(new Set(doc?.channels.map(({ id }) => id)));
+      },
+      () => {
+        if (!cancelled) {
+          setChosen(new Set());
+          setStatus("저장된 기본 채널을 불러오지 못했어요.");
+        }
+      },
+    );
+    return () => {
+      cancelled = true;
+    };
+  }, [relayUrl]);
+
+  const save = async () => {
+    if (!chosen) return;
+    const picked = channels
+      .filter(({ id }) => chosen.has(id))
+      .map(({ id, name }) => ({ id, name }));
+    setBusy(true);
+    setStatus("저장 중…");
+    // Two saves in one second would otherwise be refused as a duplicate.
+    const createdAt = Math.max(
+      Math.floor(Date.now() / 1_000),
+      lastSavedAt.current + 1,
+    );
+    try {
+      const event = await signRelayEvent({
+        kind: KIND_CHANNEL_SECTIONS,
+        content: encodeOnboarding(picked),
+        createdAt,
+        tags: [
+          ["d", onboardingDTag(relayUrl)],
+          ["t", ONBOARDING_TAG],
+        ],
+      });
+      await relayClient.publishEvent(
+        event,
+        "기본 채널을 저장하는 데 시간이 너무 오래 걸립니다.",
+        "기본 채널을 저장하지 못했습니다.",
+      );
+      lastSavedAt.current = createdAt;
+      setStatus(
+        "저장했어요. 새로 들어오는 팀원은 이 채널들에 자동으로 들어가요.",
+      );
+    } catch (error) {
+      setStatus(
+        `저장하지 못했어요: ${error instanceof Error ? error.message : String(error)}`,
+      );
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <fieldset className="flex flex-col gap-3 border-t border-border pt-6">
+      <legend className="text-sm font-semibold">
+        기본 채널 (관리자만 보여요)
+      </legend>
+      <p className="text-sm text-muted-foreground">
+        체크한 공개 채널에 새 팀원(처음 들어온 지 7일 안)이 앱을 처음 켤 때
+        자동으로 들어가요. 이미 있던 팀원은 업데이트 뒤에 새로 만든 채널을
+        체크했을 때만 한 번 들어가고, 스스로 나간 채널에 다시 넣지는 않아요.
+      </p>
+      {!chosen ? (
+        <p className="text-sm text-muted-foreground">불러오는 중…</p>
+      ) : channels.length === 0 ? (
+        <p className="text-sm text-muted-foreground">공개 채널이 없어요.</p>
+      ) : (
+        <ul className="flex max-h-72 flex-col gap-2 overflow-y-auto">
+          {channels.map((channel) => (
+            <li className="flex items-center gap-2" key={channel.id}>
+              <Checkbox
+                checked={chosen.has(channel.id)}
+                id={`team-default-channel-${channel.id}`}
+                onCheckedChange={(checked) => {
+                  const next = new Set(chosen);
+                  if (checked === true) next.add(channel.id);
+                  else next.delete(channel.id);
+                  setChosen(next);
+                }}
+              />
+              <label
+                className="text-sm"
+                htmlFor={`team-default-channel-${channel.id}`}
+              >
+                # {channel.name}
+              </label>
+            </li>
+          ))}
+        </ul>
+      )}
+      <div className="flex items-center gap-3">
+        <Button
+          disabled={!chosen || busy}
+          onClick={() => void save()}
+          type="button"
+        >
+          저장
+        </Button>
+        {status ? (
+          <span className="text-xs text-muted-foreground">{status}</span>
+        ) : null}
+      </div>
+    </fieldset>
+  );
+}

@@ -0,0 +1,101 @@
+import * as React from "react";
+
+import {
+  closeWelcomeGuide,
+  useWelcomeGuideState,
+} from "@/features/team-welcome/lib/useTeamWelcome";
+import { Button } from "@/shared/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+
+/** What a newcomer needs first, in the words of this team build's screens. */
+const STEPS: readonly { title: string; body: (joined: string) => string }[] = [
+  {
+    title: "팀 Buzz에 오신 걸 환영해요",
+    body: () =>
+      "팀원과 AI 에이전트가 함께 일하는 대화 앱이에요. 다섯 가지만 알면 바로 쓸 수 있어요.",
+  },
+  {
+    title: "채널 = 주제별 대화방",
+    body: (joined) =>
+      (joined ? `기본 채널(${joined})에 자동으로 넣어 드렸어요. ` : "") +
+      "다른 공개 채널은 왼쪽 '채널' 옆 +(채널 둘러보기)에서 찾아 들어가요. 자물쇠 채널은 그 방 멤버가 초대해야 보여요.",
+  },
+  {
+    title: "알림은 채널마다 고를 수 있어요",
+    body: () =>
+      "채널 이름을 오른쪽 클릭 → 알림에서 고르세요. 기본값은 설정 → 알림에 있어요. @everyone 을 쓰면 채널의 사람 모두에게 알림이 가요.",
+  },
+  {
+    title: "왼쪽 위 '캘린더'",
+    body: () =>
+      "팀 모두가 함께 보고 고치는 달력이에요. 촬영·회의 일정을 여기에 올리면 팀원 모두에게 보여요.",
+  },
+  {
+    title: "채널 위쪽 버튼들",
+    body: () =>
+      "플러그 모양 '연결'에 회의용 구글 미트·피그마 링크를 붙여 두면 누구나 한 번에 열어요. 옆의 파일 버튼으로 채널에 올라온 파일을 모아 보고 한꺼번에 받을 수 있어요. 이 안내는 설정 → 팀 안내에서 다시 볼 수 있어요.",
+  },
+];
+
+export function WelcomeGuide() {
+  const state = useWelcomeGuideState();
+  const [step, setStep] = React.useState(0);
+  React.useEffect(() => {
+    if (state.open) setStep(0);
+  }, [state.open]);
+  if (!state.open) return null;
+
+  const page = STEPS[step];
+  if (!page) return null;
+  const last = step === STEPS.length - 1;
+
+  return (
+    <Dialog
+      onOpenChange={(open) => {
+        if (!open) closeWelcomeGuide();
+      }}
+      open
+    >
+      <DialogContent className="max-w-[440px]" data-no-translate="">
+        <DialogHeader>
+          <p className="text-xs text-muted-foreground">
+            {step + 1} / {STEPS.length}
+          </p>
+          <DialogTitle>{page.title}</DialogTitle>
+          <DialogDescription className="leading-relaxed">
+            {page.body(state.joined.join(", "))}
+          </DialogDescription>
+        </DialogHeader>
+        <DialogFooter className="flex items-center justify-between gap-2 sm:justify-between">
+          <Button onClick={closeWelcomeGuide} type="button" variant="ghost">
+            건너뛰기
+          </Button>
+          <div className="flex gap-2">
+            {step > 0 ? (
+              <Button
+                onClick={() => setStep(step - 1)}
+                type="button"
+                variant="outline"
+              >
+                이전
+              </Button>
+            ) : null}
+            <Button
+              onClick={() => (last ? closeWelcomeGuide() : setStep(step + 1))}
+              type="button"
+            >
+              {last ? "시작하기" : "다음"}
+            </Button>
+          </div>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}

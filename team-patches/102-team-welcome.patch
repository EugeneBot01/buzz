diff --git a/desktop/src/features/team-welcome/lib/defaults.test.mjs b/desktop/src/features/team-welcome/lib/defaults.test.mjs
new file mode 100644
index 000000000..2c67fd23c
--- /dev/null
+++ b/desktop/src/features/team-welcome/lib/defaults.test.mjs
@@ -0,0 +1,155 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  MAX_DEFAULT_CHANNELS,
+  NEWCOMER_WINDOW_MS,
+  decodeOnboarding,
+  encodeOnboarding,
+  firstRunAttempted,
+  isNewcomer,
+  latestOnboarding,
+  onboardingDTag,
+  pendingDefaults,
+  readProgress,
+  writeProgress,
+} from "./defaults.ts";
+
+const ADMIN = "a".repeat(64);
+const MEMBER = "b".repeat(64);
+
+const doc = (channels) => decodeOnboarding(encodeOnboarding(channels, 1));
+
+test("the document key matches the Buzz Team 0.7 build", () => {
+  assert.equal(
+    onboardingDTag("wss://Relay.Example.com/"),
+    "team-onboarding:wss://relay.example.com",
+  );
+});
+
+test("encode and decode keep valid channels, drop bad and repeated ones", () => {
+  const decoded = decodeOnboarding(
+    JSON.stringify({
+      version: 1,
+      updatedAt: 5,
+      channels: [
+        { id: "c1", name: "공지" },
+        { id: "c1", name: "dup" },
+        { id: "", name: "empty" },
+        { id: 3 },
+        null,
+        { id: "c2" },
+      ],
+    }),
+  );
+  assert.deepEqual(decoded, {
+    version: 1,
+    updatedAt: 5,
+    channels: [
+      { id: "c1", name: "공지" },
+      { id: "c2", name: "c2" },
+    ],
+  });
+  assert.equal(decodeOnboarding("not json"), null);
+  assert.equal(
+    decodeOnboarding(JSON.stringify({ version: 2, channels: [] })),
+    null,
+  );
+});
+
+test("at most MAX_DEFAULT_CHANNELS are kept", () => {
+  const many = Array.from({ length: MAX_DEFAULT_CHANNELS + 5 }, (_, i) => ({
+    id: `c${i}`,
+    name: `c${i}`,
+  }));
+  assert.equal(doc(many).channels.length, MAX_DEFAULT_CHANNELS);
+});
+
+test("only the newest document by an owner or admin counts", () => {
+  const events = [
+    {
+      pubkey: ADMIN,
+      created_at: 10,
+      content: encodeOnboarding([{ id: "old", name: "old" }]),
+    },
+    {
+      pubkey: ADMIN,
+      created_at: 20,
+      content: encodeOnboarding([{ id: "new", name: "new" }]),
+    },
+    {
+      pubkey: MEMBER,
+      created_at: 30,
+      content: encodeOnboarding([{ id: "spam", name: "spam" }]),
+    },
+  ];
+  assert.deepEqual(
+    latestOnboarding(events, new Set([ADMIN])).channels.map(({ id }) => id),
+    ["new"],
+  );
+  assert.equal(latestOnboarding(events, new Set()), null);
+});
+
+test("pending defaults skip joined and already attempted channels", () => {
+  const defaults = doc([
+    { id: "a", name: "a" },
+    { id: "b", name: "b" },
+    { id: "c", name: "c" },
+  ]);
+  assert.deepEqual(
+    pendingDefaults(defaults, new Set(["a"]), new Set(["b"])).map(
+      ({ id }) => id,
+    ),
+    ["c"],
+  );
+  assert.deepEqual(pendingDefaults(null, new Set(), new Set()), []);
+});
+
+test("a newcomer starts with nothing handled", () => {
+  const defaults = doc([{ id: "a", name: "a" }]);
+  assert.deepEqual(firstRunAttempted(true, ["x", "y"], defaults), []);
+});
+
+test("an existing member's first run marks every unjoined public channel and every default handled", () => {
+  const defaults = doc([
+    { id: "a", name: "a" },
+    { id: "x", name: "x" },
+  ]);
+  assert.deepEqual([...firstRunAttempted(false, ["x", "y"], defaults)].sort(), [
+    "a",
+    "x",
+    "y",
+  ]);
+  // No defaults saved yet: a later first save still cannot reach old channels.
+  assert.deepEqual([...firstRunAttempted(false, ["x", "y"], null)].sort(), [
+    "x",
+    "y",
+  ]);
+});
+
+test("newcomer: in no channel yet, or first added within the window", () => {
+  const now = Date.UTC(2026, 10, 4);
+  assert.equal(isNewcomer(null, now), true);
+  assert.equal(isNewcomer(now - 60_000, now), true);
+  assert.equal(isNewcomer(now - NEWCOMER_WINDOW_MS - 1, now), false);
+});
+
+test("progress round-trips per member and relay, and is null when never run", () => {
+  const store = new Map();
+  const storage = {
+    getItem: (key) => store.get(key) ?? null,
+    setItem: (key, value) => store.set(key, value),
+  };
+  assert.equal(readProgress(ADMIN, "wss://r.example", storage), null);
+  writeProgress(
+    ADMIN,
+    "wss://r.example",
+    { welcomed: true, attempted: ["a"] },
+    storage,
+  );
+  assert.deepEqual(readProgress(ADMIN, "wss://R.example/", storage), {
+    welcomed: true,
+    attempted: ["a"],
+  });
+  assert.equal(readProgress(MEMBER, "wss://r.example", storage), null);
+});
diff --git a/desktop/src/features/team-welcome/lib/defaults.ts b/desktop/src/features/team-welcome/lib/defaults.ts
new file mode 100644
index 000000000..8a68c5520
--- /dev/null
+++ b/desktop/src/features/team-welcome/lib/defaults.ts
@@ -0,0 +1,180 @@
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+
+/**
+ * Team welcome (team patch): the channels a community's owners and admins
+ * choose for every newcomer, and a short guide shown once per device.
+ *
+ * Stored as one plaintext kind-30078 document per admin, in the same shape as
+ * the Buzz Team 0.7 build (`team-onboarding`), so both builds read each
+ * other's choice. Readers keep the newest document written by a current owner
+ * or admin, so an ordinary member's document never changes anyone's defaults.
+ */
+export const ONBOARDING_TAG = "team-onboarding";
+export const MAX_DEFAULT_CHANNELS = 30;
+
+export function onboardingDTag(relayUrl: string): string {
+  return `${ONBOARDING_TAG}:${normalizeRelayUrl(relayUrl)}`;
+}
+
+export type DefaultChannel = Readonly<{ id: string; name: string }>;
+export type OnboardingDoc = Readonly<{
+  version: 1;
+  channels: readonly DefaultChannel[];
+  updatedAt: number;
+}>;
+
+export function encodeOnboarding(
+  channels: readonly DefaultChannel[],
+  now = Date.now(),
+): string {
+  const doc: OnboardingDoc = {
+    version: 1,
+    channels: channels.slice(0, MAX_DEFAULT_CHANNELS),
+    updatedAt: now,
+  };
+  return JSON.stringify(doc);
+}
+
+export function decodeOnboarding(content: string): OnboardingDoc | null {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(content);
+  } catch {
+    return null;
+  }
+  if (!raw || typeof raw !== "object") return null;
+  const { version, channels, updatedAt } = raw as Record<string, unknown>;
+  if (version !== 1 || !Array.isArray(channels)) return null;
+  const seen = new Set<string>();
+  const valid: DefaultChannel[] = [];
+  for (const entry of channels) {
+    if (!entry || typeof entry !== "object") continue;
+    const { id, name } = entry as Record<string, unknown>;
+    if (typeof id !== "string" || !id || id.length > 128 || seen.has(id))
+      continue;
+    seen.add(id);
+    valid.push({
+      id,
+      name: typeof name === "string" ? name.slice(0, 120) : id,
+    });
+    if (valid.length === MAX_DEFAULT_CHANNELS) break;
+  }
+  return {
+    version: 1,
+    channels: valid,
+    updatedAt: typeof updatedAt === "number" ? updatedAt : 0,
+  };
+}
+
+/** The newest readable document written by a current owner or admin. */
+export function latestOnboarding(
+  events: readonly { pubkey: string; content: string; created_at: number }[],
+  managers: ReadonlySet<string>,
+): OnboardingDoc | null {
+  let best: { at: number; doc: OnboardingDoc } | undefined;
+  for (const event of events) {
+    if (!managers.has(event.pubkey)) continue;
+    const doc = decodeOnboarding(event.content);
+    if (doc && (!best || event.created_at > best.at))
+      best = { at: event.created_at, doc };
+  }
+  return best?.doc ?? null;
+}
+
+/**
+ * Default channels this member is not in and has never been put into from
+ * this device. A channel the member left after joining stays left.
+ */
+export function pendingDefaults(
+  doc: OnboardingDoc | null,
+  joined: ReadonlySet<string>,
+  attempted: ReadonlySet<string>,
+): DefaultChannel[] {
+  return (doc?.channels ?? []).filter(
+    ({ id }) => !joined.has(id) && !attempted.has(id),
+  );
+}
+
+// ---- progress on this device, per member and community ----
+
+export type WelcomeProgress = Readonly<{
+  welcomed: boolean;
+  attempted: readonly string[];
+}>;
+
+const progressKey = (pubkey: string, relayUrl: string) =>
+  `buzz-team-welcome:${pubkey}:${normalizeRelayUrl(relayUrl)}`;
+
+/** `null` when this device has never run the welcome for this member. */
+export function readProgress(
+  pubkey: string,
+  relayUrl: string,
+  storage: Pick<Storage, "getItem"> = localStorage,
+): WelcomeProgress | null {
+  try {
+    const raw = JSON.parse(
+      storage.getItem(progressKey(pubkey, relayUrl)) ?? "",
+    );
+    if (!raw || typeof raw !== "object") return null;
+    const { welcomed, attempted } = raw as Record<string, unknown>;
+    return {
+      welcomed: welcomed === true,
+      attempted: Array.isArray(attempted)
+        ? attempted.filter((id): id is string => typeof id === "string")
+        : [],
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function writeProgress(
+  pubkey: string,
+  relayUrl: string,
+  progress: WelcomeProgress,
+  storage: Pick<Storage, "setItem"> = localStorage,
+): void {
+  try {
+    storage.setItem(progressKey(pubkey, relayUrl), JSON.stringify(progress));
+  } catch {
+    // Without storage the welcome simply runs again next launch.
+  }
+}
+
+/** How long after first joining a team channel someone counts as new. */
+export const NEWCOMER_WINDOW_MS = 7 * 24 * 60 * 60 * 1_000;
+
+/**
+ * Whether this member is new to the community: in no team channel yet, or
+ * first added to one within the window. A channel keeps the first join time
+ * when someone is added back, so an old member who left and was re-added by
+ * the server-side invite still counts as old.
+ */
+export function isNewcomer(
+  earliestJoinMs: number | null,
+  now = Date.now(),
+): boolean {
+  return earliestJoinMs === null || now - earliestJoinMs < NEWCOMER_WINDOW_MS;
+}
+
+/**
+ * What the first run on a device records as already handled. A newcomer
+ * starts with nothing handled, so every default channel is joined. An
+ * existing member updating the app has every public channel they are not in
+ * marked handled, so no channel they once left (or never wanted) is forced on
+ * them, whatever an admin picks later; only channels made after this run can
+ * still reach them as defaults.
+ */
+export function firstRunAttempted(
+  newcomer: boolean,
+  notJoinedOpenChannelIds: readonly string[],
+  doc: OnboardingDoc | null,
+): readonly string[] {
+  if (newcomer) return [];
+  return [
+    ...new Set([
+      ...notJoinedOpenChannelIds,
+      ...(doc?.channels ?? []).map(({ id }) => id),
+    ]),
+  ];
+}
diff --git a/desktop/src/features/team-welcome/lib/useTeamWelcome.ts b/desktop/src/features/team-welcome/lib/useTeamWelcome.ts
new file mode 100644
index 000000000..0b3ae1a34
--- /dev/null
+++ b/desktop/src/features/team-welcome/lib/useTeamWelcome.ts
@@ -0,0 +1,190 @@
+import { useQueryClient } from "@tanstack/react-query";
+import * as React from "react";
+
+import { channelsQueryKey } from "@/features/channels/hooks";
+import { relayClient } from "@/shared/api/relayClient";
+import { listRelayMembers } from "@/shared/api/relayMembers";
+import { getChannelMembers, joinChannel } from "@/shared/api/tauri";
+import type { Channel } from "@/shared/api/types";
+import { KIND_CHANNEL_SECTIONS } from "@/shared/constants/kinds";
+import {
+  type OnboardingDoc,
+  firstRunAttempted,
+  isNewcomer,
+  latestOnboarding,
+  onboardingDTag,
+  pendingDefaults,
+  readProgress,
+  writeProgress,
+} from "./defaults";
+
+// ---- whether the guide is open, shared by the app shell and Settings ----
+
+type GuideState = { open: boolean; joined: readonly string[] };
+let guide: GuideState = { open: false, joined: [] };
+const listeners = new Set<() => void>();
+const emit = () => {
+  for (const listener of listeners) listener();
+};
+const subscribe = (listener: () => void) => {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+};
+
+export function openWelcomeGuide(joined: readonly string[] = []) {
+  guide = { open: true, joined };
+  emit();
+}
+
+export function closeWelcomeGuide() {
+  guide = { ...guide, open: false };
+  emit();
+}
+
+export function useWelcomeGuideState() {
+  return React.useSyncExternalStore(subscribe, () => guide);
+}
+
+// ---- relay reads ----
+
+/** The community's default channels, as chosen by its owners and admins. */
+export async function readDefaultChannels(
+  relayUrl: string,
+): Promise<OnboardingDoc | null> {
+  const [members, events] = await Promise.all([
+    listRelayMembers(),
+    relayClient.fetchEvents({
+      kinds: [KIND_CHANNEL_SECTIONS],
+      "#d": [onboardingDTag(relayUrl)],
+      limit: 50,
+    }),
+  ]);
+  const managers = new Set(
+    members
+      .filter(({ role }) => role === "owner" || role === "admin")
+      .map(({ pubkey }) => pubkey),
+  );
+  return latestOnboarding(events, managers);
+}
+
+const isTeamChannel = (channel: Channel) =>
+  channel.channelType !== "dm" && !channel.archivedAt;
+
+/** How many of the member's channels are asked for their first join time. */
+const JOIN_TIME_SAMPLE = 5;
+
+/**
+ * When this member was first added to a team channel, from up to a few of
+ * their channels; `null` when they are in none.
+ */
+async function earliestJoin(
+  pubkey: string,
+  team: readonly Channel[],
+): Promise<number | null> {
+  const mine = team
+    .filter((channel) => channel.isMember)
+    .slice(0, JOIN_TIME_SAMPLE);
+  const times = await Promise.all(
+    mine.map(async (channel) => {
+      const member = (await getChannelMembers(channel.id)).find(
+        (entry) => entry.pubkey === pubkey,
+      );
+      const at = member ? Date.parse(member.joinedAt) : Number.NaN;
+      return Number.isFinite(at) ? at : null;
+    }),
+  );
+  if (mine.length === 0) return null;
+  const known = times.filter((at): at is number => at !== null);
+  if (known.length === 0) throw new Error("join time unknown");
+  return Math.min(...known);
+}
+
+/**
+ * Once per member, community and launch: joins the community's default
+ * channels this member has not been put into from this device, and shows the
+ * guide on the first run.
+ */
+export function useTeamWelcome(
+  pubkey: string | undefined,
+  relayUrl: string | undefined,
+  channels: readonly Channel[] | undefined,
+) {
+  const queryClient = useQueryClient();
+  const ranRef = React.useRef("");
+  const channelsRef = React.useRef(channels);
+  channelsRef.current = channels;
+  // Runs again once the list (a snapshot, or nothing yet) has team channels.
+  const loaded = channels?.some(isTeamChannel) === true;
+
+  React.useEffect(() => {
+    const channels = channelsRef.current;
+    if (!pubkey || !relayUrl || !loaded || !channels) return;
+    const scope = `${pubkey}|${relayUrl}`;
+    if (ranRef.current === scope) return;
+    ranRef.current = scope;
+    let cancelled = false;
+
+    void (async () => {
+      const progress = readProgress(pubkey, relayUrl);
+      const team = channels.filter(isTeamChannel);
+      let doc: OnboardingDoc | null = null;
+      let newcomer = false;
+      try {
+        doc = await readDefaultChannels(relayUrl);
+        if (!progress) newcomer = isNewcomer(await earliestJoin(pubkey, team));
+      } catch {
+        // Try again next launch; guessing here could pull an existing member
+        // back into channels they left.
+        return;
+      }
+      if (cancelled) return;
+
+      const joined = new Set(
+        team.filter((channel) => channel.isMember).map(({ id }) => id),
+      );
+      const attempted = new Set(
+        progress?.attempted ??
+          firstRunAttempted(
+            newcomer,
+            team
+              .filter((c) => !c.isMember && c.visibility === "open")
+              .map(({ id }) => id),
+            doc,
+          ),
+      );
+      const byId = new Map(team.map((channel) => [channel.id, channel]));
+      const names: string[] = [];
+      for (const channel of pendingDefaults(doc, joined, attempted)) {
+        if (cancelled) return;
+        // Not in the list yet (a snapshot from before it was made): next launch.
+        const current = byId.get(channel.id);
+        if (!current) continue;
+        attempted.add(channel.id);
+        // Only channels a member can join by themself; a private one is skipped.
+        if (current.visibility !== "open") continue;
+        try {
+          await joinChannel(channel.id);
+          names.push(current.name);
+        } catch {
+          // A channel that was removed or made private is skipped for good.
+        }
+      }
+      writeProgress(pubkey, relayUrl, {
+        welcomed: true,
+        attempted: [...attempted],
+      });
+      if (names.length > 0)
+        void queryClient.invalidateQueries({ queryKey: channelsQueryKey });
+      // Everyone sees the guide once per device; later from Settings.
+      if (!progress) openWelcomeGuide(names);
+    })();
+
+    return () => {
+      cancelled = true;
+      // A switch away before finishing lets the next visit run it again.
+      if (ranRef.current === scope) ranRef.current = "";
+    };
+  }, [pubkey, relayUrl, loaded, queryClient]);
+}

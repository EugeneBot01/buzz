diff --git a/desktop/src/features/messages/ui/TeamZipAudioAttachment.tsx b/desktop/src/features/messages/ui/TeamZipAudioAttachment.tsx
new file mode 100644
index 000000000..0ee7da792
--- /dev/null
+++ b/desktop/src/features/messages/ui/TeamZipAudioAttachment.tsx
@@ -0,0 +1,121 @@
+import * as React from "react";
+import { Download, Loader2, Music } from "lucide-react";
+import { toast } from "sonner";
+
+import { invokeTauri } from "@/shared/api/tauri";
+import {
+  Attachment,
+  AttachmentAction,
+  AttachmentActions,
+  AttachmentContent,
+  AttachmentMedia,
+  AttachmentTitle,
+} from "@/shared/ui/attachment";
+
+const TEAM_AUDIO_ZIP = /\.(m4a|mp3|wav|aac|flac|ogg|opus)\.zip$/i;
+
+const AUDIO_MIME: Record<string, string> = {
+  m4a: "audio/mp4",
+  mp3: "audio/mpeg",
+  wav: "audio/wav",
+  aac: "audio/aac",
+  flac: "audio/flac",
+  ogg: "audio/ogg",
+  opus: "audio/ogg",
+};
+
+/** The original audio name of a team zip ("song.m4a.zip" → "song.m4a"), or null. */
+export function teamZipAudioName(filename: string | undefined): string | null {
+  if (!filename || !TEAM_AUDIO_ZIP.test(filename)) return null;
+  return filename.slice(0, -".zip".length);
+}
+
+/**
+ * Audio the relay refused, which team patch 65 uploaded as `name.m4a.zip`
+ * (team patch 66): unzipped in the app on demand, played inline, and saved
+ * as the original file.
+ */
+export function TeamZipAudioAttachment({
+  href,
+  audioName,
+}: {
+  href: string;
+  audioName: string;
+}) {
+  const [src, setSrc] = React.useState<string | null>(null);
+  const [loading, setLoading] = React.useState(false);
+
+  React.useEffect(
+    () => () => {
+      if (src) URL.revokeObjectURL(src);
+    },
+    [src],
+  );
+
+  const load = async () => {
+    if (loading || src) return;
+    setLoading(true);
+    try {
+      const buffer = await invokeTauri<ArrayBuffer>("unzip_team_audio", {
+        url: href,
+      });
+      const extension = audioName.split(".").pop()?.toLowerCase() ?? "";
+      setSrc(
+        URL.createObjectURL(
+          new Blob([buffer], { type: AUDIO_MIME[extension] ?? "audio/mp4" }),
+        ),
+      );
+    } catch {
+      toast.error(
+        "음원을 불러오지 못했습니다. 파일을 받아 직접 압축을 풀어 주세요.",
+      );
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const save = async () => {
+    try {
+      await invokeTauri<boolean>("save_team_audio", { url: href });
+    } catch {
+      toast.error("원본 파일을 저장하지 못했습니다.");
+    }
+  };
+
+  return (
+    <Attachment
+      className="mt-1 max-w-md"
+      data-no-translate=""
+      data-testid="team-zip-audio-attachment"
+      size="default"
+    >
+      <AttachmentMedia aria-hidden="true">
+        <Music className="h-4 w-4" />
+      </AttachmentMedia>
+      <AttachmentContent className="min-w-0 gap-2">
+        <AttachmentTitle className="truncate">{audioName}</AttachmentTitle>
+        {src ? (
+          // biome-ignore lint/a11y/useMediaCaption: user-shared music has no captions
+          <audio autoPlay className="w-full" controls src={src} />
+        ) : null}
+      </AttachmentContent>
+      <AttachmentActions>
+        {src ? null : (
+          <AttachmentAction
+            disabled={loading}
+            onClick={() => void load()}
+            size="xs"
+            type="button"
+          >
+            {loading ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : null}
+            재생
+          </AttachmentAction>
+        )}
+        <AttachmentAction onClick={() => void save()} size="xs" type="button">
+          <Download className="h-3.5 w-3.5" />
+          원본 저장
+        </AttachmentAction>
+      </AttachmentActions>
+    </Attachment>
+  );
+}

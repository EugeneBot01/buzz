diff --git a/desktop/src-tauri/src/commands/team_zip_audio.rs b/desktop/src-tauri/src/commands/team_zip_audio.rs
new file mode 100644
index 000000000..882a2a7f1
--- /dev/null
+++ b/desktop/src-tauri/src/commands/team_zip_audio.rs
@@ -0,0 +1,130 @@
+//! Play and save audio that team patch 65 had to upload as a one-file zip
+//! (team patch 66).
+//!
+//! The hosted relay refuses `audio/*` uploads, so patch 65 wraps them in a
+//! zip named `song.m4a.zip`. Receivers would have to download and unzip it by
+//! hand; these commands unzip it in the app so the message can play it and
+//! save the original file.
+
+use std::io::{Cursor, Read};
+
+use tauri::State;
+
+use super::export_util::save_bytes_with_dialog;
+use super::media_download::{fetch_blob_bytes_with_cap, validate_download_url};
+use crate::app_state::AppState;
+use crate::relay::relay_api_base_url_with_override;
+
+/// Upper bound for the zip download and the unpacked audio.
+const MAX_TEAM_AUDIO_BYTES: u64 = 200 * 1024 * 1024;
+
+const AUDIO_EXTENSIONS: &[&str] = &["m4a", "mp3", "wav", "aac", "flac", "ogg", "opus"];
+
+/// The single audio entry of a team zip: its file name and bytes.
+pub(crate) fn extract_single_audio(zip_bytes: &[u8]) -> Result<(String, Vec<u8>), String> {
+    let mut archive = zip::ZipArchive::new(Cursor::new(zip_bytes))
+        .map_err(|e| format!("not a zip file: {e}"))?;
+    if archive.len() != 1 {
+        return Err("not a single-file team zip".to_string());
+    }
+    let mut entry = archive
+        .by_index(0)
+        .map_err(|e| format!("cannot read zip entry: {e}"))?;
+    let name = entry.name().to_string();
+    if name.is_empty()
+        || name.contains('/')
+        || name.contains('\\')
+        || name.contains("..")
+        || entry.is_dir()
+    {
+        return Err("unexpected entry name in team zip".to_string());
+    }
+    let extension = name
+        .rsplit_once('.')
+        .map(|(_, ext)| ext.to_ascii_lowercase())
+        .unwrap_or_default();
+    if !AUDIO_EXTENSIONS.contains(&extension.as_str()) {
+        return Err("team zip does not hold an audio file".to_string());
+    }
+    if entry.size() > MAX_TEAM_AUDIO_BYTES {
+        return Err("audio file is too large".to_string());
+    }
+    let mut bytes = Vec::with_capacity(entry.size() as usize);
+    (&mut entry)
+        .take(MAX_TEAM_AUDIO_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| format!("cannot unzip audio: {e}"))?;
+    if bytes.len() as u64 > MAX_TEAM_AUDIO_BYTES {
+        return Err("audio file is too large".to_string());
+    }
+    Ok((name, bytes))
+}
+
+async fn fetch_team_audio(
+    url: &str,
+    state: &State<'_, AppState>,
+) -> Result<(String, Vec<u8>), String> {
+    validate_download_url(url, &relay_api_base_url_with_override(state))?;
+    let zip_bytes = fetch_blob_bytes_with_cap(url, state, MAX_TEAM_AUDIO_BYTES, None).await?;
+    extract_single_audio(&zip_bytes)
+}
+
+/// The unpacked audio bytes of a team zip attachment, as a raw buffer.
+#[tauri::command]
+pub async fn unzip_team_audio(
+    url: String,
+    state: State<'_, AppState>,
+) -> Result<tauri::ipc::Response, String> {
+    let (_, bytes) = fetch_team_audio(&url, &state).await?;
+    Ok(tauri::ipc::Response::new(bytes))
+}
+
+/// Saves the original audio file of a team zip attachment (asks where).
+#[tauri::command]
+pub async fn save_team_audio(
+    url: String,
+    app: tauri::AppHandle,
+    state: State<'_, AppState>,
+) -> Result<bool, String> {
+    let (name, bytes) = fetch_team_audio(&url, &state).await?;
+    let extension = name.rsplit_once('.').map(|(_, ext)| ext).unwrap_or("m4a");
+    save_bytes_with_dialog(&app, &name, "Audio", &[extension], &bytes).await
+}
+
+#[cfg(test)]
+mod tests {
+    use std::io::Write;
+
+    use super::extract_single_audio;
+
+    fn zip_of(entries: &[(&str, &[u8])]) -> Vec<u8> {
+        let mut out = Vec::new();
+        {
+            let mut writer = zip::ZipWriter::new(std::io::Cursor::new(&mut out));
+            for (name, data) in entries {
+                writer
+                    .start_file(*name, zip::write::SimpleFileOptions::default())
+                    .unwrap();
+                writer.write_all(data).unwrap();
+            }
+            writer.finish().unwrap();
+        }
+        out
+    }
+
+    #[test]
+    fn unpacks_one_audio_entry() {
+        let (name, bytes) = extract_single_audio(&zip_of(&[("song.m4a", b"audio")])).unwrap();
+        assert_eq!(name, "song.m4a");
+        assert_eq!(bytes, b"audio");
+    }
+
+    #[test]
+    fn refuses_anything_else() {
+        assert!(extract_single_audio(b"not a zip").is_err());
+        assert!(extract_single_audio(&zip_of(&[("a.m4a", b"x"), ("b.m4a", b"y")])).is_err());
+        assert!(extract_single_audio(&zip_of(&[("notes.txt", b"x")])).is_err());
+        assert!(extract_single_audio(&zip_of(&[("dir/song.mp3", b"x")])).is_err());
+        assert!(extract_single_audio(&zip_of(&[("../song.mp3", b"x")])).is_err());
+    }
+}

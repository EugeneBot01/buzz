+/**
+ * Team build: a member's own delete leaves no "removed a message" row. Only
+ * moderator removals (relay-stamped `public_reason`) stay visible.
+ */
+export function isSelfDeleteTombstone(message: {
+  kind?: number;
+  body: string;
+}): boolean {
+  if (message.kind !== KIND_SYSTEM_MESSAGE) return false;
+  try {
+    const payload = JSON.parse(message.body) as {
+      type?: string;
+      public_reason?: string;
+    };
+    return payload?.type === "message_deleted" && !payload.public_reason;
+  } catch {
+    return false;
+  }
+}
+
 export function buildTimelineItems(
   entries: MainTimelineEntry[],
   firstUnreadMessageId: string | null,
 ): TimelineItemsResult {

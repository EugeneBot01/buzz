--- /dev/null
+++ b/desktop/src/features/messages/lib/hideDeleteTombstone.test.mjs
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { isSelfDeleteTombstone } from "./timelineItems.ts";
+
+test("hides a member's own delete tombstone", () => {
+  assert.equal(
+    isSelfDeleteTombstone({
+      kind: 40099,
+      body: JSON.stringify({ type: "message_deleted", actor: "a" }),
+    }),
+    true,
+  );
+});
+
+test("keeps moderator removals and other system rows", () => {
+  assert.equal(
+    isSelfDeleteTombstone({
+      kind: 40099,
+      body: JSON.stringify({ type: "message_deleted", public_reason: "spam" }),
+    }),
+    false,
+  );
+  assert.equal(
+    isSelfDeleteTombstone({
+      kind: 40099,
+      body: JSON.stringify({ type: "member_joined" }),
+    }),
+    false,
+  );
+  assert.equal(
+    isSelfDeleteTombstone({
+      kind: 9,
+      body: JSON.stringify({ type: "message_deleted" }),
+    }),
+    false,
+  );
+  assert.equal(isSelfDeleteTombstone({ kind: 40099, body: "not json" }), false);
+});

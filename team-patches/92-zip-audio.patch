@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { deflateRawSync } from "node:zlib";
+
+import { teamZipAudioOf, unpackSingleEntry } from "./teamZipAudio.ts";
+
+/** A minimal zip writer for fixtures: one or more entries, stored or deflated. */
+function makeZip(files, method = 0) {
+  const parts = [];
+  const central = [];
+  let offset = 0;
+  for (const [name, data] of files) {
+    const nameBytes = Buffer.from(name);
+    const body = method === 8 ? deflateRawSync(data) : Buffer.from(data);
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50, 0);
+    local.writeUInt16LE(method, 8);
+    local.writeUInt32LE(body.length, 18);
+    local.writeUInt32LE(data.length, 22);
+    local.writeUInt16LE(nameBytes.length, 26);
+    const dir = Buffer.alloc(46);
+    dir.writeUInt32LE(0x02014b50, 0);
+    dir.writeUInt16LE(method, 10);
+    dir.writeUInt32LE(body.length, 20);
+    dir.writeUInt32LE(data.length, 24);
+    dir.writeUInt16LE(nameBytes.length, 28);
+    dir.writeUInt32LE(offset, 42);
+    parts.push(local, nameBytes, body);
+    central.push(dir, nameBytes);
+    offset += local.length + nameBytes.length + body.length;
+  }
+  const dirBytes = Buffer.concat(central);
+  const end = Buffer.alloc(22);
+  end.writeUInt32LE(0x06054b50, 0);
+  end.writeUInt16LE(files.length, 8);
+  end.writeUInt16LE(files.length, 10);
+  end.writeUInt32LE(dirBytes.length, 12);
+  end.writeUInt32LE(offset, 16);
+  return new Uint8Array(Buffer.concat([...parts, dirBytes, end]));
+}
+
+const audio = Buffer.from("ID3\x03\x00\x00\x00 some audio bytes ".repeat(20));
+
+test("recognises packed audio by its shown name", () => {
+  assert.deepEqual(
+    teamZipAudioOf({ filename: "1절가사없음.m4a.zip", m: "application/zip" }),
+    { name: "1절가사없음.m4a", type: "audio/mp4" },
+  );
+  assert.equal(
+    teamZipAudioOf({ filename: "song.mp3.zip", m: "audio/mpeg" }),
+    null,
+  );
+  assert.equal(
+    teamZipAudioOf({ filename: "photos.zip", m: "application/zip" }),
+    null,
+  );
+  assert.equal(
+    teamZipAudioOf({ filename: "doc.pdf.zip", m: "application/zip" }),
+    null,
+  );
+  assert.equal(teamZipAudioOf(undefined), null);
+});
+
+test("unpacks a stored entry", async () => {
+  const out = await unpackSingleEntry(makeZip([["a.m4a", audio]]));
+  assert.deepEqual(Buffer.from(out), audio);
+});
+
+test("unpacks a deflated entry (zips made before the stored change)", async () => {
+  const out = await unpackSingleEntry(makeZip([["a.m4a", audio]], 8));
+  assert.deepEqual(Buffer.from(out), audio);
+});
+
+test("refuses several entries and non-zips", async () => {
+  await assert.rejects(
+    unpackSingleEntry(
+      makeZip([
+        ["a.mp3", audio],
+        ["b.mp3", audio],
+      ]),
+    ),
+    /여러 개/,
+  );
+  await assert.rejects(
+    unpackSingleEntry(new Uint8Array(40)),
+    /zip 파일이 아닙니다/,
+  );
+});
diff --git a/desktop/src/features/messages/lib/teamZipAudio.ts b/desktop/src/features/messages/lib/teamZipAudio.ts
new file mode 100644
index 0000000..12f735c
--- /dev/null
+++ b/desktop/src/features/messages/lib/teamZipAudio.ts
@@ -0,0 +1,87 @@
+/**
+ * Team patch: audio the app zipped before upload (the relay refuses audio as
+ * an attachment, see `media_team_zip.rs`) is shown as `<name>.<ext>.zip`.
+ * These helpers recognise such an attachment and take the original file back
+ * out of the zip so it can be played in the chat.
+ */
+
+const AUDIO_TYPES: Record<string, string> = {
+  aac: "audio/aac",
+  aif: "audio/aiff",
+  aiff: "audio/aiff",
+  flac: "audio/flac",
+  m4a: "audio/mp4",
+  mp3: "audio/mpeg",
+  ogg: "audio/ogg",
+  opus: "audio/ogg",
+  wav: "audio/wav",
+};
+
+/** Largest packed audio the player will open in memory. */
+export const MAX_TEAM_ZIP_AUDIO_BYTES = 200 * 1024 * 1024;
+
+/** The original name and audio type of a packed audio attachment, or `null`. */
+export function teamZipAudioOf(
+  entry:
+    | {
+        filename?: string;
+        m?: string;
+      }
+    | undefined,
+): { name: string; type: string } | null {
+  const filename = entry?.filename;
+  if (!filename || entry?.m?.toLowerCase() !== "application/zip") return null;
+  const match = /^(.+\.([a-z0-9]+))\.zip$/i.exec(filename);
+  const ext = match?.[2]?.toLowerCase();
+  const type = ext ? AUDIO_TYPES[ext] : undefined;
+  return match?.[1] && type ? { name: match[1], type } : null;
+}
+
+const u16 = (view: DataView, at: number) => view.getUint16(at, true);
+const u32 = (view: DataView, at: number) => view.getUint32(at, true);
+
+/**
+ * The bytes of the single entry of a zip, read through its central directory.
+ * Stored and deflated entries are supported; anything else throws.
+ */
+export async function unpackSingleEntry(
+  zip: Uint8Array<ArrayBuffer>,
+): Promise<Uint8Array<ArrayBuffer>> {
+  const view = new DataView(zip.buffer, zip.byteOffset, zip.byteLength);
+  // End of central directory: 22 bytes plus a comment of up to 65535.
+  let end = -1;
+  for (
+    let at = zip.byteLength - 22;
+    at >= Math.max(0, zip.byteLength - 22 - 65_535);
+    at--
+  ) {
+    if (u32(view, at) === 0x06054b50) {
+      end = at;
+      break;
+    }
+  }
+  if (end < 0) throw new Error("zip 파일이 아닙니다.");
+  if (u16(view, end + 10) !== 1) throw new Error("파일이 여러 개인 zip입니다.");
+  const central = u32(view, end + 16);
+  if (central + 46 > zip.byteLength || u32(view, central) !== 0x02014b50)
+    throw new Error("zip 파일이 손상되었습니다.");
+  const method = u16(view, central + 10);
+  const packedSize = u32(view, central + 20);
+  const size = u32(view, central + 24);
+  const local = u32(view, central + 42);
+  if (local + 30 > zip.byteLength || u32(view, local) !== 0x04034b50)
+    throw new Error("zip 파일이 손상되었습니다.");
+  const start = local + 30 + u16(view, local + 26) + u16(view, local + 28);
+  if (size > MAX_TEAM_ZIP_AUDIO_BYTES || start + packedSize > zip.byteLength)
+    throw new Error("파일이 너무 크거나 손상되었습니다.");
+  const packed = zip.subarray(start, start + packedSize);
+  if (method === 0) return packed;
+  if (method !== 8) throw new Error("지원하지 않는 압축 방식입니다.");
+  const stream = new Blob([packed])
+    .stream()
+    .pipeThrough(new DecompressionStream("deflate-raw"));
+  const unpacked = new Uint8Array(await new Response(stream).arrayBuffer());
+  if (unpacked.byteLength !== size)
+    throw new Error("zip 파일이 손상되었습니다.");
+  return unpacked;
+}

index 0000000..12e8255
--- /dev/null
+++ b/desktop/src/shared/ui/markdown/TeamZipAudioCard.tsx
@@ -0,0 +1,83 @@
+import { Loader2, Play } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import { unpackSingleEntry } from "@/features/messages/lib/teamZipAudio";
+import { fetchMediaBytes } from "@/shared/api/tauriMedia";
+import { FileCard } from "./FileCard";
+
+/**
+ * Team patch: an audio file the app zipped to get past the relay. The card
+ * saves the original file (the download command unpacks it), and "바로 듣기"
+ * plays it here without saving.
+ */
+export function TeamZipAudioCard({
+  href,
+  name,
+  type,
+  size,
+}: {
+  href: string;
+  /** Original file name, without `.zip`. */
+  name: string;
+  type: string;
+  size?: number;
+}) {
+  const [state, setState] = React.useState<
+    { kind: "idle" } | { kind: "loading" } | { kind: "ready"; url: string }
+  >({ kind: "idle" });
+  const url = state.kind === "ready" ? state.url : null;
+  React.useEffect(
+    () => () => {
+      if (url) URL.revokeObjectURL(url);
+    },
+    [url],
+  );
+
+  const load = async () => {
+    setState({ kind: "loading" });
+    try {
+      const audio = await unpackSingleEntry(await fetchMediaBytes(href));
+      setState({
+        kind: "ready",
+        url: URL.createObjectURL(new Blob([audio], { type })),
+      });
+    } catch (error) {
+      setState({ kind: "idle" });
+      toast.error(
+        error instanceof Error && error.message
+          ? `재생하지 못했습니다: ${error.message}`
+          : "재생하지 못했습니다.",
+      );
+    }
+  };
+
+  return (
+    <span className="my-1 flex max-w-sm flex-col gap-1" data-no-translate="">
+      <span className="flex items-center gap-2">
+        <FileCard filename={name} href={href} size={size} />
+        {state.kind === "ready" ? null : (
+          <button
+            aria-label={`${name} 바로 듣기`}
+            className="inline-flex h-9 shrink-0 items-center gap-1 rounded-full border border-border/70 px-3 text-xs text-muted-foreground hover:bg-muted/70 disabled:opacity-60"
+            data-testid="team-zip-audio-play"
+            disabled={state.kind === "loading"}
+            onClick={() => void load()}
+            type="button"
+          >
+            {state.kind === "loading" ? (
+              <Loader2 className="h-3.5 w-3.5 animate-spin" />
+            ) : (
+              <Play className="h-3.5 w-3.5" />
+            )}
+            바로 듣기
+          </button>
+        )}
+      </span>
+      {url ? (
+        // biome-ignore lint/a11y/useMediaCaption: a music file has no captions.
+        <audio autoPlay className="w-full" controls src={url} />
+      ) : null}
+    </span>
+  );
+}

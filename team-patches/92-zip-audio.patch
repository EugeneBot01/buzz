+/// The original file inside a zip `wrap_if_refused` made, for saving it as
+/// what was sent (`song.m4a`, not `song.m4a.zip`).
+///
+/// `filename` is the shown name (`<original>.zip`). Only a one-entry zip whose
+/// entry sniffs as a type the relay refuses, and is at most `max` bytes, is
+/// unpacked; anything else (a zip someone made by hand) returns `None` and is
+/// saved as it is.
+pub(super) fn unpack_team_zip(bytes: &[u8], filename: &str, max: u64) -> Option<(Vec<u8>, String)> {
+    let lower = filename.to_ascii_lowercase();
+    let inner = filename.get(..filename.len().checked_sub(4)?)?;
+    if !lower.ends_with(".zip") || inner.is_empty() || !inner.contains('.') {
+        return None;
+    }
+    let mut archive = zip::ZipArchive::new(std::io::Cursor::new(bytes)).ok()?;
+    if archive.len() != 1 {
+        return None;
+    }
+    let entry = archive.by_index(0).ok()?;
+    if entry.is_dir() || entry.size() > max {
+        return None;
+    }
+    let mut unpacked = Vec::new();
+    // `take` bounds the read even if the declared size lies.
+    std::io::Read::read_to_end(&mut std::io::Read::take(entry, max + 1), &mut unpacked).ok()?;
+    if unpacked.len() as u64 > max {
+        return None;
+    }
+    let mime = infer::get(&unpacked)?.mime_type();
+    if !relay_refuses_media(mime) {
+        return None;
+    }
+    Some((unpacked, inner.to_string()))
+}

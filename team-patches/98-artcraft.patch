+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { canOpenInApp, fileExtension, teamAppFor } from "./openInApp.ts";
+
+test("documents open in their ArtCraft app; scripts are never offered", () => {
+  assert.equal(teamAppFor("공모전 정리_1007.xlsx"), "GridCraft");
+  assert.equal(teamAppFor("회의록.DOCX"), "WordCraft");
+  assert.equal(teamAppFor("발표.pptx"), "DeckCraft");
+  assert.equal(teamAppFor("계약서.pdf"), "PdfCraft");
+  assert.equal(teamAppFor("메모.txt"), null);
+  assert.ok(canOpenInApp("메모.txt"));
+  assert.ok(canOpenInApp("기획안.hwp"));
+  for (const name of ["run.command", "setup.sh", "Buzz.app", "x.dmg", "a.pkg", "noext"])
+    assert.equal(canOpenInApp(name), false, name);
+  assert.equal(fileExtension("a.tar.gz"), "gz");
+});

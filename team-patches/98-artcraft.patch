+    name,
+    command: "/bin/sh",
+    args: [
+      "-c",
+      `mkdir -p ${dir} && cd ${dir} && exec "${ARTCRAFT_BIN}/${cli}" mcp${roots}`,
+    ],
+    env: {},
+  };
+}

+/// Team patch: the ArtCraft app that opens an attachment, by file extension.
+fn team_app_for(ext: &str) -> Option<&'static str> {
+    match ext {
+        "docx" | "doc" | "odt" | "rtf" => Some("WordCraft"),
+        "xlsx" | "xls" | "xlsm" | "ods" | "csv" | "tsv" => Some("GridCraft"),
+        "pptx" | "ppt" | "odp" => Some("DeckCraft"),
+        "pdf" => Some("PdfCraft"),
+        _ => None,
+    }
+}
+
+/// Team patch: document and picture types "열기" may hand to another app.
+/// Anything else (a script, an app bundle, an installer) is refused, because
+/// the system would run it instead of showing it.
+const TEAM_OPENABLE_EXTENSIONS: &[&str] = &[
+    "docx", "doc", "odt", "rtf", "xlsx", "xls", "xlsm", "ods", "csv", "tsv", "pptx", "ppt",
+    "odp", "pdf", "txt", "md", "png", "jpg", "jpeg", "gif", "webp", "hwp", "hwpx",
+];
+
+/// The installed app bundle for `name`, in /Applications or ~/Applications.
+fn installed_app_path(name: &str) -> Option<std::path::PathBuf> {
+    let mut candidates = vec![std::path::PathBuf::from(format!("/Applications/{name}.app"))];
+    if let Some(home) = std::env::var_os("HOME") {
+        candidates.push(
+            std::path::PathBuf::from(home)
+                .join("Applications")
+                .join(format!("{name}.app")),
+        );
+    }
+    candidates.into_iter().find(|path| path.is_dir())
+}
+
+/// Team patch: download an attachment to a fresh temporary folder and open it
+/// in its ArtCraft app (WordCraft, GridCraft, DeckCraft, PdfCraft) when that
+/// app is installed, else in the Mac's default app for the type. Returns the
+/// name of the app it used, or "default".
+///
+/// Same address, size and type checks as `download_file`, and only the
+/// document and picture types in `TEAM_OPENABLE_EXTENSIONS` are opened.
+#[tauri::command]
+pub async fn open_file_in_app(
+    url: String,
+    filename: String,
+    state: State<'_, AppState>,
+) -> Result<String, String> {
+    let relay_base = relay_api_base_url_with_override(&state);
+    validate_download_url(&url, &relay_base)?;
+    let filename = sanitize_filename(&filename);
+
+    let bytes = fetch_blob_bytes_with_cap(&url, &state, MAX_FILE_DOWNLOAD_BYTES, None).await?;
+    detect_and_validate_mime(&bytes)?;
+    let (bytes, filename) =
+        match super::media_team_zip::unpack_team_zip(&bytes, &filename, MAX_FILE_DOWNLOAD_BYTES) {
+            Some((unpacked, original)) => (unpacked, sanitize_filename(&original)),
+            None => (bytes, filename),
+        };
+
+    let ext = std::path::Path::new(&filename)
+        .extension()
+        .and_then(|e| e.to_str())
+        .map(|e| e.to_ascii_lowercase())
+        .unwrap_or_default();
+    if !TEAM_OPENABLE_EXTENSIONS.contains(&ext.as_str()) {
+        return Err(format!("cannot open this file type here: .{ext}"));
+    }
+
+    // A fresh folder per open, so two files with the same name never collide.
+    let dir = std::env::temp_dir()
+        .join("buzz-opened")
+        .join(uuid::Uuid::new_v4().to_string());
+    std::fs::create_dir_all(&dir).map_err(|e| format!("failed to prepare the file: {e}"))?;
+    let path = dir.join(&filename);
+    std::fs::write(&path, &bytes).map_err(|e| format!("failed to prepare the file: {e}"))?;
+
+    let app = team_app_for(&ext).and_then(|name| installed_app_path(name).map(|p| (name, p)));
+    let mut command = std::process::Command::new("/usr/bin/open");
+    if let Some((_, app_path)) = &app {
+        command.arg("-a").arg(app_path);
+    }
+    let status = command
+        .arg(&path)
+        .status()
+        .map_err(|e| format!("failed to open the file: {e}"))?;
+    if !status.success() {
+        return Err("failed to open the file".to_string());
+    }
+    Ok(app
+        .map(|(name, _)| name.to_string())
+        .unwrap_or_else(|| "default".to_string()))
+}

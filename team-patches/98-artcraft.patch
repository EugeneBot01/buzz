+/**
+ * Team patch: which attachments "열기" offers, and the ArtCraft app that
+ * opens each (WordCraft, GridCraft, DeckCraft, PdfCraft). The native command
+ * keeps the same list and refuses anything else, so a script or installer is
+ * never handed to the system to run.
+ */
+const TEAM_APPS: Record<string, string> = {
+  docx: "WordCraft",
+  doc: "WordCraft",
+  odt: "WordCraft",
+  rtf: "WordCraft",
+  xlsx: "GridCraft",
+  xls: "GridCraft",
+  xlsm: "GridCraft",
+  ods: "GridCraft",
+  csv: "GridCraft",
+  tsv: "GridCraft",
+  pptx: "DeckCraft",
+  ppt: "DeckCraft",
+  odp: "DeckCraft",
+  pdf: "PdfCraft",
+};
+
+const OTHER_OPENABLE = new Set([
+  "txt",
+  "md",
+  "png",
+  "jpg",
+  "jpeg",
+  "gif",
+  "webp",
+  "hwp",
+  "hwpx",
+]);
+
+export function fileExtension(filename: string): string {
+  const match = /\.([A-Za-z0-9]+)$/.exec(filename.trim());
+  return match ? (match[1] as string).toLowerCase() : "";
+}
+
+/** True when "열기" is offered for this file name. */
+export function canOpenInApp(filename: string): boolean {
+  const ext = fileExtension(filename);
+  return ext in TEAM_APPS || OTHER_OPENABLE.has(ext);
+}
+
+/** The ArtCraft app meant for this file, or null for the Mac's default. */
+export function teamAppFor(filename: string): string | null {
+  return TEAM_APPS[fileExtension(filename)] ?? null;
+}

+++ b/desktop/src/features/team-links/lib/teamLinks.ts
@@ -231,3 +231,18 @@ export function linksForChannel(
         a.id.localeCompare(b.id),
     );
 }
+
+/** Google's page that makes a fresh Meet room. */
+export const NEW_MEET_URL = "https://meet.google.com/new";
+
+/**
+ * Splits a channel's shortcuts for the header: its Google Meet room (the
+ * first one, if any), which always has its own button, and the rest.
+ */
+export function splitMeetShortcut(shown: readonly TeamLink[]): {
+  meet: TeamLink | null;
+  others: TeamLink[];
+} {
+  const meet = shown.find((link) => link.kind === "meet") ?? null;
+  return { meet, others: shown.filter((link) => link !== meet) };
+}

diff --git a/desktop/src/features/team-calendar/lib/useWeeklyDigest.ts b/desktop/src/features/team-calendar/lib/useWeeklyDigest.ts
new file mode 100644
index 000000000..5b946b8a4
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/useWeeklyDigest.ts
@@ -0,0 +1,309 @@
+import * as React from "react";
+import { toast } from "sonner";
+
+import { getChannelMessagesBefore } from "@/shared/api/tauriChannels";
+import { relayClient } from "@/shared/api/relayClient";
+import { signRelayEvent } from "@/shared/api/tauri";
+import { sendChannelMessage } from "@/shared/api/tauriMessages";
+import { KIND_CHANNEL_SECTIONS } from "@/shared/constants/kinds";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+import {
+  REPEAT_DOC,
+  TEAM_CALENDAR_D_TAG,
+  addDays,
+  combineMonths,
+  expandRepeats,
+  monthOfDate,
+  shiftMonth,
+  todayKey,
+} from "./teamCalendar";
+import { useTeamCalendarMonth } from "./useTeamCalendar";
+import { useTeamMembers } from "./useTeamMembers";
+import {
+  type DigestSettings,
+  DEFAULT_DIGEST,
+  alreadyPosted,
+  dailyHeader,
+  dailyNotices,
+  dailyNoticesDue,
+  decodeDigest,
+  digestDTag,
+  digestHeader,
+  digestText,
+  dueDigestWeek,
+  encodeDigest,
+  latestDigest,
+  postDelaySeconds,
+  weekStartOf,
+} from "./weeklyDigest";
+
+const CHECK_INTERVAL_MS = 60_000;
+const REFRESH_SETTINGS_MS = 5 * 60_000;
+/** Recent posts scanned to see whether a notice already went out. */
+const DEDUPE_SCAN = 50;
+const POSTED_PREFIX = "buzz-team-calendar-digest-posted.v1";
+
+async function fetchDigest(relayUrl: string): Promise<DigestSettings> {
+  const events = await relayClient.fetchEvents({
+    kinds: [KIND_CHANNEL_SECTIONS],
+    "#d": [digestDTag(relayUrl)],
+    limit: 200,
+  });
+  return latestDigest(events.map((event) => decodeDigest(event.content)));
+}
+
+/** The community's shared weekly-digest settings, and a way to change them. */
+export function useDigestSettings(pubkey: string, relayUrl: string) {
+  const [settings, setSettings] =
+    React.useState<DigestSettings>(DEFAULT_DIGEST);
+  const [ready, setReady] = React.useState(false);
+
+  React.useEffect(() => {
+    let cancelled = false;
+    setReady(false);
+    const load = () =>
+      void fetchDigest(relayUrl).then(
+        (next) => {
+          if (cancelled) return;
+          setSettings((previous) => latestDigest([previous, next]));
+          setReady(true);
+        },
+        () => {},
+      );
+    setSettings(DEFAULT_DIGEST);
+    load();
+    const interval = window.setInterval(load, REFRESH_SETTINGS_MS);
+    const unsubscribe = relayClient.subscribeToReconnects(load);
+    return () => {
+      cancelled = true;
+      window.clearInterval(interval);
+      unsubscribe();
+    };
+  }, [relayUrl]);
+
+  const save = React.useCallback(
+    async (
+      change: Partial<Omit<DigestSettings, "updatedAt" | "updatedBy">>,
+    ) => {
+      const next: DigestSettings = {
+        ...settings,
+        ...change,
+        updatedAt: Math.max(Date.now(), settings.updatedAt + 1),
+        updatedBy: pubkey,
+      };
+      const event = await signRelayEvent({
+        kind: KIND_CHANNEL_SECTIONS,
+        content: encodeDigest(next),
+        createdAt: Math.floor(Date.now() / 1_000),
+        tags: [
+          ["d", digestDTag(relayUrl)],
+          ["t", TEAM_CALENDAR_D_TAG],
+        ],
+      });
+      await relayClient.publishEvent(
+        event,
+        "주간 공지 설정을 저장하는 데 시간이 너무 오래 걸립니다.",
+        "주간 공지 설정을 저장하지 못했습니다.",
+      );
+      setSettings(next);
+    },
+    [pubkey, relayUrl, settings],
+  );
+
+  return { settings, ready, save };
+}
+
+async function recentPosts(channelId: string) {
+  const page = await getChannelMessagesBefore(
+    channelId,
+    { createdAt: Math.floor(Date.now() / 1_000) + 60, eventId: "" },
+    DEDUPE_SCAN,
+  );
+  return page.events;
+}
+
+function markPosted(pubkey: string, relayUrl: string, key: string): boolean {
+  const storageKey = `${POSTED_PREFIX}:${pubkey}:${relayUrl}`;
+  try {
+    const done = new Set<string>(
+      JSON.parse(window.localStorage.getItem(storageKey) ?? "[]"),
+    );
+    if (done.has(key)) return false;
+    done.add(key);
+    window.localStorage.setItem(
+      storageKey,
+      JSON.stringify([...done].slice(-60)),
+    );
+  } catch {
+    // Without storage the channel scan still prevents a second post.
+  }
+  return true;
+}
+
+function wasPosted(pubkey: string, relayUrl: string, key: string): boolean {
+  try {
+    const done: string[] = JSON.parse(
+      window.localStorage.getItem(`${POSTED_PREFIX}:${pubkey}:${relayUrl}`) ??
+        "[]",
+    );
+    return done.includes(key);
+  } catch {
+    return false;
+  }
+}
+
+/** Calendar occurrences from four weeks before `weekStart` to its Sunday. */
+export function useWeekOccurrences(
+  pubkey: string,
+  relayUrl: string,
+  weekStart: string,
+) {
+  const firstMonth = monthOfDate(weekStart);
+  const here = useTeamCalendarMonth(pubkey, relayUrl, firstMonth);
+  const next = useTeamCalendarMonth(
+    pubkey,
+    relayUrl,
+    shiftMonth(firstMonth, 1),
+  );
+  const repeating = useTeamCalendarMonth(pubkey, relayUrl, REPEAT_DOC);
+  const occurrences = React.useMemo(
+    () =>
+      expandRepeats(
+        combineMonths([here.entries, next.entries, repeating.entries]),
+        addDays(weekStart, -28),
+        addDays(weekStart, 6),
+      ),
+    [here.entries, next.entries, repeating.entries, weekStart],
+  );
+  const ready =
+    here.status === "ready" &&
+    next.status === "ready" &&
+    repeating.status === "ready";
+  return { occurrences, ready };
+}
+
+/** Posts this week's digest now, without the de-duplication check (manual send). */
+export async function postDigestNow(
+  relayUrl: string,
+  channelId: string,
+  text: string,
+): Promise<void> {
+  await sendChannelMessage(
+    channelId,
+    text,
+    null,
+    undefined,
+    undefined,
+    undefined,
+    undefined,
+    undefined,
+    undefined,
+    undefined,
+    normalizeRelayUrl(relayUrl),
+  );
+}
+
+/**
+ * Posts the weekly digest and the same-day notices while the app runs (team
+ * patch 55). Mount once per community, next to the calendar reminders.
+ */
+export function useWeeklyDigest(pubkey: string, relayUrl: string) {
+  const { settings, ready } = useDigestSettings(pubkey, relayUrl);
+  const weekStart = weekStartOf(todayKey());
+  const { occurrences, ready: calendarReady } = useWeekOccurrences(
+    pubkey,
+    relayUrl,
+    weekStart,
+  );
+  const { nameOf } = useTeamMembers();
+
+  // The interval below reads the newest values without restarting.
+  const latest = React.useRef({
+    settings,
+    ready,
+    occurrences,
+    nameOf,
+    calendarReady,
+  });
+  latest.current = { settings, ready, occurrences, nameOf, calendarReady };
+
+  React.useEffect(() => {
+    const scope = normalizeRelayUrl(relayUrl);
+    const delayMs = postDelaySeconds(pubkey) * 1_000;
+    let busy = false;
+
+    const post = async (
+      channelId: string,
+      header: string,
+      text: string,
+      mentions: string[],
+      key: string,
+    ) => {
+      if (wasPosted(pubkey, relayUrl, key)) return;
+      if (alreadyPosted(await recentPosts(channelId), header)) {
+        markPosted(pubkey, relayUrl, key);
+        return;
+      }
+      if (!markPosted(pubkey, relayUrl, key)) return;
+      await sendChannelMessage(
+        channelId,
+        text,
+        null,
+        undefined,
+        mentions.length ? mentions : undefined,
+        undefined,
+        undefined,
+        undefined,
+        undefined,
+        undefined,
+        scope,
+      );
+    };
+
+    const check = async () => {
+      const state = latest.current;
+      if (busy || !state.ready || !state.calendarReady) return;
+      busy = true;
+      try {
+        const now = Date.now() - delayMs;
+        const day = todayKey();
+        const week = dueDigestWeek(state.settings, day, now);
+        if (week && state.settings.channelId) {
+          const header = digestHeader(week);
+          await post(
+            state.settings.channelId,
+            header,
+            digestText(state.occurrences, week, state.nameOf),
+            [],
+            `week:${week}:${state.settings.channelId}`,
+          ).catch(() =>
+            toast.error("이번 주 일정 공지를 채널에 올리지 못했습니다."),
+          );
+        }
+        if (dailyNoticesDue(state.settings, day, now)) {
+          for (const notice of dailyNotices(
+            state.occurrences,
+            day,
+            state.nameOf,
+          )) {
+            await post(
+              notice.channelId,
+              dailyHeader(day),
+              notice.text,
+              notice.mentions,
+              `day:${day}:${notice.channelId}`,
+            ).catch(() =>
+              toast.error("오늘 일정 공지를 채널에 올리지 못했습니다."),
+            );
+          }
+        }
+      } finally {
+        busy = false;
+      }
+    };
+
+    void check();
+    const interval = window.setInterval(() => void check(), CHECK_INTERVAL_MS);
+    return () => window.clearInterval(interval);
+  }, [pubkey, relayUrl]);
+}
diff --git a/desktop/src/features/team-calendar/lib/weeklyDigest.test.mjs b/desktop/src/features/team-calendar/lib/weeklyDigest.test.mjs
new file mode 100644
index 000000000..a6830e295
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/weeklyDigest.test.mjs
@@ -0,0 +1,194 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  DEFAULT_DIGEST,
+  alreadyPosted,
+  dailyNotices,
+  decodeDigest,
+  digestHeader,
+  digestText,
+  dueDigestWeek,
+  encodeDigest,
+  latestDigest,
+  postDelaySeconds,
+  weekStartOf,
+} from "./weeklyDigest.ts";
+
+const on = {
+  ...DEFAULT_DIGEST,
+  enabled: true,
+  channelId: "ch",
+  updatedAt: 1,
+  updatedBy: "a",
+};
+const at = (date, hour, minute = 0) => {
+  const [y, m, d] = date.split("-").map(Number);
+  return new Date(y, m - 1, d, hour, minute).getTime();
+};
+const names = (pubkey) => ({ a: "구윤", b: "은서" })[pubkey] ?? pubkey;
+
+test("weekStartOf finds Monday", () => {
+  assert.equal(weekStartOf("2026-10-13"), "2026-10-12"); // Tue
+  assert.equal(weekStartOf("2026-10-12"), "2026-10-12"); // Mon
+  assert.equal(weekStartOf("2026-10-18"), "2026-10-12"); // Sun
+});
+
+test("digest is due from Monday 9:00 for two days, not before or when off", () => {
+  assert.equal(dueDigestWeek(on, "2026-10-12", at("2026-10-12", 8, 59)), null);
+  assert.equal(
+    dueDigestWeek(on, "2026-10-12", at("2026-10-12", 9)),
+    "2026-10-12",
+  );
+  assert.equal(
+    dueDigestWeek(on, "2026-10-14", at("2026-10-14", 20)),
+    "2026-10-12",
+  );
+  assert.equal(dueDigestWeek(on, "2026-10-15", at("2026-10-15", 9)), null);
+  assert.equal(
+    dueDigestWeek(
+      { ...on, enabled: false },
+      "2026-10-12",
+      at("2026-10-12", 10),
+    ),
+    null,
+  );
+  assert.equal(
+    dueDigestWeek(
+      { ...on, channelId: null },
+      "2026-10-12",
+      at("2026-10-12", 10),
+    ),
+    null,
+  );
+});
+
+test("a Sunday schedule belongs to the same Monday-start week", () => {
+  const sunday = { ...on, weekday: 0, hour: 20 };
+  assert.equal(
+    dueDigestWeek(sunday, "2026-10-18", at("2026-10-18", 21)),
+    "2026-10-12",
+  );
+  assert.equal(dueDigestWeek(sunday, "2026-10-13", at("2026-10-13", 21)), null);
+});
+
+test("digest text lists the week by day with attendees and multi-day ranges", () => {
+  const text = digestText(
+    [
+      {
+        id: "1",
+        title: "촬영 회의",
+        date: "2026-10-13",
+        time: "14:00",
+        endTime: "16:00",
+        attendees: ["a", "b"],
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+      {
+        id: "2",
+        title: "로케 답사",
+        date: "2026-10-15",
+        endDate: "2026-10-16",
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+      {
+        id: "3",
+        title: "지난주부터",
+        date: "2026-10-10",
+        endDate: "2026-10-12",
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+      {
+        id: "4",
+        title: "지움",
+        date: "2026-10-13",
+        deleted: true,
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+      {
+        id: "5",
+        title: "다음주",
+        date: "2026-10-19",
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+    ],
+    "2026-10-12",
+    names,
+  );
+  assert.equal(text.split("\n")[0], digestHeader("2026-10-12"));
+  assert.match(text, /\*\*10\/12 월\*\*\n- ~10\/12 월 지난주부터/);
+  assert.match(
+    text,
+    /\*\*10\/13 화\*\*\n- 14:00~16:00 촬영 회의 \(구윤, 은서\)/,
+  );
+  assert.match(text, /- ~10\/16 금 로케 답사/);
+  assert.doesNotMatch(text, /지움|다음주/);
+});
+
+test("an empty week says so", () => {
+  assert.match(digestText([], "2026-10-12", names), /등록된 일정이 없습니다/);
+});
+
+test("daily notices group by channel and mention attendees", () => {
+  const notices = dailyNotices(
+    [
+      {
+        id: "1",
+        title: "A",
+        date: "2026-10-13",
+        time: "10:00",
+        notify: { channelId: "x" },
+        attendees: ["a"],
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+      {
+        id: "2",
+        title: "B",
+        date: "2026-10-12",
+        endDate: "2026-10-14",
+        notify: { channelId: "x" },
+        attendees: ["b"],
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+      { id: "3", title: "C", date: "2026-10-13", updatedAt: 1, updatedBy: "a" },
+      {
+        id: "4",
+        title: "D",
+        date: "2026-10-14",
+        notify: { channelId: "y" },
+        updatedAt: 1,
+        updatedBy: "a",
+      },
+    ],
+    "2026-10-13",
+    names,
+  );
+  assert.equal(notices.length, 1);
+  assert.equal(notices[0].channelId, "x");
+  assert.deepEqual(notices[0].mentions.sort(), ["a", "b"]);
+  assert.match(notices[0].text, /@구윤/);
+});
+
+test("settings round-trip and the newest wins", () => {
+  const encoded = encodeDigest({ ...on, hour: 8 });
+  assert.equal(decodeDigest(encoded).hour, 8);
+  assert.equal(decodeDigest("{bad"), null);
+  const newer = { ...on, updatedAt: 5, updatedBy: "b", hour: 7 };
+  assert.equal(latestDigest([on, null, newer]).hour, 7);
+  assert.equal(latestDigest([]).enabled, false);
+});
+
+test("an existing notice is recognised by its first line, and delays are stable", () => {
+  const header = digestHeader("2026-10-12");
+  assert.equal(alreadyPosted([{ content: `${header}\n- x` }], header), true);
+  assert.equal(alreadyPosted([{ content: "다른 글" }], header), false);
+  assert.equal(postDelaySeconds("abc"), postDelaySeconds("abc"));
+  assert.ok(postDelaySeconds("f".repeat(64)) < 120);
+});

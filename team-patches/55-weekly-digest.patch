+import * as React from "react";
+import { toast } from "sonner";
+
+import { todayKey } from "@/features/team-calendar/lib/teamCalendar";
+import { useNoticeChannels } from "@/features/team-calendar/lib/useNoticeChannels";
+import { useTeamMembers } from "@/features/team-calendar/lib/useTeamMembers";
+import {
+  postDigestNow,
+  useDigestSettings,
+  useWeekOccurrences,
+} from "@/features/team-calendar/lib/useWeeklyDigest";
+import {
+  digestText,
+  weekStartOf,
+} from "@/features/team-calendar/lib/weeklyDigest";
+import { Button } from "@/shared/ui/button";
+import { SELECT_CLASS } from "./EntryForm";
+
+const WEEKDAY_OPTIONS = [
+  [1, "월요일"],
+  [2, "화요일"],
+  [3, "수요일"],
+  [4, "목요일"],
+  [5, "금요일"],
+  [6, "토요일"],
+  [0, "일요일"],
+] as const;
+
+const HOURS = Array.from({ length: 24 }, (_, hour) => hour);
+
+/**
+ * Weekly-digest settings (team patch 55): where and when this week's calendar
+ * summary is posted, plus same-day notices. Shared by every member.
+ */
+export function DigestPanel({
+  pubkey,
+  relayUrl,
+}: {
+  pubkey: string;
+  relayUrl: string;
+}) {
+  const { settings, ready, save } = useDigestSettings(pubkey, relayUrl);
+  const channels = useNoticeChannels();
+  const { nameOf } = useTeamMembers();
+  const weekStart = weekStartOf(todayKey());
+  const { occurrences, ready: calendarReady } = useWeekOccurrences(
+    pubkey,
+    relayUrl,
+    weekStart,
+  );
+  const [saving, setSaving] = React.useState(false);
+  const preview = React.useMemo(
+    () => digestText(occurrences, weekStart, nameOf),
+    [occurrences, weekStart, nameOf],
+  );
+
+  const change = async (patch: Parameters<typeof save>[0]) => {
+    setSaving(true);
+    try {
+      await save(patch);
+    } catch (error) {
+      toast.error(
+        error instanceof Error ? error.message : "설정을 저장하지 못했습니다.",
+      );
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const sendNow = async () => {
+    if (!settings.channelId) return;
+    try {
+      await postDigestNow(relayUrl, settings.channelId, preview);
+      toast("이번 주 일정 공지를 올렸습니다.");
+    } catch {
+      toast.error("이번 주 일정 공지를 올리지 못했습니다.");
+    }
+  };
+
+  if (!ready) {
+    return (
+      <p className="py-6 text-sm text-muted-foreground">설정을 불러오는 중…</p>
+    );
+  }
+
+  return (
+    <div
+      className="flex flex-col gap-4 md:flex-row"
+      data-testid="team-calendar-digest"
+    >
+      <section
+        aria-label="주간 공지 설정"
+        className="flex min-w-0 flex-1 flex-col gap-3 text-sm"
+      >
+        <p className="text-xs text-muted-foreground">
+          정한 요일·시각에 그 주(월~일) 팀 일정을 채널에 한 번 정리해 올립니다.
+          서버가 아니라 그 시각에 켜져 있는 멤버의 Buzz가 올리고, 이미 올라와
+          있으면 다시 올리지 않습니다. 이 설정은 팀 전체에 같이 적용됩니다.
+        </p>
+        <label className="flex items-center gap-2">
+          <input
+            checked={settings.enabled}
+            data-testid="team-calendar-digest-enabled"
+            disabled={saving || (!settings.channelId && !settings.enabled)}
+            onChange={(event) => void change({ enabled: event.target.checked })}
+            type="checkbox"
+          />
+          매주 일정 공지 켜기
+        </label>
+        <div className="flex flex-wrap items-center gap-2">
+          <select
+            aria-label="공지할 채널"
+            className={SELECT_CLASS}
+            data-testid="team-calendar-digest-channel"
+            disabled={saving}
+            onChange={(event) =>
+              void change({ channelId: event.target.value || null })
+            }
+            value={settings.channelId ?? ""}
+          >
+            <option value="">채널 고르기</option>
+            {channels.map((channel) => (
+              <option key={channel.id} value={channel.id}>
+                #{channel.name}
+              </option>
+            ))}
+          </select>
+          <select
+            aria-label="요일"
+            className={SELECT_CLASS}
+            disabled={saving}
+            onChange={(event) =>
+              void change({ weekday: Number(event.target.value) })
+            }
+            value={settings.weekday}
+          >
+            {WEEKDAY_OPTIONS.map(([value, label]) => (
+              <option key={value} value={value}>
+                {label}
+              </option>
+            ))}
+          </select>
+          <select
+            aria-label="시각"
+            className={SELECT_CLASS}
+            disabled={saving}
+            onChange={(event) =>
+              void change({ hour: Number(event.target.value) })
+            }
+            value={settings.hour}
+          >
+            {HOURS.map((hour) => (
+              <option key={hour} value={hour}>
+                {hour}시
+              </option>
+            ))}
+          </select>
+        </div>
+        <label className="flex items-start gap-2">
+          <input
+            checked={settings.daily}
+            className="mt-0.5"
+            data-testid="team-calendar-digest-daily"
+            disabled={saving}
+            onChange={(event) => void change({ daily: event.target.checked })}
+            type="checkbox"
+          />
+          <span>
+            일정이 있는 날 아침(같은 시각)에, 일정마다 정해 둔 "채널 알림"
+            채널에 오늘 일정을 올리고 참석자를 부르기
+          </span>
+        </label>
+        <div>
+          <Button
+            disabled={!settings.channelId || !calendarReady}
+            onClick={() => void sendNow()}
+            size="sm"
+            type="button"
+            variant="outline"
+          >
+            이번 주 공지 지금 올리기
+          </Button>
+        </div>
+      </section>
+      <section aria-label="미리 보기" className="min-w-0 flex-1">
+        <p className="mb-2 text-xs text-muted-foreground">
+          이번 주 공지 미리 보기
+        </p>
+        <pre className="max-h-80 overflow-auto whitespace-pre-wrap rounded-md border bg-muted/30 p-3 text-xs">
+          {calendarReady ? preview : "일정을 불러오는 중…"}
+        </pre>
+      </section>
+    </div>
+  );
+}

+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+import { teamFeatureGroups } from "../lib/featureGroups";
+
+const icons: Record<string, typeof Link2> = {
+  채널·DM: MessageCircle,
+  "@everyone / @all": Bell,
+  허들: Video,
+  "에이전트 상태줄": Bot,

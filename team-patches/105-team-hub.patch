+import { useCommunities } from "@/features/communities/useCommunities";
+import { useIdentityQuery } from "@/shared/api/hooks";
+import { TeamScheduleView } from "./TeamScheduleView";
+
+/** Route content fills the body beside the sidebar and retires on navigation. */
+export function TeamScheduleScreen() {
+  const { activeCommunity } = useCommunities();
+  const { data: identity } = useIdentityQuery();
+  if (!activeCommunity || !identity)
+    return <p role="status">일정을 불러오는 중…</p>;
+  return (
+    <TeamScheduleView
+      key={`${activeCommunity.id}|${activeCommunity.relayUrl}|${identity.pubkey}`}
+      pubkey={identity.pubkey}
+      relayUrl={activeCommunity.relayUrl}
+    />
+  );
+}
diff --git a/desktop/src/features/team-schedule/ui/TeamScheduleView.tsx b/desktop/src/features/team-schedule/ui/TeamScheduleView.tsx

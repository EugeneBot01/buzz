@@ -0,0 +1,187 @@
+import assert from "node:assert/strict";
+import { afterEach, mock, test } from "node:test";
+import React from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { SidebarProvider } from "@/shared/ui/sidebar";
+import { Toaster } from "sonner";
+import { TeamFeatureHubSidebarEntry } from "./TeamFeatureHubSidebarEntry.tsx";
+import {
+  prepareScheduleDom,
+  pubkey,
+  relayUrl,
+} from "@/features/team-schedule/ui/scheduleTestSupport.mjs";
+import {
+  encodeTeamLinks,
+  teamLinksDTag,
+  NEW_MEET_URL,
+} from "@/features/team-links/lib/teamLinks.ts";
+import {
+  useWelcomeGuideState,
+  closeWelcomeGuide,
+} from "@/features/team-welcome/lib/useTeamWelcome.ts";
+
+let env;
+afterEach(() => {
+  cleanup();
+  env?.client.clear();
+  mock.restoreAll();
+  localStorage.clear();
+  closeWelcomeGuide();
+  delete globalThis.isTauri;
+});
+const channel = {
+  id: "fixture-channel",
+  name: "촬영",
+  channelType: "stream",
+  visibility: "open",
+};
+function WelcomeState() {
+  const state = useWelcomeGuideState();
+  return React.createElement(
+    "span",
+    { "data-testid": "guide-state" },
+    String(state.open),
+  );
+}
+function mount(selected = channel, meet = null) {
+  env = prepareScheduleDom(async (filter) =>
+    filter["#d"]?.[0] === teamLinksDTag(relayUrl) && meet
+      ? [
+          {
+            id: "b".repeat(64),
+            pubkey,
+            kind: 30078,
+            created_at: 1,
+            tags: [["d", teamLinksDTag(relayUrl)]],
+            content: encodeTeamLinks({ room: meet }),
+          },
+        ]
+      : [],
+  );
+  const actions = [];
+  const calendar = {
+    current: {
+      openSchedule: () => actions.push("schedule"),
+      openCalendar: (panel) => actions.push(panel),
+    },
+  };
+  const view = render(
+    React.createElement(
+      SidebarProvider,
+      null,
+      React.createElement(
+        "ul",
+        null,
+        React.createElement(TeamFeatureHubSidebarEntry, {
+          calendar,
+          onSettings: (section) => actions.push(section),
+          channel: selected,
+          pubkey,
+          relayUrl,
+        }),
+      ),
+      React.createElement(WelcomeState),
+      React.createElement(Toaster),
+    ),
+    { wrapper: env.Providers },
+  );
+  return { ...view, actions };
+}
+async function tile(view, name) {
+  fireEvent.click(view.getByRole("button", { name: "팀 기능", exact: true }));
+  const hub = await view.findByTestId("team-feature-hub");
+  const buttons = Array.from(hub.querySelectorAll("button[aria-label]"));
+  assert.deepEqual(
+    buttons.map((b) => b.getAttribute("aria-label")),
+    ["일정", "회의 시작", "채널 파일", "주간 공지", "알림 설정", "사용법"],
+  );
+  fireEvent.click(view.getByRole("button", { name, exact: true }));
+}
+
+test("schedule, digest and notification tiles call their existing destinations", async () => {
+  const view = mount();
+  await tile(view, "일정");
+  await waitFor(() => assert.deepEqual(view.actions, ["schedule"]));
+  await tile(view, "주간 공지");
+  await waitFor(() => assert.deepEqual(view.actions, ["schedule", "digest"]));
+  await tile(view, "알림 설정");
+  await waitFor(() =>
+    assert.deepEqual(view.actions, ["schedule", "digest", "notifications"]),
+  );
+});
+
+test("files tile mounts the existing channel file dialog scoped to the selected channel", async () => {
+  const view = mount();
+  await tile(view, "채널 파일");
+  await waitFor(() =>
+    assert.ok(view.getByRole("dialog").textContent.includes("촬영")),
+  );
+  await waitFor(() =>
+    assert.ok(env.queries.some((filter) => filter["#h"]?.[0] === channel.id)),
+  );
+});
+
+test("without a channel files gives a short hint and meeting opens a new room", async () => {
+  const view = mount(null);
+  await tile(view, "채널 파일");
+  await waitFor(() => assert.ok(view.getByText("채널을 먼저 고르세요")));
+  assert.equal(view.queryByRole("dialog"), null);
+  await tile(view, "회의 시작");
+  await waitFor(() =>
+    assert.equal(
+      env.calls.find((c) => c.cmd === "plugin:opener|open_url")?.args.url,
+      NEW_MEET_URL,
+    ),
+  );
+});
+
+test("meeting uses the current channel room through the same shortcut selector as the header", async () => {
+  const room = {
+    id: "room",
+    kind: "meet",
+    title: "회의실",
+    url: "https://meet.google.com/abc-defg-hij",
+    channelId: channel.id,
+    updatedAt: 1,
+    updatedBy: pubkey,
+  };
+  const view = mount(channel, room);
+  await tile(view, "회의 시작");
+  await waitFor(() =>
+    assert.ok(env.calls.some((c) => c.cmd === "plugin:opener|open_url")),
+  );
+  assert.equal(
+    env.calls.find((c) => c.cmd === "plugin:opener|open_url").args.url,
+    room.url,
+  );
+});
+
+test("a channel with no meet shortcut opens a new room", async () => {
+  const view = mount();
+  await tile(view, "회의 시작");
+  await waitFor(() =>
+    assert.equal(
+      env.calls.find((c) => c.cmd === "plugin:opener|open_url")?.args.url,
+      NEW_MEET_URL,
+    ),
+  );
+});
+
+test("help lists locations and replays the welcome guide after the dialog exits", async () => {
+  const view = mount();
+  await tile(view, "사용법");
+  const help = await view.findByRole("dialog", { name: "사용법" });
+  for (const text of [
+    "채널·DM",
+    "ArtCraft",
+    "압축 오디오",
+    "한국어",
+    "에이전트 MCP",
+  ])
+    assert.ok(help.textContent.includes(text));

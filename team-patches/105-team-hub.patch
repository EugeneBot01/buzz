+test("calendar refresh is read-only, ignores stale reads and keeps a failed refresh visible for retry", async () => {
+  const { useTeamCalendarMonth } = await import(
+    "@/features/team-calendar/lib/useTeamCalendar.ts"
+  );
+  const pending = [];
+  env = prepareScheduleDom(
+    () => new Promise((resolve, reject) => pending.push({ resolve, reject })),
+  );
+  function Month() {
+    const state = useTeamCalendarMonth(pubkey, relayUrl, "2026-11");
+    return React.createElement(
+      "div",
+      null,
+      React.createElement(
+        "span",
+        { "data-testid": "calendar-status" },
+        state.status,
+      ),
+      React.createElement(
+        "button",
+        { type: "button", onClick: state.refresh },
+        "달력 새로 읽기",
+      ),
+    );
+  }
+  const view = render(React.createElement(Month));
+  await waitFor(() => assert.equal(pending.length, 1));
+  fireEvent.click(view.getByRole("button", { name: "달력 새로 읽기" }));
+  assert.equal(pending.length, 2);
+  pending[1].resolve([]);
+  await waitFor(() =>
+    assert.equal(view.getByTestId("calendar-status").textContent, "ready"),
+  );
+  pending[0].reject(Error("old request failed"));
+  await new Promise((resolve) => setTimeout(resolve, 10));
+  assert.equal(view.getByTestId("calendar-status").textContent, "ready");
+  fireEvent.click(view.getByRole("button", { name: "달력 새로 읽기" }));
+  pending[2].reject(Error("offline"));
+  await waitFor(() =>
+    assert.equal(view.getByTestId("calendar-status").textContent, "error"),
+  );
+  fireEvent.click(view.getByRole("button", { name: "달력 새로 읽기" }));
+  pending[3].resolve([]);
+  await waitFor(() =>
+    assert.equal(view.getByTestId("calendar-status").textContent, "ready"),
+  );
+  assert.equal(
+    env.calls.some((c) => c.cmd === "sign_event" || c.cmd === "publish_event"),
+    false,
+  );
+});

+import { expect, test, type Page } from "@playwright/test";
+import { installMockBridge, TEST_IDENTITIES } from "../helpers/bridge";
+
+async function start(page: Page, role: "owner" | "member" = "member") {
+  await page.addInitScript(
+    (pubkeys) => {
+      for (const pubkey of pubkeys)
+        localStorage.setItem(
+          `buzz-team-welcome:${pubkey}:ws://localhost:3000`,
+          JSON.stringify({ welcomed: true, attempted: [] }),
+        );
+    },
+    [
+      "deadbeef".repeat(8),
+      ...Object.values(TEST_IDENTITIES).map(({ pubkey }) => pubkey),
+    ],
+  );
+  await installMockBridge(page, { relayRole: role });
+  await page.goto("/");
+  await expect(page.getByTestId("open-team-features")).toBeVisible();
+}
+
+async function openHub(page: Page) {
+  await page.getByTestId("open-team-features").click();
+  return page.getByTestId("team-feature-hub");
+}
+
+test("six tiles and keyboard navigation open the full schedule while retaining the calendar dialog", async ({
+  page,
+}) => {
+  await start(page);
+  const hub = await openHub(page);
+  for (const name of [
+    "일정",
+    "회의 시작",
+    "채널 파일",
+    "주간 공지",
+    "알림 설정",
+    "사용법",
+  ])
+    await expect(hub.getByRole("button", { name, exact: true })).toBeVisible();
+  await hub.getByRole("button", { name: "일정", exact: true }).focus();
+  await page.keyboard.press("Enter");
+  const schedule = page.getByTestId("team-schedule-screen");
+  await expect(schedule).toBeVisible();
+  await expect(schedule.getByTestId("team-calendar-embedded")).toBeVisible();
+  await expect(
+    schedule.getByRole("tab", { name: "스프린트", exact: true }),
+  ).toHaveAttribute("aria-selected", "true");
+  await schedule
+    .getByRole("button", { name: "일정 메뉴", exact: true })
+    .click();
+  await expect(
+    page.getByRole("menuitem", { name: "탭 추가", exact: true }),
+  ).toHaveCount(0);
+  await page.keyboard.press("Escape");
+  await page.getByTestId("open-team-calendar").click();
+  await expect(page.getByTestId("team-calendar-dialog")).toBeVisible();
+});
+
+test("hub retains digest, settings and help actions", async ({ page }) => {
+  await start(page);
+  let hub = await openHub(page);
+  await hub.getByRole("button", { name: "주간 공지", exact: true }).click();
+  await expect(page.getByTestId("team-calendar-digest")).toBeVisible();
+  await page.keyboard.press("Escape");
+  hub = await openHub(page);
+  await hub.getByRole("button", { name: "알림 설정", exact: true }).click();
+  await expect(page.getByTestId("settings-panel-notifications")).toBeVisible();
+  await page.keyboard.press("Escape");
+  hub = await openHub(page);
+  await hub.getByRole("button", { name: "사용법", exact: true }).click();
+  await expect(
+    page.getByRole("button", { name: "처음 안내 다시 보기", exact: true }),
+  ).toBeVisible();
+});
+
+test("owner can add a shared https schedule tab through the real signed-event seam", async ({
+  page,
+}) => {
+  await start(page, "owner");
+  await page.getByTestId("open-team-schedule").click();
+  const schedule = page.getByTestId("team-schedule-screen");
+  await schedule
+    .getByRole("button", { name: "일정 메뉴", exact: true })
+    .click();
+  await page.getByRole("menuitem", { name: "탭 추가", exact: true }).click();
+  await schedule.getByLabel("탭 이름", { exact: true }).fill("일정표");
+  await schedule
+    .getByLabel("팀과 공유할 주소", { exact: true })
+    .fill("https://example.com/schedule");
+  await schedule.getByRole("button", { name: "저장", exact: true }).click();
+  await expect
+    .poll(() =>
+      page.evaluate(
+        () =>
+          window.__BUZZ_E2E_SIGNED_EVENTS__?.filter(
+            (event) =>
+              event.kind === 30078 &&
+              event.tags.some(
+                ([name, value]) =>
+                  name === "d" && value?.startsWith("team-schedule-tabs:"),
+              ),
+          ).length ?? 0,
+      ),
+    )
+    .toBe(1);
+  const content = await page.evaluate(
+    () =>
+      window.__BUZZ_E2E_SIGNED_EVENTS__?.find((event) =>
+        event.tags.some(
+          ([name, value]) =>
+            name === "d" && value?.startsWith("team-schedule-tabs:"),
+        ),
+      )?.content,
+  );
+  expect(JSON.parse(content ?? "{}").tabs[0]).toMatchObject({
+    title: "일정표",
+    url: "https://example.com/schedule",
+  });
+  expect(content).not.toContain("localUrl");
+});

+          <DialogTitle>사용법</DialogTitle>
+          <DialogDescription className="sr-only">
+            팀 기능을 찾는 곳
+          </DialogDescription>
+        </DialogHeader>
+        <Button
+          type="button"
+          variant="outline"
+          onClick={() => {
+            onOpenChange(false);
+            onWelcome();
+          }}
+        >
+          처음 안내 다시 보기
+        </Button>
+        <ul className="space-y-3">
+          {items.map((item) => {
+            const Icon = icons[item.name] ?? Link2;
+            return (
+              <li className="flex items-start gap-2 text-xs" key={item.name}>
+                <Icon aria-hidden="true" className="size-4 shrink-0" />
+                <span>
+                  <strong className="font-semibold">{item.name}</strong> ·{" "}
+                  {item.location ?? "설정의 화면·언어에서"}
+                </span>
+              </li>
+            );
+          })}
+        </ul>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/desktop/src/features/team-hub/ui/teamHub.jsdom-test.mjs b/desktop/src/features/team-hub/ui/teamHub.jsdom-test.mjs

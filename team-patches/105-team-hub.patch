@@ -0,0 +1,190 @@
+import { register } from "node:module";
+import assert from "node:assert/strict";
+import { afterEach, mock, test } from "node:test";
+import React from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+// Node resolves the router's server condition even with jsdom. Use the same
+// browser branch as Vite so this test exercises its actual transition effects.
+register(
+  `data:text/javascript,${encodeURIComponent(`export function resolve(specifier, context, nextResolve) {
+  return nextResolve(specifier, specifier === "@tanstack/router-core/isServer" ? {...context, conditions: ["browser", "import", "default"]} : context);
+}`)}`,
+  import.meta.url,
+);
+const {
+  createMemoryHistory,
+  createRootRoute,
+  createRoute,
+  createRouter,
+  Outlet,
+  RouterProvider,
+} = await import("@tanstack/react-router");
+const { Route: ScheduleRoute } = await import("@/app/routes/schedule.tsx");
+const { deriveShellRoute } = await import("@/app/AppShell.helpers.ts");
+const { useAppNavigation } = await import(
+  "@/app/navigation/useAppNavigation.ts"
+);
+const { SidebarProvider } = await import("@/shared/ui/sidebar");
+const { TeamCalendarSidebarEntry } = await import(
+  "@/features/team-calendar/ui/TeamCalendarSidebarEntry.tsx"
+);
+const { TeamFeatureHubSidebarEntry } = await import(
+  "@/features/team-hub/ui/TeamFeatureHubSidebarEntry.tsx"
+);
+const { TeamScheduleView } = await import("./TeamScheduleView.tsx");
+const { encodeScheduleTabs, scheduleDTag } = await import(
+  "../lib/scheduleTabs.ts"
+);
+const { prepareScheduleDom, pubkey, relayUrl, tabA, tabB } = await import(
+  "./scheduleTestSupport.mjs"
+);
+
+let env;
+afterEach(() => {
+  cleanup();
+  env?.client.clear();
+  mock.restoreAll();
+  localStorage.clear();
+  delete globalThis.isTauri;
+});
+function fixtures(role) {
+  const owner = "b".repeat(64);
+  return (filter) => {
+    if (filter.kinds.includes(13534))
+      return [
+        {
+          id: "membership",
+          kind: 13534,
+          created_at: 1,
+          pubkey: owner,
+          content: "",
+          tags: [
+            ["member", pubkey, role],
+            ["member", owner, "owner"],
+          ],
+        },
+      ];
+    if (filter["#d"]?.[0] === scheduleDTag(relayUrl))
+      return [
+        {
+          id: "tabs",
+          kind: 30078,
+          created_at: 1,
+          pubkey: owner,
+          tags: [["d", scheduleDTag(relayUrl)]],
+          content: encodeScheduleTabs({ first: tabA, second: tabB }),
+        },
+      ];
+    return [];
+  };
+}
+for (const role of ["owner", "admin", "member"]) {
+  test(`NIP-43 ${role} resolves to the correct overflow menu through the production query`, async () => {
+    env = prepareScheduleDom(fixtures(role));
+    const view = render(
+      React.createElement(TeamScheduleView, { pubkey, relayUrl }),
+      { wrapper: env.Providers },
+    );
+    await waitFor(() =>
+      assert.ok(view.getByRole("button", { name: "일정표", exact: true })),
+    );
+    fireEvent.keyDown(view.getByRole("button", { name: "일정 메뉴" }), {
+      key: "ArrowDown",
+      code: "ArrowDown",
+    });
+    await waitFor(() =>
+      assert.equal(
+        view.getAllByRole("menuitem").length,
+        role === "member" ? 2 : 6,
+      ),
+    );
+  });
+}
+
+test("sidebar and hub enter the schedule route; selecting a channel unmounts it and closes its native children", async () => {
+  env = prepareScheduleDom(fixtures("member"));
+  function Shell() {
+    const calendar = React.useRef(null);
+    const { goChannel } = useAppNavigation();
+    return React.createElement(
+      React.Fragment,
+      null,
+      React.createElement(
+        SidebarProvider,
+        null,
+        React.createElement(
+          "ul",
+          null,
+          React.createElement(TeamFeatureHubSidebarEntry, {
+            calendar,
+            pubkey,
+            relayUrl,
+            onSettings() {},
+          }),
+          React.createElement(TeamCalendarSidebarEntry, {
+            ref: calendar,
+            pubkey,
+            relayUrl,
+          }),
+        ),
+        React.createElement(
+          "button",
+          { type: "button", onClick: () => void goChannel("fixture") },
+          "테스트 채널",
+        ),
+      ),
+      React.createElement(Outlet),
+    );
+  }
+  const root = createRootRoute({ component: Shell });
+  const schedule = createRoute({
+    getParentRoute: () => root,
+    path: "/schedule",
+    component: ScheduleRoute.options.component,
+  });
+  const channel = createRoute({
+    getParentRoute: () => root,
+    path: "/channels/$channelId",
+    component: () => React.createElement("p", null, "채널 본문"),
+  });
+  const router = createRouter({
+    isServer: false,
+    routeTree: root.addChildren([schedule, channel]),
+    history: createMemoryHistory({ initialEntries: ["/channels/fixture"] }),
+  });
+  await router.load();
+  const view = render(React.createElement(RouterProvider, { router }), {
+    wrapper: env.Providers,
+  });
+  await waitFor(() => assert.ok(view.getByText("채널 본문")));
+  fireEvent.click(view.getByTestId("open-team-schedule"));
+  await waitFor(() => assert.ok(view.getByTestId("team-schedule-screen")));
+  assert.equal(router.state.location.pathname, "/schedule");
+  assert.deepEqual(deriveShellRoute("/schedule"), {
+    selectedChannelId: null,
+    selectedView: "schedule",
+  });
+  fireEvent.click(
+    await view.findByRole("button", { name: "일정표", exact: true }),
+  );
+  await waitFor(() => assert.equal(env.count("webview_show"), 1));
+  fireEvent.click(view.getByRole("button", { name: "테스트 채널" }));
+  await waitFor(() => assert.ok(view.getByText("채널 본문")));
+  await waitFor(() => assert.equal(env.count("webview_close"), 1));
+  assert.equal(view.queryByTestId("team-schedule-screen"), null);
+  fireEvent.click(view.getByTestId("open-team-features"));
+  fireEvent.click(
+    await view.findByRole("button", { name: "일정", exact: true }),
+  );
+  await waitFor(() =>
+    assert.equal(router.state.location.pathname, "/schedule"),
+  );
+  await waitFor(() => assert.ok(view.getByTestId("team-calendar-embedded")));
+  assert.equal(view.queryByRole("dialog"), null);
+  assert.equal(
+    env.calls.some(
+      (call) => call.cmd === "sign_event" || call.cmd === "publish_event",
+    ),
+    false,
+  );
+});

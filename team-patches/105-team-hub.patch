index 000000000..61312a2f6
--- /dev/null
+++ b/desktop/src/features/team-schedule/ui/TeamScheduleView.tsx
@@ -0,0 +1,298 @@
+import { MoreHorizontal, RefreshCw } from "lucide-react";
+import * as React from "react";
+import { TeamCalendarDialog } from "@/features/team-calendar/ui/TeamCalendarDialog";
+import { Button } from "@/shared/ui/button";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from "@/shared/ui/dropdown-menu";
+import {
+  MAX_TABS,
+  readLocalScheduleUrl,
+  visibleScheduleTabs,
+  type ScheduleTab,
+} from "../lib/scheduleTabs";
+import { useScheduleTabs } from "../lib/useScheduleTabs";
+import {
+  ScheduleLinkPanel,
+  type ScheduleLinkActions,
+} from "./ScheduleLinkPanel";
+import { ScheduleTabForm } from "./ScheduleTabForm";
+import { ScheduleOrderForm } from "./ScheduleOrderForm";
+
+/** Shared schedule links and calendar, rendered inside the app's route outlet. */
+export function TeamScheduleView(props: { pubkey: string; relayUrl: string }) {
+  const state = useScheduleTabs(props.pubkey, props.relayUrl);
+  return <ScheduleContent {...props} {...state} />;
+}
+
+/** Full-page controls; the same permission result gates every management path. */
+export function ScheduleContent({
+  pubkey,
+  relayUrl,
+  tabs,
+  canManage,
+  loading,
+  error,
+  retry,
+  saving,
+  save,
+}: {
+  pubkey: string;
+  relayUrl: string;
+} & ReturnType<typeof useScheduleTabs>) {
+  const [selected, setSelected] = React.useState("calendar");
+  const [editing, setEditing] = React.useState<string | null>(null);
+  const [menuOpen, setMenuOpen] = React.useState(false);
+  const [localOpen, setLocalOpen] = React.useState(false);
+  const [problem, setProblem] = React.useState("");
+  const [, localChanged] = React.useReducer((n) => n + 1, 0);
+  const link = React.useRef<ScheduleLinkActions>(null);
+  const calendar = React.useRef<{ refresh: () => void }>(null);
+  const links = visibleScheduleTabs(tabs);
+  const tab = links.find((entry) => entry.id === selected);
+  const select = (id: string) => {
+    setSelected(id);
+    setEditing(null);
+    setLocalOpen(false);
+    setProblem("");
+  };
+  const run = async (changes: ScheduleTab[]) => {
+    if (!canManage) throw new Error("방장·관리자만 바꿀 수 있습니다.");
+    await save(changes);
+    setProblem("");
+    setEditing(null);
+  };
+  const refresh = () => {
+    void retry();
+    if (tab) link.current?.refresh();
+    else calendar.current?.refresh();
+  };
+  return (
+    <section
+      data-no-translate=""
+      data-schedule-surface=""
+      data-testid="team-schedule-screen"
+      aria-label="일정"
+      className="flex h-full min-h-0 min-w-0 flex-1 flex-col gap-3 p-4"
+    >
+      <header className="flex min-w-0 shrink-0 items-center gap-2">
+        <nav
+          aria-label="일정 탭"
+          className="flex min-w-0 flex-1 items-center gap-2 overflow-x-auto"
+        >
+          <Button
+            aria-pressed={!tab}
+            className="shrink-0 rounded-full"
+            variant={!tab ? "secondary" : "outline"}
+            size="lg"
+            type="button"
+            onClick={() => select("calendar")}
+          >
+            팀 캘린더
+          </Button>
+          {links.map((entry) => (
+            <Button
+              key={entry.id}
+              aria-pressed={entry.id === tab?.id}
+              className="shrink-0 rounded-full"
+              variant={entry.id === tab?.id ? "secondary" : "outline"}
+              size="lg"
+              type="button"
+              onClick={() => select(entry.id)}
+            >
+              {entry.title}
+              {readLocalScheduleUrl(relayUrl, pubkey, entry.id) ? (
+                <span className="text-xs text-muted-foreground">
+                  이 기기 전용
+                </span>
+              ) : null}
+            </Button>
+          ))}
+        </nav>
+        <Button
+          aria-label="새로고침"
+          size="icon"
+          variant="ghost"
+          type="button"
+          onClick={refresh}
+        >
+          <RefreshCw aria-hidden="true" />
+        </Button>
+        <DropdownMenu open={menuOpen} onOpenChange={setMenuOpen}>
+          <DropdownMenuTrigger asChild>
+            <Button
+              aria-label="일정 메뉴"
+              size="icon"
+              variant="ghost"
+              type="button"
+            >
+              <MoreHorizontal aria-hidden="true" />
+            </Button>
+          </DropdownMenuTrigger>
+          <DropdownMenuContent align="end">
+            <DropdownMenuItem
+              disabled={!tab}
+              onSelect={() => link.current?.open()}
+            >
+              새 창으로 열기
+            </DropdownMenuItem>
+            <DropdownMenuItem
+              disabled={!tab}
+              onSelect={() => {
+                setEditing(null);
+                setLocalOpen(true);
+              }}
+            >
+              이 기기 주소
+            </DropdownMenuItem>
+            {canManage ? (
+              <>
+                <DropdownMenuItem
+                  disabled={saving || Object.keys(tabs).length >= MAX_TABS}
+                  onSelect={() => {
+                    setLocalOpen(false);
+                    setEditing("new");
+                  }}
+                >
+                  탭 추가
+                </DropdownMenuItem>
+                <DropdownMenuItem
+                  disabled={saving || !tab}
+                  onSelect={() => {
+                    setLocalOpen(false);
+                    setEditing(tab?.id ?? null);
+                  }}
+                >
+                  이름·주소 바꾸기
+                </DropdownMenuItem>
+                <DropdownMenuItem
+                  disabled={saving || links.length < 2}
+                  onSelect={() => {
+                    setLocalOpen(false);
+                    setEditing("order");
+                  }}
+                >
+                  순서 바꾸기
+                </DropdownMenuItem>
+                <DropdownMenuItem
+                  disabled={saving || !tab}
+                  onSelect={() => {
+                    setLocalOpen(false);
+                    setEditing(`delete:${tab?.id}`);
+                  }}
+                >
+                  탭 삭제
+                </DropdownMenuItem>
+              </>
+            ) : null}
+          </DropdownMenuContent>
+        </DropdownMenu>
+      </header>
+      {loading ? (
+        <p role="status" className="text-xs">
+          일정을 불러오는 중…
+        </p>
+      ) : null}
+      {error ? (
+        <div role="alert" className="text-sm text-destructive">
+          일정 탭을 불러오지 못했습니다.{" "}
+          <Button type="button" variant="outline" onClick={() => void retry()}>
+            다시 불러오기
+          </Button>
+        </div>
+      ) : null}
+      {problem ? (
+        <p role="alert" className="text-sm text-destructive">
+          {problem}
+        </p>
+      ) : null}
+      <div className="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto">
+        {editing && canManage ? (
+          editing === "order" ? (
+            <ScheduleOrderForm
+              tabs={links}
+              saving={saving}
+              onCancel={() => setEditing(null)}
+              onSave={run}
+            />
+          ) : editing.startsWith("delete:") ? (
+            tab && editing === `delete:${tab.id}` ? (
+              <fieldset
+                className="flex items-center gap-2 rounded-lg border p-3"
+                aria-label="탭 삭제 확인"
+              >
+                <span className="text-sm">{tab.title} 탭을 삭제할까요?</span>
+                <Button
+                  type="button"
+                  variant="destructive"
+                  disabled={saving}
+                  onClick={() =>
+                    void run([
+                      { ...tab, title: "", url: "", deleted: true },
+                    ]).catch(() =>
+                      setProblem("삭제하지 못했습니다. 다시 눌러 주세요."),
+                    )
+                  }
+                >
+                  삭제 확인
+                </Button>
+                <Button
+                  type="button"
+                  variant="ghost"
+                  disabled={saving}
+                  onClick={() => setEditing(null)}
+                >
+                  취소
+                </Button>
+              </fieldset>
+            ) : null
+          ) : (
+            <ScheduleTabForm
+              key={editing}
+              tab={tabs[editing]}
+              saving={saving}
+              onCancel={() => setEditing(null)}
+              onSave={async (title, url) => {
+                const old = tabs[editing];
+                await run([
+                  {
+                    id: old?.id ?? crypto.randomUUID(),
+                    title,
+                    url,
+                    order: old?.order ?? links.length,
+                    updatedAt: 1,
+                    updatedBy: pubkey,
+                  },
+                ]);
+              }}
+            />
+          )
+        ) : null}
+        {!tab ? (
+          <TeamCalendarDialog
+            ref={calendar}
+            embedded
+            open
+            onOpenChange={() => {}}
+            pubkey={pubkey}
+            relayUrl={relayUrl}
+          />
+        ) : null}
+        <ScheduleLinkPanel
+          ref={link}
+          tab={tab}
+          blocked={menuOpen || (!!editing && canManage)}
+          localOpen={localOpen && !!tab}
+          onLocalClose={() => setLocalOpen(false)}
+          onLocalChange={localChanged}
+          pubkey={pubkey}
+          relay={relayUrl}
+          reportError={setProblem}
+        />
+      </div>
+    </section>
+  );
+}

diff --git a/desktop/src/features/team-schedule/ui/ScheduleOrderForm.tsx b/desktop/src/features/team-schedule/ui/ScheduleOrderForm.tsx
new file mode 100644
index 000000000..d6d5ec1a5
--- /dev/null
+++ b/desktop/src/features/team-schedule/ui/ScheduleOrderForm.tsx
@@ -0,0 +1,96 @@
+import * as React from "react";
+import { Button } from "@/shared/ui/button";
+import type { ScheduleTab } from "../lib/scheduleTabs";
+
+/** Collect reordering into one atomic shared save. */
+export function ScheduleOrderForm({
+  tabs,
+  saving,
+  onSave,
+  onCancel,
+}: {
+  tabs: ScheduleTab[];
+  saving: boolean;
+  onSave: (changes: ScheduleTab[]) => Promise<void>;
+  onCancel: () => void;
+}) {
+  const [order, setOrder] = React.useState(tabs.map((tab) => tab.id));
+  const [error, setError] = React.useState("");
+  const shown = order
+    .map((id) => tabs.find((tab) => tab.id === id))
+    .filter((tab): tab is ScheduleTab => !!tab);
+  const move = (index: number, delta: number) => {
+    const ids = shown.map((tab) => tab.id);
+    [ids[index], ids[index + delta]] = [
+      ids[index + delta] as string,
+      ids[index] as string,
+    ];
+    setOrder(ids);
+  };
+  return (
+    <form
+      className="space-y-2 rounded-lg border p-3"
+      aria-label="순서 바꾸기"
+      onSubmit={async (event) => {
+        event.preventDefault();
+        try {
+          // Include tabs added while editing, rather than overwriting their order.
+          const all = [
+            ...shown,
+            ...tabs.filter((tab) => !order.includes(tab.id)),
+          ];
+          await onSave(all.map((tab, index) => ({ ...tab, order: index })));
+        } catch {
+          setError("저장하지 못했습니다. 다시 눌러 주세요.");
+        }
+      }}
+    >
+      <ol className="space-y-2">
+        {shown.map((tab, index) => (
+          <li className="flex items-center gap-2 text-sm" key={tab.id}>
+            <span className="mr-auto">{tab.title}</span>
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              aria-label={`${tab.title} 위로`}
+              disabled={saving || index === 0}
+              onClick={() => move(index, -1)}
+            >
+              위로
+            </Button>
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              aria-label={`${tab.title} 아래로`}
+              disabled={saving || index === shown.length - 1}
+              onClick={() => move(index, 1)}
+            >
+              아래로
+            </Button>
+          </li>
+        ))}
+      </ol>
+      {error ? (
+        <p role="alert" className="text-sm text-destructive">
+          {error}
+        </p>
+      ) : null}
+      <div className="flex gap-2">
+        <Button type="submit" size="sm" disabled={saving}>
+          저장
+        </Button>
+        <Button
+          type="button"
+          size="sm"
+          variant="ghost"
+          disabled={saving}
+          onClick={onCancel}
+        >
+          취소
+        </Button>
+      </div>
+    </form>
+  );
+}

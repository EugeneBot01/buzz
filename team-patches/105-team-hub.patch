@@ -0,0 +1,135 @@
+import { openWelcomeGuide } from "@/features/team-welcome/lib/useTeamWelcome";
+import { openUrl } from "@tauri-apps/plugin-opener";
+import { toast } from "sonner";
+import { ChannelFilesDialog } from "@/features/channel-files/ui/ChannelFilesDialog";
+import type { Channel } from "@/shared/api/types";
+import {
+  NEW_MEET_URL,
+  linksForChannel,
+  splitMeetShortcut,
+} from "@/features/team-links/lib/teamLinks";
+import { useTeamLinks } from "@/features/team-links/lib/useTeamLinks";
+import { TeamHelpDialog } from "./TeamHelpDialog";
+import { LayoutGrid } from "lucide-react";
+import * as React from "react";
+import type { SettingsSection } from "@/features/settings/ui/SettingsPanels";
+import type { TeamCalendarNavigation } from "@/features/team-calendar/lib/calendarNavigation";
+import { useDeferredModalOpen } from "@/shared/ui/deferredModalOpen";
+import { SidebarMenuButton, SidebarMenuItem } from "@/shared/ui/sidebar";
+import { SidebarMenuLabel } from "@/shared/ui/sidebar-menu-label";
+import { TeamFeatureHubDialog } from "./TeamFeatureHubDialog";
+
+/** Keep existing entry points and add one feature map above the primary menu. */
+export function TeamFeatureHubSidebarEntry({
+  calendar,
+  onSettings,
+  channel,
+  pubkey,
+  relayUrl,
+}: {
+  channel?: Channel;
+  pubkey?: string;
+  relayUrl?: string;
+  calendar: React.RefObject<TeamCalendarNavigation | null>;
+  onSettings: (section: SettingsSection) => void;
+}) {
+  const [help, setHelp] = React.useState(false);
+  const [files, setFiles] = React.useState(false);
+  const [meeting, setMeeting] = React.useState(false);
+  const [open, setOpen] = React.useState(false);
+  const { openAfterExit } = useDeferredModalOpen();
+  return (
+    <SidebarMenuItem data-no-translate="">
+      <SidebarMenuButton
+        data-testid="open-team-features"
+        onClick={() => setOpen(true)}
+        tooltip="팀 기능"
+        type="button"
+      >
+        <LayoutGrid className="h-4 w-4" />
+        <SidebarMenuLabel>팀 기능</SidebarMenuLabel>
+      </SidebarMenuButton>
+      {meeting && channel && pubkey && relayUrl ? (
+        <OpenChannelMeet
+          channelId={channel.id}
+          pubkey={pubkey}
+          relayUrl={relayUrl}
+          onDone={() => setMeeting(false)}
+        />
+      ) : null}
+      {help ? (
+        <TeamHelpDialog
+          onOpenChange={setHelp}
+          onWelcome={() => openAfterExit(() => openWelcomeGuide())}
+        />
+      ) : null}
+      {files && channel ? (
+        <ChannelFilesDialog
+          key={channel.id}
+          channelId={channel.id}
+          channelName={channel.name}
+          open
+          onOpenChange={setFiles}
+        />
+      ) : null}
+      {open ? (
+        <TeamFeatureHubDialog
+          onOpenChange={setOpen}
+          onAction={(action) => {
+            setOpen(false);
+            openAfterExit(() => {
+              if (action === "schedule") calendar.current?.openSchedule();
+              else if (action === "digest")
+                calendar.current?.openCalendar("digest");
+              else if (action === "help") setHelp(true);
+              else if (action === "files") {
+                if (channel) setFiles(true);
+                else toast("채널을 먼저 고르세요");
+              } else if (action === "meet") {
+                if (channel && pubkey && relayUrl) setMeeting(true);
+                else
+                  void openUrl(NEW_MEET_URL).catch(() =>
+                    toast.error("링크를 열지 못했습니다."),
+                  );
+              } else onSettings("notifications");
+            });
+          }}
+        />
+      ) : null}
+    </SidebarMenuItem>
+  );
+}
+
+/** Read the same shortcuts as the channel header before choosing a room. */
+export function OpenChannelMeet({
+  channelId,
+  pubkey,
+  relayUrl,
+  onDone,
+}: {
+  channelId: string;
+  pubkey: string;
+  relayUrl: string;
+  onDone: () => void;
+}) {
+  const { links, status } = useTeamLinks(pubkey, relayUrl);
+  const opened = React.useRef(false);
+  React.useEffect(() => {
+    if (status === "loading" || opened.current) return;
+    opened.current = true;
+    if (status === "error")
+      toast.error("회의 주소를 불러오지 못했습니다. 다시 눌러 주세요.");
+    else {
+      const { meet } = splitMeetShortcut(linksForChannel(links, channelId));
+      void openUrl(meet?.url ?? NEW_MEET_URL).catch(() =>
+        toast.error("링크를 열지 못했습니다."),
+      );
+    }
+    onDone();
+  }, [links, status, channelId, onDone]);
+  return (
+    <span className="sr-only" role="status">
+      회의 주소를 불러오는 중…
+    </span>
+  );
+}

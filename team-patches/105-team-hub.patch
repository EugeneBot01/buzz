+  "파일 열기 (ArtCraft)": Files,
+  "에이전트가 만든 파일": Files,
+  "압축 오디오 재생": FileAudio,
+  "미트 버튼": Video,
+  "피그마·링크 바로가기": Link2,
+  "에이전트 MCP (고급)": Bot,
+  한국어: Globe,
+};
+const items = teamFeatureGroups
+  .flatMap((group) => group.items)
+  .filter((item) => item.location || item.name === "한국어");
+
+/** Compact location guide, separate from the six action tiles. */
+export function TeamHelpDialog({
+  onOpenChange,
+  onWelcome,
+}: {
+  onOpenChange: (open: boolean) => void;
+  onWelcome: () => void;
+}) {
+  return (
+    <Dialog open onOpenChange={onOpenChange}>
+      <DialogContent
+        className="max-w-lg max-h-[85vh] overflow-y-auto"

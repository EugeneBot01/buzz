+import type { ScheduleBounds } from "./scheduleWebviews";
+
+/** DOM coordinates are CSS pixels; DPR / native scale converts them to logical pixels. */
+export function scheduleBounds(
+  rect: Pick<DOMRect, "x" | "y" | "width" | "height">,
+  devicePixelRatio: number,
+  nativeScale: number,
+): ScheduleBounds | null {
+  const ratio = devicePixelRatio / nativeScale;
+  const values = [rect.x, rect.y, rect.width, rect.height, ratio];
+  if (
+    values.some((value) => !Number.isFinite(value)) ||
+    ratio <= 0 ||
+    rect.width < 1 ||
+    rect.height < 1 ||
+    rect.x < 0 ||
+    rect.y < 0
+  )
+    return null;
+  return {
+    x: rect.x * ratio,
+    y: rect.y * ratio,
+    width: rect.width * ratio,
+    height: rect.height * ratio,
+  };
+}
+
+/** Native children sit above the DOM, so hide them while any portal covers the schedule. */
+export function scheduleCovered(host: HTMLElement): boolean {
+  const dialog = host.closest('[role="dialog"]');
+  if (
+    !dialog ||
+    dialog.getAttribute("data-state") === "closed" ||
+    dialog.closest('[aria-hidden="true"]') ||
+    dialog
+      .getAnimations?.()
+      .some((animation) => animation.playState === "running")
+  )
+    return true;
+  return Array.from(
+    document.querySelectorAll<HTMLElement>(
+      '[role="dialog"], [role="alertdialog"], [data-radix-popper-content-wrapper]',
+    ),
+  ).some((element) => {
+    if (
+      element === dialog ||
+      dialog.contains(element) ||
+      element.getAttribute("data-state") === "closed"
+    )
+      return false;
+    const style = getComputedStyle(element);
+    return (
+      style.display !== "none" &&
+      style.visibility !== "hidden" &&
+      element.getBoundingClientRect().width > 0
+    );
+  });
+}
diff --git a/desktop/src/features/team-schedule/lib/scheduleStore.ts b/desktop/src/features/team-schedule/lib/scheduleStore.ts

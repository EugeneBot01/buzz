--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/scheduleTabs.test.mjs
@@ -0,0 +1,238 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import { relayClient } from "@/shared/api/relayClient";
+import {
+  decodeScheduleTabs,
+  encodeScheduleTabs,
+  mergeScheduleEvents,
+  mergeScheduleTabs,
+  readLocalScheduleUrl,
+  scheduleDTag,
+  visibleScheduleTabs,
+  writeLocalScheduleUrl,
+} from "./scheduleTabs.ts";
+import { readScheduleSnapshot, saveScheduleChange } from "./scheduleStore.ts";
+import { scheduleWindowLabel } from "./openScheduleWindow.ts";
+
+const admin = "a".repeat(64);
+const member = "b".repeat(64);
+const relay = "wss://relay.example.com";
+const tab = (id, time = 1, extra = {}) => ({
+  id,
+  title: id,
+  url: "https://example.com/",
+  order: 0,
+  updatedAt: time,
+  updatedBy: admin,
+  ...extra,
+});
+const event = (author, tabs, created_at = 1, extra = {}) => ({
+  id: "e",
+  pubkey: author,
+  kind: 30078,
+  created_at,
+  tags: [["d", scheduleDTag(relay)]],
+  content: encodeScheduleTabs(tabs),
+  ...extra,
+});
+const originals = {
+  fetchEvents: relayClient.fetchEvents,
+  fetchFirstEvent: relayClient.fetchFirstEvent,
+  publishEvent: relayClient.publishEvent,
+};
+afterEach(() => Object.assign(relayClient, originals));
+
+test("normalized scope, bounded decoder, https validation, tombstones and fixed calendar id", () => {
+  assert.equal(
+    scheduleDTag("wss://Relay.Example.com/"),
+    "team-schedule-tabs:wss://relay.example.com",
+  );
+  const tabs = { a: tab("a"), b: tab("b", 2, { deleted: true, url: "" }) };
+  assert.deepEqual(decodeScheduleTabs(encodeScheduleTabs(tabs)), tabs);
+  assert.deepEqual(
+    decodeScheduleTabs(
+      encodeScheduleTabs({
+        a: tab("a", 1, { url: "javascript:alert(1)" }),
+        calendar: tab("calendar"),
+      }),
+    ),
+    {},
+  );
+  assert.deepEqual(decodeScheduleTabs("not json"), {});
+  assert.throws(() =>
+    encodeScheduleTabs(
+      Object.fromEntries(
+        Array.from({ length: 101 }, (_, i) => [`id${i}`, tab(`id${i}`)]),
+      ),
+    ),
+  );
+});
+
+test("per-tab LWW retains independent edits, deletion and stable order", () => {
+  const initial = { a: tab("a"), b: tab("b", 1, { order: 1 }) };
+  const merged = mergeScheduleTabs(
+    mergeScheduleTabs(initial, { a: tab("a", 3, { title: "renamed" }) }),
+    { b: tab("b", 4, { order: -1 }) },
+  );
+  assert.deepEqual(
+    visibleScheduleTabs(merged).map(({ id }) => id),
+    ["b", "a"],
+  );
+  const deleted = tab("a", 3, { deleted: true });
+  assert.equal(mergeScheduleTabs(merged, { a: deleted }).a.deleted, true);
+  assert.deepEqual(
+    mergeScheduleTabs(merged, { a: deleted }),
+    mergeScheduleTabs({ a: deleted }, merged),
+  );
+});
+
+test("only newest current manager copies with exact kind/d-tag are accepted", () => {
+  const events = [
+    event(admin, { old: tab("old") }),
+    event(admin, { a: tab("a") }, 2),
+    event(member, { bad: tab("bad", 999) }, 3),
+    event(admin, { wrong: tab("wrong") }, 5, { kind: 1 }),
+  ];
+  assert.deepEqual(
+    Object.keys(
+      mergeScheduleEvents(events, new Set([admin]), scheduleDTag(relay)),
+    ),
+    ["a"],
+  );
+  assert.deepEqual(
+    mergeScheduleEvents(events, new Set(), scheduleDTag(relay)),
+    {},
+  );
+  assert.deepEqual(
+    mergeScheduleEvents(events, new Set([admin]), "other-scope"),
+    {},
+  );
+});
+
+test("local secret survives device storage, stays scoped and is excluded from shared encoding", () => {
+  const store = new Map();
+  const storage = {
+    getItem: (key) => store.get(key),
+    setItem: (key, value) => store.set(key, value),
+    removeItem: (key) => store.delete(key),
+  };
+  writeLocalScheduleUrl(
+    relay,
+    member,
+    "a",
+    "https://example.com/#device=fixture-secret",
+    storage,
+  );
+  assert.match(
+    readLocalScheduleUrl(relay, member, "a", storage),
+    /fixture-secret/,
+  );
+  assert.equal(readLocalScheduleUrl(relay, admin, "a", storage), null);
+  assert.equal(
+    readLocalScheduleUrl("wss://other.example.com", member, "a", storage),
+    null,
+  );
+  assert.equal(readLocalScheduleUrl(relay, member, "b", storage), null);
+  assert.doesNotMatch(
+    encodeScheduleTabs({ a: { ...tab("a"), localUrl: "fixture-secret" } }),
+    /fixture-secret|localUrl/,
+  );
+  writeLocalScheduleUrl(relay, member, "a", "", storage);
+  assert.equal(readLocalScheduleUrl(relay, member, "a", storage), null);
+  assert.throws(() =>
+    writeLocalScheduleUrl(relay, member, "a", "http://example.com", storage),
+  );
+  assert.throws(() =>
+    writeLocalScheduleUrl(relay, member, "a", "https://example.com", {
+      setItem() {
+        throw Error("full");
+      },
+    }),
+  );
+});
+
+function mockStore(role = "owner") {
+  const signed = [];
+  const published = [];
+  relayClient.fetchFirstEvent = async () => ({
+    tags: [["member", admin, role]],
+    created_at: 1,
+  });
+  relayClient.fetchEvents = async () => [
+    event(admin, { a: tab("a"), b: tab("b") }, 123),
+  ];
+  globalThis.window = {
+    __TAURI_INTERNALS__: {
+      invoke: async (cmd, args) => {
+        if (cmd !== "sign_event") throw Error(cmd);
+        signed.push(args);
+        return JSON.stringify({ ...args, pubkey: admin });
+      },
+    },
+  };
+  relayClient.publishEvent = async (value) => {
+    published.push(value);
+  };
+  return { signed, published };
+}
+
+test("real save seam rechecks role, publishes one atomic snapshot and preserves unrelated tabs", async () => {
+  const { signed, published } = mockStore();
+  await saveScheduleChange(
+    relay,
+    admin,
+    [tab("a", 1, { order: 1 }), tab("b", 1, { order: 0 })],
+    () => true,
+  );
+  assert.equal(signed.length, 1);
+  assert.equal(published.length, 1);
+  assert.equal(signed[0].kind, 30078);
+  assert.deepEqual(signed[0].tags, [["d", scheduleDTag(relay)]]);
+  assert.deepEqual(
+    visibleScheduleTabs(decodeScheduleTabs(signed[0].content)).map(
+      ({ id }) => id,
+    ),
+    ["b", "a"],
+  );
+});
+
+test("member, revoked role, failed reads, failed writes and retired scopes never report success", async () => {
+  const { published } = mockStore("member");
+  await assert.rejects(
+    saveScheduleChange(relay, admin, [tab("a")], () => true),
+    /방장/,
+  );
+  assert.equal(published.length, 0);
+  mockStore();
+  await assert.rejects(
+    saveScheduleChange(relay, admin, [tab("a")], () => false),
+    /다른 팀/,
+  );
+  relayClient.fetchEvents = async () => {
+    throw Error("offline");
+  };
+  await assert.rejects(readScheduleSnapshot(relay), /offline/);
+  mockStore();
+  relayClient.publishEvent = async () => {
+    throw Error("rejected");
+  };
+  await assert.rejects(
+    saveScheduleChange(relay, admin, [tab("a")], () => true),
+    /rejected/,
+  );
+});
+
+test("window labels are stable across restart and distinct across scopes", async () => {
+  assert.equal(
+    await scheduleWindowLabel(relay, admin, "a"),
+    await scheduleWindowLabel("wss://Relay.Example.com/", admin, "a"),
+  );
+  assert.notEqual(
+    await scheduleWindowLabel(relay, admin, "a"),
+    await scheduleWindowLabel(relay, member, "a"),
+  );
+  assert.notEqual(
+    await scheduleWindowLabel(relay, admin, "a"),
+    await scheduleWindowLabel(relay, admin, "b"),
+  );
+});
diff --git a/desktop/src/features/team-schedule/lib/scheduleTabs.ts b/desktop/src/features/team-schedule/lib/scheduleTabs.ts

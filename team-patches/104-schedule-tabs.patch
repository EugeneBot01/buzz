@@ -0,0 +1,143 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import { readFileSync } from "node:fs";
+import {
+  openScheduleWindow,
+  resetScheduleWindows,
+  scheduleWindowLabel,
+} from "./openScheduleWindow.ts";
+
+afterEach(resetScheduleWindows);
+test("real Tauri API creates one persistent top-level window and reuses it", async () => {
+  const calls = [];
+  let label;
+  globalThis.window = {
+    __TAURI_INTERNALS__: {
+      invoke: async (cmd, args) => {
+        calls.push({ cmd, args });
+        if (cmd === "plugin:window|get_all_windows")
+          return label ? [label] : [];
+        if (cmd === "plugin:webview|create_webview_window")
+          label = args.options.label;
+        return null;
+      },
+    },
+  };
+  await openScheduleWindow(
+    "wss://relay.example.com",
+    "a".repeat(64),
+    "one",
+    "https://example.com/#device=test-only",
+  );
+  const creation = calls.find(
+    ({ cmd }) => cmd === "plugin:webview|create_webview_window",
+  );
+  assert.equal(creation.args.options.incognito, false);
+  assert.equal(
+    creation.args.options.url,
+    "https://example.com/#device=test-only",
+  );
+  assert.equal(creation.args.options.title, "팀 일정");
+  assert.equal(creation.args.options.dataDirectory, undefined);
+  assert.match(label, /^schedule-[a-f0-9]{32}$/);
+  await openScheduleWindow(
+    "wss://relay.example.com",
+    "a".repeat(64),
+    "one",
+    "https://example.com/#device=test-only",
+  );
+  assert.equal(
+    calls.filter(({ cmd }) => cmd === "plugin:webview|create_webview_window")
+      .length,
+    1,
+  );
+  assert.ok(calls.some(({ cmd }) => cmd === "plugin:window|set_focus"));
+  await openScheduleWindow(
+    "wss://relay.example.com",
+    "a".repeat(64),
+    "one",
+    "https://example.com/new",
+  );
+  assert.equal(
+    calls.filter(({ cmd }) => cmd === "plugin:webview|create_webview_window")
+      .length,
+    2,
+  );
+  assert.ok(calls.some(({ cmd }) => cmd === "plugin:window|close"));
+});
+
+test("creation failure and unsafe URLs propagate, remote windows have no capabilities", async () => {
+  globalThis.window = {
+    __TAURI_INTERNALS__: {
+      invoke: async (cmd) => {
+        if (cmd === "plugin:window|get_all_windows") return [];
+        throw Error("denied");
+      },
+    },
+  };
+  await assert.rejects(
+    openScheduleWindow(
+      "wss://relay.example.com",
+      "a".repeat(64),
+      "one",
+      "https://example.com/",
+    ),
+    /창을 열지 못했습니다/,
+  );
+  await assert.rejects(
+    openScheduleWindow(
+      "wss://relay.example.com",
+      "a".repeat(64),
+      "one",
+      "http://example.com/",
+    ),
+    /https/,
+  );
+  const cap = JSON.parse(
+    readFileSync(
+      new URL(
+        "../../../../src-tauri/capabilities/team-schedule.json",
+        import.meta.url,
+      ),
+      "utf8",
+    ),
+  );
+  assert.equal(cap.windows, undefined);
+  assert.deepEqual(cap.webviews, ["main"]);
+  assert.ok(
+    cap.permissions.includes("core:webview:allow-create-webview-window"),
+  );
+  assert.ok(cap.permissions.includes("core:webview:allow-create-webview"));
+  const defaults = JSON.parse(
+    readFileSync(
+      new URL(
+        "../../../../src-tauri/capabilities/default.json",
+        import.meta.url,
+      ),
+      "utf8",
+    ),
+  );
+  assert.equal(defaults.windows, undefined);
+  assert.deepEqual(defaults.webviews, ["main", "huddle-*"]);
+  assert.equal(defaults.remote, undefined);
+  assert.equal(cap.remote, undefined);
+});
+
+test("community switch during window replacement fences the late creation", async () => {
+  const relay = "wss://relay.example.com";
+  const pubkey = "a".repeat(64);
+  const label = await scheduleWindowLabel(relay, pubkey, "stale");
+  const calls = [];
+  globalThis.window = {
+    __TAURI_INTERNALS__: {
+      invoke: async (cmd) => {
+        calls.push(cmd);
+        if (cmd === "plugin:window|get_all_windows") return [label];
+        if (cmd === "plugin:window|close") resetScheduleWindows();
+        return null;
+      },
+    },
+  };
+  await openScheduleWindow(relay, pubkey, "stale", "https://example.com/");
+  assert.equal(calls.includes("plugin:webview|create_webview_window"), false);
+});
diff --git a/desktop/src/features/team-schedule/lib/openScheduleWindow.ts b/desktop/src/features/team-schedule/lib/openScheduleWindow.ts
new file mode 100644
index 000000000..3828ec8d7
--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/openScheduleWindow.ts
@@ -0,0 +1,106 @@
+import { WebviewWindow } from "@tauri-apps/api/webviewWindow";
+import { normalizeLinkUrl } from "@/features/team-links/lib/teamLinks";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+
+let generation = 0;
+
+/** Clear community-scoped window metadata when the community changes. */
+export function resetScheduleWindows() {
+  generation += 1;
+  openedUrls.clear();
+}
+
+const opening = new Set<string>();
+const openedUrls = new Map<string, string>();
+
+/** Stable window labels keep the number of windows bounded by the tabs. */
+export async function scheduleWindowLabel(
+  relay: string,
+  pubkey: string,
+  id: string,
+) {
+  const bytes = new TextEncoder().encode(
+    `${normalizeRelayUrl(relay)}|${pubkey}|${id}`,
+  );
+  const digest = await crypto.subtle.digest("SHA-256", bytes);
+  return `schedule-${Array.from(new Uint8Array(digest).slice(0, 16), (byte) => byte.toString(16).padStart(2, "0")).join("")}`;
+}
+
+/** Stable Tauri 2 top-level webview, using the persistent default cookie store. */
+export async function openScheduleWindow(
+  relay: string,
+  pubkey: string,
+  id: string,
+  rawUrl: string,
+) {
+  const epoch = generation;
+  const url = normalizeLinkUrl(rawUrl);
+  if (!url) throw new Error("https:// 로 시작하는 주소를 넣어 주세요.");
+  const label = await scheduleWindowLabel(relay, pubkey, id);
+  const request = `${epoch}:${label}`;
+  if (opening.has(request)) return;
+  opening.add(request);
+  try {
+    const existing = await WebviewWindow.getByLabel(label);
+    if (epoch !== generation) return;
+    if (existing && openedUrls.get(label) === url) {
+      await existing.show();
+      await existing.unminimize();
+      await existing.setFocus();
+      return;
+    }
+    if (existing) await existing.close();
+    if (epoch !== generation) return;
+    await new Promise<void>((resolve, reject) => {
+      const win = new WebviewWindow(label, {
+        url,
+        title: "팀 일정",
+        width: 1100,
+        height: 800,
+        minWidth: 600,
+        minHeight: 400,
+        incognito: false,
+      });
+      let finished = false;
+      const cleanups: (() => void)[] = [];
+      const finish = (error?: Error) => {
+        if (finished) return;
+        finished = true;
+        clearTimeout(timeout);
+        for (const cleanup of cleanups) cleanup();
+        if (error) reject(error);
+        else resolve();
+      };
+      const timeout = setTimeout(
+        () => finish(new Error("창이 열리지 않았습니다. 다시 눌러 주세요.")),
+        30_000,
+      );
+      void win
+        .once("tauri://created", () => {
+          if (epoch !== generation) void win.close();
+          finish();
+        })
+        .then(
+          (off) => {
+            if (finished) off();
+            else cleanups.push(off);
+          },
+          () => finish(new Error("창을 열지 못했습니다.")),
+        );
+      void win
+        .once("tauri://error", () =>
+          finish(new Error("창을 열지 못했습니다. 다시 눌러 주세요.")),
+        )
+        .then(
+          (off) => {
+            if (finished) off();
+            else cleanups.push(off);
+          },
+          () => finish(new Error("창을 열지 못했습니다.")),
+        );
+    });
+    if (epoch === generation) openedUrls.set(label, url);
+  } finally {
+    opening.delete(request);
+  }
+}

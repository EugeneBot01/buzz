+import * as React from "react";
+import { normalizeLinkUrl } from "@/features/team-links/lib/teamLinks";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import type { ScheduleTab } from "../lib/scheduleTabs";
+
+/** Shared fields only; a local address is never used to initialize this form. */
+export function ScheduleTabForm({
+  tab,
+  saving,
+  onSave,
+  onCancel,
+}: {
+  tab?: ScheduleTab;
+  saving: boolean;
+  onSave: (title: string, url: string) => Promise<void>;
+  onCancel: () => void;
+}) {
+  const [title, setTitle] = React.useState(tab?.title ?? "");
+  const [url, setUrl] = React.useState(tab?.url ?? "");
+  const [error, setError] = React.useState("");
+  return (
+    <form
+      className="space-y-2 rounded-lg border p-3"
+      onSubmit={async (event) => {
+        event.preventDefault();
+        const normalized = normalizeLinkUrl(url);
+        if (!title.trim() || !normalized) {
+          setError("이름과 https 주소를 넣어 주세요.");
+          return;
+        }
+        try {
+          await onSave(title.trim(), normalized);
+          onCancel();
+        } catch {
+          setError(
+            "저장하지 못했습니다. 입력한 내용은 남아 있습니다. 다시 저장해 주세요.",
+          );
+        }
+      }}
+    >
+      <label className="text-sm font-medium" htmlFor="schedule-tab-title">
+        탭 이름
+      </label>
+      <Input
+        id="schedule-tab-title"
+        maxLength={40}
+        onChange={(event) => setTitle(event.target.value)}
+        required
+        value={title}
+      />
+      <label className="text-sm font-medium" htmlFor="schedule-tab-url">
+        팀과 공유할 주소
+      </label>
+      <Input
+        id="schedule-tab-url"
+        maxLength={500}
+        onChange={(event) => setUrl(event.target.value)}
+        required
+        value={url}
+      />
+      <p className="text-xs text-muted-foreground">
+        모든 팀원이 보는 주소입니다. 관리자용 주소는 “이 기기 주소”에 넣어
+        주세요.
+      </p>
+      {error ? (
+        <p className="text-sm text-destructive" role="alert">
+          {error}
+        </p>
+      ) : null}
+      <div className="flex gap-2">
+        <Button disabled={saving} size="sm" type="submit">
+          저장
+        </Button>
+        <Button
+          disabled={saving}
+          onClick={onCancel}
+          size="sm"
+          type="button"
+          variant="ghost"
+        >
+          취소
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/desktop/src/features/team-schedule/ui/TeamScheduleDialog.tsx b/desktop/src/features/team-schedule/ui/TeamScheduleDialog.tsx
new file mode 100644
index 000000000..c5610c2fe
--- /dev/null
+++ b/desktop/src/features/team-schedule/ui/TeamScheduleDialog.tsx
@@ -0,0 +1,255 @@
+import * as React from "react";
+import { TeamCalendarDialog } from "@/features/team-calendar/ui/TeamCalendarDialog";
+import { Button } from "@/shared/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+import {
+  MAX_TABS,
+  readLocalScheduleUrl,
+  visibleScheduleTabs,
+  type ScheduleTab,
+} from "../lib/scheduleTabs";
+import { useScheduleTabs } from "../lib/useScheduleTabs";
+import { ScheduleLinkPanel } from "./ScheduleLinkPanel";
+import { ScheduleTabForm } from "./ScheduleTabForm";
+
+/** Shared schedule links with a fixed embedded team calendar as the first tab. */
+export function TeamScheduleDialog({
+  pubkey,
+  relayUrl,
+  onOpenChange,
+}: {
+  pubkey: string;
+  relayUrl: string;
+  onOpenChange: (open: boolean) => void;
+}) {
+  const { tabs, canManage, loading, error, retry, saving, save } =
+    useScheduleTabs(pubkey, relayUrl);
+  const [selected, setSelected] = React.useState("calendar");
+  const [editing, setEditing] = React.useState<string | null>(null);
+  const [problem, setProblem] = React.useState("");
+  const [, localChanged] = React.useReducer((n) => n + 1, 0);
+  const links = visibleScheduleTabs(tabs);
+  const tab = links.find(({ id }) => id === selected);
+  const run = async (changes: ScheduleTab[]) => {
+    try {
+      await save(changes);
+      setProblem("");
+    } catch {
+      setProblem("저장하지 못했습니다. 다시 눌러 주세요.");
+    }
+  };
+  const move = (index: number, delta: number) => {
+    const reordered = [...links];
+    [reordered[index], reordered[index + delta]] = [
+      reordered[index + delta] as ScheduleTab,
+      reordered[index] as ScheduleTab,
+    ];
+    void run(
+      reordered
+        .map((entry, order) => ({ ...entry, order }))
+        .filter((entry) => entry.order !== tabs[entry.id]?.order),
+    );
+  };
+  const select = (entry: ScheduleTab) => {
+    setSelected(entry.id);
+    setEditing(null);
+    setProblem("");
+  };
+  return (
+    <Dialog onOpenChange={onOpenChange} open>
+      <DialogContent
+        className="flex h-[90vh] w-[90vw] min-w-[min(900px,calc(100vw-2rem))] max-w-none min-h-[min(600px,calc(100vh-2rem))] flex-col"
+        data-no-translate=""
+        data-testid="team-schedule-dialog"
+      >
+        <DialogHeader>
+          <DialogTitle>일정</DialogTitle>
+          <DialogDescription>
+            팀 캘린더와 일정 페이지를 한곳에서 엽니다.
+          </DialogDescription>
+        </DialogHeader>
+        <div className="flex min-h-0 flex-1 gap-4">
+          <nav
+            aria-label="일정 탭"
+            className="flex w-48 shrink-0 flex-col gap-1 overflow-y-auto"
+          >
+            <Button
+              aria-pressed={!tab}
+              onClick={() => {
+                setSelected("calendar");
+                setEditing(null);
+              }}
+              type="button"
+              variant={!tab ? "secondary" : "ghost"}
+            >
+              팀 캘린더
+            </Button>
+            {links.map((entry, index) => (
+              <div className="space-y-1" key={entry.id}>
+                <Button
+                  aria-pressed={entry.id === tab?.id}
+                  className="h-auto w-full flex-wrap justify-start whitespace-normal break-all"
+                  onClick={() => select(entry)}
+                  type="button"
+                  variant={entry.id === tab?.id ? "secondary" : "ghost"}
+                >
+                  {entry.title}
+                  {readLocalScheduleUrl(relayUrl, pubkey, entry.id) ? (
+                    <span className="text-2xs text-muted-foreground">
+                      이 기기 전용
+                    </span>
+                  ) : null}
+                </Button>
+                {canManage ? (
+                  <div className="flex gap-1">
+                    <Button
+                      aria-label={`${entry.title} 위로`}
+                      disabled={saving || index === 0}
+                      onClick={() => move(index, -1)}
+                      size="xs"
+                      type="button"
+                      variant="ghost"
+                    >
+                      위로
+                    </Button>
+                    <Button
+                      aria-label={`${entry.title} 아래로`}
+                      disabled={saving || index === links.length - 1}
+                      onClick={() => move(index, 1)}
+                      size="xs"
+                      type="button"
+                      variant="ghost"
+                    >
+                      아래로
+                    </Button>
+                  </div>
+                ) : null}
+              </div>
+            ))}
+            {loading ? (
+              <p className="text-xs" role="status">
+                일정을 불러오는 중…
+              </p>
+            ) : null}
+            {error ? (
+              <div role="alert" className="text-xs text-destructive">
+                일정 탭을 불러오지 못했습니다.
+                <Button
+                  onClick={() => void retry()}
+                  size="sm"
+                  type="button"
+                  variant="outline"
+                >
+                  다시 불러오기
+                </Button>
+              </div>
+            ) : null}
+            {canManage ? (
+              <Button
+                disabled={saving || Object.keys(tabs).length >= MAX_TABS}
+                onClick={() => setEditing("new")}
+                size="sm"
+                type="button"
+                variant="outline"
+              >
+                탭 추가
+              </Button>
+            ) : null}
+          </nav>
+          <section
+            aria-label={tab?.title ?? "팀 캘린더"}
+            className="flex min-h-0 min-w-0 flex-1 flex-col gap-3 overflow-y-auto"
+          >
+            {problem ? (
+              <p className="text-sm text-destructive" role="alert">
+                {problem}
+              </p>
+            ) : null}
+            {editing && !editing.startsWith("delete:") && canManage ? (
+              <ScheduleTabForm
+                key={editing}
+                onCancel={() => setEditing(null)}
+                onSave={async (title, url) => {
+                  const old = tabs[editing];
+                  await save([
+                    {
+                      id: old?.id ?? crypto.randomUUID(),
+                      title,
+                      url,
+                      order: old?.order ?? links.length,
+                      updatedAt: 1,
+                      updatedBy: pubkey,
+                    },
+                  ]);
+                }}
+                saving={saving}
+                tab={tabs[editing]}
+              />
+            ) : null}
+            {tab ? (
+              canManage ? (
+                <div className="flex gap-2">
+                  <Button
+                    disabled={saving}
+                    onClick={() => setEditing(tab.id)}
+                    size="sm"
+                    type="button"
+                    variant="outline"
+                  >
+                    이름·주소 바꾸기
+                  </Button>
+                  <Button
+                    disabled={saving}
+                    onClick={() => setEditing(`delete:${tab.id}`)}
+                    size="sm"
+                    type="button"
+                    variant="ghost"
+                  >
+                    탭 삭제
+                  </Button>
+                  {editing === `delete:${tab.id}` ? (
+                    <Button
+                      disabled={saving}
+                      onClick={() =>
+                        void run([
+                          { ...tab, title: "", url: "", deleted: true },
+                        ])
+                      }
+                      size="sm"
+                      type="button"
+                      variant="destructive"
+                    >
+                      삭제 확인
+                    </Button>
+                  ) : null}
+                </div>
+              ) : null
+            ) : (
+              <TeamCalendarDialog
+                embedded
+                onOpenChange={() => {}}
+                open
+                pubkey={pubkey}
+                relayUrl={relayUrl}
+              />
+            )}
+            <ScheduleLinkPanel
+              tab={tab}
+              blocked={!!editing}
+              onLocalChange={localChanged}
+              pubkey={pubkey}
+              relay={relayUrl}
+              reportError={setProblem}
+            />
+          </section>
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/desktop/src/features/team-schedule/ui/scheduleForms.jsdom-test.mjs b/desktop/src/features/team-schedule/ui/scheduleForms.jsdom-test.mjs
new file mode 100644
index 000000000..8c5d1a272
--- /dev/null
+++ b/desktop/src/features/team-schedule/ui/scheduleForms.jsdom-test.mjs
@@ -0,0 +1,214 @@
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import React from "react";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { ScheduleTabForm } from "./ScheduleTabForm.tsx";
+import { ScheduleLinkPanel } from "./ScheduleLinkPanel.tsx";
+import { scheduleCovered } from "../lib/scheduleGeometry.ts";
+import { readLocalScheduleUrl } from "../lib/scheduleTabs.ts";
+
+let calls;
+let observers;
+const rect = { x: 260, y: 180, width: 600, height: 400 };
+const originalRect = HTMLElement.prototype.getBoundingClientRect;
+beforeEach(() => {
+  calls = [];
+  observers = [];
+  globalThis.isTauri = true;
+  HTMLElement.prototype.getBoundingClientRect = () => rect;
+  globalThis.ResizeObserver = class {
+    constructor(callback) {
+      observers.push(callback);
+    }
+    observe() {}
+    disconnect() {}
+  };
+  globalThis.requestAnimationFrame = (cb) => setTimeout(cb, 0);
+  globalThis.cancelAnimationFrame = clearTimeout;
+  Object.defineProperty(document, "hidden", {
+    configurable: true,
+    value: false,
+  });
+  window.__TAURI_EVENT_PLUGIN_INTERNALS__ = { unregisterListener() {} };
+  window.__TAURI_INTERNALS__ = {
+    metadata: { currentWindow: { label: "main" } },
+    transformCallback: () => 1,
+    invoke: async (cmd, args) => {
+      calls.push({ cmd, args });
+      if (cmd === "plugin:window|scale_factor") return window.devicePixelRatio;
+      if (cmd === "plugin:window|get_all_windows") return [];
+      return null;
+    },
+  };
+});
+const panel = (props) =>
+  React.createElement(
+    "div",
+    { role: "dialog", "data-state": "open" },
+    React.createElement(ScheduleLinkPanel, {
+      tab: { id: "local", title: "일정표", url: "https://example.com/" },
+      pubkey: "a".repeat(64),
+      relay: "wss://relay.example.com",
+      onLocalChange() {},
+      reportError() {},
+      ...props,
+    }),
+  );
+const count = (suffix) =>
+  calls.filter(({ cmd }) => cmd === `plugin:webview|${suffix}`).length;
+
+afterEach(() => {
+  cleanup();
+  localStorage.clear();
+  delete globalThis.isTauri;
+  HTMLElement.prototype.getBoundingClientRect = originalRect;
+});
+test("shared form validates https and preserves edits after rejected save", async () => {
+  const saves = [];
+  const view = render(
+    React.createElement(ScheduleTabForm, {
+      saving: false,
+      onCancel() {
+        throw Error("must stay open");
+      },
+      onSave: async (...args) => {
+        saves.push(args);
+        throw Error("offline");
+      },
+    }),
+  );
+  fireEvent.change(view.getByLabelText("탭 이름"), {
+    target: { value: "일정표" },
+  });
+  fireEvent.change(view.getByLabelText("팀과 공유할 주소"), {
+    target: { value: "http://example.com" },
+  });
+  fireEvent.submit(view.container.querySelector("form"));
+  assert.equal(saves.length, 0);
+  fireEvent.change(view.getByLabelText("팀과 공유할 주소"), {
+    target: { value: "https://example.com/" },
+  });
+  fireEvent.submit(view.container.querySelector("form"));
+  await waitFor(() =>
+    assert.match(view.getByRole("alert").textContent, /입력한 내용은 남아/),
+  );
+  assert.equal(view.getByLabelText("탭 이름").value, "일정표");
+  assert.deepEqual(saves, [["일정표", "https://example.com/"]]);
+});
+
+test("local form keeps secret on the device and opens that address without signing", async () => {
+  const pubkey = "a".repeat(64);
+  const relay = "wss://relay.example.com";
+  const tab = { id: "local", title: "일정표", url: "https://example.com/" };
+  const view = render(panel({ tab, pubkey, relay }));
+  await waitFor(() => assert.equal(count("webview_show"), 1));
+  fireEvent.click(view.getByRole("button", { name: "이 기기 주소" }));
+  await waitFor(() => assert.ok(count("webview_hide") >= 2));
+  fireEvent.change(view.getByLabelText("이 기기에서만 다른 주소로 열기"), {
+    target: { value: "https://example.com/#device=fixture-secret" },
+  });
+  fireEvent.submit(view.container.querySelector("form"));
+  await waitFor(() =>
+    assert.ok(
+      calls.some(
+        ({ cmd, args }) =>
+          cmd === "plugin:webview|create_webview" &&
+          args.options.url.includes("fixture-secret"),
+      ),
+    ),
+  );
+  assert.match(readLocalScheduleUrl(relay, pubkey, tab.id), /fixture-secret/);
+  assert.equal(
+    calls.some(({ cmd }) => cmd === "sign_event" || cmd === "publish_event"),
+    false,
+  );
+  assert.match(
+    calls.filter(({ cmd }) => cmd === "plugin:webview|create_webview").at(-1)
+      .args.options.url,
+    /fixture-secret/,
+  );
+});
+
+test("embedded panel follows resize, hides for forms, calendar and covering modals, then cleans up on team change", async () => {
+  const view = render(panel());
+  await waitFor(() => assert.equal(count("webview_show"), 1));
+  const slot = view.getByTestId("schedule-page-slot");
+  slot.getBoundingClientRect = () => ({ ...rect, width: 500 });
+  observers.forEach((cb) => {
+    cb();
+  });
+  await waitFor(() => {
+    const size = calls
+      .filter(({ cmd }) => cmd.endsWith("|set_webview_size"))
+      .at(-1);
+    assert.equal(size.args.value.toJSON().Logical.width, 500);
+  });
+  const modal = document.createElement("div");
+  modal.setAttribute("role", "alertdialog");
+  document.body.append(modal);
+  assert.equal(scheduleCovered(slot), true);
+  await waitFor(() =>
+    assert.equal(
+      calls.filter(({ cmd }) => cmd.startsWith("plugin:webview|")).at(-1).cmd,
+      "plugin:webview|webview_hide",
+    ),
+  );
+  const shows = count("webview_show");
+  modal.remove();
+  await waitFor(() => assert.equal(count("webview_show"), shows + 1));
+  view.rerender(panel({ blocked: true }));
+  await waitFor(() =>
+    assert.equal(
+      calls.filter(({ cmd }) => cmd.startsWith("plugin:webview|")).at(-1).cmd,
+      "plugin:webview|webview_hide",
+    ),
+  );
+  view.rerender(panel({ tab: undefined }));
+  await waitFor(() =>
+    assert.equal(
+      calls.filter(({ cmd }) => cmd.startsWith("plugin:webview|")).at(-1).cmd,
+      "plugin:webview|webview_hide",
+    ),
+  );
+  view.rerender(panel({ relay: "wss://other.example.com" }));
+  await waitFor(() => assert.equal(count("create_webview"), 2));
+  assert.equal(count("webview_close"), 1);
+  view.unmount();
+  await waitFor(() => assert.equal(count("webview_close"), 2));
+});
+
+test("creation failure shows the fallback and its button opens the existing standalone window path", async () => {
+  const invoke = window.__TAURI_INTERNALS__.invoke;
+  window.__TAURI_INTERNALS__.invoke = (cmd, args) => {
+    if (cmd === "plugin:webview|create_webview")
+      return Promise.reject(Error("unsupported"));
+    return invoke(cmd, args);
+  };
+  const view = render(panel());
+  await waitFor(() =>
+    assert.match(
+      view.getByRole("status").textContent,
+      /이 화면에서는 열 수 없어/,
+    ),
+  );
+  fireEvent.click(view.getByRole("status").querySelector("button"));
+  await waitFor(() => assert.equal(count("create_webview_window"), 1));
+  assert.equal(
+    calls.find(({ cmd }) => cmd.endsWith("|create_webview_window")).args.options
+      .url,
+    "https://example.com/",
+  );
+});
+
+test("a surface without native support shows the fallback without crashing the dialog", async () => {
+  globalThis.isTauri = false;
+  delete window.__TAURI_INTERNALS__;
+  const view = render(panel());
+  await waitFor(() =>
+    assert.match(
+      view.getByRole("status").textContent,
+      /이 화면에서는 열 수 없어/,
+    ),
+  );
+  assert.equal(count("create_webview"), 0);
+});

index 000000000..9239b22f0
--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/scheduleTabs.ts
@@ -0,0 +1,184 @@
+import type { RelayEvent } from "@/shared/api/types";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+import { normalizeLinkUrl } from "@/features/team-links/lib/teamLinks";
+
+export const SCHEDULE_TAG = "team-schedule-tabs";
+export const MAX_TABS = 100;
+export const MAX_CONTENT_BYTES = 60_000;
+export type ScheduleTab = {
+  id: string;
+  title: string;
+  url: string;
+  order: number;
+  updatedAt: number;
+  updatedBy: string;
+  deleted?: true;
+};
+export type ScheduleTabs = Record<string, ScheduleTab>;
+
+/** Shared scope; local overrides never participate in this document. */
+export const scheduleDTag = (relayUrl: string) =>
+  `${SCHEDULE_TAG}:${normalizeRelayUrl(relayUrl)}`;
+
+/** Parse bounded, valid https tabs and retain deletion tombstones. */
+export function decodeScheduleTabs(content: string): ScheduleTabs {
+  if (new TextEncoder().encode(content).length > MAX_CONTENT_BYTES) return {};
+  try {
+    const raw = JSON.parse(content);
+    if (raw?.v !== 1 || !Array.isArray(raw.tabs) || raw.tabs.length > MAX_TABS)
+      return {};
+    const tabs: ScheduleTabs = {};
+    for (const tab of raw.tabs) {
+      if (
+        !tab ||
+        typeof tab !== "object" ||
+        typeof tab.id !== "string" ||
+        !/^[\w-]{1,64}$/.test(tab.id) ||
+        ["calendar", "__proto__", "constructor", "prototype"].includes(
+          tab.id,
+        ) ||
+        typeof tab.title !== "string" ||
+        tab.title.length > 40 ||
+        typeof tab.url !== "string" ||
+        !Number.isFinite(tab.order) ||
+        !Number.isSafeInteger(tab.updatedAt) ||
+        tab.updatedAt <= 0 ||
+        typeof tab.updatedBy !== "string" ||
+        !/^[0-9a-f]{64}$/.test(tab.updatedBy)
+      )
+        continue;
+      const url = normalizeLinkUrl(tab.url);
+      if (tab.deleted !== true && (!url || !tab.title.trim())) continue;
+      tabs[tab.id] = {
+        id: tab.id,
+        title: tab.title.trim(),
+        url: url ?? "",
+        order: tab.order,
+        updatedAt: tab.updatedAt,
+        updatedBy: tab.updatedBy,
+        ...(tab.deleted === true ? { deleted: true } : {}),
+      };
+    }
+    return tabs;
+  } catch {
+    return {};
+  }
+}
+
+/** Serialize only shared fields, even if a caller has extra local fields. */
+export function encodeScheduleTabs(tabs: ScheduleTabs): string {
+  const rows = Object.values(tabs)
+    .sort((a, b) => a.id.localeCompare(b.id))
+    .map(({ id, title, url, order, updatedAt, updatedBy, deleted }) => ({
+      id,
+      title,
+      url,
+      order,
+      updatedAt,
+      updatedBy,
+      ...(deleted ? { deleted: true } : {}),
+    }));
+  const content = JSON.stringify({ v: 1, tabs: rows });
+  if (
+    rows.length > MAX_TABS ||
+    new TextEncoder().encode(content).length > MAX_CONTENT_BYTES
+  )
+    throw new Error("일정 탭이 너무 많습니다.");
+  return content;
+}
+
+/** Deterministic per-tab LWW, including deletions. */
+export function mergeScheduleTabs(
+  base: ScheduleTabs,
+  other: ScheduleTabs,
+): ScheduleTabs {
+  const result = { ...base };
+  for (const tab of Object.values(other)) {
+    const old = result[tab.id];
+    if (
+      !old ||
+      tab.updatedAt > old.updatedAt ||
+      (tab.updatedAt === old.updatedAt &&
+        (tab.updatedBy > old.updatedBy ||
+          (tab.updatedBy === old.updatedBy &&
+            (Number(!!tab.deleted) > Number(!!old.deleted) ||
+              (tab.deleted === old.deleted &&
+                JSON.stringify(tab) > JSON.stringify(old))))))
+    )
+      result[tab.id] = tab;
+  }
+  return result;
+}
+
+/** Only current owner/admin copies of the exact kind and scope count. */
+export function mergeScheduleEvents(
+  events: readonly RelayEvent[],
+  managers: ReadonlySet<string>,
+  dTag: string,
+): ScheduleTabs {
+  const newest = new Map<string, RelayEvent>();
+  for (const event of events) {
+    const tags = event.tags.filter(([name]) => name === "d");
+    if (
+      event.kind !== 30078 ||
+      !managers.has(event.pubkey) ||
+      tags.length !== 1 ||
+      tags[0]?.[1] !== dTag
+    )
+      continue;
+    const old = newest.get(event.pubkey);
+    if (
+      !old ||
+      event.created_at > old.created_at ||
+      (event.created_at === old.created_at && event.id < old.id)
+    )
+      newest.set(event.pubkey, event);
+  }
+  return [...newest.values()].reduce(
+    (tabs, event) => mergeScheduleTabs(tabs, decodeScheduleTabs(event.content)),
+    {} as ScheduleTabs,
+  );
+}
+
+/** Calendar is separate and always first; live link tabs follow explicit order. */
+export function visibleScheduleTabs(tabs: ScheduleTabs) {
+  return Object.values(tabs)
+    .filter((tab) => !tab.deleted)
+    .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));
+}
+
+const localKey = (relay: string, pubkey: string, id: string) =>
+  `buzz-schedule-local:${normalizeRelayUrl(relay)}:${pubkey}:${id}`;
+
+/** This device's override, isolated by community, member and tab id. */
+export function readLocalScheduleUrl(
+  relay: string,
+  pubkey: string,
+  id: string,
+  storage: Pick<Storage, "getItem"> = localStorage,
+): string | null {
+  try {
+    const raw = storage.getItem(localKey(relay, pubkey, id));
+    return raw ? normalizeLinkUrl(raw) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Never passed to a relay writer. Storage failures propagate to the form. */
+export function writeLocalScheduleUrl(
+  relay: string,
+  pubkey: string,
+  id: string,
+  url: string,
+  storage: Pick<Storage, "setItem" | "removeItem"> = localStorage,
+): void {
+  const key = localKey(relay, pubkey, id);
+  if (!url.trim()) {
+    storage.removeItem(key);
+    return;
+  }
+  const normalized = normalizeLinkUrl(url);
+  if (!normalized) throw new Error("https:// 로 시작하는 주소를 넣어 주세요.");
+  storage.setItem(key, normalized);
+}
diff --git a/desktop/src/features/team-schedule/lib/scheduleWebviews.test.mjs b/desktop/src/features/team-schedule/lib/scheduleWebviews.test.mjs
new file mode 100644
index 000000000..558cb2e69
--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/scheduleWebviews.test.mjs
@@ -0,0 +1,201 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ScheduleWebviews } from "./scheduleWebviews.ts";
+import { scheduleBounds } from "./scheduleGeometry.ts";
+
+const bounds = { x: 250, y: 140, width: 650, height: 450 };
+const page = (id, extra = {}) => ({
+  id,
+  url: `https://example.com/${id}`,
+  bounds,
+  revision: 0,
+  ...extra,
+});
+const deferred = () => {
+  let resolve;
+  const promise = new Promise((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+};
+function child(name, log) {
+  return Object.fromEntries(
+    ["hide", "show", "close", "setPosition", "setSize"].map((method) => [
+      method,
+      async (value) => {
+        log.push([name, method, value]);
+      },
+    ]),
+  );
+}
+
+test("DOM to logical pixels handles retina, fractional scale and app rem zoom without double scaling", () => {
+  assert.deepEqual(scheduleBounds(bounds, 2, 2), bounds);
+  assert.deepEqual(scheduleBounds(bounds, 1.5, 1.5), bounds);
+  assert.deepEqual(scheduleBounds(bounds, 2.5, 2), {
+    x: 312.5,
+    y: 175,
+    width: 812.5,
+    height: 562.5,
+  });
+  for (const rect of [
+    { ...bounds, width: 0 },
+    { ...bounds, x: -1 },
+    { ...bounds, y: NaN },
+  ])
+    assert.equal(scheduleBounds(rect, 2, 2), null);
+  assert.equal(scheduleBounds(bounds, 2, 0), null);
+});
+
+test("real Tauri IPC creates a persistent child of main, positions it and reuses hidden tabs", async () => {
+  const calls = [];
+  globalThis.window = {
+    __TAURI_INTERNALS__: {
+      metadata: { currentWindow: { label: "main" } },
+      invoke: async (cmd, args) => {
+        calls.push({ cmd, args });
+        return null;
+      },
+    },
+  };
+  const errors = [];
+  const views = new ScheduleWebviews((id) => errors.push(id));
+  await views.update(page("a"));
+  await views.update(page("b"));
+  await views.update(page("a", { bounds: { ...bounds, width: 700 } }));
+  const creations = calls.filter(
+    ({ cmd }) => cmd === "plugin:webview|create_webview",
+  );
+  assert.equal(creations.length, 2);
+  const first = creations[0].args;
+  assert.equal(first.windowLabel, "main");
+  assert.equal(first.options.incognito, false);
+  assert.equal(first.options.focus, false);
+  assert.equal(first.options.dataDirectory, undefined);
+  assert.equal(first.options.x, -10000);
+  const shows = calls.filter(
+    ({ cmd }) => cmd === "plugin:webview|webview_show",
+  );
+  assert.deepEqual(
+    shows.map(({ args }) => args.label),
+    [first.options.label, creations[1].args.options.label, first.options.label],
+  );
+  const sizes = calls.filter(
+    ({ cmd }) => cmd === "plugin:webview|set_webview_size",
+  );
+  assert.equal(sizes.at(-1).args.value.toJSON().Logical.width, 700);
+  await views.update(null); // calendar / modal / address form
+  assert.equal(calls.at(-1).cmd, "plugin:webview|webview_hide");
+  await views.dispose();
+  assert.equal(
+    calls.filter(({ cmd }) => cmd === "plugin:webview|webview_close").length,
+    2,
+  );
+  assert.deepEqual(errors, []);
+});
+
+test("a delayed creation never reveals a tab retired by calendar, modal, team switch or close", async () => {
+  for (const dispose of [false, true]) {
+    const pending = deferred();
+    const started = deferred();
+    const log = [];
+    const views = new ScheduleWebviews(
+      () => assert.fail("unexpected failure"),
+      () => {
+        started.resolve();
+        return pending.promise;
+      },
+    );
+    const opening = views.update(page("a"));
+    await started.promise;
+    const hiding = dispose ? views.dispose() : views.update(null);
+    pending.resolve(child("a", log));
+    await Promise.all([opening, hiding]);
+    assert.equal(
+      log.some(([, method]) => method === "show"),
+      false,
+    );
+    assert.equal(
+      log.some(([, method]) => method === "close"),
+      dispose,
+    );
+    await views.dispose();
+  }
+});
+
+test("a selection changed during show IPC is hidden before the next tab shows", async () => {
+  const log = [];
+  const showing = deferred();
+  const started = deferred();
+  const a = child("a", log);
+  a.show = async () => {
+    log.push(["a", "show"]);
+    started.resolve();
+    await showing.promise;
+  };
+  const views = new ScheduleWebviews(
+    () => assert.fail("unexpected failure"),
+    async (url) => (url.endsWith("/a") ? a : child("b", log)),
+  );
+  const opening = views.update(page("a"));
+  await started.promise;
+  const switching = views.update(page("b"));
+  showing.resolve();
+  await Promise.all([opening, switching]);
+  const aShow = log.findIndex(
+    ([name, method]) => name === "a" && method === "show",
+  );
+  const bShow = log.findIndex(
+    ([name, method]) => name === "b" && method === "show",
+  );
+  assert.ok(
+    log
+      .slice(aShow + 1, bShow)
+      .some(([name, method]) => name === "a" && method === "hide"),
+  );
+  await views.dispose();
+});
+
+test("failure reports the affected tab, refresh retries, and refresh or URL replacement closes the old child", async () => {
+  const errors = [];
+  const log = [];
+  let attempts = 0;
+  const views = new ScheduleWebviews(
+    (id) => errors.push(id),
+    async () => {
+      if (++attempts === 1) throw Error("unavailable");
+      return child(`view${attempts}`, log);
+    },
+  );
+  await views.update(page("a"));
+  assert.deepEqual(errors, ["a"]);
+  await views.update(page("a", { revision: 1 }));
+  await views.update(page("a", { revision: 2 }));
+  await views.update(
+    page("a", { revision: 2, url: "https://example.com/new" }),
+  );
+  assert.equal(attempts, 4);
+  assert.equal(log.filter(([, method]) => method === "close").length, 2);
+  await views.dispose();
+});
+
+test("back-to-back updates coalesce to the newest page and retain the final hide", async () => {
+  const log = [];
+  let attempts = 0;
+  const views = new ScheduleWebviews(
+    () => assert.fail("unexpected failure"),
+    async () => {
+      attempts += 1;
+      return child("b", log);
+    },
+  );
+  const first = views.update(null);
+  const second = views.update(page("a"));
+  const third = views.update(page("b"));
+  await Promise.all([first, second, third]);
+  assert.equal(attempts, 1);
+  assert.equal(log.at(-1)[1], "show");
+  await views.update(null);
+  assert.equal(log.at(-1)[1], "hide");
+  await views.dispose();
+});
diff --git a/desktop/src/features/team-schedule/lib/scheduleWebviews.ts b/desktop/src/features/team-schedule/lib/scheduleWebviews.ts
new file mode 100644
index 000000000..b06e777dd
--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/scheduleWebviews.ts
@@ -0,0 +1,163 @@
+import { LogicalPosition, LogicalSize } from "@tauri-apps/api/dpi";
+import { Webview } from "@tauri-apps/api/webview";
+import { getCurrentWindow } from "@tauri-apps/api/window";
+import { normalizeLinkUrl } from "@/features/team-links/lib/teamLinks";
+
+/** Rectangle in native logical pixels, relative to the main window content. */
+export type ScheduleBounds = {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+};
+type Page = {
+  id: string;
+  url: string;
+  bounds: ScheduleBounds;
+  revision: number;
+};
+type Child = Pick<
+  Webview,
+  "hide" | "show" | "close" | "setPosition" | "setSize"
+>;
+type Entry = { view: Child; url: string; revision: number };
+
+let nextLabel = 0;
+
+async function createChild(url: string, onError: () => void): Promise<Child> {
+  // No initial focus or on-screen flash while an asynchronous creation is pending.
+  const view = new Webview(
+    getCurrentWindow(),
+    `schedule-child-${++nextLabel}`,
+    {
+      url,
+      x: -10000,
+      y: -10000,
+      width: 1,
+      height: 1,
+      focus: false,
+      incognito: false,
+    },
+  );
+  return new Promise((resolve, reject) => {
+    let expired = false;
+    const timer = setTimeout(() => {
+      expired = true;
+      reject(new Error("페이지를 열지 못했습니다."));
+    }, 30_000);
+    void view.once("tauri://created", () => {
+      clearTimeout(timer);
+      if (expired) {
+        // A late child remains off screen, then closes. Never reveal it.
+        void view.close().catch(onError);
+      } else resolve(view);
+    });
+    void view.once("tauri://error", () => {
+      clearTimeout(timer);
+      reject(new Error("페이지를 열지 못했습니다."));
+    });
+  });
+}
+
+/** Serializes native mutations and fences every reveal against the newest selection. */
+export class ScheduleWebviews {
+  private entries = new Map<string, Entry>();
+  private desired: Page | null = null;
+  private version = 0;
+  private handled = 0;
+  private running: Promise<void> | null = null;
+  private disposed = false;
+
+  private onError: (id: string | undefined) => void;
+  private create: (url: string) => Promise<Child>;
+
+  constructor(
+    onError: (id: string | undefined) => void,
+    create?: (url: string) => Promise<Child>,
+  ) {
+    this.onError = onError;
+    this.create =
+      create ?? ((url) => createChild(url, () => onError(undefined)));
+  }
+
+  /** Null hides all children; revisions recreate only the requested page on refresh. */
+  update(page: Page | null): Promise<void> {
+    if (this.disposed) return this.running ?? Promise.resolve();
+    this.desired = page;
+    this.version += 1;
+    return this.start();
+  }
+
+  /** Closing the schedule destroys its children, including any late creation. */
+  dispose(): Promise<void> {
+    this.disposed = true;
+    this.desired = null;
+    this.version += 1;
+    return this.start();
+  }
+
+  private start(): Promise<void> {
+    if (!this.running) {
+      this.running = Promise.resolve()
+        .then(() => this.drain())
+        .finally(() => {
+          this.running = null;
+          if (this.handled !== this.version) return this.start();
+        });
+    }
+    return this.running;
+  }
+
+  private async drain() {
+    let handled: number;
+    do {
+      handled = this.version;
+      this.handled = handled;
+      const page = this.desired;
+      try {
+        // Hide before creating/showing another child: two pages never overlap.
+        for (const entry of this.entries.values()) await entry.view.hide();
+        if (handled !== this.version) continue;
+        if (this.disposed) {
+          for (const [id, entry] of this.entries) {
+            await entry.view.close();
+            this.entries.delete(id);
+          }
+        } else if (page) {
+          const url = normalizeLinkUrl(page.url);
+          if (!url) throw new Error("주소를 확인해 주세요.");
+          let entry = this.entries.get(page.id);
+          if (
+            entry &&
+            (entry.url !== url || entry.revision !== page.revision)
+          ) {
+            await entry.view.close();
+            this.entries.delete(page.id);
+            entry = undefined;
+          }
+          if (handled !== this.version) continue;
+          if (!entry) {
+            const view = await this.create(url);
+            entry = { view, url, revision: page.revision };
+            this.entries.set(page.id, entry);
+            await view.hide();
+          }
+          if (handled !== this.version) continue;
+          await entry.view.setPosition(
+            new LogicalPosition(page.bounds.x, page.bounds.y),
+          );
+          await entry.view.setSize(
+            new LogicalSize(page.bounds.width, page.bounds.height),
+          );
+          if (handled !== this.version) continue;
+          await entry.view.show();
+          // Selection can change during the show IPC itself.
+          if (handled !== this.version) await entry.view.hide();
+        }
+      } catch {
+        // Keep ownership on failure, so the next explicit update retries cleanup.
+        if (handled === this.version) this.onError(page?.id);
+      }
+    } while (handled !== this.version);
+  }
+}
diff --git a/desktop/src/features/team-schedule/lib/useScheduleTabs.ts b/desktop/src/features/team-schedule/lib/useScheduleTabs.ts

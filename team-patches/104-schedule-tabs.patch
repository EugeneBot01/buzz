index 000000000..4203c6e47
--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/scheduleStore.ts
@@ -0,0 +1,78 @@
+import { relayClient } from "@/shared/api/relayClient";
+import { listRelayMembers } from "@/shared/api/relayMembers";
+import { signRelayEvent } from "@/shared/api/tauri";
+import {
+  encodeScheduleTabs,
+  mergeScheduleEvents,
+  mergeScheduleTabs,
+  scheduleDTag,
+  type ScheduleTab,
+} from "./scheduleTabs";
+
+/** Read authorized copies only; failures remain errors rather than empty state. */
+export async function readScheduleSnapshot(relay: string) {
+  const members = await listRelayMembers();
+  const managers = new Set(
+    members
+      .filter(({ role }) => role === "owner" || role === "admin")
+      .map(({ pubkey }) => pubkey),
+  );
+  if (managers.size > 200)
+    throw new Error("일정 관리자를 불러오지 못했습니다.");
+  const dTag = scheduleDTag(relay);
+  const events = managers.size
+    ? await relayClient.fetchEvents({
+        kinds: [30078],
+        authors: [...managers],
+        "#d": [dTag],
+        limit: 200,
+      })
+    : [];
+  return {
+    managers,
+    events,
+    tabs: mergeScheduleEvents(events, managers, dTag),
+  };
+}
+
+/** Recheck roles and merge fresh copies before publishing one shared snapshot. */
+export async function saveScheduleChange(
+  relay: string,
+  pubkey: string,
+  changes: readonly ScheduleTab[],
+  active: () => boolean,
+) {
+  const snapshot = await readScheduleSnapshot(relay);
+  if (!active()) throw new Error("다른 팀으로 이동했습니다. 다시 열어 주세요.");
+  if (!snapshot.managers.has(pubkey))
+    throw new Error("방장과 관리자만 바꿀 수 있습니다.");
+  let tabs = snapshot.tabs;
+  for (const change of changes) {
+    tabs = mergeScheduleTabs(tabs, {
+      [change.id]: {
+        ...change,
+        updatedBy: pubkey,
+        updatedAt: Math.max(Date.now(), (tabs[change.id]?.updatedAt ?? 0) + 1),
+      },
+    });
+  }
+  const ownCreatedAt = Math.max(
+    0,
+    ...snapshot.events
+      .filter((event) => event.pubkey === pubkey)
+      .map((event) => event.created_at),
+  );
+  const event = await signRelayEvent({
+    kind: 30078,
+    content: encodeScheduleTabs(tabs),
+    createdAt: Math.max(Math.floor(Date.now() / 1000), ownCreatedAt + 1),
+    tags: [["d", scheduleDTag(relay)]],
+  });
+  if (!active()) throw new Error("다른 팀으로 이동했습니다. 다시 열어 주세요.");
+  await relayClient.publishEvent(
+    event,
+    "저장 시간이 오래 걸립니다. 다시 시도해 주세요.",
+    "일정 탭을 저장하지 못했습니다.",
+    active,
+  );
+}
diff --git a/desktop/src/features/team-schedule/lib/scheduleTabs.test.mjs b/desktop/src/features/team-schedule/lib/scheduleTabs.test.mjs

index 000000000..cd0e9acfd
--- /dev/null
+++ b/desktop/src/features/team-schedule/lib/useScheduleWebview.ts
@@ -0,0 +1,145 @@
+import * as React from "react";
+import { isTauri } from "@tauri-apps/api/core";
+import { getCurrentWindow } from "@tauri-apps/api/window";
+import { scheduleBounds, scheduleCovered } from "./scheduleGeometry";
+import { ScheduleWebviews } from "./scheduleWebviews";
+
+/** Follow the DOM slot without revealing a retired tab or an obscured dialog. */
+export function useScheduleWebview(
+  scope: string,
+  id: string | undefined,
+  url: string,
+  blocked: boolean,
+) {
+  const host = React.useRef<HTMLElement>(null);
+  const session = React.useRef<{
+    scope: string;
+    views: ScheduleWebviews;
+  } | null>(null);
+  const [failed, setFailed] = React.useState<string | undefined>();
+  const [revisions, refreshTab] = React.useReducer(
+    (state: Record<string, number>, tab: string) => ({
+      ...state,
+      [tab]: (state[tab] ?? 0) + 1,
+    }),
+    {},
+  );
+  const revision = revisions[id ?? ""] ?? 0;
+  const refresh = () => {
+    if (id) refreshTab(id);
+  };
+  const key = `${scope}|${id}|${url}|${revision}`;
+  const latestKey = React.useRef(key);
+  latestKey.current = key;
+
+  const latestId = React.useRef(id);
+  latestId.current = id;
+
+  React.useEffect(() => {
+    const views = new ScheduleWebviews((failedId) => {
+      if (!failedId || failedId === latestId.current)
+        setFailed(latestKey.current);
+    });
+    session.current = { scope, views };
+    return () => {
+      session.current = null;
+      void views.dispose();
+    };
+  }, [scope]);
+  React.useEffect(() => {
+    const currentSession = session.current;
+    const slot = host.current;
+    if (!currentSession || currentSession.scope !== scope) return;
+    const { views } = currentSession;
+    if (!id || !slot || blocked || failed === key) {
+      void views.update(null);
+      return;
+    }
+    if (!isTauri()) {
+      setFailed(key);
+      return;
+    }
+    let stopped = false;
+    let frame: number | undefined;
+    let last = "";
+    let measurement = 0;
+    const sync = async () => {
+      frame = undefined;
+      const current = ++measurement;
+      try {
+        const scale = await getCurrentWindow().scaleFactor();
+        if (stopped || current !== measurement) return;
+        const bounds = scheduleBounds(
+          slot.getBoundingClientRect(),
+          window.devicePixelRatio,
+          scale,
+        );
+        const page =
+          bounds && !document.hidden && !scheduleCovered(slot)
+            ? { id, url, bounds, revision }
+            : null;
+        const signature = JSON.stringify(page);
+        if (signature !== last) {
+          last = signature;
+          void views.update(page);
+        }
+      } catch {
+        if (!stopped && current === measurement) {
+          void views.update(null);
+          setFailed(key);
+        }
+      }
+    };
+    const schedule = () => {
+      if (frame === undefined) frame = requestAnimationFrame(() => void sync());
+    };
+    const resize = new ResizeObserver(schedule);
+    resize.observe(slot);
+    const mutations = new MutationObserver(schedule);
+    mutations.observe(document.body, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ["data-state", "aria-hidden", "style", "class"],
+    });
+    const unlisteners: (() => void)[] = [];
+    const appWindow = getCurrentWindow();
+    for (const registration of [
+      appWindow.onResized(schedule),
+      appWindow.onScaleChanged(schedule),
+    ]) {
+      void registration.then(
+        (off) => {
+          if (stopped) off();
+          else unlisteners.push(off);
+        },
+        () => {
+          if (!stopped) {
+            void views.update(null);
+            setFailed(key);
+          }
+        },
+      );
+    }
+    window.addEventListener("resize", schedule);
+    window.addEventListener("scroll", schedule, true);
+    document.addEventListener("visibilitychange", schedule);
+    slot.closest('[role="dialog"]')?.addEventListener("animationend", schedule);
+    schedule();
+    return () => {
+      stopped = true;
+      if (frame !== undefined) cancelAnimationFrame(frame);
+      resize.disconnect();
+      mutations.disconnect();
+      for (const off of unlisteners) off();
+      window.removeEventListener("resize", schedule);
+      window.removeEventListener("scroll", schedule, true);
+      document.removeEventListener("visibilitychange", schedule);
+      slot
+        .closest('[role="dialog"]')
+        ?.removeEventListener("animationend", schedule);
+      void views.update(null);
+    };
+  }, [id, url, blocked, key, revision, failed, scope]);
+  return { host, failed: failed === key, refresh };
+}

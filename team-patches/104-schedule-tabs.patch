+import * as React from "react";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import { openScheduleWindow } from "../lib/openScheduleWindow";
+import { useScheduleWebview } from "../lib/useScheduleWebview";
+import {
+  readLocalScheduleUrl,
+  writeLocalScheduleUrl,
+  type ScheduleTab,
+} from "../lib/scheduleTabs";
+
+/** Device-only addresses never reach the shared save function. */
+export function ScheduleLinkPanel({
+  tab,
+  pubkey,
+  relay,
+  blocked = false,
+  onLocalChange,
+  reportError,
+}: {
+  tab?: ScheduleTab;
+  pubkey: string;
+  relay: string;
+  blocked?: boolean;
+  onLocalChange: () => void;
+  reportError: (message: string) => void;
+}) {
+  const [localUrl, setLocalUrl] = React.useState("");
+  const [expanded, setExpanded] = React.useState(false);
+  const [opening, setOpening] = React.useState(false);
+  const [, localChanged] = React.useReducer((n) => n + 1, 0);
+  const tabId = tab?.id;
+  React.useEffect(() => {
+    setLocalUrl(
+      tabId ? (readLocalScheduleUrl(relay, pubkey, tabId) ?? "") : "",
+    );
+    setExpanded(false);
+  }, [tabId, relay, pubkey]);
+  const url = tab
+    ? (readLocalScheduleUrl(relay, pubkey, tab.id) ?? tab.url)
+    : "";
+  const { host, failed, refresh } = useScheduleWebview(
+    `${relay}|${pubkey}`,
+    tab?.id,
+    url,
+    blocked || expanded,
+  );
+  const open = async () => {
+    if (!tab) return;
+    setOpening(true);
+    try {
+      await openScheduleWindow(relay, pubkey, tab.id, url);
+    } catch {
+      reportError("새 창을 열지 못했습니다. 다시 눌러 주세요.");
+    } finally {
+      setOpening(false);
+    }
+  };
+  if (!tab) return null;
+  return (
+    <div className="flex min-h-0 flex-1 flex-col gap-2">
+      <div className="flex flex-wrap items-center gap-2">
+        <h3 className="mr-auto text-sm font-semibold">{tab.title}</h3>
+        <Button onClick={refresh} size="sm" type="button" variant="ghost">
+          새로고침
+        </Button>
+        <Button
+          disabled={opening}
+          onClick={() => void open()}
+          size="sm"
+          type="button"
+          variant="ghost"
+        >
+          새 창으로 열기
+        </Button>
+        <Button
+          aria-expanded={expanded}
+          aria-controls="schedule-local-form"
+          onClick={() => setExpanded(!expanded)}
+          size="sm"
+          type="button"
+          variant="outline"
+        >
+          이 기기 주소
+        </Button>
+      </div>
+      {expanded ? (
+        <form
+          id="schedule-local-form"
+          className="space-y-2 rounded-lg border p-3"
+          onSubmit={(event) => {
+            event.preventDefault();
+            try {
+              writeLocalScheduleUrl(relay, pubkey, tab.id, localUrl);
+              localChanged();
+              onLocalChange();
+              reportError("");
+              setExpanded(false);
+            } catch {
+              reportError(
+                "주소를 저장하지 못했습니다. https 주소와 기기 저장 공간을 확인해 주세요.",
+              );
+            }
+          }}
+        >
+          <label className="text-sm font-medium" htmlFor="schedule-local-url">
+            이 기기에서만 다른 주소로 열기
+          </label>
+          <Input
+            autoComplete="off"
+            id="schedule-local-url"
+            maxLength={500}
+            onChange={(event) => setLocalUrl(event.target.value)}
+            type="password"
+            value={localUrl}
+          />
+          <p className="text-xs text-muted-foreground">
+            팀에는 공유되지 않습니다. 비워서 저장하면 팀 주소로 돌아갑니다.
+          </p>
+          <Button size="sm" type="submit" variant="outline">
+            이 기기에 저장
+          </Button>
+        </form>
+      ) : null}
+      <section
+        ref={host}
+        data-testid="schedule-page-slot"
+        aria-label={`${tab.title} 페이지`}
+        className="min-h-0 flex-1 rounded-lg border"
+      >
+        {failed ? (
+          <div className="space-y-3 p-4" role="status">
+            <p className="text-sm">이 화면에서는 열 수 없어 새 창으로 엽니다</p>
+            <Button
+              disabled={opening}
+              onClick={() => void open()}
+              type="button"
+            >
+              새 창으로 열기
+            </Button>
+          </div>
+        ) : null}
+      </section>
+    </div>
+  );
+}
diff --git a/desktop/src/features/team-schedule/ui/ScheduleTabForm.tsx b/desktop/src/features/team-schedule/ui/ScheduleTabForm.tsx

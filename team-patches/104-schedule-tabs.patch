@@ -0,0 +1,53 @@
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import * as React from "react";
+import { readScheduleSnapshot, saveScheduleChange } from "./scheduleStore";
+import type { ScheduleTab } from "./scheduleTabs";
+
+/** Refresh on reopen, reconnect and every 30 seconds while the window is open. */
+export function useScheduleTabs(pubkey: string, relay: string) {
+  const queryClient = useQueryClient();
+  const queryKey = ["team-schedule-tabs", relay, pubkey];
+  const query = useQuery({
+    queryKey,
+    queryFn: () => readScheduleSnapshot(relay),
+    refetchInterval: 30_000,
+    retry: false,
+  });
+  const [saving, setSaving] = React.useState(false);
+  const lock = React.useRef(false);
+  const currentScope = React.useRef({ relay, pubkey, active: true });
+  React.useEffect(() => {
+    const scope = { relay, pubkey, active: true };
+    currentScope.current = scope;
+    return () => {
+      scope.active = false;
+    };
+  }, [relay, pubkey]);
+  const save = async (changes: readonly ScheduleTab[]) => {
+    if (lock.current) throw new Error("저장이 끝난 뒤 다시 눌러 주세요.");
+    const scope = currentScope.current;
+    lock.current = true;
+    setSaving(true);
+    try {
+      await saveScheduleChange(
+        relay,
+        pubkey,
+        changes,
+        () => scope.active && currentScope.current === scope,
+      );
+      await queryClient.invalidateQueries({ queryKey });
+    } finally {
+      lock.current = false;
+      if (scope.active) setSaving(false);
+    }
+  };
+  return {
+    tabs: query.data?.tabs ?? {},
+    canManage: query.isSuccess && query.data.managers.has(pubkey),
+    loading: query.isPending,
+    error: query.isError,
+    retry: query.refetch,
+    saving,
+    save,
+  };
+}

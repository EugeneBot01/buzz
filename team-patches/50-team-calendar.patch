+            return (
+              <li key={item.id}>
+                <button
+                  className="flex w-full flex-col items-start gap-0.5 rounded-lg border border-border/60 px-3 py-2 text-left transition-colors hover:bg-muted/70 focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring"
+                  data-testid="team-poll-item"
+                  onClick={() => setOpenId(item.id)}
+                  type="button"
+                >
+                  <span className="text-sm font-medium">{item.title}</span>
+                  <span className="text-xs text-muted-foreground">
+                    {dayLabel(item.startDate)} ~ {dayLabel(item.endDate)}

@@ -0,0 +1,75 @@
+import { CalendarDays } from "lucide-react";
+import * as React from "react";
+
+import {
+  type AddFromMessageRequest,
+  onAddFromMessage,
+} from "@/features/team-calendar/lib/addFromMessage";
+import { useTeamCalendarReminders } from "@/features/team-calendar/lib/useTeamCalendarReminders";
+import { SidebarMenuButton, SidebarMenuItem } from "@/shared/ui/sidebar";
+import { SidebarMenuLabel } from "@/shared/ui/sidebar-menu-label";
+import { AddFromMessageDialog } from "./AddFromMessageDialog";
+import { TeamCalendarDialog } from "./TeamCalendarDialog";
+
+/**
+ * Sidebar entry for the team calendar (team patch). The calendar window is
+ * mounted only while open. Reminders and "add to calendar" from a message are
+ * handled here too, because this is mounted for as long as a community is
+ * shown.
+ */
+export function TeamCalendarSidebarEntry({
+  pubkey,
+  relayUrl,
+}: {
+  pubkey?: string;
+  relayUrl?: string;
+}) {
+  if (!pubkey || !relayUrl) return null;
+  return <TeamCalendarEntry pubkey={pubkey} relayUrl={relayUrl} />;
+}
+
+function TeamCalendarEntry({
+  pubkey,
+  relayUrl,
+}: {
+  pubkey: string;
+  relayUrl: string;
+}) {
+  const [open, setOpen] = React.useState(false);
+  const [request, setRequest] = React.useState<AddFromMessageRequest | null>(
+    null,
+  );
+  useTeamCalendarReminders(pubkey, relayUrl);
+  React.useEffect(() => onAddFromMessage(setRequest), []);
+
+  return (
+    <SidebarMenuItem data-no-translate="">
+      <SidebarMenuButton
+        data-testid="open-team-calendar"
+        onClick={() => setOpen(true)}
+        tooltip="팀 캘린더"
+        type="button"
+      >
+        <CalendarDays className="h-4 w-4" />
+        <SidebarMenuLabel>캘린더</SidebarMenuLabel>
+      </SidebarMenuButton>
+      {open ? (
+        <TeamCalendarDialog
+          onOpenChange={setOpen}
+          open={open}
+          pubkey={pubkey}
+          relayUrl={relayUrl}
+        />
+      ) : null}
+      {request ? (
+        <AddFromMessageDialog
+          key={request.eventId}
+          onClose={() => setRequest(null)}
+          pubkey={pubkey}
+          relayUrl={relayUrl}
+          request={request}
+        />
+      ) : null}
+    </SidebarMenuItem>
+  );
+}

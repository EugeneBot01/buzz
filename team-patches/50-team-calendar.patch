+                  <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+                    종료 날짜
+                    <Input
+                      min={draft.date || undefined}
+                      onChange={(event) =>
+                        setDraft({ ...draft, endDate: event.target.value })
+                      }
+                      required
+                      type="date"
+                      value={draft.endDate}
+                    />
+                  </label>
+                  <label className="flex w-28 flex-col gap-1 text-xs">
+                    종료 시간 (선택)
+                    <Input
+                      disabled={!draft.time}
+                      onChange={(event) =>
+                        setDraft({ ...draft, endTime: event.target.value })
+                      }
+                      type="time"
+                      value={draft.endTime}
+                    />
+                  </label>
+                </div>
+                {rangeError ? (
+                  <p
+                    className="text-xs text-destructive"
+                    data-testid="team-calendar-range-error"
+                    role="alert"
+                  >
+                    {rangeError}
+                  </p>
+                ) : null}
+                <fieldset className="flex min-w-0 flex-col gap-1 text-xs">
+                  <legend className="mb-1">색상</legend>
+                  <div className="flex flex-wrap gap-1.5">
+                    {COLOR_CHOICES.map((choice) => {
+                      const { label, dot } = COLOR_STYLES[choice];
+                      const checked = draft.color === choice;
+                      return (
+                        <button
+                          aria-label={label}
+                          aria-pressed={checked}
+                          className={cn(
+                            "h-5 w-5 rounded-full border-2 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring",
+                            dot,
+                            checked
+                              ? "border-foreground"
+                              : "border-transparent",
+                          )}
+                          data-testid={`team-calendar-color-${choice || "default"}`}
+                          key={choice || "default"}
+                          onClick={() => setDraft({ ...draft, color: choice })}
+                          title={label}
+                          type="button"
+                        />
+                      );
+                    })}
+                  </div>
+                </fieldset>
+                <label className="flex flex-col gap-1 text-xs">
+                  메모 (선택)
+                  <Textarea
+                    maxLength={MAX_NOTE_LENGTH}
+                    onChange={(event) =>
+                      setDraft({ ...draft, note: event.target.value })
+                    }
+                    rows={3}
+                    value={draft.note}
+                  />
+                </label>
+                <div className="flex justify-end gap-2">
+                  <Button
+                    disabled={saving}
+                    onClick={() => setDraft(null)}
+                    size="sm"
+                    type="button"
+                    variant="ghost"
+                  >
+                    취소
+                  </Button>
+                  <Button
+                    disabled={
+                      saving ||
+                      draft.title.trim().length === 0 ||
+                      rangeError !== null
+                    }
+                    size="sm"
+                    type="submit"
+                  >
+                    {draft.id ? "수정 저장" : "저장"}
+                  </Button>
+                </div>
+              </form>
+            ) : selectedEntries.length === 0 ? (
+              <p className="text-sm text-muted-foreground">
+                이 날에는 일정이 없습니다.
+              </p>
+            ) : (
+              <ul className="flex max-h-80 flex-col gap-2 overflow-y-auto">
+                {selectedEntries.map((entry) => (
+                  <li
+                    className="rounded-lg border border-border/60 px-3 py-2"
+                    data-testid="team-calendar-entry"
+                    key={entry.id}
+                  >
+                    <div className="flex items-start gap-2">
+                      <div className="min-w-0 flex-1">
+                        <p className="flex items-start gap-1.5 break-words text-sm font-medium">
+                          <span
+                            aria-hidden="true"
+                            className={cn(
+                              "mt-1.5 h-2 w-2 shrink-0 rounded-full",
+                              COLOR_STYLES[entry.color ?? ""].dot,
+                            )}
+                          />
+                          {entry.title}
+                        </p>
+                        <p className="text-xs text-muted-foreground">
+                          {rangeLabel(entry)}
+                        </p>
+                      </div>
+                      <Button
+                        aria-label={`${entry.title} 수정`}
+                        disabled={saving}
+                        onClick={() => setDraft(draftOf(entry))}
+                        size="icon-xs"
+                        type="button"
+                        variant="ghost"
+                      >
+                        <Pencil />
+                      </Button>
+                      {confirmingId === entry.id ? (
+                        <Button
+                          aria-label={`${entry.title} 삭제 확인`}
+                          disabled={saving}
+                          onBlur={() => setConfirmingId(null)}
+                          onClick={() => removeEntry(entry)}
+                          size="xs"
+                          type="button"
+                          variant="destructive"
+                        >
+                          삭제 확인
+                        </Button>
+                      ) : (
+                        <Button
+                          aria-label={`${entry.title} 삭제`}
+                          disabled={saving}
+                          onClick={() => removeEntry(entry)}
+                          size="icon-xs"
+                          type="button"
+                          variant="ghost"
+                        >
+                          <Trash2 />
+                        </Button>
+                      )}
+                    </div>
+                    {entry.note ? (
+                      <p className="mt-1 whitespace-pre-wrap break-words text-xs text-muted-foreground">
+                        {entry.note}
+                      </p>
+                    ) : null}
+                  </li>
+                ))}
+              </ul>
+            )}
+          </section>
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}

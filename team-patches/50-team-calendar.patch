diff --git a/desktop/src/features/team-calendar/lib/teamCalendar.test.mjs b/desktop/src/features/team-calendar/lib/teamCalendar.test.mjs
new file mode 100644
index 0000000..9f0e54a
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/teamCalendar.test.mjs
@@ -0,0 +1,166 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  MAX_TEAM_CALENDAR_CONTENT_BYTES,
+  decodeMonth,
+  encodeForPublish,
+  encodeMonth,
+  entriesByDate,
+  hasNewerEntries,
+  mergeMonthEvents,
+  mergeMonths,
+  monthGrid,
+  shiftMonth,
+  teamCalendarDTag,
+} from "./teamCalendar.ts";
+
+const ALICE = "a".repeat(64);
+const BOB = "b".repeat(64);
+
+const entry = (id, overrides = {}) => ({
+  id,
+  title: `Entry ${id}`,
+  date: "2026-10-07",
+  updatedAt: 1_000,
+  updatedBy: ALICE,
+  ...overrides,
+});
+
+const monthOf = (...entries) =>
+  Object.fromEntries(entries.map((value) => [value.id, value]));
+
+let seq = 0;
+const ev = (pubkey, month, createdAt, dTag) => ({
+  id: `id-${String(++seq).padStart(6, "0")}`,
+  pubkey,
+  kind: 30078,
+  content: encodeMonth(month),
+  created_at: createdAt,
+  tags: [["d", dTag]],
+  sig: "s",
+});
+
+test("the d tag names the community and the month", () => {
+  const here = teamCalendarDTag("wss://a.example.com/", "2026-10");
+  assert.equal(here, teamCalendarDTag("WSS://A.example.com", "2026-10"));
+  assert.notEqual(here, teamCalendarDTag("wss://b.example.com", "2026-10"));
+  assert.notEqual(here, teamCalendarDTag("wss://a.example.com", "2026-11"));
+});
+
+test("month arithmetic crosses year boundaries", () => {
+  assert.equal(shiftMonth("2026-12", 1), "2027-01");
+  assert.equal(shiftMonth("2026-01", -1), "2025-12");
+  assert.equal(shiftMonth("2026-10", 0), "2026-10");
+});
+
+test("the month grid is six full weeks starting on Sunday", () => {
+  const grid = monthGrid("2026-10");
+  assert.equal(grid.length, 42);
+  // 2026-10-01 is a Thursday, so the grid starts on Sunday 2026-09-27.
+  assert.deepEqual(grid[0], { date: "2026-09-27", day: 27, inMonth: false });
+  assert.deepEqual(grid[4], { date: "2026-10-01", day: 1, inMonth: true });
+  assert.equal(grid.filter((cell) => cell.inMonth).length, 31);
+  assert.equal(grid[41].date, "2026-11-07");
+});
+
+test("a document round-trips and malformed entries are dropped", () => {
+  const month = monthOf(
+    entry("a", { time: "09:30", note: "Bring slides" }),
+    entry("b", { deleted: true, title: "" }),
+  );
+  assert.deepEqual(decodeMonth(encodeMonth(month), "2026-10"), month);
+
+  const raw = JSON.stringify({
+    v: 1,
+    entries: {
+      ok: { title: " Trim me ", date: "2026-10-01", updatedAt: 5, updatedBy: BOB },
+      wrongMonth: { title: "x", date: "2026-11-01", updatedAt: 5, updatedBy: BOB },
+      badDate: { title: "x", date: "2026-10-32", updatedAt: 5, updatedBy: BOB },
+      noTitle: { title: "  ", date: "2026-10-01", updatedAt: 5, updatedBy: BOB },
+      badAuthor: { title: "x", date: "2026-10-01", updatedAt: 5, updatedBy: "me" },
+      badTime: { title: "x", date: "2026-10-01", time: "25:00", updatedAt: 5, updatedBy: BOB },
+    },
+  });
+  const decoded = decodeMonth(raw, "2026-10");
+  assert.deepEqual(Object.keys(decoded).sort(), ["badTime", "ok"]);
+  assert.equal(decoded.ok.title, "Trim me");
+  assert.equal(decoded.badTime.time, undefined);
+  assert.deepEqual(decodeMonth("not json", "2026-10"), {});
+  assert.deepEqual(decodeMonth("[]", "2026-10"), {});
+});
+
+test("the later edit of an entry wins, and a deletion beats an older copy", () => {
+  const mine = monthOf(entry("a", { title: "Old", updatedAt: 10 }));
+  const theirs = monthOf(
+    entry("a", { title: "New", updatedAt: 20, updatedBy: BOB }),
+    entry("b", { updatedAt: 5, updatedBy: BOB }),
+  );
+  const merged = mergeMonths(mine, theirs);
+  assert.equal(merged.a.title, "New");
+  assert.ok(merged.b);
+  assert.equal(mergeMonths(merged, mine), merged, "nothing newer: same object");
+
+  const deleted = monthOf(
+    entry("a", { deleted: true, updatedAt: 30, updatedBy: BOB }),
+  );
+  assert.equal(mergeMonths(merged, deleted).a.deleted, true);
+  assert.equal(mergeMonths(deleted, merged).a.deleted, true);
+  assert.deepEqual(entriesByDate(mergeMonths(merged, deleted))["2026-10-07"].map((e) => e.id), ["b"]);
+});
+
+test("entries are listed by date, timed before all-day", () => {
+  const month = monthOf(
+    entry("late", { time: "15:00" }),
+    entry("allday"),
+    entry("early", { time: "09:00" }),
+    entry("first", { date: "2026-10-01" }),
+  );
+  const grouped = entriesByDate(month);
+  assert.deepEqual(grouped["2026-10-07"].map((e) => e.id), ["early", "late", "allday"]);
+  assert.deepEqual(grouped["2026-10-01"].map((e) => e.id), ["first"]);
+});
+
+test("every member's newest event is merged and my own is tracked", () => {
+  const dTag = teamCalendarDTag("wss://a.example.com", "2026-10");
+  const other = teamCalendarDTag("wss://b.example.com", "2026-10");
+  const events = [
+    ev(ALICE, monthOf(entry("a", { title: "Stale", updatedAt: 1 })), 100, dTag),
+    ev(ALICE, monthOf(entry("a", { title: "Mine", updatedAt: 2 })), 200, dTag),
+    ev(BOB, monthOf(entry("b", { updatedBy: BOB })), 150, dTag),
+    ev(BOB, monthOf(entry("elsewhere", { updatedBy: BOB })), 999, other),
+  ];
+  const { merged, own, ownCreatedAt } = mergeMonthEvents(events, dTag, "2026-10", ALICE);
+  assert.deepEqual(Object.keys(merged).sort(), ["a", "b"]);
+  assert.equal(merged.a.title, "Mine");
+  assert.equal(ownCreatedAt, 200);
+  assert.deepEqual(Object.keys(own), ["a"]);
+  // What Alice still has to publish: Bob's entry is not in her own event.
+  assert.equal(hasNewerEntries(merged, own), true);
+  assert.equal(hasNewerEntries(own, merged), false);
+});
+
+test("an oversized month drops its oldest deletions before giving up", () => {
+  const note = "n".repeat(900);
+  const live = Array.from({ length: 30 }, (_, i) =>
+    entry(`live-${i}`, { note, updatedAt: 1_000 + i }),
+  );
+  const deletions = Array.from({ length: 60 }, (_, i) =>
+    entry(`gone-${String(i).padStart(2, "0")}`, {
+      deleted: true,
+      title: "t".repeat(120),
+      note,
+      updatedAt: i + 1,
+    }),
+  );
+  const content = encodeForPublish(monthOf(...live, ...deletions));
+  assert.ok(content);
+  assert.ok(new TextEncoder().encode(content).length <= MAX_TEAM_CALENDAR_CONTENT_BYTES);
+  const kept = decodeMonth(content, "2026-10");
+  assert.equal(Object.values(kept).filter((e) => !e.deleted).length, 30);
+  assert.ok(!kept["gone-00"], "oldest deletion dropped first");
+  assert.ok(kept["gone-59"], "newest deletion kept");
+
+  const tooMany = Array.from({ length: 80 }, (_, i) => entry(`x-${i}`, { note }));
+  assert.equal(encodeForPublish(monthOf(...tooMany)), null);
+});
diff --git a/desktop/src/features/team-calendar/lib/teamCalendar.ts b/desktop/src/features/team-calendar/lib/teamCalendar.ts
new file mode 100644
index 0000000..a31e84d
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/teamCalendar.ts
@@ -0,0 +1,299 @@
+import type { RelayEvent } from "@/shared/api/types";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+
+/**
+ * Team calendar (team patch): one calendar every member of a community sees
+ * and any member can edit.
+ *
+ * Same sharing model as team sections: nobody can overwrite another member's
+ * event, so each member publishes their merged copy of a month as a plaintext
+ * kind 30078 event at their own `(pubkey, d)` coordinate, and readers merge
+ * every member's copy. An entry is last-writer-wins as a whole (`updatedAt`,
+ * then `updatedBy`); a deletion is an entry with `deleted: true` so it also
+ * wins over older copies.
+ *
+ * The `d` tag names the community (relay URL) and the month, so a calendar
+ * never shows up in another community on a shared host and one busy month
+ * cannot push the whole calendar over the relay's event size limit.
+ */
+export const TEAM_CALENDAR_D_TAG = "team-calendar";
+
+/** Most member events merged per read. */
+export const MAX_TEAM_CALENDAR_AUTHORS = 200;
+/** Relay event size ceiling, with headroom for the envelope. */
+export const MAX_TEAM_CALENDAR_CONTENT_BYTES = 60_000;
+
+export const MAX_TITLE_LENGTH = 120;
+export const MAX_NOTE_LENGTH = 1_000;
+
+export type CalendarEntry = {
+  id: string;
+  title: string;
+  /** Local calendar date, `YYYY-MM-DD`. */
+  date: string;
+  /** Optional local start time, `HH:MM` (24h). */
+  time?: string;
+  note?: string;
+  /** Milliseconds since epoch of the last edit. */
+  updatedAt: number;
+  /** Pubkey of the member who made the last edit. */
+  updatedBy: string;
+  deleted?: true;
+};
+
+/** Every entry of one month by id, deletions included. */
+export type CalendarMonth = Record<string, CalendarEntry>;
+
+const DATE_PATTERN = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const TIME_PATTERN = /^([01]\d|2[0-3]):[0-5]\d$/;
+const MONTH_PATTERN = /^\d{4}-(0[1-9]|1[0-2])$/;
+
+const pad = (value: number) => String(value).padStart(2, "0");
+
+/** `YYYY-MM` for a year and a 1-based month. */
+export const monthKey = (year: number, month: number) =>
+  `${year}-${pad(month)}`;
+
+/** `YYYY-MM-DD` for a year, a 1-based month and a day. */
+export const dateKey = (year: number, month: number, day: number) =>
+  `${year}-${pad(month)}-${pad(day)}`;
+
+/** The month (`YYYY-MM`) a `YYYY-MM-DD` date falls in. */
+export const monthOfDate = (date: string) => date.slice(0, 7);
+
+/** Local today as `YYYY-MM-DD`. */
+export function todayKey(now: Date = new Date()): string {
+  return dateKey(now.getFullYear(), now.getMonth() + 1, now.getDate());
+}
+
+/** The month before (`step = -1`) or after (`step = 1`) a `YYYY-MM` key. */
+export function shiftMonth(month: string, step: number): string {
+  const [year, value] = month.split("-").map(Number) as [number, number];
+  const index = year * 12 + (value - 1) + step;
+  return monthKey(Math.floor(index / 12), (index % 12) + 1);
+}
+
+/**
+ * The 42 day cells (6 weeks, Sunday first) of a month grid. Days outside the
+ * month are included so every row is full.
+ */
+export function monthGrid(
+  month: string,
+): Array<{ date: string; day: number; inMonth: boolean }> {
+  const [year, value] = month.split("-").map(Number) as [number, number];
+  const first = new Date(year, value - 1, 1);
+  const cells: Array<{ date: string; day: number; inMonth: boolean }> = [];
+  for (let offset = 0; offset < 42; offset++) {
+    const cell = new Date(year, value - 1, 1 - first.getDay() + offset);
+    cells.push({
+      date: dateKey(cell.getFullYear(), cell.getMonth() + 1, cell.getDate()),
+      day: cell.getDate(),
+      inMonth: cell.getMonth() === value - 1,
+    });
+  }
+  return cells;
+}
+
+/** The `d` tag of one community's calendar for one month. */
+export function teamCalendarDTag(relayUrl: string, month: string): string {
+  return `${TEAM_CALENDAR_D_TAG}:${normalizeRelayUrl(relayUrl)}:${month}`;
+}
+
+const isPubkey = (value: unknown): value is string =>
+  typeof value === "string" && /^[0-9a-f]{64}$/.test(value);
+
+/** A stored entry if it is well-formed and belongs to `month`, else `null`. */
+function readEntry(
+  id: string,
+  raw: unknown,
+  month: string,
+): CalendarEntry | null {
+  if (!raw || typeof raw !== "object") return null;
+  const value = raw as Record<string, unknown>;
+  if (id.length === 0 || id.length > 64) return null;
+  if (typeof value.date !== "string" || !DATE_PATTERN.test(value.date))
+    return null;
+  if (monthOfDate(value.date) !== month) return null;
+  if (
+    typeof value.updatedAt !== "number" ||
+    !Number.isFinite(value.updatedAt) ||
+    value.updatedAt <= 0
+  )
+    return null;
+  if (!isPubkey(value.updatedBy)) return null;
+  const title =
+    typeof value.title === "string"
+      ? value.title.trim().slice(0, MAX_TITLE_LENGTH)
+      : "";
+  const deleted = value.deleted === true;
+  if (!deleted && title.length === 0) return null;
+  const entry: CalendarEntry = {
+    id,
+    title,
+    date: value.date,
+    updatedAt: value.updatedAt,
+    updatedBy: value.updatedBy,
+  };
+  if (typeof value.time === "string" && TIME_PATTERN.test(value.time))
+    entry.time = value.time;
+  if (typeof value.note === "string" && value.note.trim().length > 0)
+    entry.note = value.note.trim().slice(0, MAX_NOTE_LENGTH);
+  if (deleted) entry.deleted = true;
+  return entry;
+}
+
+/** Parses one member's month document. Malformed entries are skipped. */
+export function decodeMonth(content: string, month: string): CalendarMonth {
+  if (!MONTH_PATTERN.test(month)) return {};
+  let json: unknown = null;
+  try {
+    json = JSON.parse(content);
+  } catch {
+    return {};
+  }
+  if (!json || typeof json !== "object") return {};
+  const entries = (json as { entries?: unknown }).entries;
+  if (!entries || typeof entries !== "object") return {};
+  const result: CalendarMonth = {};
+  for (const [id, raw] of Object.entries(entries as Record<string, unknown>)) {
+    const entry = readEntry(id, raw, month);
+    if (entry) result[id] = entry;
+  }
+  return result;
+}
+
+export function encodeMonth(month: CalendarMonth): string {
+  const entries: Record<string, Omit<CalendarEntry, "id">> = {};
+  for (const id of Object.keys(month).sort()) {
+    const { id: _id, ...rest } = month[id] as CalendarEntry;
+    entries[id] = rest;
+  }
+  return JSON.stringify({ v: 1, entries });
+}
+
+/** True when `candidate` replaces `current` (later edit, then higher pubkey). */
+function wins(candidate: CalendarEntry, current: CalendarEntry): boolean {
+  if (candidate.updatedAt !== current.updatedAt)
+    return candidate.updatedAt > current.updatedAt;
+  if (candidate.updatedBy !== current.updatedBy)
+    return candidate.updatedBy > current.updatedBy;
+  return candidate.deleted === true && current.deleted !== true;
+}
+
+/** Merges month copies entry by entry. Returns `base` when nothing changed. */
+export function mergeMonths(
+  base: CalendarMonth,
+  ...others: CalendarMonth[]
+): CalendarMonth {
+  let result = base;
+  for (const other of others) {
+    for (const [id, entry] of Object.entries(other)) {
+      const current = result[id];
+      if (current && !wins(entry, current)) continue;
+      if (result === base) result = { ...base };
+      result[id] = entry;
+    }
+  }
+  return result;
+}
+
+/** True when `local` holds an entry (or a newer edit) that `remote` lacks. */
+export function hasNewerEntries(
+  local: CalendarMonth,
+  remote: CalendarMonth,
+): boolean {
+  return Object.values(local).some((entry) => {
+    const current = remote[entry.id];
+    return !current || wins(entry, current);
+  });
+}
+
+/** Live entries, ordered by date, then timed before all-day by time, then title. */
+export function liveEntries(month: CalendarMonth): CalendarEntry[] {
+  return Object.values(month)
+    .filter((entry) => !entry.deleted)
+    .sort(
+      (a, b) =>
+        a.date.localeCompare(b.date) ||
+        (a.time ?? "99:99").localeCompare(b.time ?? "99:99") ||
+        a.title.localeCompare(b.title) ||
+        a.id.localeCompare(b.id),
+    );
+}
+
+/** Live entries of one month grouped by `YYYY-MM-DD`. */
+export function entriesByDate(
+  month: CalendarMonth,
+): Record<string, CalendarEntry[]> {
+  const grouped: Record<string, CalendarEntry[]> = {};
+  for (const entry of liveEntries(month)) {
+    const list = grouped[entry.date];
+    if (list) list.push(entry);
+    else grouped[entry.date] = [entry];
+  }
+  return grouped;
+}
+
+const byteLength = (text: string) => new TextEncoder().encode(text).length;
+
+/**
+ * The document to publish for a month, or `null` when it cannot fit the
+ * relay's size limit. Deletions are kept (they are what stops an older copy
+ * from bringing an entry back); only when the month is over the limit are the
+ * oldest deletions dropped to make room.
+ */
+export function encodeForPublish(month: CalendarMonth): string | null {
+  let content = encodeMonth(month);
+  if (byteLength(content) <= MAX_TEAM_CALENDAR_CONTENT_BYTES) return content;
+  const trimmed: CalendarMonth = { ...month };
+  const deletions = Object.values(month)
+    .filter((entry) => entry.deleted)
+    .sort((a, b) => a.updatedAt - b.updatedAt);
+  for (const entry of deletions) {
+    delete trimmed[entry.id];
+    content = encodeMonth(trimmed);
+    if (byteLength(content) <= MAX_TEAM_CALENDAR_CONTENT_BYTES) return content;
+  }
+  return null;
+}
+
+/**
+ * Every member's newest event for one month merged into one copy, plus the
+ * `created_at` of `pubkey`'s own event (0 when they have none) so the next
+ * publish can replace it.
+ */
+export function mergeMonthEvents(
+  events: RelayEvent[],
+  dTag: string,
+  month: string,
+  pubkey: string,
+): { merged: CalendarMonth; ownCreatedAt: number; own: CalendarMonth } {
+  const newest = new Map<string, RelayEvent>();
+  for (const event of events) {
+    const d = event.tags.filter((tag) => tag[0] === "d");
+    if (d.length !== 1 || d[0]?.[1] !== dTag) continue;
+    const current = newest.get(event.pubkey);
+    // The relay's replaceable winner: later `created_at`, then lower id.
+    if (
+      current &&
+      !(
+        event.created_at > current.created_at ||
+        (event.created_at === current.created_at && event.id < current.id)
+      )
+    )
+      continue;
+    newest.set(event.pubkey, event);
+  }
+  let merged: CalendarMonth = {};
+  let own: CalendarMonth = {};
+  let ownCreatedAt = 0;
+  for (const event of newest.values()) {
+    const copy = decodeMonth(event.content, month);
+    merged = mergeMonths(merged, copy);
+    if (event.pubkey === pubkey) {
+      own = copy;
+      ownCreatedAt = event.created_at;
+    }
+  }
+  return { merged, ownCreatedAt, own };
+}

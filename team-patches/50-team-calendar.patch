+                        </div>
+                      ) : null}
+                      <p className="mt-1 break-words text-xs text-muted-foreground">
+                        {attendeeLabel(entry)}
+                      </p>
+                      {entry.note ? (
+                        <p className="mt-1 whitespace-pre-wrap break-words text-xs text-muted-foreground">
+                          {entry.note}
+                        </p>
+                      ) : null}
+                      {mine ? (
+                        <div className="mt-1 text-xs text-muted-foreground">
+                          <button
+                            className="underline-offset-2 hover:underline focus-visible:underline focus-visible:outline-hidden"
+                            data-testid="team-calendar-reminders-toggle"
+                            onClick={() =>
+                              setRemindersFor(remindersFor === key ? null : key)
+                            }
+                            type="button"
+                          >
+                            내 알림:{" "}
+                            {offsets.length === 0
+                              ? "없음"
+                              : offsets.map(reminderLabel).join(", ")}
+                          </button>
+                          {remindersFor === key ? (
+                            <div className="mt-1 flex flex-wrap gap-1">
+                              {REMINDER_CHOICES.map((choice) => {
+                                const on = offsets.includes(choice);
+                                return (
+                                  <Button
+                                    aria-pressed={on}
+                                    key={choice}
+                                    onClick={() =>
+                                      setEntryOffsets(
+                                        entry.id,
+                                        on
+                                          ? offsets.filter(
+                                              (offset) => offset !== choice,
+                                            )
+                                          : [...offsets, choice],
+                                      )
+                                    }
+                                    size="xs"
+                                    type="button"
+                                    variant={on ? "secondary" : "outline"}
+                                  >
+                                    {reminderLabel(choice)}
+                                  </Button>
+                                );
+                              })}
+                              <Button
+                                onClick={() => setEntryOffsets(entry.id, null)}
+                                size="xs"
+                                type="button"
+                                variant="ghost"
+                              >
+                                기본값으로
+                              </Button>
+                            </div>
+                          ) : null}
+                        </div>
+                      ) : null}
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+          </section>
+        </div>
+        )}
+      </DialogContent>
+    </Dialog>
+  );
+}

+  assert.deepEqual(decodePollDoc(encodePollDoc({ polls: { p1: poll }, answers: {} }, "2026-12-25")).polls, {});
+});
+
+test("answers are counted per author and the best days are found", () => {
+  const poll = {
+    id: "p1",
+    title: "모임",
+    startDate: "2026-10-12",
+    endDate: "2026-10-14",
+    createdBy: A,
+    updatedAt: 5,

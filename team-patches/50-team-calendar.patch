diff --git a/desktop/src/features/team-calendar/lib/teamCalendar.test.mjs b/desktop/src/features/team-calendar/lib/teamCalendar.test.mjs
new file mode 100644
index 000000000..82fb933fd
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/teamCalendar.test.mjs
@@ -0,0 +1,415 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  MAX_SPAN_DAYS,
+  MAX_TEAM_CALENDAR_CONTENT_BYTES,
+  addDays,
+  combineMonths,
+  daysBetween,
+  decodeMonth,
+  encodeForPublish,
+  encodeMonth,
+  entriesByDate,
+  entriesOnDate,
+  hasNewerEntries,
+  mergeMonthEvents,
+  mergeMonths,
+  monthGrid,
+  monthsAround,
+  shiftMonth,
+  teamCalendarDTag,
+  validateRange,
+  weekSegments,
+} from "./teamCalendar.ts";
+
+const ALICE = "a".repeat(64);
+const BOB = "b".repeat(64);
+
+const entry = (id, overrides = {}) => ({
+  id,
+  title: `Entry ${id}`,
+  date: "2026-10-07",
+  updatedAt: 1_000,
+  updatedBy: ALICE,
+  ...overrides,
+});
+
+const monthOf = (...entries) =>
+  Object.fromEntries(entries.map((value) => [value.id, value]));
+
+let seq = 0;
+const ev = (pubkey, month, createdAt, dTag) => ({
+  id: `id-${String(++seq).padStart(6, "0")}`,
+  pubkey,
+  kind: 30078,
+  content: encodeMonth(month),
+  created_at: createdAt,
+  tags: [["d", dTag]],
+  sig: "s",
+});
+
+test("the d tag names the community and the month", () => {
+  const here = teamCalendarDTag("wss://a.example.com/", "2026-10");
+  assert.equal(here, teamCalendarDTag("WSS://A.example.com", "2026-10"));
+  assert.notEqual(here, teamCalendarDTag("wss://b.example.com", "2026-10"));
+  assert.notEqual(here, teamCalendarDTag("wss://a.example.com", "2026-11"));
+});
+
+test("month arithmetic crosses year boundaries", () => {
+  assert.equal(shiftMonth("2026-12", 1), "2027-01");
+  assert.equal(shiftMonth("2026-01", -1), "2025-12");
+  assert.equal(shiftMonth("2026-10", 0), "2026-10");
+});
+
+test("the month grid is six full weeks starting on Sunday", () => {
+  const grid = monthGrid("2026-10");
+  assert.equal(grid.length, 42);
+  // 2026-10-01 is a Thursday, so the grid starts on Sunday 2026-09-27.
+  assert.deepEqual(grid[0], { date: "2026-09-27", day: 27, inMonth: false });
+  assert.deepEqual(grid[4], { date: "2026-10-01", day: 1, inMonth: true });
+  assert.equal(grid.filter((cell) => cell.inMonth).length, 31);
+  assert.equal(grid[41].date, "2026-11-07");
+});
+
+test("a document round-trips and malformed entries are dropped", () => {
+  const month = monthOf(
+    entry("a", { time: "09:30", note: "Bring slides" }),
+    entry("b", { deleted: true, title: "" }),
+  );
+  assert.deepEqual(decodeMonth(encodeMonth(month), "2026-10"), month);
+
+  const raw = JSON.stringify({
+    v: 1,
+    entries: {
+      ok: {
+        title: " Trim me ",
+        date: "2026-10-01",
+        updatedAt: 5,
+        updatedBy: BOB,
+      },
+      wrongMonth: {
+        title: "x",
+        date: "2026-11-01",
+        updatedAt: 5,
+        updatedBy: BOB,
+      },
+      badDate: { title: "x", date: "2026-10-32", updatedAt: 5, updatedBy: BOB },
+      noTitle: {
+        title: "  ",
+        date: "2026-10-01",
+        updatedAt: 5,
+        updatedBy: BOB,
+      },
+      badAuthor: {
+        title: "x",
+        date: "2026-10-01",
+        updatedAt: 5,
+        updatedBy: "me",
+      },
+      badTime: {
+        title: "x",
+        date: "2026-10-01",
+        time: "25:00",
+        updatedAt: 5,
+        updatedBy: BOB,
+      },
+    },
+  });
+  const decoded = decodeMonth(raw, "2026-10");
+  assert.deepEqual(Object.keys(decoded).sort(), ["badTime", "ok"]);
+  assert.equal(decoded.ok.title, "Trim me");
+  assert.equal(decoded.badTime.time, undefined);
+  assert.deepEqual(decodeMonth("not json", "2026-10"), {});
+  assert.deepEqual(decodeMonth("[]", "2026-10"), {});
+});
+
+test("the later edit of an entry wins, and a deletion beats an older copy", () => {
+  const mine = monthOf(entry("a", { title: "Old", updatedAt: 10 }));
+  const theirs = monthOf(
+    entry("a", { title: "New", updatedAt: 20, updatedBy: BOB }),
+    entry("b", { updatedAt: 5, updatedBy: BOB }),
+  );
+  const merged = mergeMonths(mine, theirs);
+  assert.equal(merged.a.title, "New");
+  assert.ok(merged.b);
+  assert.equal(mergeMonths(merged, mine), merged, "nothing newer: same object");
+
+  const deleted = monthOf(
+    entry("a", { deleted: true, updatedAt: 30, updatedBy: BOB }),
+  );
+  assert.equal(mergeMonths(merged, deleted).a.deleted, true);
+  assert.equal(mergeMonths(deleted, merged).a.deleted, true);
+  assert.deepEqual(
+    entriesByDate(mergeMonths(merged, deleted))["2026-10-07"].map((e) => e.id),
+    ["b"],
+  );
+});
+
+test("entries are listed by date, timed before all-day", () => {
+  const month = monthOf(
+    entry("late", { time: "15:00" }),
+    entry("allday"),
+    entry("early", { time: "09:00" }),
+    entry("first", { date: "2026-10-01" }),
+  );
+  const grouped = entriesByDate(month);
+  assert.deepEqual(
+    grouped["2026-10-07"].map((e) => e.id),
+    ["early", "late", "allday"],
+  );
+  assert.deepEqual(
+    grouped["2026-10-01"].map((e) => e.id),
+    ["first"],
+  );
+});
+
+test("every member's newest event is merged and my own is tracked", () => {
+  const dTag = teamCalendarDTag("wss://a.example.com", "2026-10");
+  const other = teamCalendarDTag("wss://b.example.com", "2026-10");
+  const events = [
+    ev(ALICE, monthOf(entry("a", { title: "Stale", updatedAt: 1 })), 100, dTag),
+    ev(ALICE, monthOf(entry("a", { title: "Mine", updatedAt: 2 })), 200, dTag),
+    ev(BOB, monthOf(entry("b", { updatedBy: BOB })), 150, dTag),
+    ev(BOB, monthOf(entry("elsewhere", { updatedBy: BOB })), 999, other),
+  ];
+  const { merged, own, ownCreatedAt } = mergeMonthEvents(
+    events,
+    dTag,
+    "2026-10",
+    ALICE,
+  );
+  assert.deepEqual(Object.keys(merged).sort(), ["a", "b"]);
+  assert.equal(merged.a.title, "Mine");
+  assert.equal(ownCreatedAt, 200);
+  assert.deepEqual(Object.keys(own), ["a"]);
+  // What Alice still has to publish: Bob's entry is not in her own event.
+  assert.equal(hasNewerEntries(merged, own), true);
+  assert.equal(hasNewerEntries(own, merged), false);
+});
+
+test("an oversized month drops its oldest deletions before giving up", () => {
+  const note = "n".repeat(900);
+  const live = Array.from({ length: 30 }, (_, i) =>
+    entry(`live-${i}`, { note, updatedAt: 1_000 + i }),
+  );
+  const deletions = Array.from({ length: 60 }, (_, i) =>
+    entry(`gone-${String(i).padStart(2, "0")}`, {
+      deleted: true,
+      title: "t".repeat(120),
+      note,
+      updatedAt: i + 1,
+    }),
+  );
+  const content = encodeForPublish(monthOf(...live, ...deletions));
+  assert.ok(content);
+  assert.ok(
+    new TextEncoder().encode(content).length <= MAX_TEAM_CALENDAR_CONTENT_BYTES,
+  );
+  const kept = decodeMonth(content, "2026-10");
+  assert.equal(Object.values(kept).filter((e) => !e.deleted).length, 30);
+  assert.ok(!kept["gone-00"], "oldest deletion dropped first");
+  assert.ok(kept["gone-59"], "newest deletion kept");
+
+  const tooMany = Array.from({ length: 80 }, (_, i) =>
+    entry(`x-${i}`, { note }),
+  );
+  assert.equal(encodeForPublish(monthOf(...tooMany)), null);
+});
+
+const WEEK = [
+  "2026-10-04",
+  "2026-10-05",
+  "2026-10-06",
+  "2026-10-07",
+  "2026-10-08",
+  "2026-10-09",
+  "2026-10-10",
+];
+
+test("day arithmetic crosses month, year and daylight-saving changes", () => {
+  assert.equal(addDays("2026-10-30", 3), "2026-11-02");
+  assert.equal(addDays("2026-12-31", 1), "2027-01-01");
+  assert.equal(addDays("2026-03-01", -1), "2026-02-28");
+  assert.equal(daysBetween("2026-03-28", "2026-03-30"), 2);
+  assert.equal(daysBetween("2026-10-31", "2026-11-02"), 2);
+  assert.equal(daysBetween("2026-10-05", "2026-10-04"), -1);
+  assert.deepEqual(monthsAround("2026-01"), ["2025-12", "2026-01", "2026-02"]);
+});
+
+test("range, end time and color survive a round trip", () => {
+  const trip = entry("t", {
+    time: "14:00",
+    endDate: "2026-10-09",
+    endTime: "11:30",
+    color: "green",
+  });
+  const back = decodeMonth(encodeMonth(monthOf(trip)), "2026-10").t;
+  assert.equal(back.endDate, "2026-10-09");
+  assert.equal(back.endTime, "11:30");
+  assert.equal(back.color, "green");
+});
+
+test("an entry without a range or color reads as before", () => {
+  const plain = decodeMonth(encodeMonth(monthOf(entry("p"))), "2026-10").p;
+  assert.equal(plain.endDate, undefined);
+  assert.equal(plain.endTime, undefined);
+  assert.equal(plain.color, undefined);
+});
+
+test("a bad range is dropped but the entry stays on its start day", () => {
+  const bad = (overrides) =>
+    decodeMonth(encodeMonth(monthOf(entry("b", overrides))), "2026-10").b;
+  // Ends before it starts, is not a date, is too long, or is the same day.
+  for (const endDate of ["2026-10-06", "nope", "2026-12-25", "2026-10-07"]) {
+    const read = bad({ endDate });
+    assert.ok(read, endDate);
+    assert.equal(read.endDate, undefined, endDate);
+  }
+  assert.equal(
+    bad({ endDate: addDays("2026-10-07", MAX_SPAN_DAYS - 1) }).endDate,
+    "2026-11-03",
+  );
+  assert.equal(
+    bad({ endDate: addDays("2026-10-07", MAX_SPAN_DAYS) }).endDate,
+    undefined,
+  );
+  // An end time needs a start time; an unknown color is ignored.
+  assert.equal(bad({ endTime: "10:00" }).endTime, undefined);
+  assert.equal(bad({ color: "chartreuse" }).color, undefined);
+});
+
+test("the copy that kept the range wins over a stripped copy of the same edit", () => {
+  const full = entry("r", { endDate: "2026-10-09", color: "red" });
+  const stripped = entry("r");
+  assert.equal(
+    mergeMonths(monthOf(stripped), monthOf(full)).r.endDate,
+    "2026-10-09",
+  );
+  assert.equal(
+    mergeMonths(monthOf(full), monthOf(stripped)).r.endDate,
+    "2026-10-09",
+  );
+  // A real later edit still wins even without the range.
+  const later = entry("r", { updatedAt: 2_000 });
+  assert.equal(mergeMonths(monthOf(full), monthOf(later)).r.endDate, undefined);
+  assert.equal(hasNewerEntries(monthOf(full), monthOf(stripped)), true);
+});
+
+test("a moved entry is not hidden by the deletion left in its old month", () => {
+  const moved = entry("m", { date: "2026-11-02", updatedAt: 1_000 });
+  const left = {
+    id: "m",
+    title: "",
+    date: "2026-10-30",
+    updatedAt: 2_000,
+    updatedBy: ALICE,
+    deleted: true,
+  };
+  const listed = combineMonths([monthOf(left), monthOf(moved)]);
+  assert.deepEqual(
+    listed.map((value) => value.date),
+    ["2026-11-02"],
+  );
+  // An interrupted move leaves two live copies: the newer one is kept.
+  const older = entry("d", { date: "2026-10-30", updatedAt: 1_000 });
+  const newer = entry("d", { date: "2026-11-02", updatedAt: 2_000 });
+  assert.deepEqual(
+    combineMonths([monthOf(older), monthOf(newer)]).map((value) => value.date),
+    ["2026-11-02"],
+  );
+});
+
+test("an entry covers every day from its start to its end", () => {
+  const trip = entry("t", { date: "2026-10-05", endDate: "2026-10-07" });
+  const one = entry("o", { date: "2026-10-06" });
+  const all = [trip, one];
+  assert.deepEqual(
+    entriesOnDate(all, "2026-10-04").map((v) => v.id),
+    [],
+  );
+  assert.deepEqual(
+    entriesOnDate(all, "2026-10-05").map((v) => v.id),
+    ["t"],
+  );
+  assert.deepEqual(
+    entriesOnDate(all, "2026-10-06").map((v) => v.id),
+    ["t", "o"],
+  );
+  assert.deepEqual(
+    entriesOnDate(all, "2026-10-07").map((v) => v.id),
+    ["t"],
+  );
+  assert.deepEqual(
+    entriesOnDate(all, "2026-10-08").map((v) => v.id),
+    [],
+  );
+});
+
+test("week bars start in the right column and are cut at the week edges", () => {
+  const trip = entry("t", { date: "2026-10-01", endDate: "2026-10-06" });
+  const next = entry("n", { date: "2026-10-09", endDate: "2026-10-14" });
+  const out = entry("x", { date: "2026-10-20" });
+  const bars = weekSegments([trip, next, out], WEEK);
+  assert.equal(bars.length, 2);
+  const [a, b] = bars;
+  assert.deepEqual(
+    [a.entry.id, a.startColumn, a.span, a.continuesBefore, a.continuesAfter],
+    ["t", 0, 3, true, false],
+  );
+  assert.deepEqual(
+    [b.entry.id, b.startColumn, b.span, b.continuesBefore, b.continuesAfter],
+    ["n", 5, 2, false, true],
+  );
+});
+
+test("overlapping bars take different lanes and a free lane is reused", () => {
+  const long = entry("a", { date: "2026-10-04", endDate: "2026-10-08" });
+  const mid = entry("b", { date: "2026-10-05", endDate: "2026-10-06" });
+  const late = entry("c", { date: "2026-10-09" });
+  const lane = Object.fromEntries(
+    weekSegments([mid, late, long], WEEK).map((bar) => [
+      bar.entry.id,
+      bar.lane,
+    ]),
+  );
+  // The longer entry sits on top; the later one slides into the free lane 0.
+  assert.deepEqual(lane, { a: 0, b: 1, c: 0 });
+});
+
+test("the range is checked before it is saved", () => {
+  assert.equal(validateRange({ date: "2026-10-07" }), null);
+  assert.equal(
+    validateRange({ date: "2026-10-07", endDate: "2026-10-09" }),
+    null,
+  );
+  assert.equal(
+    validateRange({
+      date: "2026-10-07",
+      time: "09:00",
+      endDate: "2026-10-09",
+      endTime: "08:00",
+    }),
+    null,
+  );
+  assert.match(
+    validateRange({ date: "2026-10-07", endDate: "2026-10-06" }),
+    /빠를 수 없/,
+  );
+  assert.match(
+    validateRange({ date: "2026-10-07", time: "09:00", endTime: "09:00" }),
+    /늦어야/,
+  );
+  assert.match(
+    validateRange({ date: "2026-10-07", endTime: "09:00" }),
+    /시작 시간/,
+  );
+  assert.match(
+    validateRange({ date: "2026-10-07", endDate: "2026-12-01" }),
+    /최대 28일/,
+  );
+  assert.equal(
+    validateRange({ date: "2026-10-07", endDate: "2026-11-03" }),
+    null,
+  );
+});
diff --git a/desktop/src/features/team-calendar/lib/teamCalendar.ts b/desktop/src/features/team-calendar/lib/teamCalendar.ts
new file mode 100644
index 000000000..9c32bbe2c
--- /dev/null
+++ b/desktop/src/features/team-calendar/lib/teamCalendar.ts
@@ -0,0 +1,501 @@
+import type { RelayEvent } from "@/shared/api/types";
+import { normalizeRelayUrl } from "@/shared/lib/normalizeRelayUrl";
+
+/**
+ * Team calendar (team patch): one calendar every member of a community sees
+ * and any member can edit.
+ *
+ * Same sharing model as team sections: nobody can overwrite another member's
+ * event, so each member publishes their merged copy of a month as a plaintext
+ * kind 30078 event at their own `(pubkey, d)` coordinate, and readers merge
+ * every member's copy. An entry is last-writer-wins as a whole (`updatedAt`,
+ * then `updatedBy`); a deletion is an entry with `deleted: true` so it also
+ * wins over older copies.
+ *
+ * The `d` tag names the community (relay URL) and the month, so a calendar
+ * never shows up in another community on a shared host and one busy month
+ * cannot push the whole calendar over the relay's event size limit.
+ */
+export const TEAM_CALENDAR_D_TAG = "team-calendar";
+
+/** Most member events merged per read. */
+export const MAX_TEAM_CALENDAR_AUTHORS = 200;
+/** Relay event size ceiling, with headroom for the envelope. */
+export const MAX_TEAM_CALENDAR_CONTENT_BYTES = 60_000;
+
+export const MAX_TITLE_LENGTH = 120;
+export const MAX_NOTE_LENGTH = 1_000;
+
+/**
+ * Longest entry, in days. An entry is stored in the month it starts in and the
+ * calendar reads the month before and after the visible one, so a span this
+ * short can never start outside what is read (a 28-day span that starts in
+ * month M-2 ends before month M begins).
+ */
+export const MAX_SPAN_DAYS = 28;
+
+/** Bar colors an entry can have. No color is the default look. */
+export const CALENDAR_COLORS = [
+  "red",
+  "orange",
+  "green",
+  "blue",
+  "purple",
+  "pink",
+  "gray",
+] as const;
+export type CalendarColor = (typeof CALENDAR_COLORS)[number];
+
+const isCalendarColor = (value: unknown): value is CalendarColor =>
+  typeof value === "string" &&
+  (CALENDAR_COLORS as readonly string[]).includes(value);
+
+export type CalendarEntry = {
+  id: string;
+  title: string;
+  /** Local start date, `YYYY-MM-DD`. */
+  date: string;
+  /** Optional local start time, `HH:MM` (24h). */
+  time?: string;
+  /** Last day of a multi-day entry, `YYYY-MM-DD`; absent for a one-day entry. */
+  endDate?: string;
+  /** Optional local end time on the last day, `HH:MM`; needs `time`. */
+  endTime?: string;
+  color?: CalendarColor;
+  note?: string;
+  /** Milliseconds since epoch of the last edit. */
+  updatedAt: number;
+  /** Pubkey of the member who made the last edit. */
+  updatedBy: string;
+  deleted?: true;
+};
+
+/** Every entry of one month by id, deletions included. */
+export type CalendarMonth = Record<string, CalendarEntry>;
+
+const DATE_PATTERN = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const TIME_PATTERN = /^([01]\d|2[0-3]):[0-5]\d$/;
+const MONTH_PATTERN = /^\d{4}-(0[1-9]|1[0-2])$/;
+
+const pad = (value: number) => String(value).padStart(2, "0");
+
+/** `YYYY-MM` for a year and a 1-based month. */
+export const monthKey = (year: number, month: number) =>
+  `${year}-${pad(month)}`;
+
+/** `YYYY-MM-DD` for a year, a 1-based month and a day. */
+export const dateKey = (year: number, month: number, day: number) =>
+  `${year}-${pad(month)}-${pad(day)}`;
+
+/** The month (`YYYY-MM`) a `YYYY-MM-DD` date falls in. */
+export const monthOfDate = (date: string) => date.slice(0, 7);
+
+/** Local today as `YYYY-MM-DD`. */
+export function todayKey(now: Date = new Date()): string {
+  return dateKey(now.getFullYear(), now.getMonth() + 1, now.getDate());
+}
+
+const dayNumber = (date: string) => {
+  const [year, month, day] = date.split("-").map(Number) as [
+    number,
+    number,
+    number,
+  ];
+  // UTC so a daylight-saving change never makes a day 23 or 25 hours long.
+  return Math.round(Date.UTC(year, month - 1, day) / 86_400_000);
+};
+
+/** Whole days from `from` to `to` (negative when `to` is earlier). */
+export const daysBetween = (from: string, to: string) =>
+  dayNumber(to) - dayNumber(from);
+
+/** The date `count` days after (or, when negative, before) `date`. */
+export function addDays(date: string, count: number): string {
+  const [year, month, day] = date.split("-").map(Number) as [
+    number,
+    number,
+    number,
+  ];
+  const shifted = new Date(Date.UTC(year, month - 1, day + count));
+  return dateKey(
+    shifted.getUTCFullYear(),
+    shifted.getUTCMonth() + 1,
+    shifted.getUTCDate(),
+  );
+}
+
+/** The last day of an entry (its start day for a one-day entry). */
+export const entryEndDate = (entry: CalendarEntry) =>
+  entry.endDate ?? entry.date;
+
+/** The months a month view reads: the one before, the month itself, the next. */
+export const monthsAround = (month: string) =>
+  [shiftMonth(month, -1), month, shiftMonth(month, 1)] as const;
+
+/** The month before (`step = -1`) or after (`step = 1`) a `YYYY-MM` key. */
+export function shiftMonth(month: string, step: number): string {
+  const [year, value] = month.split("-").map(Number) as [number, number];
+  const index = year * 12 + (value - 1) + step;
+  return monthKey(Math.floor(index / 12), (index % 12) + 1);
+}
+
+/**
+ * The 42 day cells (6 weeks, Sunday first) of a month grid. Days outside the
+ * month are included so every row is full.
+ */
+export function monthGrid(
+  month: string,
+): Array<{ date: string; day: number; inMonth: boolean }> {
+  const [year, value] = month.split("-").map(Number) as [number, number];
+  const first = new Date(year, value - 1, 1);
+  const cells: Array<{ date: string; day: number; inMonth: boolean }> = [];
+  for (let offset = 0; offset < 42; offset++) {
+    const cell = new Date(year, value - 1, 1 - first.getDay() + offset);
+    cells.push({
+      date: dateKey(cell.getFullYear(), cell.getMonth() + 1, cell.getDate()),
+      day: cell.getDate(),
+      inMonth: cell.getMonth() === value - 1,
+    });
+  }
+  return cells;
+}
+
+/** The `d` tag of one community's calendar for one month. */
+export function teamCalendarDTag(relayUrl: string, month: string): string {
+  return `${TEAM_CALENDAR_D_TAG}:${normalizeRelayUrl(relayUrl)}:${month}`;
+}
+
+const isPubkey = (value: unknown): value is string =>
+  typeof value === "string" && /^[0-9a-f]{64}$/.test(value);
+
+/** A stored entry if it is well-formed and belongs to `month`, else `null`. */
+function readEntry(
+  id: string,
+  raw: unknown,
+  month: string,
+): CalendarEntry | null {
+  if (!raw || typeof raw !== "object") return null;
+  const value = raw as Record<string, unknown>;
+  if (id.length === 0 || id.length > 64) return null;
+  if (typeof value.date !== "string" || !DATE_PATTERN.test(value.date))
+    return null;
+  if (monthOfDate(value.date) !== month) return null;
+  if (
+    typeof value.updatedAt !== "number" ||
+    !Number.isFinite(value.updatedAt) ||
+    value.updatedAt <= 0
+  )
+    return null;
+  if (!isPubkey(value.updatedBy)) return null;
+  const title =
+    typeof value.title === "string"
+      ? value.title.trim().slice(0, MAX_TITLE_LENGTH)
+      : "";
+  const deleted = value.deleted === true;
+  if (!deleted && title.length === 0) return null;
+  const entry: CalendarEntry = {
+    id,
+    title,
+    date: value.date,
+    updatedAt: value.updatedAt,
+    updatedBy: value.updatedBy,
+  };
+  if (typeof value.time === "string" && TIME_PATTERN.test(value.time))
+    entry.time = value.time;
+  // A bad range is dropped, not the entry: it still shows on its start day.
+  if (
+    typeof value.endDate === "string" &&
+    DATE_PATTERN.test(value.endDate) &&
+    daysBetween(value.date, value.endDate) > 0 &&
+    daysBetween(value.date, value.endDate) < MAX_SPAN_DAYS
+  ) {
+    entry.endDate = value.endDate;
+  }
+  if (
+    entry.time &&
+    typeof value.endTime === "string" &&
+    TIME_PATTERN.test(value.endTime)
+  )
+    entry.endTime = value.endTime;
+  if (isCalendarColor(value.color)) entry.color = value.color;
+  if (typeof value.note === "string" && value.note.trim().length > 0)
+    entry.note = value.note.trim().slice(0, MAX_NOTE_LENGTH);
+  if (deleted) entry.deleted = true;
+  return entry;
+}
+
+/** Parses one member's month document. Malformed entries are skipped. */
+export function decodeMonth(content: string, month: string): CalendarMonth {
+  if (!MONTH_PATTERN.test(month)) return {};
+  let json: unknown = null;
+  try {
+    json = JSON.parse(content);
+  } catch {
+    return {};
+  }
+  if (!json || typeof json !== "object") return {};
+  const entries = (json as { entries?: unknown }).entries;
+  if (!entries || typeof entries !== "object") return {};
+  const result: CalendarMonth = {};
+  for (const [id, raw] of Object.entries(entries as Record<string, unknown>)) {
+    const entry = readEntry(id, raw, month);
+    if (entry) result[id] = entry;
+  }
+  return result;
+}
+
+export function encodeMonth(month: CalendarMonth): string {
+  const entries: Record<string, Omit<CalendarEntry, "id">> = {};
+  for (const id of Object.keys(month).sort()) {
+    const { id: _id, ...rest } = month[id] as CalendarEntry;
+    entries[id] = rest;
+  }
+  return JSON.stringify({ v: 1, entries });
+}
+
+/** How many of the range and color fields an entry carries. */
+const richness = (entry: CalendarEntry) =>
+  (entry.endDate ? 1 : 0) + (entry.endTime ? 1 : 0) + (entry.color ? 1 : 0);
+
+/**
+ * True when `candidate` replaces `current` (later edit, then higher pubkey).
+ * For the very same edit, the copy that kept the range and color wins: an app
+ * from before those fields existed republishes entries without them, and its
+ * copy must not hide the real one.
+ */
+function wins(candidate: CalendarEntry, current: CalendarEntry): boolean {
+  if (candidate.updatedAt !== current.updatedAt)
+    return candidate.updatedAt > current.updatedAt;
+  if (candidate.updatedBy !== current.updatedBy)
+    return candidate.updatedBy > current.updatedBy;
+  if (candidate.deleted !== current.deleted)
+    return candidate.deleted === true && current.deleted !== true;
+  return richness(candidate) > richness(current);
+}
+
+/** Merges month copies entry by entry. Returns `base` when nothing changed. */
+export function mergeMonths(
+  base: CalendarMonth,
+  ...others: CalendarMonth[]
+): CalendarMonth {
+  let result = base;
+  for (const other of others) {
+    for (const [id, entry] of Object.entries(other)) {
+      const current = result[id];
+      if (current && !wins(entry, current)) continue;
+      if (result === base) result = { ...base };
+      result[id] = entry;
+    }
+  }
+  return result;
+}
+
+/** True when `local` holds an entry (or a newer edit) that `remote` lacks. */
+export function hasNewerEntries(
+  local: CalendarMonth,
+  remote: CalendarMonth,
+): boolean {
+  return Object.values(local).some((entry) => {
+    const current = remote[entry.id];
+    return !current || wins(entry, current);
+  });
+}
+
+const byDisplayOrder = (a: CalendarEntry, b: CalendarEntry) =>
+  a.date.localeCompare(b.date) ||
+  (a.time ?? "99:99").localeCompare(b.time ?? "99:99") ||
+  a.title.localeCompare(b.title) ||
+  a.id.localeCompare(b.id);
+
+/** Live entries, ordered by date, then timed before all-day by time, then title. */
+export function liveEntries(month: CalendarMonth): CalendarEntry[] {
+  return Object.values(month)
+    .filter((entry) => !entry.deleted)
+    .sort(byDisplayOrder);
+}
+
+/**
+ * Live entries of several months as one list. An entry that was moved to
+ * another month leaves a deletion behind in the old one, so months are not
+ * merged by id (the deletion would hide the moved entry); deletions are just
+ * dropped, and if an interrupted move left a live copy in both months the
+ * newer one is kept.
+ */
+export function combineMonths(months: CalendarMonth[]): CalendarEntry[] {
+  const byId = new Map<string, CalendarEntry>();
+  for (const month of months) {
+    for (const entry of Object.values(month)) {
+      if (entry.deleted) continue;
+      const current = byId.get(entry.id);
+      if (!current || entry.updatedAt > current.updatedAt)
+        byId.set(entry.id, entry);
+    }
+  }
+  return [...byId.values()].sort(byDisplayOrder);
+}
+
+/** The entries that cover `date`, from the first day to the last. */
+export function entriesOnDate(
+  entries: CalendarEntry[],
+  date: string,
+): CalendarEntry[] {
+  return entries.filter(
+    (entry) => entry.date <= date && date <= entryEndDate(entry),
+  );
+}
+
+/** One entry's bar within one week row of the month grid. */
+export type WeekSegment = {
+  entry: CalendarEntry;
+  /** Column of the first day shown in this week, 0 (Sunday) to 6. */
+  startColumn: number;
+  /** Days shown in this week. */
+  span: number;
+  /** The entry started in an earlier week. */
+  continuesBefore: boolean;
+  /** The entry goes on into a later week. */
+  continuesAfter: boolean;
+  /** Row of the bar under the day numbers, 0 first. */
+  lane: number;
+};
+
+/**
+ * The bars of one week (`week` is its seven dates, Sunday first). Longer and
+ * earlier-starting entries get the upper lanes, and a bar takes the first lane
+ * that is free for all its days.
+ */
+export function weekSegments(
+  entries: CalendarEntry[],
+  week: string[],
+): WeekSegment[] {
+  const first = week[0] as string;
+  const last = week[6] as string;
+  const segments: Omit<WeekSegment, "lane">[] = [];
+  for (const entry of entries) {
+    const end = entryEndDate(entry);
+    if (end < first || entry.date > last) continue;
+    const startColumn = Math.max(0, daysBetween(first, entry.date));
+    const endColumn = Math.min(6, daysBetween(first, end));
+    segments.push({
+      entry,
+      startColumn,
+      span: endColumn - startColumn + 1,
+      continuesBefore: entry.date < first,
+      continuesAfter: end > last,
+    });
+  }
+  segments.sort(
+    (a, b) =>
+      a.startColumn - b.startColumn ||
+      b.span - a.span ||
+      byDisplayOrder(a.entry, b.entry),
+  );
+  const laneEnds: number[] = [];
+  return segments.map((segment) => {
+    let lane = laneEnds.findIndex((end) => end < segment.startColumn);
+    if (lane === -1) lane = laneEnds.length;
+    laneEnds[lane] = segment.startColumn + segment.span - 1;
+    return { ...segment, lane };
+  });
+}
+
+/** The fields of an entry that decide when it starts and ends. */
+export type CalendarRangeInput = {
+  date: string;
+  time?: string;
+  endDate?: string;
+  endTime?: string;
+};
+
+/** Why `range` cannot be saved (a message for the person), or `null`. */
+export function validateRange(range: CalendarRangeInput): string | null {
+  if (!DATE_PATTERN.test(range.date)) return "시작 날짜를 확인해 주세요.";
+  const endDate = range.endDate || range.date;
+  if (!DATE_PATTERN.test(endDate)) return "종료 날짜를 확인해 주세요.";
+  const span = daysBetween(range.date, endDate);
+  if (span < 0) return "종료 날짜는 시작 날짜보다 빠를 수 없습니다.";
+  if (span >= MAX_SPAN_DAYS)
+    return `일정은 최대 ${MAX_SPAN_DAYS}일까지 잡을 수 있습니다.`;
+  if (range.endTime && !range.time)
+    return "종료 시간을 정하려면 시작 시간도 정해 주세요.";
+  if (span === 0 && range.time && range.endTime && range.endTime <= range.time)
+    return "종료 시간은 시작 시간보다 늦어야 합니다.";
+  return null;
+}
+
+/** Live entries of one month grouped by `YYYY-MM-DD`. */
+export function entriesByDate(
+  month: CalendarMonth,
+): Record<string, CalendarEntry[]> {
+  const grouped: Record<string, CalendarEntry[]> = {};
+  for (const entry of liveEntries(month)) {
+    const list = grouped[entry.date];
+    if (list) list.push(entry);
+    else grouped[entry.date] = [entry];
+  }
+  return grouped;
+}
+
+const byteLength = (text: string) => new TextEncoder().encode(text).length;
+
+/**
+ * The document to publish for a month, or `null` when it cannot fit the
+ * relay's size limit. Deletions are kept (they are what stops an older copy
+ * from bringing an entry back); only when the month is over the limit are the
+ * oldest deletions dropped to make room.
+ */
+export function encodeForPublish(month: CalendarMonth): string | null {
+  let content = encodeMonth(month);
+  if (byteLength(content) <= MAX_TEAM_CALENDAR_CONTENT_BYTES) return content;
+  const trimmed: CalendarMonth = { ...month };
+  const deletions = Object.values(month)
+    .filter((entry) => entry.deleted)
+    .sort((a, b) => a.updatedAt - b.updatedAt);
+  for (const entry of deletions) {
+    delete trimmed[entry.id];
+    content = encodeMonth(trimmed);
+    if (byteLength(content) <= MAX_TEAM_CALENDAR_CONTENT_BYTES) return content;
+  }
+  return null;
+}
+
+/**
+ * Every member's newest event for one month merged into one copy, plus the
+ * `created_at` of `pubkey`'s own event (0 when they have none) so the next
+ * publish can replace it.
+ */
+export function mergeMonthEvents(
+  events: RelayEvent[],
+  dTag: string,
+  month: string,
+  pubkey: string,
+): { merged: CalendarMonth; ownCreatedAt: number; own: CalendarMonth } {
+  const newest = new Map<string, RelayEvent>();
+  for (const event of events) {
+    const d = event.tags.filter((tag) => tag[0] === "d");
+    if (d.length !== 1 || d[0]?.[1] !== dTag) continue;
+    const current = newest.get(event.pubkey);
+    // The relay's replaceable winner: later `created_at`, then lower id.
+    if (
+      current &&
+      !(
+        event.created_at > current.created_at ||
+        (event.created_at === current.created_at && event.id < current.id)
+      )
+    )
+      continue;
+    newest.set(event.pubkey, event);
+  }
+  let merged: CalendarMonth = {};
+  let own: CalendarMonth = {};
+  let ownCreatedAt = 0;
+  for (const event of newest.values()) {
+    const copy = decodeMonth(event.content, month);
+    merged = mergeMonths(merged, copy);
+    if (event.pubkey === pubkey) {
+      own = copy;
+      ownCreatedAt = event.created_at;
+    }
+  }
+  return { merged, ownCreatedAt, own };
+}

+++ b/desktop/src/features/team-calendar/lib/useTeamPolls.ts
@@ -0,0 +1,291 @@
+import * as React from "react";
+
+import { relayClient } from "@/shared/api/relayClient";
+import { signRelayEvent } from "@/shared/api/tauri";
+import type { RelayEvent } from "@/shared/api/types";
+import { KIND_CHANNEL_SECTIONS } from "@/shared/constants/kinds";
+import { MAX_TEAM_CALENDAR_AUTHORS, todayKey } from "./teamCalendar";
+import {
+  type DatePoll,
+  MAX_POLL_TITLE_LENGTH,
+  type PollAnswer,
+  type PollInput,
+  type PollState,
+  TEAM_POLLS_D_TAG,
+  decodePollDoc,
+  encodePollDoc,
+  mergePollEvents,
+  mergePolls,
+  pollOptions,
+  teamPollsDTag,
+  validatePoll,
+} from "./teamPolls";
+
+export type TeamPollsStatus = "loading" | "ready" | "error";
+
+const emptyState = (): PollState => ({ polls: {}, answersByMember: {} });
+
+/**
+ * The community's meeting-date polls for one pubkey + relay scope: every
+ * member's copy merged, kept live, and this member's edits and answers
+ * published.
+ */
+export function useTeamPolls(pubkey: string, relayUrl: string) {
+  const scope = `${pubkey}|${relayUrl}`;
+  const [state, setState] = React.useState<{
+    scope: string;
+    data: PollState;
+    status: TeamPollsStatus;
+  }>({ scope, data: emptyState(), status: "loading" });
+  const current =
+    state.scope === scope
+      ? state
+      : { scope, data: emptyState(), status: "loading" as const };
+
+  const liveRef = React.useRef<{
+    scope: string;
+    cancelled: boolean;
+    /** The first read finished, so this member's own answers are known. */
+    loaded: boolean;
+    data: PollState;
+    ownCreatedAt: number;
+    /** What this member's event on the relay holds, as far as we know. */
+    published: string | null;
+    queue: Promise<void>;
+  } | null>(null);
+
+  React.useEffect(() => {
+    const live = {
+      scope,
+      cancelled: false,
+      loaded: false,
+      data: emptyState(),
+      ownCreatedAt: 0,
+      published: null as string | null,
+      queue: Promise.resolve(),
+    };
+    liveRef.current = live;
+    setState({ scope, data: emptyState(), status: "loading" });
+
+    const dTag = teamPollsDTag(relayUrl);
+    const filter = { kinds: [KIND_CHANNEL_SECTIONS], "#d": [dTag] };
+    const apply = (data: PollState, status?: TeamPollsStatus) => {
+      live.data = data;
+      setState((previous) => ({
+        scope,
+        data,
+        status:
+          status ?? (previous.scope === scope ? previous.status : "ready"),
+      }));
+    };
+
+    /** Folds one member's document in; their answers replace the old ones. */
+    const fold = (
+      base: PollState,
+      author: string,
+      polls: Record<string, DatePoll>,
+      answers: Record<string, PollAnswer>,
+    ): PollState => {
+      // This member's own answers are whatever they last chose here, not an
+      // echo of an older event.
+      const keepOwn = author === pubkey && base.answersByMember[pubkey];
+      return {
+        polls: mergePolls(base.polls, polls),
+        answersByMember: keepOwn
+          ? base.answersByMember
+          : { ...base.answersByMember, [author]: answers },
+      };
+    };
+
+    const load = () =>
+      void relayClient
+        .fetchEvents({ ...filter, limit: MAX_TEAM_CALENDAR_AUTHORS })
+        .then(
+          (events) => {
+            if (live.cancelled) return;
+            const merged = mergePollEvents(events, dTag, pubkey);
+            if (merged.ownCreatedAt > live.ownCreatedAt)
+              live.ownCreatedAt = merged.ownCreatedAt;
+            let next = live.data;
+            for (const [author, answers] of Object.entries(
+              merged.answersByMember,
+            ))
+              next = fold(next, author, {}, answers);
+            next = { ...next, polls: mergePolls(next.polls, merged.polls) };
+            live.loaded = true;
+            apply(next, "ready");
+          },
+          () => {
+            if (live.cancelled) return;
+            setState((previous) =>
+              previous.scope === scope && previous.status === "loading"
+                ? { ...previous, status: "error" }
+                : previous,
+            );
+          },
+        );
+
+    const ingest = (event: RelayEvent) => {
+      if (live.cancelled) return;
+      const d = event.tags.filter((tag) => tag[0] === "d");
+      if (d.length !== 1 || d[0]?.[1] !== dTag) return;
+      if (event.pubkey === pubkey && event.created_at > live.ownCreatedAt)
+        live.ownCreatedAt = event.created_at;
+      const doc = decodePollDoc(event.content);
+      apply(fold(live.data, event.pubkey, doc.polls, doc.answers));
+    };
+
+    let unsubLive: (() => Promise<void>) | null = null;
+    void relayClient
+      .subscribeLive({ ...filter, limit: 0 }, ingest)
+      .then((dispose) => {
+        if (live.cancelled) void dispose();
+        else unsubLive = dispose;
+      })
+      .catch(() => {});
+    const unsubReconnect = relayClient.subscribeToReconnects(load);
+    load();
+
+    return () => {
+      live.cancelled = true;
+      unsubReconnect();
+      if (unsubLive) void unsubLive();
+    };
+  }, [scope, pubkey, relayUrl]);
+
+  /** Applies `change` locally, then publishes this member's document. */
+  const commit = React.useCallback(
+    (change: (data: PollState) => PollState): Promise<void> => {
+      const live = liveRef.current;
+      // Publishing before the first read would drop answers already saved.
+      if (!live || live.cancelled || live.scope !== scope || !live.loaded)
+        return Promise.reject(new Error("투표를 아직 불러오는 중입니다."));
+      const next = change(live.data);
+      live.data = next;
+      setState((previous) => ({
+        scope,
+        data: next,
+        status: previous.scope === scope ? previous.status : "ready",
+      }));
+      const run = async () => {
+        if (live.cancelled) return;
+        const content = encodePollDoc(
+          {
+            polls: live.data.polls,
+            answers: live.data.answersByMember[pubkey] ?? {},
+          },
+          todayKey(),
+        );
+        if (content === null)
+          throw new Error("투표가 너무 많아 더 저장할 수 없습니다.");
+        if (content === live.published) return;
+        const createdAt = Math.max(
+          Math.floor(Date.now() / 1_000),
+          live.ownCreatedAt + 1,
+        );
+        const event = await signRelayEvent({
+          kind: KIND_CHANNEL_SECTIONS,
+          content,
+          createdAt,
+          tags: [
+            ["d", teamPollsDTag(relayUrl)],
+            ["t", TEAM_POLLS_D_TAG],
+          ],
+        });
+        try {
+          await relayClient.publishEvent(
+            event,
+            "투표를 저장하는 데 시간이 너무 오래 걸립니다.",
+            "투표를 저장하지 못했습니다.",
+            () => !live.cancelled,
+          );
+        } catch (error) {
+          if (!String((error as Error)?.message).startsWith("duplicate:"))
+            throw error;
+        }
+        live.ownCreatedAt = createdAt;
+        live.published = content;
+      };
+      const result = live.queue.then(run, run);
+      live.queue = result.catch(() => {});
+      return result;
+    },
+    [scope, pubkey, relayUrl],
+  );
+
+  /** Creates a poll, or changes one (pass its `id`). */
+  const savePoll = React.useCallback(
+    (input: PollInput & { id?: string }): Promise<void> => {
+      const problem = validatePoll(input);
+      if (problem) return Promise.reject(new Error(problem));
+      return commit((data) => {
+        const previous = input.id ? data.polls[input.id] : undefined;
+        const poll: DatePoll = {
+          id: input.id ?? crypto.randomUUID(),
+          title: input.title.trim().slice(0, MAX_POLL_TITLE_LENGTH),
+          startDate: input.startDate,
+          endDate: input.endDate,
+          createdBy: previous?.createdBy ?? pubkey,
+          updatedAt: Math.max(Date.now(), (previous?.updatedAt ?? 0) + 1),
+          updatedBy: pubkey,
+        };
+        if (input.hours) poll.hours = input.hours;
+        return { ...data, polls: mergePolls(data.polls, { [poll.id]: poll }) };
+      });
+    },
+    [commit, pubkey],
+  );
+
+  const deletePoll = React.useCallback(
+    (id: string): Promise<void> =>
+      commit((data) => {
+        const poll = data.polls[id];
+        if (!poll || poll.deleted) return data;
+        const gone: DatePoll = {
+          ...poll,
+          title: "",
+          updatedAt: Math.max(Date.now(), poll.updatedAt + 1),
+          updatedBy: pubkey,
+          deleted: true,
+        };
+        return { ...data, polls: mergePolls(data.polls, { [id]: gone }) };
+      }),
+    [commit, pubkey],
+  );
+
+  /** Replaces this member's answer to a poll. */
+  const answerPoll = React.useCallback(
+    (id: string, choices: string[]): Promise<void> =>
+      commit((data) => {
+        const poll = data.polls[id];
+        if (!poll || poll.deleted) return data;
+        const options = new Set(pollOptions(poll));
+        const answer: PollAnswer = {
+          choices: [...new Set(choices)]
+            .filter((choice) => options.has(choice))
+            .sort(),
+          updatedAt: Date.now(),
+        };
+        return {
+          ...data,
+          answersByMember: {
+            ...data.answersByMember,
+            [pubkey]: { ...data.answersByMember[pubkey], [id]: answer },
+          },
+        };
+      }),
+    [commit, pubkey],
+  );
+
+  const retry = React.useCallback(() => commit((data) => data), [commit]);
+
+  return {
+    polls: current.data.polls,
+    answersByMember: current.data.answersByMember,
+    status: current.status,
+    savePoll,
+    deletePoll,
+    answerPoll,
+    retry,
+  };
+}
diff --git a/desktop/src/features/team-calendar/ui/AddFromMessageDialog.tsx b/desktop/src/features/team-calendar/ui/AddFromMessageDialog.tsx
new file mode 100644
index 0000000..203cbbc
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/AddFromMessageDialog.tsx
@@ -0,0 +1,135 @@
+import * as React from "react";
+import { toast } from "sonner";
+
+import { useChannelMembersQuery } from "@/features/channels/hooks";
+import {
+  type AddFromMessageRequest,
+  entryIdForMessage,
+} from "@/features/team-calendar/lib/addFromMessage";
+import {
+  parseSchedule,
+  titleFromMessage,
+} from "@/features/team-calendar/lib/parseSchedule";
+import { todayKey } from "@/features/team-calendar/lib/teamCalendar";
+import { saveEntryToDoc } from "@/features/team-calendar/lib/useTeamCalendar";
+import { useTeamMembers } from "@/features/team-calendar/lib/useTeamMembers";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/shared/ui/dialog";
+import {
+  type Draft,
+  EntryForm,
+  draftError,
+  emptyDraft,
+  inputOfDraft,
+} from "./EntryForm";
+
+/**
+ * Confirms a calendar entry made from a chat message (team patch). The date
+ * and time are read from the message text as a first guess, and the channel's
+ * members are the attendees until the person changes them. The entry id comes
+ * from the message, so adding the same message again edits that entry.
+ */
+export function AddFromMessageDialog({
+  pubkey,
+  relayUrl,
+  request,
+  onClose,
+}: {
+  pubkey: string;
+  relayUrl: string;
+  request: AddFromMessageRequest;
+  onClose: () => void;
+}) {
+  const channelMembers = useChannelMembersQuery(request.channelId).data;
+  const channelPeople = React.useMemo(
+    () =>
+      (channelMembers ?? [])
+        .filter((member) => !member.isAgent)
+        .map((member) => member.pubkey.toLowerCase()),
+    [channelMembers],
+  );
+  const { members } = useTeamMembers(channelPeople);
+  const parsed = React.useMemo(
+    () => parseSchedule(request.text),
+    [request.text],
+  );
+  const [draft, setDraft] = React.useState<Draft>(() => {
+    return {
+      ...emptyDraft(parsed?.date ?? todayKey()),
+      id: entryIdForMessage(request.eventId),
+      sourceEventId: request.eventId,
+      title: titleFromMessage(request.text),
+      time: parsed?.time ?? "",
+      endTime: parsed?.endTime ?? "",
+    };
+  });
+  const [saving, setSaving] = React.useState(false);
+  // The channel's members arrive after the first render; they are the default
+  // attendees until the person touches the list.
+  const touchedRef = React.useRef(false);
+  React.useEffect(() => {
+    if (touchedRef.current || channelPeople.length === 0) return;
+    setDraft((current) => ({
+      ...current,
+      everyone: false,
+      attendees: channelPeople,
+    }));
+  }, [channelPeople]);
+
+  const submit = async () => {
+    if (saving || draft.title.trim().length === 0 || draftError(draft)) return;
+    setSaving(true);
+    try {
+      await saveEntryToDoc({ pubkey, relayUrl, entry: inputOfDraft(draft) });
+      toast.success("캘린더에 추가했습니다.");
+      onClose();
+    } catch (error) {
+      toast.error(
+        error instanceof Error && error.message
+          ? error.message
+          : "일정을 저장하지 못했습니다.",
+      );
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <Dialog onOpenChange={(open) => (open ? undefined : onClose())} open>
+      <DialogContent
+        className="max-w-md"
+        data-no-translate=""
+        data-testid="team-calendar-from-message"
+      >
+        <DialogHeader>
+          <DialogTitle>캘린더에 추가</DialogTitle>
+          <DialogDescription>
+            {parsed
+              ? "메시지에서 날짜와 시간을 읽어 왔습니다. 맞는지 확인하고 저장해 주세요."
+              : "메시지에서 날짜를 찾지 못했습니다. 직접 골라 주세요."}
+          </DialogDescription>
+        </DialogHeader>
+        <EntryForm
+          draft={draft}
+          members={members}
+          onCancel={onClose}
+          onChange={(next) => {
+            if (
+              next.everyone !== draft.everyone ||
+              next.attendees !== draft.attendees
+            )
+              touchedRef.current = true;
+            setDraft(next);
+          }}
+          onSubmit={() => void submit()}
+          saving={saving}
+        />
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/desktop/src/features/team-calendar/ui/EntryForm.tsx b/desktop/src/features/team-calendar/ui/EntryForm.tsx
new file mode 100644
index 0000000..155f643
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/EntryForm.tsx
@@ -0,0 +1,355 @@
+import type * as React from "react";
+
+import {
+  type CalendarColor,
+  type CalendarOccurrence,
+  CALENDAR_COLORS,
+  MAX_NOTE_LENGTH,
+  MAX_TITLE_LENGTH,
+  type RepeatEvery,
+  REPEAT_CHOICES,
+  addDays,
+  daysBetween,
+  entryEndDate,
+  validateRange,
+} from "@/features/team-calendar/lib/teamCalendar";
+import type { CalendarEntryInput } from "@/features/team-calendar/lib/useTeamCalendar";
+import type { TeamMember } from "@/features/team-calendar/lib/useTeamMembers";
+import { cn } from "@/shared/lib/cn";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import { Textarea } from "@/shared/ui/textarea";
+import { MemberPicker } from "./MemberPicker";
+
+/** An empty color is the default look. */
+export type ColorChoice = CalendarColor | "";
+
+// Tailwind only keeps class names it can read in full, so they are spelled out.
+export const COLOR_STYLES: Record<
+  ColorChoice,
+  { label: string; bar: string; dot: string }
+> = {
+  "": { label: "기본", bar: "bg-primary/15", dot: "bg-primary" },
+  red: { label: "빨강", bar: "bg-red-500/25", dot: "bg-red-500" },
+  orange: { label: "주황", bar: "bg-orange-500/25", dot: "bg-orange-500" },
+  green: { label: "초록", bar: "bg-green-500/25", dot: "bg-green-500" },
+  blue: { label: "파랑", bar: "bg-blue-500/25", dot: "bg-blue-500" },
+  purple: { label: "보라", bar: "bg-purple-500/25", dot: "bg-purple-500" },
+  pink: { label: "분홍", bar: "bg-pink-500/25", dot: "bg-pink-500" },
+  gray: { label: "회색", bar: "bg-gray-500/25", dot: "bg-gray-500" },
+};
+const COLOR_CHOICES: ColorChoice[] = ["", ...CALENDAR_COLORS];
+
+export const REPEAT_LABELS: Record<RepeatEvery, string> = {
+  daily: "매일",
+  weekly: "매주",
+  biweekly: "2주마다",
+  monthly: "매월",
+};
+
+export type Draft = {
+  id?: string;
+  title: string;
+  date: string;
+  time: string;
+  endDate: string;
+  endTime: string;
+  color: ColorChoice;
+  note: string;
+  repeat: RepeatEvery | "";
+  until: string;
+  everyone: boolean;
+  attendees: string[];
+  skip?: string[];
+  sourceEventId?: string;
+};
+
+export const emptyDraft = (date: string): Draft => ({
+  title: "",
+  date,
+  time: "",
+  endDate: date,
+  endTime: "",
+  color: "",
+  note: "",
+  repeat: "",
+  until: "",
+  everyone: true,
+  attendees: [],
+});
+
+/** The draft that edits `entry` (for a repeating entry: the whole series). */
+export function draftOf(entry: CalendarOccurrence): Draft {
+  const start = entry.seriesDate ?? entry.date;
+  const span = daysBetween(entry.date, entryEndDate(entry));
+  return {
+    id: entry.id,
+    title: entry.title,
+    date: start,
+    time: entry.time ?? "",
+    endDate: addDays(start, span),
+    endTime: entry.endTime ?? "",
+    color: entry.color ?? "",
+    note: entry.note ?? "",
+    repeat: entry.repeat?.every ?? "",
+    until: entry.repeat?.until ?? "",
+    everyone: !entry.attendees,
+    attendees: entry.attendees ?? [],
+    skip: entry.skip,
+    sourceEventId: entry.sourceEventId,
+  };
+}
+
+const repeatOf = (draft: Draft) =>
+  draft.repeat
+    ? { every: draft.repeat, until: draft.until || undefined }
+    : undefined;
+
+/** Why the draft cannot be saved (a message for the person), or `null`. */
+export function draftError(draft: Draft): string | null {
+  const range = validateRange({
+    date: draft.date,
+    time: draft.time || undefined,
+    endDate: draft.endDate || undefined,
+    endTime: draft.endTime || undefined,
+    repeat: repeatOf(draft),
+  });
+  if (range) return range;
+  if (!draft.everyone && draft.attendees.length === 0)
+    return "참석자를 한 명 이상 골라 주세요.";
+  return null;
+}
+
+export function inputOfDraft(draft: Draft): CalendarEntryInput {
+  return {
+    id: draft.id,
+    title: draft.title.trim(),
+    date: draft.date,
+    time: draft.time || undefined,
+    endDate: draft.endDate || undefined,
+    endTime: draft.endTime || undefined,
+    color: draft.color || undefined,
+    note: draft.note.trim() || undefined,
+    attendees: draft.everyone ? undefined : draft.attendees,
+    repeat: repeatOf(draft),
+    skip: draft.repeat ? draft.skip : undefined,
+    sourceEventId: draft.sourceEventId,
+  };
+}
+
+/** The end date once the start moves to `date`: an entry keeps its length. */
+function endAfterStartMove(draft: Draft, date: string): string {
+  if (!date || !draft.date || !draft.endDate) return date || draft.endDate;
+  return addDays(date, Math.max(0, daysBetween(draft.date, draft.endDate)));
+}
+
+const SELECT_CLASS =
+  "h-9 rounded-md border border-input bg-background px-2 text-sm focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring";
+
+/** The add/edit form of one calendar entry. */
+export function EntryForm({
+  draft,
+  members,
+  saving,
+  onChange,
+  onCancel,
+  onSubmit,
+}: {
+  draft: Draft;
+  members: TeamMember[];
+  saving: boolean;
+  onChange: (draft: Draft) => void;
+  onCancel: () => void;
+  onSubmit: () => void;
+}) {
+  const error = draftError(draft);
+  const submit = (event: React.FormEvent) => {
+    event.preventDefault();
+    onSubmit();
+  };
+
+  return (
+    <form
+      className="flex max-h-[min(36rem,62vh)] flex-col gap-2 overflow-y-auto pr-1"
+      data-testid="team-calendar-form"
+      onSubmit={submit}
+    >
+      <label className="flex flex-col gap-1 text-xs">
+        제목
+        <Input
+          autoFocus
+          maxLength={MAX_TITLE_LENGTH}
+          onChange={(event) => onChange({ ...draft, title: event.target.value })}
+          placeholder="예: 기획 회의"
+          required
+          value={draft.title}
+        />
+      </label>
+      <div className="flex gap-2">
+        <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+          시작 날짜
+          <Input
+            onChange={(event) => {
+              const date = event.target.value;
+              onChange({
+                ...draft,
+                date,
+                endDate: endAfterStartMove(draft, date),
+              });
+            }}
+            required
+            type="date"
+            value={draft.date}
+          />
+        </label>
+        <label className="flex w-28 flex-col gap-1 text-xs">
+          시작 시간 (선택)
+          <Input
+            onChange={(event) =>
+              onChange({
+                ...draft,
+                time: event.target.value,
+                // An end time means nothing without a start time.
+                endTime: event.target.value ? draft.endTime : "",
+              })
+            }
+            type="time"
+            value={draft.time}
+          />
+        </label>
+      </div>
+      <div className="flex gap-2">
+        <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+          종료 날짜
+          <Input
+            min={draft.date || undefined}
+            onChange={(event) =>
+              onChange({ ...draft, endDate: event.target.value })
+            }
+            required
+            type="date"
+            value={draft.endDate}
+          />
+        </label>
+        <label className="flex w-28 flex-col gap-1 text-xs">
+          종료 시간 (선택)
+          <Input
+            disabled={!draft.time}
+            onChange={(event) =>
+              onChange({ ...draft, endTime: event.target.value })
+            }
+            type="time"
+            value={draft.endTime}
+          />
+        </label>
+      </div>
+      <div className="flex gap-2">
+        <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+          반복
+          <select
+            className={SELECT_CLASS}
+            data-testid="team-calendar-repeat"
+            onChange={(event) =>
+              onChange({
+                ...draft,
+                repeat: event.target.value as RepeatEvery | "",
+              })
+            }
+            value={draft.repeat}
+          >
+            <option value="">반복 안 함</option>
+            {REPEAT_CHOICES.map((choice) => (
+              <option key={choice} value={choice}>
+                {REPEAT_LABELS[choice]}
+              </option>
+            ))}
+          </select>
+        </label>
+        {draft.repeat ? (
+          <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+            반복 종료 (선택)
+            <Input
+              min={draft.date || undefined}
+              onChange={(event) =>
+                onChange({ ...draft, until: event.target.value })
+              }
+              type="date"
+              value={draft.until}
+            />
+          </label>
+        ) : null}
+      </div>
+      {error ? (
+        <p
+          className="text-xs text-destructive"
+          data-testid="team-calendar-range-error"
+          role="alert"
+        >
+          {error}
+        </p>
+      ) : null}
+      <fieldset className="flex min-w-0 flex-col gap-1 text-xs">
+        <legend className="mb-1">색상</legend>
+        <div className="flex flex-wrap gap-1.5">
+          {COLOR_CHOICES.map((choice) => {
+            const { label, dot } = COLOR_STYLES[choice];
+            const checked = draft.color === choice;
+            return (
+              <button
+                aria-label={label}
+                aria-pressed={checked}
+                className={cn(
+                  "h-5 w-5 rounded-full border-2 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring",
+                  dot,
+                  checked ? "border-foreground" : "border-transparent",
+                )}
+                data-testid={`team-calendar-color-${choice || "default"}`}
+                key={choice || "default"}
+                onClick={() => onChange({ ...draft, color: choice })}
+                title={label}
+                type="button"
+              />
+            );
+          })}
+        </div>
+      </fieldset>
+      <MemberPicker
+        everyone={draft.everyone}
+        members={members}
+        onChange={({ everyone, selected }) =>
+          onChange({ ...draft, everyone, attendees: selected })
+        }
+        selected={draft.attendees}
+      />
+      <label className="flex flex-col gap-1 text-xs">
+        메모 (선택)
+        <Textarea
+          maxLength={MAX_NOTE_LENGTH}
+          onChange={(event) => onChange({ ...draft, note: event.target.value })}
+          rows={2}
+          value={draft.note}
+        />
+      </label>
+      <div className="flex justify-end gap-2">
+        <Button
+          disabled={saving}
+          onClick={onCancel}
+          size="sm"
+          type="button"
+          variant="ghost"
+        >
+          취소
+        </Button>
+        <Button
+          disabled={
+            saving || draft.title.trim().length === 0 || error !== null
+          }
+          size="sm"
+          type="submit"
+        >
+          {draft.id ? "수정 저장" : "저장"}
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/desktop/src/features/team-calendar/ui/MemberPicker.tsx b/desktop/src/features/team-calendar/ui/MemberPicker.tsx
new file mode 100644
index 0000000..d702c0e
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/MemberPicker.tsx
@@ -0,0 +1,59 @@
+import type { TeamMember } from "@/features/team-calendar/lib/useTeamMembers";
+import { Checkbox } from "@/shared/ui/checkbox";
+
+/**
+ * Attendee choice: the whole team, or a ticked list of members. An empty
+ * `selected` with `everyone` means the entry is for all.
+ */
+export function MemberPicker({
+  members,
+  everyone,
+  selected,
+  onChange,
+}: {
+  members: TeamMember[];
+  everyone: boolean;
+  selected: string[];
+  onChange: (next: { everyone: boolean; selected: string[] }) => void;
+}) {
+  const chosen = new Set(selected);
+  return (
+    <fieldset className="flex min-w-0 flex-col gap-1 text-xs">
+      <legend className="mb-1">참석자</legend>
+      <label className="flex items-center gap-2">
+        <Checkbox
+          checked={everyone}
+          data-testid="team-calendar-attendees-everyone"
+          onCheckedChange={(checked) =>
+            onChange({ everyone: checked === true, selected })
+          }
+        />
+        팀 전체
+      </label>
+      {everyone ? null : (
+        <div className="flex max-h-32 flex-col gap-1 overflow-y-auto rounded-lg border border-border/60 p-2">
+          {members.length === 0 ? (
+            <span className="text-muted-foreground">
+              멤버를 불러오는 중…
+            </span>
+          ) : (
+            members.map((member) => (
+              <label className="flex items-center gap-2" key={member.pubkey}>
+                <Checkbox
+                  checked={chosen.has(member.pubkey)}
+                  onCheckedChange={(checked) => {
+                    const next = new Set(chosen);
+                    if (checked === true) next.add(member.pubkey);
+                    else next.delete(member.pubkey);
+                    onChange({ everyone: false, selected: [...next] });
+                  }}
+                />
+                <span className="truncate">{member.name}</span>
+              </label>
+            ))
+          )}
+        </div>
+      )}
+    </fieldset>
+  );
+}
diff --git a/desktop/src/features/team-calendar/ui/PollDetail.tsx b/desktop/src/features/team-calendar/ui/PollDetail.tsx
new file mode 100644
index 0000000..fb693e8
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/PollDetail.tsx
@@ -0,0 +1,343 @@
+import { ArrowLeft, CalendarPlus, Trash2 } from "lucide-react";
+import * as React from "react";
+
+import {
+  type DatePoll,
+  type PollAnswer,
+  type PollRange,
+  mergeOptions,
+  pollDates,
+  pollHours,
+  rankPollRanges,
+  slotKey,
+  tallyPoll,
+} from "@/features/team-calendar/lib/teamPolls";
+import type { TeamMember } from "@/features/team-calendar/lib/useTeamMembers";
+import { cn } from "@/shared/lib/cn";
+import { Button } from "@/shared/ui/button";
+
+const WEEKDAYS = ["일", "월", "화", "수", "목", "금", "토"] as const;
+
+export function dayLabel(date: string): string {
+  const [year, month, day] = date.split("-").map(Number) as [
+    number,
+    number,
+    number,
+  ];
+  return `${month}/${day} (${WEEKDAYS[new Date(year, month - 1, day).getDay()]})`;
+}
+
+/** "10/12 (월)" or "10/12 (월) 14시~17시". */
+function rangeLabel(range: PollRange): string {
+  return range.from === undefined
+    ? dayLabel(range.date)
+    : `${dayLabel(range.date)} ${range.from}시~${range.to}시`;
+}
+
+const pad = (value: number) => String(value).padStart(2, "0");
+
+/** What "make this an entry" hands to the calendar. */
+export type PollPick = {
+  title: string;
+  date: string;
+  time?: string;
+  endTime?: string;
+  attendees: string[];
+};
+
+/**
+ * One poll (team patch). A member first ticks when they can make it and
+ * confirms; after that the poll reads as plain text: the times most people
+ * can make, then when each person can.
+ */
+export function PollDetail({
+  poll,
+  pubkey,
+  answersByMember,
+  members,
+  nameOf,
+  saving,
+  onAnswer,
+  onDelete,
+  onBack,
+  onPick,
+}: {
+  poll: DatePoll;
+  pubkey: string;
+  answersByMember: Record<string, Record<string, PollAnswer>>;
+  members: TeamMember[];
+  nameOf: (pubkey: string) => string;
+  saving: boolean;
+  /** Saves this member's answer; resolves to whether it was saved. */
+  onAnswer: (choices: string[]) => Promise<boolean>;
+  onDelete: () => void;
+  onBack: () => void;
+  onPick: (pick: PollPick) => void;
+}) {
+  const myAnswer = answersByMember[pubkey]?.[poll.id];
+  const [picking, setPicking] = React.useState(myAnswer === undefined);
+  const [chosen, setChosen] = React.useState<Set<string>>(
+    () => new Set(myAnswer?.choices ?? []),
+  );
+  const [confirmingDelete, setConfirmingDelete] = React.useState(false);
+
+  const dates = pollDates(poll);
+  const hours = pollHours(poll);
+  const unit = hours.length > 0 ? "시간" : "날";
+
+  const toggle = (option: string) =>
+    setChosen((current) => {
+      const next = new Set(current);
+      if (next.has(option)) next.delete(option);
+      else next.add(option);
+      return next;
+    });
+
+  const cell = (option: string, label: string) => {
+    const on = chosen.has(option);
+    return (
+      <button
+        aria-label={`${label}${on ? ", 고름" : ""}`}
+        aria-pressed={on}
+        className={cn(
+          "min-w-0 truncate rounded-md border px-2 py-1.5 text-xs transition-colors hover:bg-muted/70 focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring",
+          on
+            ? "border-primary bg-primary/20 font-medium"
+            : "border-border/60 bg-background text-muted-foreground",
+        )}
+        data-testid={`team-poll-option-${option}`}
+        key={option}
+        onClick={() => toggle(option)}
+        type="button"
+      >
+        {label}
+      </button>
+    );
+  };
+
+  const tally = tallyPoll(poll, answersByMember);
+  const ranked = rankPollRanges(poll, tally);
+  const waiting = members.filter(
+    (member) => !tally.voters.includes(member.pubkey),
+  );
+
+  return (
+    <div className="flex min-h-80 flex-col gap-3" data-testid="team-poll-detail">
+      <div className="flex items-center gap-2">
+        <Button
+          aria-label="투표 목록으로"
+          onClick={onBack}
+          size="icon"
+          type="button"
+          variant="ghost"
+        >
+          <ArrowLeft className="h-4 w-4" />
+        </Button>
+        <h3 className="min-w-0 flex-1 truncate text-sm font-semibold">
+          {poll.title}
+        </h3>
+        {confirmingDelete ? (
+          <Button
+            disabled={saving}
+            onBlur={() => setConfirmingDelete(false)}
+            onClick={onDelete}
+            size="xs"
+            type="button"
+            variant="destructive"
+          >
+            삭제 확인
+          </Button>
+        ) : (
+          <Button
+            aria-label="투표 삭제"
+            disabled={saving}
+            onClick={() => setConfirmingDelete(true)}
+            size="icon-xs"
+            type="button"
+            variant="ghost"
+          >
+            <Trash2 />
+          </Button>
+        )}
+      </div>
+
+      {picking ? (
+        <>
+          <p className="text-xs text-muted-foreground">
+            내가 되는 {unit}을 모두 누른 뒤 아래 "확인"을 눌러 주세요. 다시
+            누르면 취소됩니다.
+          </p>
+          {hours.length === 0 ? (
+            <div className="grid grid-cols-4 gap-1.5 sm:grid-cols-7">
+              {dates.map((date) => cell(date, dayLabel(date)))}
+            </div>
+          ) : (
+            <div className="max-h-72 overflow-auto">
+              <div
+                className="grid gap-1"
+                style={{
+                  gridTemplateColumns: `repeat(${dates.length}, minmax(4.5rem, 1fr))`,
+                }}
+              >
+                {dates.map((date) => (
+                  <span
+                    className="text-center text-2xs text-muted-foreground"
+                    key={date}
+                  >
+                    {dayLabel(date)}
+                  </span>
+                ))}
+                {hours.map((hour) => (
+                  <React.Fragment key={hour}>
+                    {dates.map((date) =>
+                      cell(slotKey(date, hour), `${hour}시~${hour + 1}시`),
+                    )}
+                  </React.Fragment>
+                ))}
+              </div>
+            </div>
+          )}
+          <div className="flex items-center justify-end gap-2">
+            <span className="mr-auto text-xs text-muted-foreground">
+              {chosen.size === 0
+                ? `고른 ${unit}이 없습니다. 이대로 확인하면 "되는 때 없음"으로 저장됩니다.`
+                : `내가 고른 때: ${mergeOptions([...chosen]).map(rangeLabel).join(", ")}`}
+            </span>
+            {myAnswer ? (
+              <Button
+                disabled={saving}
+                onClick={() => {
+                  setChosen(new Set(myAnswer.choices));
+                  setPicking(false);
+                }}
+                size="sm"
+                type="button"
+                variant="ghost"
+              >
+                취소
+              </Button>
+            ) : null}
+            <Button
+              data-testid="team-poll-confirm"
+              disabled={saving}
+              onClick={() =>
+                void onAnswer([...chosen]).then((saved) => {
+                  if (saved) setPicking(false);
+                })
+              }
+              size="sm"
+              type="button"
+            >
+              확인
+            </Button>
+          </div>
+        </>
+      ) : (
+        <div className="flex flex-col gap-3 text-sm" data-testid="team-poll-result">
+          <section className="rounded-lg border border-border/60 px-3 py-2">
+            <h4 className="text-xs font-semibold text-muted-foreground">
+              가장 많이 되는 때
+            </h4>
+            {ranked.length === 0 ? (
+              <p className="mt-1 text-muted-foreground">
+                아직 되는 때를 고른 사람이 없습니다.
+              </p>
+            ) : (
+              <ol className="mt-1 flex flex-col gap-1.5">
+                {ranked.map((range, index) => (
+                  <li
+                    className="flex items-center gap-2"
+                    key={`${range.date}-${range.from ?? "day"}`}
+                  >
+                    <span className="min-w-0 flex-1 break-words">
+                      <span
+                        className={cn(
+                          "font-semibold",
+                          index === 0 && "text-base text-green-600",
+                        )}
+                      >
+                        {rangeLabel(range)}
+                      </span>{" "}
+                      · {range.members.length}명
+                      <span className="text-xs text-muted-foreground">
+                        {" "}
+                        ({range.members.map(nameOf).join(", ")})
+                      </span>
+                    </span>
+                    <Button
+                      data-testid="team-poll-pick"
+                      onClick={() =>
+                        onPick({
+                          title: poll.title,
+                          date: range.date,
+                          time:
+                            range.from === undefined
+                              ? undefined
+                              : `${pad(range.from)}:00`,
+                          endTime:
+                            range.to === undefined
+                              ? undefined
+                              : range.to === 24
+                                ? "23:59"
+                                : `${pad(range.to)}:00`,
+                          attendees: range.members,
+                        })
+                      }
+                      size="xs"
+                      type="button"
+                      variant="outline"
+                    >
+                      <CalendarPlus className="h-3.5 w-3.5" />
+                      일정으로 만들기
+                    </Button>
+                  </li>
+                ))}
+              </ol>
+            )}
+          </section>
+
+          <section className="rounded-lg border border-border/60 px-3 py-2">
+            <h4 className="text-xs font-semibold text-muted-foreground">
+              사람별 되는 때 (응답 {tally.voters.length}명)
+            </h4>
+            <ul className="mt-1 flex max-h-48 flex-col gap-1 overflow-y-auto">
+              {tally.voters.map((voter) => {
+                const ranges = mergeOptions(
+                  answersByMember[voter]?.[poll.id]?.choices ?? [],
+                );
+                return (
+                  <li className="break-words" key={voter}>
+                    <span className="font-medium">{nameOf(voter)}</span>:{" "}
+                    {ranges.length === 0
+                      ? "되는 때 없음"
+                      : ranges.map(rangeLabel).join(", ")}
+                  </li>
+                );
+              })}
+            </ul>
+            {waiting.length > 0 ? (
+              <p className="mt-2 break-words text-xs text-muted-foreground">
+                아직 답하지 않음: {waiting.map((member) => member.name).join(", ")}
+              </p>
+            ) : null}
+          </section>
+
+          <div className="flex justify-end">
+            <Button
+              data-testid="team-poll-edit-answer"
+              onClick={() => {
+                setChosen(new Set(myAnswer?.choices ?? []));
+                setPicking(true);
+              }}
+              size="sm"
+              type="button"
+              variant="outline"
+            >
+              {myAnswer ? "내 답 고치기" : "내 답 고르기"}
+            </Button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/desktop/src/features/team-calendar/ui/PollsPanel.tsx b/desktop/src/features/team-calendar/ui/PollsPanel.tsx
new file mode 100644
index 0000000..6147470
--- /dev/null
+++ b/desktop/src/features/team-calendar/ui/PollsPanel.tsx
@@ -0,0 +1,296 @@
+import { Plus } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import { addDays, todayKey } from "@/features/team-calendar/lib/teamCalendar";
+import {
+  type DatePoll,
+  MAX_POLL_TITLE_LENGTH,
+  type PollInput,
+  livePolls,
+  tallyPoll,
+  validatePoll,
+} from "@/features/team-calendar/lib/teamPolls";
+import { useTeamPolls } from "@/features/team-calendar/lib/useTeamPolls";
+import type { TeamMember } from "@/features/team-calendar/lib/useTeamMembers";
+import { Button } from "@/shared/ui/button";
+import { Checkbox } from "@/shared/ui/checkbox";
+import { Input } from "@/shared/ui/input";
+import { type PollPick, PollDetail, dayLabel } from "./PollDetail";
+
+export type { PollPick };
+
+const errorText = (error: unknown, fallback: string) =>
+  error instanceof Error && error.message ? error.message : fallback;
+
+const SELECT_CLASS =
+  "h-9 rounded-md border border-input bg-background px-2 text-sm focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring";
+
+type PollDraft = {
+  title: string;
+  startDate: string;
+  endDate: string;
+  withHours: boolean;
+  from: number;
+  to: number;
+};
+
+const inputOf = (draft: PollDraft): PollInput => ({
+  title: draft.title,
+  startDate: draft.startDate,
+  endDate: draft.endDate,
+  hours: draft.withHours ? { from: draft.from, to: draft.to } : undefined,
+});
+
+/**
+ * Meeting-date polls (team patch): propose a span of days, everyone ticks
+ * when they can make it, and the days most people can make are shown.
+ */
+export function PollsPanel({
+  pubkey,
+  relayUrl,
+  members,
+  nameOf,
+  onPick,
+}: {
+  pubkey: string;
+  relayUrl: string;
+  members: TeamMember[];
+  nameOf: (pubkey: string) => string;
+  onPick: (pick: PollPick) => void;
+}) {
+  const { polls, answersByMember, status, savePoll, deletePoll, answerPoll } =
+    useTeamPolls(pubkey, relayUrl);
+  const [openId, setOpenId] = React.useState<string | null>(null);
+  const [draft, setDraft] = React.useState<PollDraft | null>(null);
+  const [saving, setSaving] = React.useState(false);
+
+  const list = livePolls(polls);
+  const poll: DatePoll | undefined = openId
+    ? list.find((candidate) => candidate.id === openId)
+    : undefined;
+
+  const run = async (action: () => Promise<void>, failure: string) => {
+    setSaving(true);
+    try {
+      await action();
+      return true;
+    } catch (error) {
+      toast.error(errorText(error, failure));
+      return false;
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  if (draft) {
+    const problem = validatePoll(inputOf(draft));
+    return (
+      <form
+        className="flex min-h-80 max-w-md flex-col gap-2"
+        data-testid="team-poll-form"
+        onSubmit={(event) => {
+          event.preventDefault();
+          if (problem || saving) return;
+          void run(
+            () => savePoll(inputOf(draft)),
+            "투표를 만들지 못했습니다.",
+          ).then((saved) => {
+            if (saved) setDraft(null);
+          });
+        }}
+      >
+        <h3 className="text-sm font-semibold">모임 날짜 투표 만들기</h3>
+        <label className="flex flex-col gap-1 text-xs">
+          제목
+          <Input
+            autoFocus
+            maxLength={MAX_POLL_TITLE_LENGTH}
+            onChange={(event) =>
+              setDraft({ ...draft, title: event.target.value })
+            }
+            placeholder="예: 10월 정기 모임"
+            value={draft.title}
+          />
+        </label>
+        <div className="flex gap-2">
+          <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+            후보 시작 날짜
+            <Input
+              onChange={(event) =>
+                setDraft({ ...draft, startDate: event.target.value })
+              }
+              type="date"
+              value={draft.startDate}
+            />
+          </label>
+          <label className="flex min-w-0 flex-1 flex-col gap-1 text-xs">
+            후보 종료 날짜
+            <Input
+              min={draft.startDate || undefined}
+              onChange={(event) =>
+                setDraft({ ...draft, endDate: event.target.value })
+              }
+              type="date"
+              value={draft.endDate}
+            />
+          </label>
+        </div>
+        <label className="flex items-center gap-2 text-xs">
+          <Checkbox
+            checked={draft.withHours}
+            data-testid="team-poll-with-hours"
+            onCheckedChange={(checked) =>
+              setDraft({ ...draft, withHours: checked === true })
+            }
+          />
+          시간대까지 고르기
+        </label>
+        {draft.withHours ? (
+          <div className="flex items-center gap-2 text-xs">
+            <select
+              aria-label="시작 시각"
+              className={SELECT_CLASS}
+              onChange={(event) =>
+                setDraft({ ...draft, from: Number(event.target.value) })
+              }
+              value={draft.from}
+            >
+              {Array.from({ length: 24 }, (_, hour) => hour).map((hour) => (
+                <option key={hour} value={hour}>
+                  {hour}시
+                </option>
+              ))}
+            </select>
+            부터
+            <select
+              aria-label="끝 시각"
+              className={SELECT_CLASS}
+              onChange={(event) =>
+                setDraft({ ...draft, to: Number(event.target.value) })
+              }
+              value={draft.to}
+            >
+              {Array.from({ length: 24 }, (_, hour) => hour + 1).map((hour) => (
+                <option key={hour} value={hour}>
+                  {hour}시
+                </option>
+              ))}
+            </select>
+            까지
+          </div>
+        ) : null}
+        {problem && draft.title.trim().length > 0 ? (
+          <p className="text-xs text-destructive" role="alert">
+            {problem}
+          </p>
+        ) : null}
+        <div className="flex justify-end gap-2">
+          <Button
+            disabled={saving}
+            onClick={() => setDraft(null)}
+            size="sm"
+            type="button"
+            variant="ghost"
+          >
+            취소
+          </Button>
+          <Button disabled={saving || problem !== null} size="sm" type="submit">
+            만들기
+          </Button>
+        </div>
+      </form>
+    );
+  }
+
+  if (poll) {
+    return (
+      <PollDetail

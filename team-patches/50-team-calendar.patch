+                        </p>
+                        <p className="text-xs text-muted-foreground">
+                          {entry.time ?? "하루 종일"}
+                        </p>
+                      </div>
+                      <Button
+                        aria-label={`${entry.title} 수정`}
+                        disabled={saving}
+                        onClick={() =>
+                          setDraft({
+                            id: entry.id,
+                            title: entry.title,
+                            date: entry.date,
+                            time: entry.time ?? "",
+                            note: entry.note ?? "",
+                          })
+                        }
+                        size="icon-xs"
+                        type="button"
+                        variant="ghost"
+                      >
+                        <Pencil />
+                      </Button>
+                      {confirmingId === entry.id ? (
+                        <Button
+                          aria-label={`${entry.title} 삭제 확인`}
+                          disabled={saving}
+                          onBlur={() => setConfirmingId(null)}
+                          onClick={() => removeEntry(entry)}
+                          size="xs"
+                          type="button"
+                          variant="destructive"
+                        >
+                          삭제 확인
+                        </Button>
+                      ) : (
+                        <Button
+                          aria-label={`${entry.title} 삭제`}
+                          disabled={saving}
+                          onClick={() => removeEntry(entry)}
+                          size="icon-xs"
+                          type="button"
+                          variant="ghost"
+                        >
+                          <Trash2 />
+                        </Button>
+                      )}
+                    </div>
+                    {entry.note ? (
+                      <p className="mt-1 whitespace-pre-wrap break-words text-xs text-muted-foreground">
+                        {entry.note}
+                      </p>
+                    ) : null}
+                  </li>
+                ))}
+              </ul>
+            )}
+          </section>
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
